/* KBO V4 UNIFIED SCORE PROBABILITY ENGINE - shadow first */
export const KBO_V4_ENGINE_VERSION = "4.0-shadow";

export type KboV4ScorePoint = { away: number; home: number; p: number };
export type KboV4Result = { engineVersion: string; expectedAway: number; expectedHome: number; awayWin: number; homeWin: number; tie: number; distribution: KboV4ScorePoint[] };
export type KboV4MarketProbability = { win: number; push: number };

const AWAY_DISPERSION = 3.57;
const HOME_DISPERSION = 4.92;
const MAX_RUNS = 30;

const clamp = (x: number, a: number, b: number) => Math.max(a, Math.min(b, x));

function nb(k: number, mu: number, size: number) { let logp = 0; for (let i = 1; i <= k; i++) logp += Math.log(size + i - 1) - Math.log(i); logp += size * Math.log(size / (size + mu)) + k * Math.log(mu / (size + mu)); return Math.exp(logp); }

export function kboV4Distribution(expectedAway: number, expectedHome: number): KboV4Result { const a = clamp(expectedAway, 1.5, 9); const h = clamp(expectedHome, 1.5, 9); const distribution: KboV4ScorePoint[] = []; let mass = 0; for (let away = 0; away <= MAX_RUNS; away++) { for (let home = 0; home <= MAX_RUNS; home++) { const p = nb(away, a, AWAY_DISPERSION) * nb(home, h, HOME_DISPERSION); distribution.push({ away, home, p }); mass += p; } } let awayWin = 0, homeWin = 0, tie = 0; for (const x of distribution) { x.p /= mass; if (x.away > x.home) awayWin += x.p; else if (x.home > x.away) homeWin += x.p; else tie += x.p; } const settled = awayWin + homeWin; return { engineVersion: KBO_V4_ENGINE_VERSION, expectedAway: a, expectedHome: h, awayWin: settled ? awayWin / settled : 0.5, homeWin: settled ? homeWin / settled : 0.5, tie, distribution }; }

export function kboV4Handicap(result: KboV4Result, side: "away" | "home", line: number): KboV4MarketProbability { let win = 0, push = 0; for (const x of result.distribution) { const margin = (side === "away" ? x.away - x.home : x.home - x.away) + line; if (margin > 0) win += x.p; else if (margin === 0) push += x.p; } return { win: win / Math.max(1e-12, 1 - push), push }; }

export function kboV4Total(result: KboV4Result, side: "over" | "under", line: number): KboV4MarketProbability { let win = 0, push = 0; for (const x of result.distribution) { const d = x.away + x.home - line; if (d === 0) push += x.p; else if ((side === "over" && d > 0) || (side === "under" && d < 0)) win += x.p; } return { win: win / Math.max(1e-12, 1 - push), push }; }
