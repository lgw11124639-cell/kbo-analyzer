import type { KboGame, OddsInput, Pick } from "@/types/kbo";

function implied(odds: number | null) {
  return odds && odds > 1 ? 1 / odds : null;
}

function clamp(value: number, min = 0.2, max = 0.8) {
  return Math.max(min, Math.min(max, value));
}

function fairTwoWay(
  firstOdds: number | null,
  secondOdds: number | null
) {
  const first = implied(firstOdds);
  const second = implied(secondOdds);

  if (first === null || second === null) {
    return {
      first: null,
      second: null,
    };
  }

  const sum = first + second;

  if (sum <= 0) {
    return {
      first: null,
      second: null,
    };
  }

  return {
    first: first / sum,
    second: second / sum,
  };
}

function grade(
  confidence: number,
  ev: number | null
): "A" | "B" | "C" {
  if (
    confidence >= 0.64 &&
    (ev ?? 0) >= 0.04
  ) {
    return "A";
  }

  if (
    confidence >= 0.57 &&
    (ev ?? 0) >= 0
  ) {
    return "B";
  }

  return "C";
}

function formatLine(line: number | null) {
  if (line === null) return "";

  return line > 0
    ? `+${line}`
    : String(line);
}

/*
  현재 v0.2 임시 분석 모델

  ML:
  - 시장배당
  - 홈 이점
  - 팀 순위

  핸디캡:
  - 시장 핸디캡 확률
  - ML 모델의 팀 우위 일부 반영

  O/U:
  - 현재는 시장 no-vig 확률 기반
  - 추후 최근 득실점 / 선발 / 불펜 / 구장 데이터를 연결해 교체
*/
export function analyzeGame(
  game: KboGame,
  odds: OddsInput,
  starterEdgeScore = 0,
  teamFormEdgeScore = 0,
  bullpenEdgeScore = 0,
  lineupMatchupEdgeScore = 0,
  projectedTotal: number | null = null
): Pick[] {
  const picks: Pick[] = [];

  // ----------------------------------------------------------
  // ML
  // ----------------------------------------------------------

  const rankEdge =
    game.awayRank && game.homeRank
      ? Math.max(
          -0.08,
          Math.min(
            0.08,
            (game.homeRank - game.awayRank) * 0.008
          )
        )
      : 0;

  const baseAway = 0.48 + rankEdge;

  const mlFair = fairTwoWay(
    odds.awayMl,
    odds.homeMl
  );

  const awayFairMarket =
    mlFair.first ?? 0.5;

  const baseAwayProb = clamp(
    baseAway * 0.45 +
      awayFairMarket * 0.55
  );

  /*
    선발 보정 v0.3

    starterEdgeScore:
    원정 선발점수 - 홈 선발점수

    10점 차이 ≈ 1.8% 보정
    20점 차이 ≈ 3.6% 보정

    최대 ±5% 제한

    아직 백테스트 전이므로
    선발 비중을 보수적으로 제한한다.
  */

  const starterAdjustment =
    Math.max(
      -0.05,
      Math.min(
        0.05,
        starterEdgeScore * 0.0018
      )
    );

  /*
    최근 팀 폼 보정 v0.4

    teamFormEdgeScore:
    원정 최근폼 점수 - 홈 최근폼 점수

    최대 ±4%만 반영한다.

    선발 + 최근폼이 동시에
    한 방향으로 강해도 과도한 확률 상승을
    막기 위해 제한한다.
  */

  const teamFormAdjustment =
    Math.max(
      -0.04,
      Math.min(
        0.04,
        teamFormEdgeScore * 0.0013
      )
    );

  /*
    불펜 보정 v0.5

    bullpenEdgeScore:
    원정 불펜점수 - 홈 불펜점수

    피로도가 낮을수록 높은 점수.
    아직 초기 모델이므로 최대 ±2.5%만 반영.
  */

  const bullpenAdjustment =
    Math.max(
      -0.025,
      Math.min(
        0.025,
        bullpenEdgeScore * 0.0008
      )
    );

  /*
    확정 라인업 + 상대 선발 매치업 보정 v0.6

    lineupMatchupEdgeScore:
    원정 타선 매치업점수 - 홈 타선 매치업점수

    예:
    +1점 = 원정 승률 약 +0.3%
    +5점 = 원정 승률 약 +1.5%

    BvP 자체가 작은 표본일 수 있으므로
    전체 승률 영향은 최대 ±2%로 제한한다.
  */

  const lineupMatchupAdjustment =
    Math.max(
      -0.02,
      Math.min(
        0.02,
        lineupMatchupEdgeScore *
          0.003
      )
    );

  const awayProb = clamp(
    baseAwayProb +
      starterAdjustment +
      teamFormAdjustment +
      bullpenAdjustment +
      lineupMatchupAdjustment
  );

  const homeProb =
    1 - awayProb;

  const awayEv =
    odds.awayMl
      ? awayProb * odds.awayMl - 1
      : null;

  const homeEv =
    odds.homeMl
      ? homeProb * odds.homeMl - 1
      : null;

  picks.push(
    {
      gameId: game.gameId,
      label: `${game.awayTeamName} 승`,
      market: "ML",
      odds: odds.awayMl,
      confidence: awayProb,
      ev: awayEv,
      grade: grade(
        awayProb,
        awayEv
      ),
    },
    {
      gameId: game.gameId,
      label: `${game.homeTeamName} 승`,
      market: "ML",
      odds: odds.homeMl,
      confidence: homeProb,
      ev: homeEv,
      grade: grade(
        homeProb,
        homeEv
      ),
    }
  );

  // ----------------------------------------------------------
  // HANDICAP
  // ----------------------------------------------------------

  const handicapFair = fairTwoWay(
    odds.awayHandicap,
    odds.homeHandicap
  );

  if (
    handicapFair.first !== null &&
    handicapFair.second !== null
  ) {
    // ML 모델과 시장 방향 차이를 소폭만 반영
    const teamEdge =
      awayProb - 0.5;

    const awayHandicapProb =
      clamp(
        handicapFair.first +
          teamEdge * 0.18,
        0.15,
        0.85
      );

    const homeHandicapProb =
      1 - awayHandicapProb;

    const awayHandicapEv =
      odds.awayHandicap
        ? awayHandicapProb *
            odds.awayHandicap -
          1
        : null;

    const homeHandicapEv =
      odds.homeHandicap
        ? homeHandicapProb *
            odds.homeHandicap -
          1
        : null;

    picks.push(
      {
        gameId: game.gameId,
        label:
          `${game.awayTeamName} ` +
          `${formatLine(
            odds.awayHandicapLine
          )}`,
        market: "HANDICAP",
        odds: odds.awayHandicap,
        confidence:
          awayHandicapProb,
        ev: awayHandicapEv,
        grade: grade(
          awayHandicapProb,
          awayHandicapEv
        ),
      },
      {
        gameId: game.gameId,
        label:
          `${game.homeTeamName} ` +
          `${formatLine(
            odds.homeHandicapLine
          )}`,
        market: "HANDICAP",
        odds: odds.homeHandicap,
        confidence:
          homeHandicapProb,
        ev: homeHandicapEv,
        grade: grade(
          homeHandicapProb,
          homeHandicapEv
        ),
      }
    );
  }

  // ----------------------------------------------------------
  // TOTAL
  //
  // projectedTotal이 있으면 배당시장이 아닌
  // 자체 예상 총득점을 이용해 O/U 확률을 만든다.
  //
  // 아직 v0.1 휴리스틱 모델이며
  // 추후 실제 경기 결과로 분산/계수를 보정한다.
  // ----------------------------------------------------------

  const totalFair = fairTwoWay(
    odds.overOdds,
    odds.underOdds
  );

  if (
    odds.totalLine !== null &&
    odds.overOdds !== null &&
    odds.underOdds !== null
  ) {
    let overProb: number | null = null;
    let underProb: number | null = null;

    if (
      projectedTotal !== null &&
      Number.isFinite(projectedTotal)
    ) {
      const runEdge =
        projectedTotal -
        odds.totalLine;

      /*
        총득점 차이를 확률로 변환.

        기준점과 예상득점이 같으면 50%.

        v0.2에서는 야구 득점 변동성을 반영해
        확률을 기존보다 50% 쪽으로 축소한다.

        약 1점 차이 = 58% 전후
        약 2점 차이 = 66% 전후

        지나친 확률을 막기 위해
        30~70% 범위로 제한.
      */
      overProb = clamp(
        1 /
          (
            1 +
            Math.exp(
              -runEdge / 3.0
            )
          ),
        0.30,
        0.70
      );

      underProb =
        1 - overProb;
    } else if (
      totalFair.first !== null &&
      totalFair.second !== null
    ) {
      // 자체 총득점 계산이 불가능할 때만 시장확률 fallback
      overProb =
        totalFair.first;

      underProb =
        totalFair.second;
    }

    if (
      overProb !== null &&
      underProb !== null
    ) {
      const overEv =
        overProb *
          odds.overOdds -
        1;

      const underEv =
        underProb *
          odds.underOdds -
        1;

      picks.push(
        {
          gameId: game.gameId,
          label:
            `오버 ${odds.totalLine}`,
          market: "TOTAL",
          odds: odds.overOdds,
          confidence:
            overProb,
          ev:
            overEv,
          grade:
            grade(
              overProb,
              overEv
            ),
        },
        {
          gameId: game.gameId,
          label:
            `언더 ${odds.totalLine}`,
          market: "TOTAL",
          odds: odds.underOdds,
          confidence:
            underProb,
          ev:
            underEv,
          grade:
            grade(
              underProb,
              underEv
            ),
        }
      );
    }
  }

  // ----------------------------------------------------------
  // BEST MARKET RANKING
  //
  // 승패 / 핸디캡 / O-U 전체를 같은 후보군에서 비교한다.
  //
  // 단순 EV만 비교하면 낮은 신뢰도의 고배당 픽이
  // 과도하게 1위가 될 수 있으므로
  // EV + 모델 확률 + 등급을 함께 반영한다.
  // ----------------------------------------------------------

  const gradeBonus = (g: Pick["grade"]) => {
    if (g === "A") return 0.08;
    if (g === "B") return 0.04;
    return 0;
  };

  const bestMarketScore = (pick: Pick) => {
    if (!pick.odds || pick.ev === null) {
      return -999;
    }

    const evScore =
      Math.max(-0.20, Math.min(0.30, pick.ev));

    const confidenceScore =
      (pick.confidence - 0.50) * 0.70;

    /*
      TOTAL은 아직 시장 no-vig 기반 임시 모델이므로
      완성된 득점예측 모델이 붙기 전까지 소폭 보수적으로 평가.
      추천 후보에서는 제외하지 않는다.
    */
    const marketAdjustment =
      pick.market === "TOTAL"
        ? -0.045
        : pick.market === "HANDICAP"
          ? 0.005
          : 0;

    return (
      evScore +
      confidenceScore +
      gradeBonus(pick.grade) +
      marketAdjustment
    );
  };

  return picks.sort(
    (a, b) =>
      bestMarketScore(b) -
      bestMarketScore(a)
  );
}

export function makeAutoCombos(
  allPicks: Pick[]
) {
  const usable = allPicks.filter(
    (p) =>
      p.grade !== "C" &&
      p.odds &&
      p.ev !== null &&
      p.ev > -0.02
  );

  /*
    같은 경기에서는 1개 픽만 허용.
    예:
    LG 승 + LG -1.5
    같은 경기 중복 조합 방지
  */
  const byGame =
    new Map<string, Pick>();

  for (
    const p of usable.sort(
      (a, b) =>
        (b.ev ?? 0) -
        (a.ev ?? 0)
    )
  ) {
    if (!byGame.has(p.gameId)) {
      byGame.set(
        p.gameId,
        p
      );
    }
  }

  const picks =
    [...byGame.values()];

  const combo = (
    name: string,
    count: number
  ) => {
    const selected =
      picks.slice(0, count);

    return {
      name,
      picks: selected,
      odds:
        selected.reduce(
          (acc, p) =>
            acc *
            (p.odds ?? 1),
          1
        ),
    };
  };

  return [
    combo("안정형 2폴", 2),
    combo("균형형 3폴", 3),
    combo("공격형 4폴", 4),
  ].filter(
    (x) =>
      x.picks.length >= 2
  );
}




