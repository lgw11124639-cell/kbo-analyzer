  .autoComboProbability b {
    font-size: 15px !important;
  }
}



/* =========================================================
   FEATURED COMBO + LARGER CARD TEXT V1
========================================================= */

.featuredComboSection {
  margin: 14px 0;
  padding: 14px;

  border: 1px solid #cfe0f6;
  border-radius: 14px;
  background:
    linear-gradient(
      135deg,
      #f7fbff,
      #eef5ff
    );
}

.featuredComboHead {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;

  margin-bottom: 12px;
}

.featuredComboHead h3 {
  margin: 0;
  color: #0f172a;
  font-size: 18px;
}

.featuredComboHead p {
  margin: 4px 0 0;
  color: #64748b;
  font-size: 12px;
}

.featuredComboHead > button {
  min-height: 34px;
  padding: 0 12px;

  border: 1px solid #bfdbfe;
  border-radius: 999px;
  background: white;

  color: #1d4ed8;
  font-size: 11px;
  font-weight: 900;

  cursor: pointer;
}

.featuredComboGrid {
  display: grid;
  grid-template-columns:
    repeat(auto-fit, minmax(210px, 1fr));
  gap: 9px;
}

.featuredComboCard {
  min-width: 0;
  min-height: 146px;
  padding: 11px;

  display: flex;
  flex-direction: column;
  gap: 8px;

  border: 1px solid #d8e2ef;
  border-radius: 11px;
  background: white;

  color: #0f172a;
  text-align: left;

  box-shadow: 0 3px 10px rgba(15,23,42,.05);
  cursor: pointer;
}

.featuredComboCard:hover,
.featuredComboCard.active {
  border-color: #3b82f6;
  box-shadow: 0 5px 15px rgba(37,99,235,.14);
}

.featuredComboTop {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 7px;
}

.featuredComboTop > span {
  padding: 4px 7px;

  border-radius: 999px;
  background: #2563eb;

  color: white;
  font-size: 10px;
  font-weight: 900;
}

.featuredComboTop > b {
  color: #047857;
  font-size: 11px;
}

.featuredComboCard > strong {
  color: #0f172a;
  font-size: 15px;
  line-height: 20px;
}

.featuredComboPicks {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
}

.featuredComboPicks span {
  padding: 4px 7px;

  border-radius: 6px;
  background: #f1f5f9;

  color: #334155;
  font-size: 10px;
  font-weight: 850;
}

.featuredComboBottom {
  margin-top: auto;
  padding-top: 8px;

  display: grid;
  grid-template-columns:
    repeat(2, minmax(0, 1fr));
  gap: 6px;

  border-top: 1px solid #e2e8f0;
}

.featuredComboBottom span {
  color: #64748b;
  font-size: 9px;
}

.featuredComboBottom b {
  display: block;
  margin-top: 2px;

  color: #1d4ed8;
  font-size: 14px;
}


/* 자동조합 카드 내부 글씨 확대 */

.autoComboCardTitle h3 {
  font-size: 15px !important;
  line-height: 20px !important;
}

.autoComboCardTitle > span {
  font-size: 10px !important;
  line-height: 15px !important;
}

.autoComboOdds > span {
  font-size: 10px !important;
  font-weight: 850 !important;
}

.autoComboOdds > strong {
  font-size: 28px !important;
  line-height: 32px !important;
}

.autoComboPickMain strong {
  font-size: 13px !important;
  line-height: 18px !important;
}

.autoComboPickMain small {
  margin-top: 3px !important;
  font-size: 10px !important;
  line-height: 14px !important;
}

.autoComboPickOdds {
  font-size: 11px !important;
  font-weight: 900 !important;
}

.autoComboGrade {
  font-size: 11px !important;
  font-weight: 950 !important;
}

.autoComboMetrics span {
  font-size: 9px !important;
  font-weight: 800 !important;
}

.autoComboMetrics b {
  font-size: 11px !important;
  font-weight: 950 !important;
}

.autoComboProbability span {
  font-size: 10px !important;
}

.autoComboProbability b {
  font-size: 15px !important;
}

.autoComboSave {
  min-height: 38px !important;
  font-size: 11px !important;
  font-weight: 900 !important;
}


@media (max-width: 760px) {

  .featuredComboSection {
    padding: 11px;
  }

  .featuredComboHead {
    align-items: flex-start;
  }

  .featuredComboHead h3 {
    font-size: 17px;
  }

  .featuredComboHead > button {
    min-width: 90px;
  }

  .featuredComboGrid {
    grid-template-columns:
      minmax(0, 1fr);
  }

  .featuredComboCard {
    min-height: 132px;
  }

  .autoComboCardTitle h3 {
    font-size: 17px !important;
  }

  .autoComboPickMain strong {
    font-size: 14px !important;
  }

  .autoComboPickMain small {
    font-size: 11px !important;
  }

  .autoComboMetrics span {
    font-size: 10px !important;
  }

  .autoComboMetrics b {
    font-size: 12px !important;
  }
}



/* =========================================================
   FIVE LEG AVAILABILITY + ANCHOR FEEDBACK V1
========================================================= */

.featuredComboUnavailable {
  order: 99;
  min-height: 142px;
  padding: 14px;
  border: 1px dashed #f59e0b;
  border-radius: 12px;
  background: #fffaf0;
  color: #92400e;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 7px;
}

.featuredComboUnavailable > div {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.featuredComboUnavailable > div span {
  padding: 5px 9px;
  border-radius: 999px;
  background: #f59e0b;
  color: #fff;
  font-size: 13px;
  font-weight: 900;
}

.featuredComboUnavailable > div b {
  color: #dc2626;
  font-size: 14px;
  font-weight: 900;
}

.featuredComboUnavailable strong {
  color: #111827;
  font-size: 17px;
  font-weight: 900;
}

.featuredComboUnavailable p {
  margin: 0;
  color: #475569;
  font-size: 13px;
  font-weight: 700;
  line-height: 1.45;
}

.featuredComboUnavailable small {
  color: #b45309;
  font-size: 12px;
  font-weight: 800;
}

@media (max-width: 760px) {
  .featuredComboUnavailable {
    min-height: 126px;
  }
}



/* =========================================================
   FEATURED COMBO SETTLEMENT BADGE V1
========================================================= */

.featuredComboTop > div {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8px;
}

.featuredComboResult {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 25px;
  padding: 4px 9px;
  border-radius: 999px;
  font-size: 12px;
  font-style: normal;
  font-weight: 900;
  line-height: 1;
  white-space: nowrap;
}

.featuredComboResult.status-win {
  background: #d1fae5;
  color: #047857;
}

.featuredComboResult.status-loss {
  background: #fee2e2;
  color: #dc2626;
}

.featuredComboResult.status-live {
  background: #fef3c7;
  color: #b45309;
}

.featuredComboResult.status-pending {
  background: #e2e8f0;
  color: #475569;
}

.featuredComboResult.status-void {
  background: #ede9fe;
  color: #6d28d9;
}

@media (max-width: 760px) {
  .featuredComboTop > div {
    align-items: flex-end;
    flex-direction: column;
    gap: 5px;
  }

  .featuredComboResult {
    min-height: 23px;
    padding: 4px 8px;
    font-size: 11px;
  }
}



/* =========================================================
   PRACTICAL FEATURED RECOMMENDATION V1
========================================================= */

.featuredComboReason {
  margin: 8px 0 2px;
  padding: 8px 9px;
  border-left: 3px solid #2563eb;
  border-radius: 6px;
  background: #f1f5f9;
  color: #334155;
  font-size: 12px;
  font-weight: 700;
  line-height: 1.45;
  text-align: left;
}

@media (max-width: 760px) {
  .featuredComboReason {
    font-size: 11px;
    line-height: 1.5;
  }
}



/* =========================================================
   FEATURED COMBO SAVE BUTTON
========================================================= */

.featuredComboCard {
  cursor: pointer;
}

.featuredComboSave {
  width: 100%;
  min-height: 38px;
  margin-top: 10px;
  border: 1px solid #2563eb;
  border-radius: 10px;
  background: #2563eb;
  color: #ffffff;
  font-size: 13px;
  font-weight: 800;
  line-height: 1;
  cursor: pointer;
  transition:
    background 0.16s ease,
    transform 0.16s ease;
}

.featuredComboSave:hover {
  background: #1d4ed8;
  transform: translateY(-1px);
}

.featuredComboSave:active {
  transform: translateY(0);
}

@media (max-width: 760px) {
  .featuredComboSave {
    min-height: 46px;
    margin-top: 12px;
    font-size: 15px;
  }
}


/* =========================================================
   AUTO COMBO SAVE / CANCEL STATE
========================================================= */

.featuredComboSave.isSaved,
.autoComboSave.isSaved {
  border-color: #fca5a5 !important;
  background: #fff1f2 !important;
  color: #dc2626 !important;
}

.featuredComboSave.isSaved:hover,
.autoComboSave.isSaved:hover {
  border-color: #ef4444 !important;
  background: #fee2e2 !important;
  color: #b91c1c !important;
}


/* =========================================================
   INVESTMENT PLANNER
========================================================= */

.investmentPlanner {
  margin-top: 18px;
  padding: 18px;
  border: 1px solid #cbdaf0;
  border-radius: 16px;
  background:
    linear-gradient(
      135deg,
      #ffffff 0%,
      #f4f8ff 100%
    );
}

.investmentPlannerHead {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding-bottom: 14px;
  border-bottom: 1px dashed #cbd5e1;
}

.investmentPlannerHead h3 {
  margin: 0 0 5px;
  font-size: 19px;
  color: #0f172a;
}

.investmentPlannerHead p {
  margin: 0;
  font-size: 12px;
  color: #64748b;
}

.investmentPlannerHead > button {
  min-height: 40px;
  padding: 0 18px;
  border: 0;
  border-radius: 10px;
  background: #0f172a;
  color: #ffffff;
  font-size: 13px;
  font-weight: 800;
  cursor: pointer;
}

.investmentPlannerHead > button:disabled {
  cursor: not-allowed;
  opacity: 0.45;
}

.investmentPlannerControls {
  display: grid;
  grid-template-columns: minmax(240px, 0.8fr) 2fr;
  gap: 14px;
  margin-top: 16px;
}

.investmentPlannerControls > label,
.investmentProfileButtons {
  padding: 13px;
  border: 1px solid #dbe4f0;
  border-radius: 12px;
  background: #ffffff;
}

.investmentPlannerControls > label > span,
.investmentProfileButtons > span {
  display: block;
  margin-bottom: 8px;
  font-size: 12px;
  font-weight: 800;
  color: #475569;
}

.investmentPlannerControls > label > div {
  display: flex;
  align-items: center;
  border: 1px solid #bfdbfe;
  border-radius: 9px;
  overflow: hidden;
}

.investmentPlannerControls input {
  width: 100%;
  height: 42px;
  padding: 0 12px;
  border: 0;
  outline: 0;
  background: #eff6ff;
  color: #0f172a;
  font-size: 18px;
  font-weight: 900;
  text-align: right;
}

.investmentPlannerControls > label > div > b {
  padding: 0 12px;
  color: #2563eb;
  font-size: 14px;
}

.investmentProfileButtons > div {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
}

.investmentProfileButtons button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  min-height: 42px;
  border: 1px solid #dbe4f0;
  border-radius: 9px;
  background: #f8fafc;
  color: #475569;
  cursor: pointer;
}

.investmentProfileButtons button.active {
  border-color: #2563eb;
  background: #2563eb;
  color: #ffffff;
}

.investmentProfileButtons small {
  font-size: 10px;
  opacity: 0.8;
}

.investmentPlanGrid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin-top: 14px;
}

.investmentPlanCard {
  position: relative;
  padding: 14px;
  border: 1px solid #dbe4f0;
  border-top-width: 4px;
  border-radius: 13px;
  background: #ffffff;
}

.investmentPlanCard.defense {
  border-top-color: #16a34a;
}

.investmentPlanCard.balance {
  border-top-color: #2563eb;
}

.investmentPlanCard.attack {
  border-top-color: #f43f5e;
}

.investmentPlanTitle {
  display: flex;
  justify-content: space-between;
  gap: 10px;
}

.investmentPlanTitle strong {
  display: block;
  margin-bottom: 3px;
  font-size: 16px;
}

.investmentPlanTitle small {
  color: #64748b;
  font-size: 10px;
}

.investmentPlanTitle > b {
  color: #2563eb;
  font-size: 17px;
}

.investmentPlanCombo {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 8px;
  margin-top: 13px;
  padding-top: 11px;
  border-top: 1px solid #e2e8f0;
}

.investmentPlanCombo strong {
  font-size: 14px;
}

.investmentPlanCombo span {
  color: #64748b;
  font-size: 10px;
}

.investmentPlanPicks {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
  min-height: 31px;
  margin-top: 10px;
}

.investmentPlanPicks span {
  padding: 5px 7px;
  border-radius: 7px;
  background: #f1f5f9;
  color: #334155;
  font-size: 10px;
  font-weight: 800;
}

.investmentPlanMoney {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 7px;
  margin-top: 12px;
}

.investmentPlanMoney > div {
  padding: 9px;
  border-radius: 9px;
  background: #f1f5f9;
}

.investmentPlanMoney span {
  display: block;
  margin-bottom: 4px;
  color: #64748b;
  font-size: 10px;
}

.investmentPlanMoney strong {
  display: block;
  color: #0f172a;
  font-size: 15px;
}

.investmentPlanOdds {
  display: block;
  margin-top: 8px;
  color: #64748b;
  text-align: right;
}

.investmentPlannerSummary {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 12px;
}

.investmentPlannerSummary span {
  padding: 9px 13px;
  border-radius: 9px;
  background: #eaf2ff;
  color: #475569;
  font-size: 11px;
}

.investmentPlannerSummary b {
  margin-left: 7px;
  color: #1d4ed8;
  font-size: 14px;
}

@media (max-width: 900px) {
  .investmentPlannerControls,
  .investmentPlanGrid {
    grid-template-columns: 1fr;
  }

  .investmentPlannerHead {
    align-items: stretch;
    flex-direction: column;
  }

  .investmentPlannerHead > button {
    width: 100%;
  }
}

@media (max-width: 600px) {
  .investmentPlanner {
    padding: 14px;
  }

  .investmentProfileButtons > div {
    grid-template-columns: 1fr;
  }

  .investmentProfileButtons button {
    justify-content: space-between;
    padding: 0 14px;
  }

  .investmentPlanMoney {
    grid-template-columns: 1fr;
  }

  .investmentPlannerSummary {
    align-items: stretch;
    flex-direction: column;
  }

  .investmentPlannerSummary span {
    display: flex;
    justify-content: space-between;
  }
}
