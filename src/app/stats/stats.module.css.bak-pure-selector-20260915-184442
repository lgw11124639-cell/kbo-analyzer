  letter-spacing: 0.12em !important;
}

.title,
.header h1 {
  font-size: 36px !important;
  line-height: 1.2 !important;
  font-weight: 900 !important;
  letter-spacing: -0.04em !important;
}

.subtitle,
.header p {
