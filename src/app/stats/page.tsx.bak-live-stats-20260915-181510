import fs from "node:fs";
import path from "node:path";
import styles from "./stats.module.css";

export const dynamic = "force-dynamic";

type Market = "ML" | "HANDICAP" | "TOTAL";
type Result = "WIN" | "LOSS" | "PUSH" | "VOID";

type BacktestRow = {
  date: string;
  month?: string;
  gameId: string;
  market: Market;
  label: string;
  grade: "A" | "B" | "C" | string;
  confidence: number;
  ev: number | null;
  odds: number | null;
  result: Result | string;
  profit?: number | null;
};

type Stat = {
  n: number;
  wins: number;
  losses: number;
  pushes: number;
  hitRate: number | null;
  returnRate: number | null;
};

const LIVE_START = "2026-09-14";

function gradeValue(grade: string) {
  if (grade === "A") return 3;
  if (grade === "B") return 2;
  return 1;
}

function eligible(row: BacktestRow) {
  const ev = row.ev ?? -999;
  const odds = row.odds ?? 0;

  return (
    Number.isFinite(row.confidence) &&
    Number.isFinite(ev) &&
    row.confidence >= 0.4 &&
    ev >= -0.03 &&
    ev <= 0.15 &&
    odds >= 1.2
  );
}

function pickScore(row: BacktestRow) {
  const ev = Math.max(
    -0.3,
    Math.min(0.35, row.ev ?? -0.2)
  );

  return (
    row.confidence * 0.72 +
    ev * 0.18 +
    gradeValue(row.grade) * 0.035
  );
}

function topBy(
  rows: BacktestRow[],
  keyOf: (row: BacktestRow) => string
) {
  const map = new Map<string, BacktestRow>();

  for (const row of rows) {
    const key = keyOf(row);
    const prev = map.get(key);

    if (!prev || pickScore(row) > pickScore(prev)) {
      map.set(key, row);
    }
  }

  return [...map.values()].sort(
    (a, b) => a.date.localeCompare(b.date)
  );
}

function stats(rows: BacktestRow[]): Stat {
  const wins = rows.filter(
    (row) => row.result === "WIN"
  ).length;

  const losses = rows.filter(
    (row) => row.result === "LOSS"
  ).length;

  const pushes = rows.filter(
    (row) => row.result === "PUSH"
  ).length;

  const settled = wins + losses;
  const stake = rows.length * 10000;

  const profit = rows.reduce(
    (sum, row) =>
      sum +
      (typeof row.profit === "number"
        ? row.profit
        : row.result === "WIN" && row.odds
          ? Math.round(10000 * (row.odds - 1))
          : row.result === "LOSS"
            ? -10000
            : 0),
    0
  );

  return {
    n: rows.length,
    wins,
    losses,
    pushes,
    hitRate:
      settled > 0
        ? (wins / settled) * 100
        : null,
    returnRate:
      stake > 0
        ? (profit / stake) * 100
        : null,
  };
}

function pct(value: number | null) {
  return value === null
    ? "-"
    : `${value.toFixed(1)}%`;
}

function signedPct(value: number | null) {
  if (value === null) return "-";
  return `${value >= 0 ? "+" : ""}${value.toFixed(1)}%`;
}

function marketName(market: Market) {
  if (market === "ML") return "승패";
  if (market === "HANDICAP") return "핸디캡";
  return "오버/언더";
}

function readRows(): BacktestRow[] {
  try {
    const file = path.join(
      process.cwd(),
      "data",
      "kbo-backtest-2026-all-candidates-lineup-base.json"
    );

    const root = JSON.parse(
      fs.readFileSync(file, "utf8")
    ) as
      | BacktestRow[]
      | { results?: BacktestRow[] };

    return Array.isArray(root)
      ? root
      : Array.isArray(root.results)
        ? root.results
        : [];
  } catch {
    return [];
  }
}

