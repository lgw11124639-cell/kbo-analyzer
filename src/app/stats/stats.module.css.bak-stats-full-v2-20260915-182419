.page {
  min-height: 100vh;
  padding: 42px 46px 80px;
  background: #f4f7fb;
  color: #0f1f38;
}

.header {
  max-width: 1180px;
  margin: 0 auto 26px;
  display: flex;
  justify-content: space-between;
  gap: 24px;
}

.eyebrow {
  color: #2563eb;
  font-size: 12px;
  font-weight: 900;
  letter-spacing: .14em;
}

.header h1 {
  margin: 5px 0 0;
  font-size: 34px;
}

.header p,
.panelTop p {
  margin: 7px 0 0;
  color: #718096;
  font-size: 14px;
}

.back {
  height: fit-content;
  padding: 11px 16px;
  border: 1px solid #d7e0ec;
  border-radius: 10px;
  background: white;
  color: #0f1f38;
  font-weight: 800;
  text-decoration: none;
}

.panel {
  max-width: 1180px;
  margin: 0 auto 20px;
  padding: 22px;
  border: 1px solid #dce4ef;
  border-radius: 18px;
  background: white;
  box-shadow: 0 8px 28px rgba(30, 50, 80, .05);
}

.livePanel {
  border-left: 4px solid #ef4444;
}

.panelTop {
  display: flex;
  justify-content: space-between;
  gap: 18px;
  margin-bottom: 18px;
}

.panel h2 {
  margin: 8px 0 0;
  font-size: 21px;
}

.badge {
  display: inline-flex;
  padding: 5px 8px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 900;
}

.liveBadge {
  color: #dc2626;
  background: #fee2e2;
}

.backtestBadge {
  color: #1d4ed8;
  background: #dbeafe;
}

.period {
  height: fit-content;
  padding: 8px 10px;
  border: 1px solid #dce4ef;
  border-radius: 9px;
  background: #f8fafc;
  font-size: 12px;
  font-weight: 800;
  white-space: nowrap;
}

.metrics {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 10px;
}

.metric {
  min-height: 88px;
  padding: 15px;
  border: 1px solid #dce4ef;
  border-radius: 12px;
  background: #f8fafc;
}

.metric > span {
  display: block;
  margin-bottom: 7px;
  color: #66758a;
  font-size: 12px;
  font-weight: 800;
}

.metric strong {
  display: block;
  font-size: 23px;
}

.metric small {
  display: block;
  margin-top: 5px;
  color: #718096;
  font-size: 11px;
}

.blue { color: #1d4ed8; }
.green { color: #16a34a; }
.red { color: #ef4444; }

.empty,
.info,
.note {
  margin-top: 14px;
  padding: 12px 14px;
  border-radius: 10px;
  background: #f8fafc;
  color: #66758a;
  font-size: 12px;
  line-height: 1.55;
}

.empty {
  border: 1px dashed #f2b5b5;
  background: #fff8f8;
  color: #9f3a3a;
}

.twoCol {
  max-width: 1180px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}

.twoCol .panel {
  width: auto;
  margin: 0 0 20px;
}

.tableWrap {
  margin-top: 14px;
  overflow-x: auto;
}

.table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
}

.table th {
  padding: 10px 9px;
  border-bottom: 1px solid #dce4ef;
  color: #718096;
  font-size: 11px;
  text-align: left;
}

.table td {
  padding: 11px 9px;
  border-bottom: 1px solid #eef2f7;
}

.win {
  color: #16a34a;
  font-weight: 900;
}

.loss {
  color: #ef4444;
  font-weight: 900;
}

.pending {
  color: #64748b;
  font-weight: 900;
}

.gradeGrid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
  margin-top: 14px;
}

.gradeCard {
  padding: 16px;
  border: 1px solid #dce4ef;
  border-radius: 12px;
  background: #f8fafc;
}

.gradeCard span {
  display: inline-flex;
  width: 28px;
  height: 28px;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  background: #dbeafe;
  color: #1d4ed8;
  font-weight: 900;
}

.gradeCard strong {
  display: block;
  margin-top: 12px;
  font-size: 22px;
}

.gradeCard small {
  color: #718096;
}

@media (max-width: 900px) {
  .page {
    padding: 24px 14px 60px;
  }

  .header,
  .panelTop {
    flex-direction: column;
  }

  .metrics {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .twoCol {
    grid-template-columns: 1fr;
    gap: 0;
  }
}

@media (max-width: 560px) {
  .metrics,
  .gradeGrid {
    grid-template-columns: 1fr;
  }
}
