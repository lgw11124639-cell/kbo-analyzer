import fs from "fs";
import path from "path";
import Link from "next/link";
import styles from "./stats.module.css";

export const dynamic = "force-dynamic";

type BacktestRow = {
  date: string;
  month: string;
  gameId: string;
  market: "ML" | "HANDICAP" | "TOTAL";
  label: string;
  grade: "A" | "B" | "C";
  confidence: number;
  ev: number | null;
  odds: number;
  passesCurrentFilter: boolean;
  result: "WIN" | "LOSS" | "PUSH" | "VOID";
};

type LivePrediction = {
  id: string;
  date: string;
  gameId: string;
  awayTeamName: string;
  homeTeamName: string;
  market: "ML" | "HANDICAP" | "TOTAL";
  label: string;
  grade: string;
  confidence: number;
  ev: number | null;
  odds: number;
  capturedAt: string;
  result: "PENDING" | "WIN" | "LOSS" | "PUSH" | "VOID";
};

const LIVE_START = "2026-09-16";
const BACKTEST_END = "2026-09-13";

function readJson(file: string) {
  try {
    return JSON.parse(
      fs.readFileSync(
        path.join(process.cwd(), file),
        "utf8"
      )
    );
  } catch {
    return null;
  }
}

function rate(rows: { result: string }[]) {
  const graded = rows.filter(
    (x) =>
      x.result === "WIN" ||
      x.result === "LOSS"
  );

  if (!graded.length) return null;

  return (
    graded.filter(
      (x) => x.result === "WIN"
    ).length / graded.length
  );
}

function returnRate(
  rows: {
    result: string;
    odds: number;
  }[]
) {
  const settled = rows.filter(
    (x) =>
      x.result === "WIN" ||
      x.result === "LOSS" ||
      x.result === "PUSH" ||
      x.result === "VOID"
  );

  if (!settled.length) return null;

  let stake = 0;
  let returned = 0;

  for (const row of settled) {
    stake += 10000;

    if (row.result === "WIN") {
      returned += 10000 * row.odds;
    } else if (
      row.result === "PUSH" ||
      row.result === "VOID"
    ) {
      returned += 10000;
    }
  }

  return (returned - stake) / stake;
}

function pct(value: number | null) {
  return value === null
    ? "-"
    : `${(value * 100).toFixed(1)}%`;
}

function signed(value: number | null) {
  if (value === null) return "-";

  const n = value * 100;

  return `${n >= 0 ? "+" : ""}${n.toFixed(1)}%`;
}

function score(row: BacktestRow) {
  const grade =
    row.grade === "A"
      ? 300
      : row.grade === "B"
        ? 200
        : 100;

  return (
    grade +
    row.confidence * 100 +
    (row.ev ?? -1) * 100
  );
}

function marketName(market: string) {
  if (market === "ML") return "승패";
  if (market === "HANDICAP") return "핸디캡";
  return "오버/언더";
}

export default function StatsPage() {
  const backtestRaw = readJson(
    "data/kbo-backtest-2026-all-candidates-lineup-base.json"
  );

  const rows: BacktestRow[] = (
    Array.isArray(backtestRaw)
      ? backtestRaw
      : backtestRaw?.results || []
  ).filter(
    (row: BacktestRow) =>
      row.date <= BACKTEST_END
  );

  const recommended = rows.filter(
    (row) =>
      row.passesCurrentFilter &&
      row.result !== "VOID"
  );

  const uniqueGames = new Set(
    rows.map((row) => row.gameId)
  ).size;

  const byDate =
    new Map<string, BacktestRow[]>();

  for (const row of recommended) {
    const list =
      byDate.get(row.date) || [];

    list.push(row);
    byDate.set(row.date, list);
  }

  const dailyTop = [...byDate.values()]
    .map(
      (list) =>
        [...list].sort(
          (a, b) =>
            score(b) - score(a)
        )[0]
    )
    .filter(Boolean);

  const liveRaw = readJson(
    "data/kbo-live-predictions.json"
  );

  const live: LivePrediction[] =
    Array.isArray(liveRaw?.predictions)
      ? liveRaw.predictions
          .filter(
            (row: LivePrediction) =>
              row.date >= LIVE_START
          )
          .sort(
            (
              a: LivePrediction,
              b: LivePrediction
            ) =>
              b.date.localeCompare(a.date) ||
              b.gameId.localeCompare(a.gameId)
          )
      : [];

  const liveSettled = live.filter(
    (row) =>
      row.result !== "PENDING"
  );

  const liveWins = live.filter(
    (row) => row.result === "WIN"
  ).length;

  const liveLosses = live.filter(
    (row) => row.result === "LOSS"
  ).length;

  const livePending = live.filter(
    (row) =>
      row.result === "PENDING"
  ).length;

  const liveGames = new Set(
    live.map((row) => row.gameId)
  ).size;

  const markets = [
    "ML",
    "HANDICAP",
    "TOTAL",
  ] as const;

  const grades = [
    "A",
    "B",
    "C",
  ] as const;

  return (
    <main className={styles.page}>
      <header className={styles.header}>
        <div>
          <span className={styles.eyebrow}>
            KBO ANALYZER PERFORMANCE
          </span>

          <h1>통계 리포트</h1>

          <p>
            라이브 추천 성적과 과거 경기
            백테스트를 분리해서 보여줍니다.
          </p>
        </div>

        <Link
          href="/"
          className={styles.back}
        >
          ← 오늘 경기
        </Link>
      </header>

      <section
        className={`${styles.panel} ${styles.livePanel}`}
      >
        <div className={styles.panelTop}>
          <div>
            <span
              className={`${styles.badge} ${styles.liveBadge}`}
            >
              LIVE
            </span>

            <h2>라이브 성적</h2>

            <p>
              실제 사이트가 당일 추천으로
              생성하고 저장한 원본만 집계합니다.
            </p>
          </div>

          <span className={styles.period}>
            기준 시작 2026-09-16
          </span>
        </div>

        <div className={styles.metrics}>
          <Metric
            title="저장된 추천"
            value={`${live.length}건`}
          />

          <Metric
            title="분석 경기"
            value={`${liveGames}경기`}
          />

          <Metric
            title="판정 완료"
            value={`${liveSettled.length}건`}
          />

          <Metric
            title="적중률"
            value={pct(rate(live))}
            blue
            sub={`${liveWins}승 · ${liveLosses}패`}
          />

          <Metric
            title="수익률(1만원 기준)"
            value={signed(returnRate(live))}
            positive={
              (returnRate(live) ?? 0) >= 0
            }
            sub="동일 금액 가정"
          />
        </div>

        {live.length === 0 ? (
          <div className={styles.empty}>
            아직 저장된 라이브 추천이 없습니다.
            오늘 경기 화면에서 실제 추천이
            생성되면 자동으로 누적됩니다.
          </div>
        ) : (
          <>
            <div className={styles.info}>
              판정 대기{" "}
              <strong>{livePending}</strong>
              건 · 과거 재계산값은 포함하지 않음
            </div>

            <div className={styles.tableWrap}>
              <table className={styles.table}>
                <thead>
                  <tr>
                    <th>날짜</th>
                    <th>경기</th>
                    <th>추천</th>
                    <th>등급</th>
                    <th>확률</th>
                    <th>배당</th>
                    <th>결과</th>
                  </tr>
                </thead>

                <tbody>
                  {live
                    .slice(0, 12)
                    .map((row) => (
                      <tr key={row.id}>
                        <td>{row.date}</td>
                        <td>
                          {row.awayTeamName} @{" "}
                          {row.homeTeamName}
                        </td>
                        <td>
                          <b>{row.label}</b>
                        </td>
                        <td>{row.grade}</td>
                        <td>
                          {(row.confidence * 100).toFixed(1)}%
                        </td>
                        <td>
                          {row.odds.toFixed(2)}
                        </td>
                        <td>
                          <Result result={row.result} />
                        </td>
                      </tr>
                    ))}
                </tbody>
              </table>
            </div>
          </>
        )}

        <p className={styles.note}>
          9월 14일을 라이브 기준 시작일로
          구분하지만, 저장 기능 적용 이전
          데이터를 현재 엔진으로 다시 계산해
          채우지는 않습니다.
        </p>
      </section>

      <section className={styles.panel}>
        <div className={styles.panelTop}>
          <div>
            <span
              className={`${styles.badge} ${styles.backtestBadge}`}
            >
              BACKTEST
            </span>

            <h2>과거 경기 백테스트</h2>

            <p>
              현재 추천 기준을 과거 경기 데이터에
              적용한 별도 성적입니다.
            </p>
          </div>

          <span className={styles.period}>
            2026-03-28 ~ 2026-09-13
          </span>
        </div>

        <div className={styles.metrics}>
          <Metric
            title="누적 분석 경기"
            value={`${uniqueGames}경기`}
          />

          <Metric
            title="추천 픽"
            value={`${recommended.length}건`}
          />

          <Metric
            title="추천픽 적중률"
            value={pct(rate(recommended))}
          />

          <Metric
            title="일일 최고픽 적중률"
            value={pct(rate(dailyTop))}
            blue
            sub={`${
              dailyTop.filter(
                (x) => x.result === "WIN"
              ).length
            }승 ${
              dailyTop.filter(
                (x) => x.result === "LOSS"
              ).length
            }패`}
          />

          <Metric
            title="일일 최고픽 수익률"
            value={signed(
              returnRate(dailyTop)
            )}
            positive={
              (returnRate(dailyTop) ?? 0) >= 0
            }
            sub="1만원 동일 베팅 기준"
          />
        </div>

        <p className={styles.note}>
          수익률은 모든 추천에 10,000원씩
          동일하게 베팅했다고 가정해 계산합니다.
          실제 개인 베팅 내역이 아닌 사이트
          추천 성적입니다.
        </p>
      </section>

      <div className={styles.twoCol}>
        <section className={styles.panel}>
          <h2>시장별 성적</h2>

          <div className={styles.tableWrap}>
            <table className={styles.table}>
              <thead>
                <tr>
                  <th>시장</th>
                  <th>픽</th>
                  <th>적중률</th>
                  <th>수익률</th>
                </tr>
              </thead>

              <tbody>
                {markets.map((market) => {
                  const list =
                    recommended.filter(
                      (row) =>
                        row.market === market
                    );

                  return (
                    <tr key={market}>
                      <td>
                        <b>
                          {marketName(market)}
                        </b>
                      </td>
                      <td>{list.length}</td>
                      <td>
                        <b>
                          {pct(rate(list))}
                        </b>
                      </td>
                      <td>
                        {signed(
                          returnRate(list)
                        )}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </section>

        <section className={styles.panel}>
          <h2>등급별 성적</h2>

          <div className={styles.gradeGrid}>
            {grades.map((grade) => {
              const list =
                recommended.filter(
                  (row) =>
                    row.grade === grade
                );

              return (
                <div
                  className={styles.gradeCard}
                  key={grade}
                >
                  <span>{grade}</span>
                  <strong>
                    {pct(rate(list))}
                  </strong>
                  <small>
                    {list.length}픽
                  </small>
                </div>
              );
            })}
          </div>
        </section>
      </div>
    </main>
  );
}

function Metric({
  title,
  value,
  sub,
  blue,
  positive,
}: {
  title: string;
  value: string;
  sub?: string;
  blue?: boolean;
  positive?: boolean;
}) {
  return (
    <div className={styles.metric}>
      <span>{title}</span>

      <strong
        className={
          blue
            ? styles.blue
            : positive === true
              ? styles.green
              : positive === false
                ? styles.red
                : ""
        }
      >
        {value}
      </strong>

      {sub && <small>{sub}</small>}
    </div>
  );
}

function Result({
  result,
}: {
  result: LivePrediction["result"];
}) {
  if (result === "WIN") {
    return (
      <span className={styles.win}>
        적중
      </span>
    );
  }

  if (result === "LOSS") {
    return (
      <span className={styles.loss}>
        미적중
      </span>
    );
  }

  if (
    result === "PUSH" ||
    result === "VOID"
  ) {
    return (
      <span className={styles.pending}>
        적특/무효
      </span>
    );
  }

  return (
    <span className={styles.pending}>
      대기
    </span>
  );
}
