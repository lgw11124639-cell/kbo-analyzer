.shell {
  min-height: 100vh;
  background: #f3f6fb;
  color: #0f172a;
}





.brand span:nth-child(2) {
  display: flex;
  flex-direction: column;
  line-height: 1.05;
  font-size: 16px;
}

.brand small {
  margin-left: auto;
  color: #68809f;
  font-size: 9px;
}

.ball {
  font-size: 16px;
}



.nav a,
.nav span {
  display: block;
  border-radius: 9px;
  padding: 12px 12px;
  text-decoration: none;
  color: #d7e2f1;
  font-size: 13px;
  font-weight: 800;
}

.nav a:hover {
  background: rgba(255,255,255,.07);
}

.nav .active {
  color: #fff;
  background: #2f72e9;
  box-shadow: 0 8px 18px rgba(47,114,233,.25);
}

.nav .disabled {
  color: #60738e;
  cursor: default;
}



.collector b {
  color: #d8e4f3;
  font-size: 11px;
  margin-bottom: 2px;
}

.main {
  margin-left: 180px;
  padding: 30px 28px 60px;
  max-width: 1500px;
}

.header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 22px;
}

.eyebrow {
  margin: 0 0 4px;
  color: #1763df;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: .12em;
}

.header h1 {
  margin: 0;
  font-size: 30px;
  letter-spacing: -.04em;
}

.subtitle {
  margin: 7px 0 0;
  color: #6b7d96;
  font-size: 12px;
}

.headerActions button {
  border: 1px solid #d3ddea;
  background: #fff;
  color: #0f172a;
  border-radius: 10px;
  padding: 11px 16px;
  font-weight: 800;
  cursor: pointer;
}

.headerActions button:disabled {
  opacity: .55;
  cursor: default;
}

.error {
  margin-bottom: 16px;
  border: 1px solid #fecaca;
  background: #fff1f2;
  color: #b91c1c;
  border-radius: 12px;
  padding: 13px 15px;
  font-size: 12px;
  font-weight: 700;
}

.card {
  background: #fff;
  border: 1px solid #dbe4ef;
  border-radius: 16px;
  padding: 20px;
  box-shadow: 0 8px 24px rgba(15,23,42,.035);
  margin-bottom: 18px;
}

.liveCard {
  border-left: 4px solid #ff4d4f;
}

.sectionHeader {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 17px;
}

.sectionHeader h2 {
  margin: 8px 0 3px;
  font-size: 20px;
}

.sectionHeader p {
  margin: 0;
  color: #75869e;
  font-size: 11px;
}

.badge {
  display: inline-flex;
  border-radius: 999px;
  padding: 4px 8px;
  font-size: 9px;
  font-weight: 900;
}

.liveBadge {
  color: #ef4444;
  background: #ffe8e8;
}

.backtestBadge {
  color: #1763df;
  background: #e7f0ff;
}

.range {
  white-space: nowrap;
  border: 1px solid #d8e2ee;
  border-radius: 9px;
  padding: 8px 10px;
  font-size: 10px;
  background: #fbfdff;
}

.statsGrid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 10px;
}

.statBox {
  min-width: 0;
  border: 1px solid #dbe4ef;
  background: #f8fafc;
  border-radius: 12px;
  padding: 14px 13px;
  min-height: 84px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.statBox span {
  color: #60738c;
  font-size: 10px;
  font-weight: 800;
}

.statBox strong {
  margin-top: 6px;
  font-size: 21px;
  letter-spacing: -.03em;
}

.statBox small {
  margin-top: 4px;
  color: #8290a5;
  font-size: 9px;
}

.accent {
  background: #eef6ff;
  border-color: #b8d6ff;
}

.accent strong {
  color: #145cdb;
}

.positive {
  color: #11975d !important;
}

.negative {
  color: #ef3434 !important;
}

.emptyNotice {
  margin-top: 12px;
  border: 1px dashed #f3b5b5;
  background: #fffafa;
  color: #cf5252;
  border-radius: 10px;
  padding: 11px 13px;
  font-size: 10px;
}

.infoLine {
  margin-top: 12px;
  border-radius: 9px;
  background: #f6f8fb;
  padding: 10px 12px;
  color: #718098;
  font-size: 10px;
  line-height: 1.5;
}

.twoCol {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px;
}

.card h3 {
  margin: 0 0 14px;
  font-size: 16px;
}

.table {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.tableHead,
.tableRow {
  display: grid;
  grid-template-columns: 1.4fr .7fr .9fr .9fr;
  align-items: center;
  gap: 8px;
}

.tableHead {
  color: #8a98aa;
  font-size: 9px;
  padding: 0 10px 5px;
}

.tableRow {
  background: #f7f9fc;
  border-radius: 9px;
  min-height: 36px;
  padding: 0 10px;
  font-size: 10px;
}

.tableRow b {
  font-size: 10px;
}

.tableRow strong {
  font-size: 10px;
}

.gradeGrid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 9px;
}

.gradeBox {
  border: 1px solid #dbe4ef;
  border-radius: 11px;
  padding: 14px 12px;
  display: flex;
  flex-direction: column;
  min-height: 86px;
}

.grade {
  width: fit-content;
  min-width: 24px;
  text-align: center;
  border-radius: 7px;
  padding: 4px 7px;
  font-weight: 900;
  font-size: 11px;
  background: #edf2f7;
}

.gradeA {
  color: #129459;
  background: #dcfce7;
}

.gradeB {
  color: #1763df;
  background: #dbeafe;
}

.gradeC {
  color: #64748b;
  background: #eef2f7;
}

.gradeBox strong {
  margin-top: 9px;
  font-size: 20px;
}

.gradeBox small {
  margin-top: 5px;
  color: #8090a6;
  font-size: 9px;
}

@media (max-width: 1100px) {
  .statsGrid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .twoCol {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 760px) {
  

  

  

  .nav a,
  .nav span {
    text-align: center;
    padding: 10px 6px;
    font-size: 11px;
  }

  

  .main {
    margin-left: 0;
    padding: 18px 12px 40px;
  }

  .header {
    align-items: flex-end;
  }

  .header h1 {
    font-size: 25px;
  }

  .subtitle {
    max-width: 260px;
  }

  .sectionHeader {
    flex-direction: column;
  }

  .range {
    align-self: flex-start;
  }

  .statsGrid {
    grid-template-columns: 1fr 1fr;
  }

  .tableHead,
  .tableRow {
    grid-template-columns: 1.2fr .6fr .9fr .9fr;
  }
}


/* STATS_UI_FINAL_V5 */

/* =========================================================
   전체 화면
========================================================= */

.shell {
  width: 100%;
  min-width: 0;
  max-width: 100vw;
  overflow-x: hidden;
}

.main {
  flex: 1 1 0;
  width: auto;
  min-width: 0;
  max-width: 100%;
  overflow-x: hidden;
  box-sizing: border-box;

  padding: 30px 34px 48px !important;

  font-size: 16px !important;
  line-height: 1.55 !important;
  color: #0f172a !important;
}

.content,
.page,
.workspace,
.container {
  width: 100% !important;
  max-width: 1460px !important;
  min-width: 0 !important;

  margin-left: auto !important;
  margin-right: auto !important;

  box-sizing: border-box !important;
}


/* =========================================================
   상단 제목
========================================================= */

.eyebrow {
  font-size: 14px !important;
  font-weight: 800 !important;
  letter-spacing: .11em !important;
}

.title,
.header h1 {
  font-size: 36px !important;
  line-height: 1.15 !important;
  font-weight: 900 !important;
  letter-spacing: -.035em !important;
}

.subtitle,
.header p {
  margin-top: 8px !important;

  font-size: 16px !important;
  line-height: 1.6 !important;
  color: #64748b !important;
}


/* =========================================================
   2열 레이아웃
========================================================= */

.grid,
.statsGrid,
.contentGrid,
.reportGrid {
  display: grid !important;

  grid-template-columns:
    repeat(2, minmax(0, 1fr)) !important;

  align-items: start !important;

  gap: 20px !important;

  width: 100% !important;
  min-width: 0 !important;
}

.grid > *,
.statsGrid > *,
.contentGrid > *,
.reportGrid > * {
  min-width: 0 !important;
  align-self: start !important;
}


/* =========================================================
   큰 섹션
========================================================= */

.sectionTitle h2,
.section h2 {
  font-size: 27px !important;
  line-height: 1.25 !important;
  font-weight: 900 !important;
}

.sectionTitle p,
.section > p {
  margin-top: 7px !important;

  font-size: 15px !important;
  line-height: 1.6 !important;
  color: #64748b !important;
}


/* =========================================================
   요약 카드
========================================================= */

.summaryGrid {
  gap: 14px !important;
}

.summaryGrid article {
  min-height: 126px !important;

  padding: 21px 20px !important;

  border-radius: 14px !important;
}

.summaryGrid article small,
.summaryGrid article > span:first-child {
  font-size: 14px !important;
  line-height: 1.4 !important;
  font-weight: 750 !important;
  color: #64748b !important;
}

.summaryGrid article strong {
  display: block !important;

  margin-top: 9px !important;

  font-size: 34px !important;
  line-height: 1.05 !important;
  font-weight: 900 !important;
  letter-spacing: -.035em !important;
}

.summaryGrid article span,
.summaryGrid article div {
  font-size: 14px !important;
  line-height: 1.5 !important;
}


/* =========================================================
   일반 카드
========================================================= */

.card {
  width: 100% !important;
  min-width: 0 !important;
  height: auto !important;

  padding: 26px !important;

  box-sizing: border-box !important;

  overflow: hidden !important;
}

.card h3 {
  margin: 0 0 22px !important;

  font-size: 24px !important;
  line-height: 1.3 !important;
  font-weight: 900 !important;
}


/* =========================================================
   시장별 / 확률구간

   이전에 만든 막대그래프는 숨긴다.
   바로 아래 정확한 표를 크게 보여준다.
========================================================= */

.visualList {
  display: none !important;
}


/* =========================================================
   표
========================================================= */

.tableHead,
.tableRow {
  width: 100% !important;
  min-width: 0 !important;

  box-sizing: border-box !important;

  grid-template-columns:
    minmax(130px, 1.35fr)
    minmax(75px, .65fr)
    minmax(100px, .9fr)
    minmax(100px, .9fr) !important;
}

.tableHead {
  min-height: 48px !important;

  padding: 12px 14px !important;

  font-size: 15px !important;
  line-height: 1.4 !important;
  font-weight: 750 !important;
  color: #64748b !important;
}

.tableRow {
  min-height: 54px !important;

  padding: 13px 14px !important;

  font-size: 16px !important;
  line-height: 1.4 !important;
  font-weight: 650 !important;
  color: #0f172a !important;

  border-radius: 9px !important;
}

.tableRow strong {
  font-size: 16px !important;
  font-weight: 850 !important;
}


/* =========================================================
   등급별
========================================================= */

.gradeGrid {
  display: grid !important;

  grid-template-columns:
    repeat(3, minmax(0, 1fr)) !important;

  gap: 14px !important;
}

.gradeGrid article {
  min-width: 0 !important;
  min-height: 145px !important;

  padding: 20px !important;

  box-sizing: border-box !important;
}

.gradeGrid article strong {
  display: block !important;

  margin-top: 14px !important;

  font-size: 32px !important;
  line-height: 1.1 !important;
  font-weight: 900 !important;
}

.gradeGrid article small,
.gradeGrid article span {
  font-size: 15px !important;
  line-height: 1.5 !important;
}


/* =========================================================
   월별 그래프

   이것만 그래프로 유지
========================================================= */

.monthChart {
  position: relative !important;

  display: grid !important;

  grid-template-columns:
    repeat(7, minmax(0, 1fr)) !important;

  align-items: end !important;

  width: 100% !important;
  max-width: 100% !important;
  min-width: 0 !important;

  height: 300px !important;
  min-height: 300px !important;

  gap: 14px !important;

  padding: 28px 20px 17px !important;
  margin: 0 0 25px !important;

  box-sizing: border-box !important;

  overflow: hidden !important;

  background: #f8fafc !important;
  border: 1px solid #dbe4ef !important;
  border-radius: 15px !important;
}

.monthChart > div {
  display: flex !important;
  flex-direction: column !important;
  justify-content: flex-end !important;
  align-items: center !important;

  width: 100% !important;
  height: 100% !important;
  min-width: 0 !important;

  box-sizing: border-box !important;
}

/* 실제 파란 막대 */
.monthChart > div > div {
  width: 42px !important;
  max-width: 70% !important;
  min-width: 24px !important;

  border-radius: 8px 8px 2px 2px !important;
}

/* 위 적중률 */
.monthChart strong {
  font-size: 15px !important;
  line-height: 1.2 !important;
  font-weight: 900 !important;
}

/* 월 / 수익률 */
.monthChart span,
.monthChart small,
.monthChart em {
  font-size: 13px !important;
  line-height: 1.4 !important;
  font-weight: 700 !important;
  font-style: normal !important;
}


/* =========================================================
   안내문
========================================================= */

.infoBox,
.notice,
.emptyNotice,
.description {
  padding: 14px 16px !important;

  font-size: 14px !important;
  line-height: 1.65 !important;
}


/* =========================================================
   배지
========================================================= */

.badge,
.liveBadge,
.backtestBadge,
.dateBadge {
  padding: 6px 10px !important;

  font-size: 12px !important;
  line-height: 1.2 !important;
  font-weight: 850 !important;
}


/* =========================================================
   사이드바
========================================================= */

.sidebar nav a,
.sidebar nav button,
.nav a,
.nav button {
  min-height: 45px !important;

  font-size: 15px !important;
  font-weight: 750 !important;
}

.sidebar small {
  font-size: 12px !important;
}

.sidebar li,
.sidebar p {
  font-size: 13px !important;
  line-height: 1.65 !important;
}


/* =========================================================
   수익률
========================================================= */

.positive {
  font-weight: 900 !important;
}

.negative {
  font-weight: 900 !important;
}


/* =========================================================
   반응형
========================================================= */

@media (max-width: 1180px) {
  .grid,
  .statsGrid,
  .contentGrid,
  .reportGrid {
    grid-template-columns: 1fr !important;
  }

  .main {
    padding-left: 22px !important;
    padding-right: 22px !important;
  }
}

@media (max-width: 760px) {
  .main {
    padding: 16px 10px 32px !important;
  }

  .title,
  .header h1 {
    font-size: 30px !important;
  }

  .sectionTitle h2,
  .section h2 {
    font-size: 23px !important;
  }

  .card {
    padding: 18px !important;
  }

  .card h3 {
    font-size: 21px !important;
  }

  .tableHead {
    font-size: 13px !important;
  }

  .tableRow {
    font-size: 14px !important;
  }

  .monthChart {
    height: 260px !important;
    min-height: 260px !important;

    gap: 6px !important;

    padding: 20px 8px 14px !important;
  }

  .monthChart > div > div {
    width: 70% !important;
    min-width: 13px !important;
  }

  .monthChart strong {
    font-size: 12px !important;
  }

  .monthChart span,
  .monthChart small,
  .monthChart em {
    font-size: 11px !important;
  }

  .gradeGrid {
    grid-template-columns: 1fr !important;
  }
}

