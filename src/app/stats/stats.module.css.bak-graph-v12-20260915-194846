  box-sizing:
    border-box !important;

  overflow:
    hidden !important;
}

.monthChart > div {
  display: flex !important;

  flex-direction:
    column !important;

  align-items:
    center !important;

  justify-content:
    flex-end !important;

  width:
    100% !important;

  height:
    100% !important;

  min-width:
    0 !important;
}

/*
  height는 JSX에서 hitRate 값으로 들어감.
  수치가 달라지면 막대 높이도 자동 변경됨.
*/
.monthChart > div > div {
  display: block !important;

  width:
    34px !important;

  max-width:
    68% !important;

  min-width:
    18px !important;

  min-height:
