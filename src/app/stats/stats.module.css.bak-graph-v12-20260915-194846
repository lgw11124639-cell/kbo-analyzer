  style={{ width: `${row.hitRate}%` }}
*/
.progressTrack > div {
  display: block !important;

  height: 100% !important;
  min-width: 2px !important;

  border-radius: 999px !important;

  background:
    linear-gradient(
      90deg,
      #60a5fa,
      #2563eb
    ) !important;

  transition:
    width .25s ease !important;
}


