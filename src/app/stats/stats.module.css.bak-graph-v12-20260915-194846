.shell {
  min-height: 100vh;
  background: #f3f6fb;
  color: #0f172a;
}





.brand span:nth-child(2) {
  display: flex;
  flex-direction: column;
  line-height: 1.05;
  font-size: 16px;
}

.brand small {
  margin-left: auto;
  color: #68809f;
  font-size: 9px;
}

.ball {
  font-size: 16px;
}



.nav a,
.nav span {
  display: block;
  border-radius: 9px;
  padding: 12px 12px;
  text-decoration: none;
  color: #d7e2f1;
  font-size: 13px;
  font-weight: 800;
}

.nav a:hover {
  background: rgba(255,255,255,.07);
}

.nav .active {
  color: #fff;
  background: #2f72e9;
  box-shadow: 0 8px 18px rgba(47,114,233,.25);
}

.nav .disabled {
  color: #60738e;
  cursor: default;
}



.collector b {
  color: #d8e4f3;
  font-size: 11px;
  margin-bottom: 2px;
}

.main {
  margin-left: 180px;
  padding: 30px 28px 60px;
  max-width: 1500px;
}

.header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 22px;
}

.eyebrow {
  margin: 0 0 4px;
  color: #1763df;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: .12em;
}

.header h1 {
  margin: 0;
  font-size: 30px;
  letter-spacing: -.04em;
}

.subtitle {
  margin: 7px 0 0;
  color: #6b7d96;
  font-size: 12px;
}

.headerActions button {
  border: 1px solid #d3ddea;
  background: #fff;
  color: #0f172a;
  border-radius: 10px;
  padding: 11px 16px;
  font-weight: 800;
  cursor: pointer;
}

.headerActions button:disabled {
  opacity: .55;
  cursor: default;
}

.error {
  margin-bottom: 16px;
  border: 1px solid #fecaca;
  background: #fff1f2;
  color: #b91c1c;
  border-radius: 12px;
  padding: 13px 15px;
  font-size: 12px;
  font-weight: 700;
}

.card {
  background: #fff;
  border: 1px solid #dbe4ef;
  border-radius: 16px;
  padding: 20px;
  box-shadow: 0 8px 24px rgba(15,23,42,.035);
  margin-bottom: 18px;
}

.liveCard {
  border-left: 4px solid #ff4d4f;
}

.sectionHeader {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 17px;
}

.sectionHeader h2 {
  margin: 8px 0 3px;
  font-size: 20px;
}

.sectionHeader p {
  margin: 0;
  color: #75869e;
  font-size: 11px;
}

.badge {
  display: inline-flex;
  border-radius: 999px;
  padding: 4px 8px;
  font-size: 9px;
  font-weight: 900;
}

.liveBadge {
  color: #ef4444;
  background: #ffe8e8;
}

.backtestBadge {
  color: #1763df;
  background: #e7f0ff;
}

.range {
  white-space: nowrap;
  border: 1px solid #d8e2ee;
  border-radius: 9px;
  padding: 8px 10px;
  font-size: 10px;
  background: #fbfdff;
}

.statsGrid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 10px;
}

.statBox {
  min-width: 0;
  border: 1px solid #dbe4ef;
  background: #f8fafc;
  border-radius: 12px;
  padding: 14px 13px;
  min-height: 84px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.statBox span {
  color: #60738c;
  font-size: 10px;
  font-weight: 800;
}

.statBox strong {
  margin-top: 6px;
  font-size: 21px;
  letter-spacing: -.03em;
}

.statBox small {
  margin-top: 4px;
  color: #8290a5;
  font-size: 9px;
}

.accent {
  background: #eef6ff;
  border-color: #b8d6ff;
}

.accent strong {
  color: #145cdb;
}

.positive {
  color: #11975d !important;
}

.negative {
  color: #ef3434 !important;
}

.emptyNotice {
  margin-top: 12px;
  border: 1px dashed #f3b5b5;
  background: #fffafa;
  color: #cf5252;
  border-radius: 10px;
  padding: 11px 13px;
  font-size: 10px;
}

.infoLine {
  margin-top: 12px;
  border-radius: 9px;
  background: #f6f8fb;
  padding: 10px 12px;
  color: #718098;
  font-size: 10px;
  line-height: 1.5;
}

.twoCol {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px;
}

.card h3 {
  margin: 0 0 14px;
  font-size: 16px;
}

.table {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.tableHead,
.tableRow {
  display: grid;
  grid-template-columns: 1.4fr .7fr .9fr .9fr;
  align-items: center;
  gap: 8px;
}

.tableHead {
  color: #8a98aa;
  font-size: 9px;
  padding: 0 10px 5px;
}

.tableRow {
  background: #f7f9fc;
  border-radius: 9px;
  min-height: 36px;
  padding: 0 10px;
  font-size: 10px;
}

.tableRow b {
  font-size: 10px;
}

.tableRow strong {
  font-size: 10px;
}

.gradeGrid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 9px;
}

.gradeBox {
  border: 1px solid #dbe4ef;
  border-radius: 11px;
  padding: 14px 12px;
  display: flex;
  flex-direction: column;
  min-height: 86px;
}

.grade {
  width: fit-content;
  min-width: 24px;
  text-align: center;
  border-radius: 7px;
  padding: 4px 7px;
  font-weight: 900;
  font-size: 11px;
  background: #edf2f7;
}

.gradeA {
  color: #129459;
  background: #dcfce7;
}

.gradeB {
  color: #1763df;
  background: #dbeafe;
}

.gradeC {
  color: #64748b;
  background: #eef2f7;
}

.gradeBox strong {
  margin-top: 9px;
  font-size: 20px;
}

.gradeBox small {
  margin-top: 5px;
  color: #8090a6;
  font-size: 9px;
}

@media (max-width: 1100px) {
  .statsGrid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .twoCol {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 760px) {
  

  

  

  .nav a,
  .nav span {
    text-align: center;
    padding: 10px 6px;
    font-size: 11px;
  }

  

  .main {
    margin-left: 0;
    padding: 18px 12px 40px;
  }

  .header {
    align-items: flex-end;
  }

  .header h1 {
    font-size: 25px;
  }

  .subtitle {
    max-width: 260px;
  }

  .sectionHeader {
    flex-direction: column;
  }

  .range {
    align-self: flex-start;
  }

  .statsGrid {
    grid-template-columns: 1fr 1fr;
  }

  .tableHead,
  .tableRow {
    grid-template-columns: 1.2fr .6fr .9fr .9fr;
  }
}


/* STATS_FINAL_CLEAN_V8 */

/* =========================================================
   통계 본문 전체
   사이드바 / 글로벌 shell은 건드리지 않는다.
========================================================= */

.main {
  width: 100% !important;
  max-width: 100% !important;
  min-width: 0 !important;

  margin: 0 !important;
  padding: 24px 28px 40px !important;

  box-sizing: border-box !important;
  overflow-x: hidden !important;

  font-size: 14px !important;
  line-height: 1.5 !important;
}

.main > * {
  min-width: 0 !important;
  max-width: 100% !important;
  box-sizing: border-box !important;
}

.page,
.workspace,
.container,
.content {
  width: 100% !important;
  max-width: 100% !important;
  min-width: 0 !important;

  margin: 0 !important;

  box-sizing: border-box !important;
}


/* =========================================================
   페이지 헤더
========================================================= */

.header {
  margin-bottom: 20px !important;
}

.eyebrow {
  margin-bottom: 4px !important;

  font-size: 13px !important;
  line-height: 1.3 !important;
  font-weight: 800 !important;
  letter-spacing: .08em !important;
}

.header h1,
.title {
  margin: 0 !important;

  font-size: 29px !important;
  line-height: 1.2 !important;
  font-weight: 900 !important;
  letter-spacing: -.025em !important;
}

.header p,
.subtitle {
  margin: 6px 0 0 !important;

  font-size: 14px !important;
  line-height: 1.55 !important;
}


/* =========================================================
   날짜 / 기간 / 상태 배지
========================================================= */

.dateBadge,
.rangeBadge,
.periodBadge,
.badge,
.liveBadge,
.backtestBadge {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;

  min-height: 28px !important;

  padding: 5px 10px !important;

  font-size: 13px !important;
  line-height: 1.2 !important;
  font-weight: 800 !important;

  white-space: nowrap !important;
}


/* =========================================================
   LIVE / BACKTEST 큰 섹션
========================================================= */

.section {
  width: 100% !important;
  min-width: 0 !important;

  margin-bottom: 18px !important;
  padding: 20px !important;

  box-sizing: border-box !important;
}

.sectionTitle {
  margin-bottom: 16px !important;
}

.sectionTitle h2,
.section h2 {
  margin: 0 !important;

  font-size: 21px !important;
  line-height: 1.3 !important;
  font-weight: 900 !important;
}

.sectionTitle p,
.section > p {
  margin: 5px 0 0 !important;

  font-size: 13px !important;
  line-height: 1.5 !important;
}


/* =========================================================
   상단 요약수치
   데스크탑에서는 5개 한 줄
========================================================= */

.summaryGrid {
  display: grid !important;

  grid-template-columns:
    repeat(5, minmax(0, 1fr)) !important;

  gap: 10px !important;

  width: 100% !important;
  min-width: 0 !important;
}

.summaryGrid article {
  width: 100% !important;
  min-width: 0 !important;
  min-height: 92px !important;

  padding: 14px 15px !important;

  box-sizing: border-box !important;
}

.summaryGrid article small,
.summaryGrid article > span:first-child {
  display: block !important;

  font-size: 12px !important;
  line-height: 1.35 !important;
  font-weight: 750 !important;
}

.summaryGrid article strong {
  display: block !important;

  margin-top: 6px !important;

  font-size: 25px !important;
  line-height: 1.1 !important;
  font-weight: 900 !important;
}

.summaryGrid article span,
.summaryGrid article div {
  font-size: 12px !important;
  line-height: 1.45 !important;
}


/* =========================================================
   하단 통계 2열
========================================================= */

.grid,
.statsGrid,
.contentGrid,
.reportGrid {
  display: grid !important;

  grid-template-columns:
    repeat(2, minmax(0, 1fr)) !important;

  align-items: start !important;

  width: 100% !important;
  min-width: 0 !important;

  gap: 16px !important;
}

.grid > *,
.statsGrid > *,
.contentGrid > *,
.reportGrid > * {
  min-width: 0 !important;
  align-self: start !important;
}


/* =========================================================
   카드
========================================================= */

.card {
  width: 100% !important;
  max-width: 100% !important;
  min-width: 0 !important;

  height: auto !important;

  padding: 20px !important;

  box-sizing: border-box !important;
  overflow: hidden !important;
}

.card h3 {
  margin: 0 0 16px !important;

  font-size: 19px !important;
  line-height: 1.3 !important;
  font-weight: 900 !important;
}


/* =========================================================
   시장별 / 확률구간 가로 그래프
========================================================= */

.visualList {
  display: grid !important;

  width: 100% !important;
  min-width: 0 !important;

  gap: 8px !important;

  margin: 0 0 18px !important;
}

.visualList > div {
  display: grid !important;

  grid-template-columns:
    90px
    50px
    minmax(100px, 1fr)
    85px !important;

  align-items: center !important;

  width: 100% !important;
  min-width: 0 !important;

  column-gap: 10px !important;

  padding: 9px 11px !important;

  box-sizing: border-box !important;
}

.visualList > div > * {
  min-width: 0 !important;
}

.visualList strong {
  font-size: 13px !important;
  line-height: 1.3 !important;
  font-weight: 850 !important;
  white-space: nowrap !important;
}

.visualList span,
.visualList small {
  font-size: 12px !important;
  line-height: 1.35 !important;
}

.progressTrack {
  width: 100% !important;
  max-width: 100% !important;
  min-width: 0 !important;

  height: 12px !important;

  overflow: hidden !important;
}

.progressTrack > div {
  height: 100% !important;

  min-width: 2px !important;
}


/* =========================================================
   월별 그래프
========================================================= */

.monthChart {
  position: relative !important;

  display: grid !important;

  grid-template-columns:
    repeat(7, minmax(0, 1fr)) !important;

  align-items: end !important;

  width: 100% !important;
  max-width: 100% !important;
  min-width: 0 !important;

  height: 250px !important;
  min-height: 250px !important;

  gap: 8px !important;

  margin: 0 0 18px !important;
  padding: 22px 14px 14px !important;

  box-sizing: border-box !important;

  overflow: hidden !important;
}

.monthChart > div {
  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  justify-content: flex-end !important;

  width: 100% !important;
  height: 100% !important;
  min-width: 0 !important;
}

.monthChart > div > div {
  width: 34px !important;
  max-width: 70% !important;
  min-width: 18px !important;

  border-radius: 7px 7px 2px 2px !important;
}

.monthChart strong {
  font-size: 13px !important;
  line-height: 1.2 !important;
  font-weight: 850 !important;
}

.monthChart span,
.monthChart small,
.monthChart em {
  font-size: 12px !important;
  line-height: 1.3 !important;
  font-style: normal !important;
}


/* =========================================================
   등급별
========================================================= */

.gradeGrid {
  display: grid !important;

  grid-template-columns:
    repeat(3, minmax(0, 1fr)) !important;

  width: 100% !important;
  min-width: 0 !important;

  gap: 10px !important;
}

.gradeGrid article {
  min-width: 0 !important;
  min-height: 105px !important;

  padding: 14px !important;

  box-sizing: border-box !important;
}

.gradeGrid article strong {
  display: block !important;

  margin-top: 8px !important;

  font-size: 24px !important;
  line-height: 1.1 !important;
  font-weight: 900 !important;
}

.gradeGrid article span,
.gradeGrid article small {
  font-size: 12px !important;
  line-height: 1.4 !important;
}


/* =========================================================
   표
========================================================= */

.tableHead,
.tableRow {
  width: 100% !important;
  max-width: 100% !important;
  min-width: 0 !important;

  box-sizing: border-box !important;
}

.tableHead {
  min-height: 39px !important;

  padding: 8px 10px !important;

  font-size: 12px !important;
  line-height: 1.35 !important;
  font-weight: 750 !important;
}

.tableRow {
  min-height: 44px !important;

  padding: 9px 10px !important;

  font-size: 13px !important;
  line-height: 1.35 !important;
  font-weight: 650 !important;
}

.tableRow strong {
  font-size: 13px !important;
  font-weight: 850 !important;
}


/* =========================================================
   설명 / 안내
========================================================= */

.infoBox,
.notice,
.emptyNotice,
.description {
  padding: 10px 12px !important;

  font-size: 12px !important;
  line-height: 1.55 !important;
}


/* =========================================================
   반응형
========================================================= */

@media (max-width: 1250px) {
  .summaryGrid {
    grid-template-columns:
      repeat(3, minmax(0, 1fr)) !important;
  }
}

@media (max-width: 1050px) {
  .grid,
  .statsGrid,
  .contentGrid,
  .reportGrid {
    grid-template-columns: 1fr !important;
  }

  .monthChart {
    height: 240px !important;
    min-height: 240px !important;
  }
}

@media (max-width: 760px) {
  .main {
    padding: 15px 10px 28px !important;
  }

  .summaryGrid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr)) !important;
  }

  .header h1,
  .title {
    font-size: 25px !important;
  }

  .section {
    padding: 15px !important;
  }

  .card {
    padding: 15px !important;
  }

  .visualList > div {
    grid-template-columns:
      78px
      42px
      minmax(60px, 1fr)
      70px !important;

    column-gap: 6px !important;
  }

  .monthChart {
    height: 220px !important;
    min-height: 220px !important;

    gap: 5px !important;

    padding-left: 7px !important;
    padding-right: 7px !important;
  }

  .monthChart > div > div {
    width: 70% !important;
    min-width: 12px !important;
  }
}



