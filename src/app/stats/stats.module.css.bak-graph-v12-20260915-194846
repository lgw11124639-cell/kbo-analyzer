/* =========================================
   시장별 / 확률구간
========================================= */

.visualList {
  display: grid !important;
  gap: 10px !important;
  margin: 0 0 18px !important;
}

.visualList > div {
  display: grid !important;

  grid-template-columns:
    120px
    175px
    minmax(150px, 1fr)
    95px !important;

  align-items: center !important;

  column-gap: 14px !important;

  min-height: 46px !important;

  padding: 9px 12px !important;

  box-sizing: border-box !important;
}

.visualList > div > * {
  min-width: 0 !important;
}

/* 글씨가 서로 붙거나 이상하게 줄바꿈되지 않게 */
.visualList > div > :nth-child(1),
.visualList > div > :nth-child(2),
.visualList > div > :nth-child(4) {
  white-space: nowrap !important;
}

.visualList strong {
  display: block !important;

  font-size: 14px !important;
  line-height: 1.35 !important;
  font-weight: 800 !important;
}

.visualList span,
.visualList small,
.visualList b {
  font-size: 13px !important;
  line-height: 1.35 !important;
}

.progressTrack {
  width: 100% !important;
  min-width: 0 !important;

  height: 12px !important;

  border-radius: 999px !important;

  overflow: hidden !important;

  background: #e5eaf1 !important;
}

/* 기존 JSX의 width값 사용 */
.progressTrack > * {
  height: 100% !important;

  min-width: 2px !important;

  border-radius: 999px !important;

  background:
    linear-gradient(
      90deg,
      #60a5fa,
      #2563eb
    ) !important;

  transition:
    width .25s ease !important;
}


/* =========================================
   월별 그래프
========================================= */

.monthChart {
  position: relative !important;

  display: grid !important;

  /* 실제 월 7개만 컬럼 */
  grid-template-columns:
    repeat(7, minmax(0, 1fr)) !important;

  align-items: end !important;

  width: 100% !important;

  height: 270px !important;
  min-height: 270px !important;

  gap: 12px !important;

  padding:
    24px 14px 16px 48px !important;

  margin:
    0 0 18px !important;

  box-sizing: border-box !important;

  overflow: hidden !important;
}

/*
  첫 번째 직접 자식은 50% 기준선
  grid 컬럼을 차지하지 않게 absolute 처리
*/
.monthChart > :first-child {
  position: absolute !important;

  left: 12px !important;
  right: 12px !important;

  top: 50% !important;

  width: auto !important;
  height: 0 !important;
  min-height: 0 !important;

  display: block !important;

  border-top:
    1px dashed #aeb9c8 !important;

  z-index: 1 !important;
}

/* 50% 글씨 */
.monthChart > :first-child * {
  position: absolute !important;

  left: 0 !important;
  top: -10px !important;

  width: auto !important;
  height: auto !important;

  min-width: 0 !important;
  min-height: 0 !important;

  padding:
    0 4px 0 0 !important;

  background:
    #f8fafc !important;

  color:
    #64748b !important;

  font-size:
    12px !important;

  line-height:
    1.2 !important;

  font-weight:
    700 !important;
}


/* 실제 03~09 월 */
.monthChart > :not(:first-child) {
  position: relative !important;

  z-index: 2 !important;

  display: flex !important;

  flex-direction:
    column !important;

  align-items:
    center !important;

  justify-content:
    flex-end !important;

  width:
    100% !important;

  height:
    100% !important;

  min-width:
    0 !important;
}


/*
  이전 CSS가 내부 div 전부 파란 막대로 만든 문제 제거
*/
.monthChart > :not(:first-child) > div {
  width:
    auto !important;

  max-width:
    none !important;

  min-width:
    0 !important;

  background:
    transparent !important;

  border-radius:
    0 !important;
}


/*
  JSX에서 실제 적중률로 넣은 inline height만
  진짜 막대로 사용.

  hitRate 바뀌면
  막대 높이도 자동 변경됨.
*/
.monthChart
> :not(:first-child)
[style*="height"] {
  width:
    36px !important;

  max-width:
    70% !important;

  min-width:
    18px !important;

  min-height:
    2px !important;

  border-radius:
    8px 8px 2px 2px !important;

  background:
    linear-gradient(
      180deg,
      #60a5fa,
      #2563eb
    ) !important;

  transition:
    height .25s ease !important;
}


/* 막대 위 적중률 */
.monthChart
> :not(:first-child)
strong {
  font-size:
    14px !important;

  line-height:
    1.2 !important;

  font-weight:
    800 !important;

  color:
    #172033 !important;

  white-space:
    nowrap !important;
}


/* 월 / 수익률 */
.monthChart
> :not(:first-child)
span,
.monthChart
> :not(:first-child)
small,
.monthChart
> :not(:first-child)
em,
.monthChart
> :not(:first-child)
b {
  font-size:
    13px !important;

  line-height:
    1.3 !important;

  white-space:
    nowrap !important;
}


