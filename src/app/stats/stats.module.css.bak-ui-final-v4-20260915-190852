.shell {
  min-height: 100vh;
  background: #f3f6fb;
  color: #0f172a;
}

.sidebar {
  position: fixed;
  inset: 0 auto 0 0;
  width: 180px;
  background: #0d203b;
  color: #fff;
  padding: 28px 16px;
  z-index: 20;
  display: flex;
  flex-direction: column;
}

.brand {
  display: flex;
  align-items: center;
  gap: 8px;
  min-height: 68px;
  color: #fff;
  text-decoration: none;
  border-bottom: 1px solid rgba(255,255,255,.08);
  padding: 0 8px 22px;
}

.brand span:nth-child(2) {
  display: flex;
  flex-direction: column;
  line-height: 1.05;
  font-size: 16px;
}

.brand small {
  margin-left: auto;
  color: #68809f;
  font-size: 9px;
}

.ball {
  font-size: 16px;
}

.nav {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-top: 26px;
}

.nav a,
.nav span {
  display: block;
  border-radius: 9px;
  padding: 12px 12px;
  text-decoration: none;
  color: #d7e2f1;
  font-size: 13px;
  font-weight: 800;
}

.nav a:hover {
  background: rgba(255,255,255,.07);
}

.nav .active {
  color: #fff;
  background: #2f72e9;
  box-shadow: 0 8px 18px rgba(47,114,233,.25);
}

.nav .disabled {
  color: #60738e;
  cursor: default;
}

.collector {
  margin-top: auto;
  padding: 14px 10px;
  border-top: 1px solid rgba(255,255,255,.08);
  display: flex;
  flex-direction: column;
  gap: 6px;
  font-size: 10px;
  color: #8296b2;
}

.collector b {
  color: #d8e4f3;
  font-size: 11px;
  margin-bottom: 2px;
}

.main {
  margin-left: 180px;
  padding: 30px 28px 60px;
  max-width: 1500px;
}

.header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 22px;
}

.eyebrow {
  margin: 0 0 4px;
  color: #1763df;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: .12em;
}

.header h1 {
  margin: 0;
  font-size: 30px;
  letter-spacing: -.04em;
}

.subtitle {
  margin: 7px 0 0;
  color: #6b7d96;
  font-size: 12px;
}

.headerActions button {
  border: 1px solid #d3ddea;
  background: #fff;
  color: #0f172a;
  border-radius: 10px;
  padding: 11px 16px;
  font-weight: 800;
  cursor: pointer;
}

.headerActions button:disabled {
  opacity: .55;
  cursor: default;
}

.error {
  margin-bottom: 16px;
  border: 1px solid #fecaca;
  background: #fff1f2;
  color: #b91c1c;
  border-radius: 12px;
  padding: 13px 15px;
  font-size: 12px;
  font-weight: 700;
}

.card {
  background: #fff;
  border: 1px solid #dbe4ef;
  border-radius: 16px;
  padding: 20px;
  box-shadow: 0 8px 24px rgba(15,23,42,.035);
  margin-bottom: 18px;
}

.liveCard {
  border-left: 4px solid #ff4d4f;
}

.sectionHeader {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 17px;
}

.sectionHeader h2 {
  margin: 8px 0 3px;
  font-size: 20px;
}

.sectionHeader p {
  margin: 0;
  color: #75869e;
  font-size: 11px;
}

.badge {
  display: inline-flex;
  border-radius: 999px;
  padding: 4px 8px;
  font-size: 9px;
  font-weight: 900;
}

.liveBadge {
  color: #ef4444;
  background: #ffe8e8;
}

.backtestBadge {
  color: #1763df;
  background: #e7f0ff;
}

.range {
  white-space: nowrap;
  border: 1px solid #d8e2ee;
  border-radius: 9px;
  padding: 8px 10px;
  font-size: 10px;
  background: #fbfdff;
}

.statsGrid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 10px;
}

.statBox {
  min-width: 0;
  border: 1px solid #dbe4ef;
  background: #f8fafc;
  border-radius: 12px;
  padding: 14px 13px;
  min-height: 84px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.statBox span {
  color: #60738c;
  font-size: 10px;
  font-weight: 800;
}

.statBox strong {
  margin-top: 6px;
  font-size: 21px;
  letter-spacing: -.03em;
}

.statBox small {
  margin-top: 4px;
  color: #8290a5;
  font-size: 9px;
}

.accent {
  background: #eef6ff;
  border-color: #b8d6ff;
}

.accent strong {
  color: #145cdb;
}

.positive {
  color: #11975d !important;
}

.negative {
  color: #ef3434 !important;
}

.emptyNotice {
  margin-top: 12px;
  border: 1px dashed #f3b5b5;
  background: #fffafa;
  color: #cf5252;
  border-radius: 10px;
  padding: 11px 13px;
  font-size: 10px;
}

.infoLine {
  margin-top: 12px;
  border-radius: 9px;
  background: #f6f8fb;
  padding: 10px 12px;
  color: #718098;
  font-size: 10px;
  line-height: 1.5;
}

.twoCol {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px;
}

.card h3 {
  margin: 0 0 14px;
  font-size: 16px;
}

.table {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.tableHead,
.tableRow {
  display: grid;
  grid-template-columns: 1.4fr .7fr .9fr .9fr;
  align-items: center;
  gap: 8px;
}

.tableHead {
  color: #8a98aa;
  font-size: 9px;
  padding: 0 10px 5px;
}

.tableRow {
  background: #f7f9fc;
  border-radius: 9px;
  min-height: 36px;
  padding: 0 10px;
  font-size: 10px;
}

.tableRow b {
  font-size: 10px;
}

.tableRow strong {
  font-size: 10px;
}

.gradeGrid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 9px;
}

.gradeBox {
  border: 1px solid #dbe4ef;
  border-radius: 11px;
  padding: 14px 12px;
  display: flex;
  flex-direction: column;
  min-height: 86px;
}

.grade {
  width: fit-content;
  min-width: 24px;
  text-align: center;
  border-radius: 7px;
  padding: 4px 7px;
  font-weight: 900;
  font-size: 11px;
  background: #edf2f7;
}

.gradeA {
  color: #129459;
  background: #dcfce7;
}

.gradeB {
  color: #1763df;
  background: #dbeafe;
}

.gradeC {
  color: #64748b;
  background: #eef2f7;
}

.gradeBox strong {
  margin-top: 9px;
  font-size: 20px;
}

.gradeBox small {
  margin-top: 5px;
  color: #8090a6;
  font-size: 9px;
}

@media (max-width: 1100px) {
  .statsGrid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .twoCol {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 760px) {
  .sidebar {
    position: static;
    width: auto;
    padding: 12px;
  }

  .brand {
    min-height: auto;
    padding: 6px 6px 12px;
  }

  .nav {
    margin-top: 10px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .nav a,
  .nav span {
    text-align: center;
    padding: 10px 6px;
    font-size: 11px;
  }

  .collector {
    display: none;
  }

  .main {
    margin-left: 0;
    padding: 18px 12px 40px;
  }

  .header {
    align-items: flex-end;
  }

  .header h1 {
    font-size: 25px;
  }

  .subtitle {
    max-width: 260px;
  }

  .sectionHeader {
    flex-direction: column;
  }

  .range {
    align-self: flex-start;
  }

  .statsGrid {
    grid-template-columns: 1fr 1fr;
  }

  .tableHead,
  .tableRow {
    grid-template-columns: 1.2fr .6fr .9fr .9fr;
  }
}


