/* STATS_VISUAL_V1 */

.visualList {
  display: grid;
  gap: 16px;
  margin: 2px 0 24px;
}

.visualRow {
  display: grid;
  grid-template-columns: minmax(250px, 0.8fr) minmax(260px, 1.2fr);
  gap: 20px;
  align-items: center;
  padding: 14px 16px;
  border: 1px solid #e2e8f0;
  border-radius: 14px;
  background: #f8fafc;
}

.visualMeta {
  display: grid;
  grid-template-columns: minmax(90px, 1fr) minmax(130px, auto) minmax(100px, auto);
  gap: 12px;
  align-items: center;
}

.visualMeta strong {
  font-size: 16px;
  font-weight: 800;
  color: #0f172a;
}

.visualMeta span {
  font-size: 14px;
  font-weight: 650;
  color: #64748b;
}

.visualMeta b {
  justify-self: end;
  font-size: 15px;
  font-weight: 850;
}

.returnPositive {
  color: #059669;
}

.returnNegative {
  color: #dc2626;
}

.progressTrack {
  position: relative;
  height: 18px;
  overflow: hidden;
  border-radius: 999px;
  background: #e2e8f0;
}

.progressTrack::after {
  content: "";
  position: absolute;
  top: 0;
  bottom: 0;
  left: 50%;
  width: 2px;
  background: rgba(15, 23, 42, 0.18);
}

.progressFill {
  position: relative;
  z-index: 1;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #60a5fa, #2563eb);
}

.monthChart {
  position: relative;
  display: grid;
  grid-template-columns: repeat(7, minmax(74px, 1fr));
  gap: 16px;
  min-height: 280px;
  margin: 2px 0 24px;
  padding: 26px 18px 18px;
  border: 1px solid #e2e8f0;
  border-radius: 16px;
  background: #f8fafc;
  overflow-x: auto;
}

.monthGuide {
  position: absolute;
  z-index: 0;
  left: 18px;
  right: 18px;
  top: 50%;
  border-top: 1px dashed #94a3b8;
}

.monthGuide span {
  position: absolute;
  top: -20px;
  left: 0;
  font-size: 12px;
  font-weight: 800;
  color: #64748b;
}

.monthCol {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-rows: 28px 1fr 24px 24px;
  gap: 6px;
  min-width: 74px;
  text-align: center;
}

.monthHit {
  font-size: 14px;
  font-weight: 850;
  color: #0f172a;
}

.monthBarArea {
  display: flex;
  min-height: 170px;
  align-items: flex-end;
  justify-content: center;
  border-bottom: 2px solid #cbd5e1;
}

.monthBar {
  width: min(58px, 72%);
  min-height: 6px;
  border-radius: 10px 10px 3px 3px;
  background: linear-gradient(180deg, #3b82f6, #2563eb);
  box-shadow: 0 6px 14px rgba(37, 99, 235, 0.16);
}

.monthName {
  font-size: 14px;
  font-weight: 800;
  color: #334155;
}

.monthReturnPositive,
.monthReturnNegative {
  font-size: 13px;
  font-weight: 850;
}

.monthReturnPositive {
  color: #059669;
}

.monthReturnNegative {
  color: #dc2626;
}

@media (max-width: 1100px) {
  .visualRow {
    grid-template-columns: 1fr;
    gap: 12px;
  }

  .monthChart {
    grid-template-columns: repeat(7, minmax(86px, 1fr));
  }
}

@media (max-width: 700px) {
  .visualMeta {
    grid-template-columns: 1fr auto;
  }

  .visualMeta b {
    grid-column: 1 / -1;
    justify-self: start;
  }

  .visualRow {
    padding: 13px;
  }

  .progressTrack {
    height: 16px;
  }
}


/* STATS_DASHBOARD_UI_V2 */

/* =========================================================
   전체 폭 확장
   ========================================================= */

.main,
.content,
.page,
.workspace,
.container {
  width: 100% !important;
  max-width: none !important;
}

.main {
  padding-right: 28px !important;
}

.content {
  padding-left: 24px !important;
  padding-right: 28px !important;
}

/* =========================================================
   2열 대시보드 폭 확장
   ========================================================= */

.grid,
.statsGrid,
.contentGrid,
.reportGrid {
  width: 100% !important;
  grid-template-columns:
    minmax(0, 1fr)
    minmax(0, 1fr) !important;
  gap: 20px !important;
}

/* =========================================================
   카드
   ========================================================= */

.card {
  min-width: 0 !important;
  padding: 26px !important;
}

.card h3 {
  font-size: 24px !important;
  margin-bottom: 22px !important;
}

/* =========================================================
   시장별 / 확률구간 그래프
   ========================================================= */

.visualList {
  display: grid !important;
  gap: 14px !important;
  margin-bottom: 24px !important;
}

.visualList > div {
  display: grid !important;
  grid-template-columns:
    minmax(90px, 120px)
    minmax(100px, 150px)
    minmax(240px, 1fr)
    minmax(80px, 100px) !important;
  gap: 14px !important;
  align-items: center !important;

  min-height: 64px !important;
  padding: 12px 14px !important;

  border-radius: 12px !important;
  background: #f8fafc !important;
  border: 1px solid #e2e8f0 !important;
}

.visualList > div > * {
  min-width: 0 !important;
}

.visualList strong {
  font-size: 16px !important;
  line-height: 1.35 !important;
}

.visualList span,
.visualList small {
  font-size: 14px !important;
  line-height: 1.4 !important;
}

/* =========================================================
   적중률 바
   ========================================================= */

.progressTrack {
  position: relative !important;
  width: 100% !important;
  min-width: 220px !important;
  height: 18px !important;

  overflow: hidden !important;
  border-radius: 999px !important;

  background: #e2e8f0 !important;
}

.progressTrack > div {
  height: 100% !important;
  border-radius: 999px !important;
}

/* 그래프 옆 숫자 */
.progressTrack + span,
.progressTrack + strong {
  min-width: 72px !important;
  text-align: right !important;
  font-size: 15px !important;
  font-weight: 850 !important;
}

/* =========================================================
   월별 차트 대형화
   ========================================================= */

.monthChart {
  width: 100% !important;
  min-height: 320px !important;
  padding: 28px 22px 18px !important;

  display: flex !important;
  align-items: flex-end !important;
  justify-content: stretch !important;
  gap: 14px !important;

  border: 1px solid #dbe4ef !important;
  border-radius: 16px !important;
  background: #f8fafc !important;

  margin-bottom: 24px !important;
}

.monthChart > div {
  flex: 1 1 0 !important;
  min-width: 0 !important;
}

/* 월별 수치 */
.monthChart strong {
  font-size: 15px !important;
  font-weight: 850 !important;
}

/* 월 표시 */
.monthChart small,
.monthChart span {
  font-size: 13px !important;
  line-height: 1.4 !important;
}

/* =========================================================
   등급별 카드 크게
   ========================================================= */

.gradeGrid {
  grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
  gap: 16px !important;
}

.gradeGrid article {
  min-height: 150px !important;
  padding: 22px !important;
}

.gradeGrid article strong {
  font-size: 34px !important;
  margin-top: 14px !important;
}

.gradeGrid article small,
.gradeGrid article span {
  font-size: 14px !important;
}

/* =========================================================
   표도 조금 더 넓고 선명하게
   ========================================================= */

.tableHead,
.tableRow {
  grid-template-columns:
    minmax(120px, 1.4fr)
    minmax(70px, .7fr)
    minmax(90px, .9fr)
    minmax(90px, .9fr) !important;

  min-height: 50px !important;
  padding-left: 12px !important;
  padding-right: 12px !important;
}

.tableHead {
  font-size: 14px !important;
}

.tableRow {
  font-size: 15px !important;
}

/* =========================================================
   수익률 색상 숫자 가독성
   ========================================================= */

.positive {
  font-weight: 900 !important;
}

.negative {
  font-weight: 900 !important;
}

/* =========================================================
   큰 화면에서는 더 넓게
   ========================================================= */

@media (min-width: 1400px) {
  .content,
  .main {
    padding-right: 40px !important;
  }

  .grid,
  .statsGrid,
  .contentGrid,
  .reportGrid {
    gap: 24px !important;
  }

  .card {
    padding: 30px !important;
  }

  .monthChart {
    min-height: 350px !important;
  }
}

/* =========================================================
   태블릿
   ========================================================= */

@media (max-width: 1100px) {
  .grid,
  .statsGrid,
  .contentGrid,
  .reportGrid {
    grid-template-columns: 1fr !important;
  }

  .visualList > div {
    grid-template-columns:
      minmax(90px, 120px)
      minmax(90px, 130px)
      minmax(180px, 1fr)
      minmax(70px, 90px) !important;
  }
}

/* =========================================================
   모바일
   ========================================================= */

@media (max-width: 760px) {
  .content,
  .main {
    padding-left: 12px !important;
    padding-right: 12px !important;
  }

  .card {
    padding: 18px !important;
  }

  .visualList > div {
    grid-template-columns: 1fr !important;
    gap: 8px !important;
  }

  .progressTrack {
    min-width: 0 !important;
    height: 16px !important;
  }

  .monthChart {
    min-height: 260px !important;
    gap: 8px !important;
    padding: 20px 12px 14px !important;
  }

  .gradeGrid {
    grid-template-columns: 1fr !important;
  }
}


/* STATS_LAYOUT_FIX_V3 */

/* =========================================================
   가로 오버플로우 제거
   ========================================================= */

.shell {
  width: 100% !important;
  max-width: 100vw !important;
  min-width: 0 !important;
  overflow-x: hidden !important;
}

.main {
  flex: 1 1 auto !important;
  width: auto !important;
  max-width: 100% !important;
  min-width: 0 !important;
  overflow-x: hidden !important;
  box-sizing: border-box !important;

  padding-left: 24px !important;
  padding-right: 24px !important;
}

.content,
.page,
.workspace,
.container {
  width: auto !important;
  max-width: 1400px !important;
  min-width: 0 !important;

  margin-left: auto !important;
  margin-right: auto !important;

  box-sizing: border-box !important;
}

/* 모든 주요 박스가 부모보다 커지지 않게 */
.main > *,
.content > *,
.page > * {
  max-width: 100% !important;
  min-width: 0 !important;
  box-sizing: border-box !important;
}

/* =========================================================
   2열 영역
   ========================================================= */

.grid,
.statsGrid,
.contentGrid,
.reportGrid {
  display: grid !important;

  width: 100% !important;
  max-width: 100% !important;
  min-width: 0 !important;

  grid-template-columns:
    repeat(2, minmax(0, 1fr)) !important;

  gap: 18px !important;
}

.card {
  width: 100% !important;
  max-width: 100% !important;
  min-width: 0 !important;

  overflow: hidden !important;
  box-sizing: border-box !important;
}

/* =========================================================
   시장별 / 확률구간 막대
   이름 | 픽 | 그래프 | 적중률/수익률
   ========================================================= */

.visualList {
  width: 100% !important;
  max-width: 100% !important;

  display: grid !important;
  gap: 10px !important;

  margin-bottom: 20px !important;
}

.visualList > div {
  display: grid !important;

  grid-template-columns:
    105px
    62px
    minmax(120px, 1fr)
    82px !important;

  align-items: center !important;
  gap: 10px !important;

  width: 100% !important;
  max-width: 100% !important;
  min-width: 0 !important;

  min-height: 54px !important;
  padding: 10px 12px !important;

  box-sizing: border-box !important;

  border: 1px solid #e2e8f0 !important;
  border-radius: 11px !important;
  background: #f8fafc !important;
}

.visualList > div > * {
  min-width: 0 !important;
  max-width: 100% !important;
}

.visualList strong {
  font-size: 15px !important;
  line-height: 1.3 !important;
  white-space: nowrap !important;
}

.visualList span,
.visualList small {
  font-size: 13px !important;
  line-height: 1.35 !important;
}

/* =========================================================
   가로 적중률 바
   ========================================================= */

.progressTrack {
  position: relative !important;

  width: 100% !important;
  max-width: 100% !important;
  min-width: 0 !important;

  height: 14px !important;

  overflow: hidden !important;

  border-radius: 999px !important;
  background: #e2e8f0 !important;
}

.progressTrack > div {
  height: 100% !important;
  max-width: 100% !important;

  border-radius: 999px !important;
}

/* =========================================================
   월별 그래프
   ========================================================= */

.monthChart {
  width: 100% !important;
  max-width: 100% !important;
  min-width: 0 !important;

  height: 280px !important;
  min-height: 280px !important;

  padding: 22px 16px 14px !important;

  display: grid !important;
  grid-template-columns:
    repeat(7, minmax(0, 1fr)) !important;

  align-items: end !important;
  gap: 10px !important;

  overflow: hidden !important;

  box-sizing: border-box !important;

  border: 1px solid #dbe4ef !important;
  border-radius: 14px !important;
  background: #f8fafc !important;

  margin-bottom: 20px !important;
}

.monthChart > div {
  min-width: 0 !important;
  max-width: 100% !important;

  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  justify-content: flex-end !important;
}

.monthChart strong {
  font-size: 13px !important;
  line-height: 1.2 !important;
}

.monthChart small,
.monthChart span {
  font-size: 12px !important;
  line-height: 1.3 !important;
}

/* =========================================================
   표
   ========================================================= */

.tableHead,
.tableRow {
  width: 100% !important;
  max-width: 100% !important;
  min-width: 0 !important;

  box-sizing: border-box !important;
}

/* =========================================================
   등급 카드
   ========================================================= */

.gradeGrid {
  width: 100% !important;

  grid-template-columns:
    repeat(3, minmax(0, 1fr)) !important;

  gap: 12px !important;
}

.gradeGrid article {
  min-width: 0 !important;
  min-height: 125px !important;
}

/* =========================================================
   중간 화면
   ========================================================= */

@media (max-width: 1180px) {
  .grid,
  .statsGrid,
  .contentGrid,
  .reportGrid {
    grid-template-columns: 1fr !important;
  }

  .monthChart {
    height: 270px !important;
  }
}

/* =========================================================
   모바일
   ========================================================= */

@media (max-width: 760px) {
  .main {
    padding-left: 10px !important;
    padding-right: 10px !important;
  }

  .visualList > div {
    grid-template-columns:
      90px
      52px
      minmax(80px, 1fr)
      70px !important;

    gap: 6px !important;
    padding: 9px !important;
  }

  .visualList strong {
    font-size: 13px !important;
  }

  .visualList span,
  .visualList small {
    font-size: 12px !important;
  }

  .monthChart {
    height: 245px !important;
    min-height: 245px !important;

    gap: 5px !important;
    padding: 18px 8px 12px !important;
  }

  .gradeGrid {
    grid-template-columns: 1fr !important;
  }
}
