"use client";

import Link from "next/link";
import { useCallback, useEffect, useState } from "react";
import styles from "./stats.module.css";

type Summary = {
  count: number;
  wins: number;
  losses: number;
  hitRate: number | null;
  returnRate: number | null;
};

type GroupSummary = Summary & {
  name: string;
};

type BacktestReport = {
  start: string;
  end: string;
  analyzedGames: number;
  recommendations: Summary;
  dailyTop: Summary;
  recommendationDays: number;
  markets: GroupSummary[];
  grades: GroupSummary[];
  buckets: GroupSummary[];
  monthly: GroupSummary[];
};

type LiveReport = {
  liveStart?: string;
  count?: number;
  settled?: number;
  pending?: number;
  wins?: number;
  losses?: number;
  hitRate?: number | null;
  returnRate?: number | null;
};

function percent(value: number | null | undefined) {
  return typeof value === "number"
    ? `${value.toFixed(1)}%`
    : "-";
}

function rateClass(value: number | null | undefined) {
  if (typeof value !== "number") return "";
  return value >= 0 ? styles.positive : styles.negative;
}

function gradeClass(name: string) {
  if (name === "A") return styles.gradeA;
  if (name === "B") return styles.gradeB;
  return styles.gradeC;
}

function StatBox({
  label,
  value,
  sub,
  accent,
}: {
  label: string;
  value: string;
  sub?: string;
  accent?: boolean;
}) {
  return (
    <div className={`${styles.statBox} ${accent ? styles.accent : ""}`}>
      <span>{label}</span>
      <strong>{value}</strong>
      {sub ? <small>{sub}</small> : null}
    </div>
  );
}

export default function StatsPage() {
  const [backtest, setBacktest] =
    useState<BacktestReport | null>(null);

  const [live, setLive] =
    useState<LiveReport | null>(null);

  const [loading, setLoading] =
    useState(true);

  const [error, setError] =
    useState("");

  const load = useCallback(async () => {
    setLoading(true);
    setError("");

    try {
      const [statsResponse, liveResponse] =
        await Promise.all([
          fetch("/api/stats/report", {
            cache: "no-store",
          }),
          fetch("/api/predictions/live", {
            cache: "no-store",
          }),
        ]);

      if (!statsResponse.ok) {
        throw new Error(
          `통계 API ${statsResponse.status}`
        );
      }

      if (!liveResponse.ok) {
        throw new Error(
          `라이브 API ${liveResponse.status}`
        );
      }

      const statsJson =
        await statsResponse.json();

      const liveJson =
        await liveResponse.json();

      setBacktest(
        statsJson.backtest || null
      );

      setLive(liveJson || null);
    } catch (e) {
      console.error(e);
      setError(
        e instanceof Error
          ? e.message
          : "통계를 불러오지 못했습니다."
      );
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    void load();
  }, [load]);

  const liveStart =
    live?.liveStart || "2026-09-16";

  const liveCount =
    live?.count ?? 0;

  const liveSettled =
    live?.settled ?? 0;

  const livePending =
    live?.pending ?? 0;

  const liveWins =
    live?.wins ?? 0;

  const liveLosses =
    live?.losses ?? 0;

  return (
    <div className={styles.shell}>
      <aside className={styles.sidebar}>
        <Link href="/" className={styles.brand}>
          <span className={styles.ball}>⚾</span>
          <span>
            <b>KBO</b>
            <b>Analyzer</b>
          </span>
          <small>v0.1</small>
        </Link>

        <nav className={styles.nav}>
          <Link href="/">오늘 경기</Link>
          <Link href="/?tab=combos">자동조합</Link>
          <Link href="/?tab=my-combos">내 조합</Link>
          <span className={styles.disabled}>적중기록</span>
          <Link href="/stats" className={styles.active}>
            통계 리포트
          </Link>
          <span className={styles.disabled}>설정</span>
        </nav>

        <div className={styles.collector}>
          <b>통계 기준</b>
          <span>● 라이브 원본 자동저장</span>
          <span>● 과거 백테스트 분리</span>
          <span>● 1만원 동일 금액 기준</span>
        </div>
      </aside>

      <main className={styles.main}>
        <header className={styles.header}>
          <div>
            <p className={styles.eyebrow}>
              KBO ANALYZER PERFORMANCE
            </p>
            <h1>통계 리포트</h1>
            <p className={styles.subtitle}>
              라이브 추천 성적과 과거 경기 백테스트를 분리해서 보여줍니다.
            </p>
          </div>

          <div className={styles.headerActions}>
            <button
              type="button"
              onClick={() => void load()}
              disabled={loading}
            >
              {loading ? "불러오는 중..." : "↻ 새로고침"}
            </button>
          </div>
        </header>

        {error ? (
          <div className={styles.error}>
            {error}
          </div>
        ) : null}

        <section className={`${styles.card} ${styles.liveCard}`}>
          <div className={styles.sectionHeader}>
            <div>
              <span className={`${styles.badge} ${styles.liveBadge}`}>
                LIVE
              </span>
              <h2>라이브 성적</h2>
              <p>
                실제 사이트가 당일 생성하고 서버에 저장한 추천 원본만 집계합니다.
              </p>
            </div>

            <strong className={styles.range}>
              기준 시작 {liveStart}
            </strong>
          </div>

          <div className={styles.statsGrid}>
            <StatBox
              label="저장된 추천"
              value={`${liveCount}건`}
            />
            <StatBox
              label="판정 완료"
              value={`${liveSettled}건`}
            />
            <StatBox
              label="판정 대기"
              value={`${livePending}건`}
            />
            <StatBox
              label="적중률"
              value={percent(live?.hitRate)}
              sub={`${liveWins}승 · ${liveLosses}패`}
              accent
            />
            <div className={styles.statBox}>
              <span>수익률(1만원 기준)</span>
              <strong className={rateClass(live?.returnRate)}>
                {percent(live?.returnRate)}
              </strong>
              <small>동일 금액 가정</small>
            </div>
          </div>

          {liveCount === 0 ? (
            <div className={styles.emptyNotice}>
              아직 저장된 라이브 추천이 없습니다. 오늘 경기 화면에서 실제 추천이 생성되면 자동으로 누적됩니다.
            </div>
          ) : null}

          <div className={styles.infoLine}>
            {liveStart} 이후 저장 기능이 실제로 기록한 추천만 라이브 성적에 포함합니다.
            과거 날짜를 현재 엔진으로 다시 계산한 값은 라이브 성적에 넣지 않습니다.
          </div>
        </section>

        <section className={styles.card}>
          <div className={styles.sectionHeader}>
            <div>
              <span className={`${styles.badge} ${styles.backtestBadge}`}>
                BACKTEST
              </span>
              <h2>과거 경기 백테스트</h2>
              <p>
                현재 추천 기준을 과거 경기 데이터에 적용한 별도 성적입니다.
              </p>
            </div>

            <strong className={styles.range}>
              {backtest
                ? `${backtest.start} ~ ${backtest.end}`
                : "불러오는 중"}
            </strong>
          </div>

          <div className={styles.statsGrid}>
            <StatBox
              label="누적 분석 경기"
              value={`${backtest?.analyzedGames ?? 0}경기`}
            />
            <StatBox
              label="경기별 최종픽"
              value={`${backtest?.recommendations.count ?? 0}건`}
            />
            <StatBox
              label="최종픽 적중률"
              value={percent(
                backtest?.recommendations.hitRate
              )}
              sub={
                backtest
                  ? `${backtest.recommendations.wins}승 ${backtest.recommendations.losses}패`
                  : ""
              }
            />
            <StatBox
              label="일일 최고픽 적중률"
              value={percent(
                backtest?.dailyTop.hitRate
              )}
              sub={
                backtest
                  ? `${backtest.dailyTop.wins}승 ${backtest.dailyTop.losses}패 · ${backtest.recommendationDays}일`
                  : ""
              }
              accent
            />
            <div className={styles.statBox}>
              <span>일일 최고픽 수익률</span>
              <strong
                className={rateClass(
                  backtest?.dailyTop.returnRate
                )}
              >
                {percent(
                  backtest?.dailyTop.returnRate
                )}
              </strong>
              <small>1만원 동일 베팅 기준</small>
            </div>
          </div>

          <div className={styles.infoLine}>
            수익률은 각 추천에 10,000원씩 동일하게 베팅했다고 가정해 계산합니다.
            실제 개인 베팅 내역이 아닌 사이트 추천 성적입니다.
          </div>
        </section>

        <div className={styles.twoCol}>
          <section className={styles.card}>
            <h3>시장별 성적</h3>
              {/* STATS_VISUAL_V1 */}
              <div className={styles.visualList}>
                {backtest.markets.map((row) => {
                  const hit = row.hitRate ?? 0;
                  const ret = row.returnRate;

                  return (
                    <div className={styles.visualRow} key={`market-chart-${row.name}`}>
                      <div className={styles.visualMeta}>
                        <strong>{row.name}</strong>
                        <span>
                          {row.count}픽 · 적중률 {row.hitRate === null ? "-" : `${row.hitRate.toFixed(1)}%`}
                        </span>
                        <b
                          className={
                            ret !== null && ret >= 0
                              ? styles.returnPositive
                              : styles.returnNegative
                          }
                        >
                          수익률 {ret === null ? "-" : `${ret > 0 ? "+" : ""}${ret.toFixed(1)}%`}
                        </b>
                      </div>

                      <div className={styles.progressTrack}>
                        <div
                          className={styles.progressFill}
                          style={{ width: `${Math.max(2, Math.min(100, hit))}%` }}
                        />
                      </div>
                    </div>
                  );
                })}
              </div>
            <div className={styles.table}>
              <div className={styles.tableHead}>
                <span>시장</span>
                <span>픽</span>
                <span>적중률</span>
                <span>수익률</span>
              </div>

              {(backtest?.markets || []).map((row) => (
                <div className={styles.tableRow} key={row.name}>
                  <b>{row.name}</b>
                  <span>{row.count}</span>
                  <strong>{percent(row.hitRate)}</strong>
                  <strong className={rateClass(row.returnRate)}>
                    {percent(row.returnRate)}
                  </strong>
                </div>
              ))}
            </div>
          </section>

          <section className={styles.card}>
            <h3>등급별 성적</h3>
            <div className={styles.gradeGrid}>
              {(backtest?.grades || []).map((row) => (
                <div className={styles.gradeBox} key={row.name}>
                  <span className={`${styles.grade} ${gradeClass(row.name)}`}>
                    {row.name}
                  </span>
                  <strong>{percent(row.hitRate)}</strong>
                  <small>
                    {row.count}픽 · {row.wins}승 {row.losses}패
                  </small>
                </div>
              ))}
            </div>
          </section>
        </div>

        <div className={styles.twoCol}>
          <section className={styles.card}>
            <h3>예측확률 구간별 실제 적중률</h3>
              <div className={styles.visualList}>
                {backtest.buckets.map((row) => {
                  const hit = row.hitRate ?? 0;

                  return (
                    <div className={styles.visualRow} key={`bucket-chart-${row.name}`}>
                      <div className={styles.visualMeta}>
                        <strong>{row.name}</strong>
                        <span>{row.count}픽</span>
                        <b>{row.hitRate === null ? "-" : `실제 ${row.hitRate.toFixed(1)}%`}</b>
                      </div>

                      <div className={styles.progressTrack}>
                        <div
                          className={styles.progressFill}
                          style={{ width: `${Math.max(2, Math.min(100, hit))}%` }}
                        />
                      </div>
                    </div>
                  );
                })}
              </div>
            <div className={styles.table}>
              <div className={styles.tableHead}>
                <span>예측 구간</span>
                <span>픽</span>
                <span>실제 적중률</span>
                <span>수익률</span>
              </div>

              {(backtest?.buckets || []).map((row) => (
                <div className={styles.tableRow} key={row.name}>
                  <b>{row.name}</b>
                  <span>{row.count}</span>
                  <strong>{percent(row.hitRate)}</strong>
                  <strong className={rateClass(row.returnRate)}>
                    {percent(row.returnRate)}
                  </strong>
                </div>
              ))}
            </div>
          </section>

          <section className={styles.card}>
            <h3>월별 추천 성적</h3>
              <div className={styles.monthChart}>
                <div className={styles.monthGuide}>
                  <span>50%</span>
                </div>

                {backtest.monthly.map((row) => {
                  const hit = row.hitRate ?? 0;
                  const ret = row.returnRate;

                  return (
                    <div className={styles.monthCol} key={`month-chart-${row.name}`}>
                      <div className={styles.monthHit}>
                        {row.hitRate === null ? "-" : `${row.hitRate.toFixed(1)}%`}
                      </div>

                      <div className={styles.monthBarArea}>
                        <div
                          className={styles.monthBar}
                          style={{ height: `${Math.max(4, Math.min(100, hit))}%` }}
                        />
                      </div>

                      <strong className={styles.monthName}>
                        {row.name.slice(5)}
                      </strong>

                      <span
                        className={
                          ret !== null && ret >= 0
                            ? styles.monthReturnPositive
                            : styles.monthReturnNegative
                        }
                      >
                        {ret === null ? "-" : `${ret > 0 ? "+" : ""}${ret.toFixed(1)}%`}
                      </span>
                    </div>
                  );
                })}
              </div>
            <div className={styles.table}>
              <div className={styles.tableHead}>
                <span>월</span>
                <span>추천</span>
                <span>적중률</span>
                <span>수익률</span>
              </div>

              {(backtest?.monthly || []).map((row) => (
                <div className={styles.tableRow} key={row.name}>
                  <b>{row.name}</b>
                  <span>{row.count}</span>
                  <strong>{percent(row.hitRate)}</strong>
                  <strong className={rateClass(row.returnRate)}>
                    {percent(row.returnRate)}
                  </strong>
                </div>
              ))}
            </div>
          </section>
        </div>
      </main>
    </div>
  );
}
