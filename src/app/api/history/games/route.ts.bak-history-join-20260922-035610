import { NextResponse } from "next/server";
import { promises as fs } from "fs";
import path from "path";

export const dynamic = "force-dynamic";

async function readJson(name: string, fallback: any) {
  try {
    return JSON.parse(await fs.readFile(path.join(process.cwd(), "data", name), "utf8"));
  } catch {
    return fallback;
  }
}

function text(v: any) {
  return String(v ?? "").trim();
}

function num(v: any): number | null {
  if (v === null || v === undefined || v === "") return null;
  const n = Number(v);
  return Number.isFinite(n) ? n : null;
}

function gameKey(date: any, gameId: any) {
  return `${text(date)}|${text(gameId)}`;
}

export async function GET(request: Request) {
  const url = new URL(request.url);
  const year = text(url.searchParams.get("year") || "2026");
  const month = text(url.searchParams.get("month"));
  const gameId = text(url.searchParams.get("gameId"));

  const [betman, predictions, oddsHistory, lineups] = await Promise.all([
    readJson("betman-kbo-history-2026.json", { games: [] }),
    readJson("kbo-live-predictions.json", { predictions: [] }),
    readJson("kbo-odds-history.json", { snapshots: [] }),
    readJson("kbo-historical-lineup-stats-2026.json", { snapshots: [] }),
  ]);

  const betmanGames = Array.isArray(betman?.games) ? betman.games : [];
  const predictionRows = Array.isArray(predictions?.predictions) ? predictions.predictions : [];
  const oddsRows = Array.isArray(oddsHistory?.snapshots) ? oddsHistory.snapshots : [];
  const lineupRows = Array.isArray(lineups?.snapshots) ? lineups.snapshots : [];

  const predictionMap = new Map<string, any[]>();
  for (const row of predictionRows) {
    const key = gameKey(row?.date, row?.gameId);
    if (!predictionMap.has(key)) predictionMap.set(key, []);
    predictionMap.get(key)!.push(row);
  }

  const oddsMap = new Map<string, any[]>();
  for (const row of oddsRows) {
    const key = gameKey(row?.date, row?.gameId);
    if (!oddsMap.has(key)) oddsMap.set(key, []);
    oddsMap.get(key)!.push(row);
  }

  const lineupMap = new Map<string, any>();
  for (const row of lineupRows) {
    const key = gameKey(row?.date, row?.gameId);
    const prev = lineupMap.get(key);
    if (!prev || (!prev?.confirmed && row?.confirmed)) lineupMap.set(key, row);
  }

  const games = betmanGames
    .filter((g: any) => {
      const date = text(g?.date);
      if (!date.startsWith(`${year}-`)) return false;
      if (month && !date.startsWith(`${year}-${month.padStart(2, "0")}-`)) return false;
      if (gameId && text(g?.id) !== gameId) return false;
      return g?.actualScore != null && !g?.canceled;
    })
    .map((g: any) => {
      const date = text(g?.date);
      const id = text(g?.id);
      const key = gameKey(date, id);

      const frozen = (predictionMap.get(key) || [])
        .filter((p: any) => ["ML", "HANDICAP", "TOTAL"].includes(text(p?.market)))
        .sort((a: any, b: any) => text(a?.capturedAt).localeCompare(text(b?.capturedAt)));

      const latestByMarket = new Map<string, any>();
      for (const p of frozen) latestByMarket.set(text(p?.market), p);

      const gameOdds = (oddsMap.get(key) || [])
        .slice()
        .sort((a: any, b: any) => text(a?.capturedAt).localeCompare(text(b?.capturedAt)));

      const lastOdds = gameOdds.length ? gameOdds[gameOdds.length - 1] : null;
      const lineup = lineupMap.get(key) || null;

      const score = g?.actualScore;
      let awayScore: number | null = null;
      let homeScore: number | null = null;

      if (Array.isArray(score) && score.length >= 2) {
        awayScore = num(score[0]);
        homeScore = num(score[1]);
      } else if (score && typeof score === "object") {
        awayScore = num(score.away ?? score.awayScore);
        homeScore = num(score.home ?? score.homeScore);
      } else if (typeof score === "string") {
        const m = score.match(/(\d+)\D+(\d+)/);
        if (m) {
          awayScore = num(m[1]);
          homeScore = num(m[2]);
        }
      }

      const picks = Array.from(latestByMarket.values()).map((p: any) => ({
        market: text(p?.market),
        label: text(p?.label),
        grade: text(p?.grade),
        confidence: num(p?.confidence),
        ev: num(p?.ev),
        odds: num(p?.odds),
        result: text(p?.result) || null,
        capturedAt: text(p?.capturedAt) || null,
        settledAt: text(p?.settledAt) || null,
      }));

      return {
        gameId: id,
        date,
        commenceTime: g?.commenceTime ?? null,
        stadium: g?.stadium ?? null,
        awayTeamName: text(g?.awayTeam),
        homeTeamName: text(g?.homeTeam),
        awayScore,
        homeScore,
        finalScoreRaw: g?.actualScore ?? null,
        ai: {
          frozen: picks.length > 0,
          picks,
        },
        betman: lastOdds ? {
          capturedAt: lastOdds.capturedAt ?? null,
          awayMl: lastOdds.awayMl ?? null,
          homeMl: lastOdds.homeMl ?? null,
          awayHandicapLine: lastOdds.awayHandicapLine ?? null,
          homeHandicapLine: lastOdds.homeHandicapLine ?? null,
          awayHandicap: lastOdds.awayHandicap ?? null,
          homeHandicap: lastOdds.homeHandicap ?? null,
          totalLine: lastOdds.totalLine ?? null,
          overOdds: lastOdds.overOdds ?? null,
          underOdds: lastOdds.underOdds ?? null,
          source: lastOdds.source ?? null,
        } : null,
        lineup: lineup ? {
          confirmed: !!lineup.confirmed,
          away: lineup.away ?? null,
          home: lineup.home ?? null,
          lineupEdge: lineup.lineupEdge ?? null,
        } : null,
        snapshotOnly: true,
      };
    })
    .sort((a: any, b: any) => b.date.localeCompare(a.date) || b.gameId.localeCompare(a.gameId));

  return NextResponse.json({
    ok: true,
    source: "STORED_PREGAME_SNAPSHOTS_ONLY",
    recalculated: false,
    year,
    month: month || null,
    count: games.length,
    games,
  }, {
    headers: {
      "Cache-Control": "no-store, no-cache, must-revalidate",
    },
  });
}
