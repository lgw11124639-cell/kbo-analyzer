import { NextRequest, NextResponse } from "next/server";
import * as cheerio from "cheerio";

export const dynamic = "force-dynamic";

const KBO_BASE =
  "https://www.koreabaseball.com";

function numberOrNull(
  value: string | undefined
) {
  if (!value) return null;

  const cleaned =
    value
      .replace(/,/g, "")
      .trim();

  if (
    !cleaned ||
    cleaned === "-"
  ) {
    return null;
  }

  const n =
    Number(cleaned);

  return Number.isFinite(n)
    ? n
    : null;
}


export async function GET(
  request: NextRequest
) {
  const playerId =
    request.nextUrl.searchParams.get(
      "playerId"
    );

  if (!playerId) {
    return NextResponse.json(
      {
        error:
          "playerId가 필요합니다.",
      },
      {
        status: 400,
      }
    );
  }


  try {
    const url =
      `${KBO_BASE}/Record/Player/HitterDetail/Basic.aspx?playerId=${encodeURIComponent(playerId)}`;

    const response =
      await fetch(
        url,
        {
          cache:
            "no-store",

          headers: {
            "User-Agent":
              "Mozilla/5.0",
          },
        }
      );


    if (!response.ok) {
      throw new Error(
        `KBO 응답 오류 ${response.status}`
      );
    }


    const html =
      await response.text();

    const $ =
      cheerio.load(html);


    let recent:
      Record<
        string,
        string
      > | null =
      null;


    $("table").each(
      (_, table) => {
        if (recent) {
          return;
        }


        const headers =
          $(table)
            .find("thead th")
            .map(
              (_, th) =>
                $(th)
                  .text()
                  .replace(/\s+/g, "")
                  .trim()
            )
            .get();


        /*
          최근 10경기 테이블 판별

          시즌 기본기록 테이블과 구분하기 위해
          AVG + PA + AB + H + HR + BB + SO를
          동시에 가진 테이블만 대상으로 한다.
        */
        const required = [
          "AVG",
          "PA",
          "AB",
          "H",
          "HR",
          "BB",
          "SO",
        ];


        if (
          !required.every(
            (key) =>
              headers.includes(key)
          )
        ) {
          return;
        }


        $(table)
          .find("tbody tr")
          .each(
            (_, tr) => {
              if (recent) {
                return;
              }


              const cells =
                $(tr)
                  .find("th,td")
                  .map(
                    (_, cell) =>
                      $(cell)
                        .text()
                        .replace(/\s+/g, " ")
                        .trim()
                  )
                  .get();


              if (
                cells.length === 0
              ) {
                return;
              }


              /*
                최근 10경기 첫 번째 행은 합계
              */
              if (
                cells[0] !== "합계"
              ) {
                return;
              }


              const values =
                cells.slice(1);


              const row:
                Record<
                  string,
                  string
                > = {};


              headers.forEach(
                (header, index) => {
                  row[header] =
                    values[index] ??
                    "";
                }
              );


              recent =
                row;
            }
          );
      }
    );


    if (!recent) {
      return NextResponse.json({
        playerId:
          Number(playerId),

        found:
          false,

        recent10:
          null,
      });
    }


    return NextResponse.json({
      playerId:
        Number(playerId),

      found:
        true,

      recent10: {
        avg:
          numberOrNull(
            recent["AVG"]
          ),

        pa:
          numberOrNull(
            recent["PA"]
          ),

        ab:
          numberOrNull(
            recent["AB"]
          ),

        runs:
          numberOrNull(
            recent["R"]
          ),

        hits:
          numberOrNull(
            recent["H"]
          ),

        doubles:
          numberOrNull(
            recent["2B"]
          ),

        triples:
          numberOrNull(
            recent["3B"]
          ),

        hr:
          numberOrNull(
            recent["HR"]
          ),

        rbi:
          numberOrNull(
            recent["RBI"]
          ),

        sb:
          numberOrNull(
            recent["SB"]
          ),

        cs:
          numberOrNull(
            recent["CS"]
          ),

        bb:
          numberOrNull(
            recent["BB"]
          ),

        hbp:
          numberOrNull(
            recent["HBP"]
          ),

        so:
          numberOrNull(
            recent["SO"]
          ),

        gdp:
          numberOrNull(
            recent["GDP"]
          ),
      },
    });

  } catch (error) {
    return NextResponse.json(
      {
        error:
          error instanceof Error
            ? error.message
            : "최근 타격 기록 조회 실패",
      },
      {
        status: 500,
      }
    );
  }
}
