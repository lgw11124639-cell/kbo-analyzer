import { NextResponse } from "next/server";

export const dynamic = "force-dynamic";

type RawGame = {
  G_ID?: string;
  G_DT?: string;

  HOME_NM?: string;
  AWAY_NM?: string;

  B_SCORE_CN?: string | number | null;
  T_SCORE_CN?: string | number | null;

  GAME_STATE_SC?: string;
  CANCEL_SC_ID?: string;
};

type TeamGame = {
  gameId: string;
  date: string;

  opponent: string;
  homeAway: "HOME" | "AWAY";

  runs: number;
  runsAllowed: number;

  result: "W" | "L" | "D";
};

function repairUtf8(
  value: string | null | undefined
) {
  if (!value) return "";

  /*
    KBO 응답 일부가
    UTF-8 bytes -> latin1 문자열처럼
    들어오는 경우 복구한다.

    정상 한글이면 그대로 둔다.
  */

  if (
    !/[ÃÂëíìê]/.test(value)
  ) {
    return value;
  }

  try {
    return decodeURIComponent(
      Array.from(value)
        .map((char) => {
          const code =
            char.charCodeAt(0);

          if (code > 255) {
            return char;
          }

          return (
            "%" +
            code
              .toString(16)
              .padStart(2, "0")
          );
        })
        .join("")
    );
  } catch {
    return value;
  }
}

function normalizeTeamName(
  value: string | null | undefined
) {
  return repairUtf8(value)
    .replace(/\s+/g, "")
    .replace("두산베어스", "두산")
    .replace("LG트윈스", "LG")
    .replace("삼성라이온즈", "삼성")
    .replace("KIA타이거즈", "KIA")
    .replace("한화이글스", "한화")
    .replace("롯데자이언츠", "롯데")
    .replace("KT위즈", "KT")
    .replace("NC다이노스", "NC")
    .replace("SSG랜더스", "SSG")
    .replace("키움히어로즈", "키움");
}

function ymd(date: Date) {
  const yyyy =
    date.getFullYear();

  const mm =
    String(
      date.getMonth() + 1
    ).padStart(2, "0");

  const dd =
    String(
      date.getDate()
    ).padStart(2, "0");

  return `${yyyy}${mm}${dd}`;
}

function isoDate(date: Date) {
  const yyyy =
    date.getFullYear();

  const mm =
    String(
      date.getMonth() + 1
    ).padStart(2, "0");

  const dd =
    String(
      date.getDate()
    ).padStart(2, "0");

  return `${yyyy}-${mm}-${dd}`;
}

function numberValue(
  value:
    | string
    | number
    | null
    | undefined
) {
  if (
    value === null ||
    value === undefined ||
    value === ""
  ) {
    return null;
  }

  const n =
    Number(value);

  return Number.isFinite(n)
    ? n
    : null;
}

async function fetchGames(
  date: Date
): Promise<RawGame[]> {
  const response =
    await fetch(
      "https://www.koreabaseball.com/ws/Main.asmx/GetKboGameList",
      {
        method: "POST",

        headers: {
          "Content-Type":
            "application/json; charset=UTF-8",

          "User-Agent":
            "Mozilla/5.0 (Windows NT 10.0; Win64; x64)",

          Referer:
            "https://www.koreabaseball.com/",
        },

        body:
          JSON.stringify({
            leId: "1",
            srId: "0,9,6",
            date: ymd(date),
          }),

        cache: "no-store",
      }
    );

  if (!response.ok) {
    return [];
  }

  let text =
    await response.text();

  const htmlIndex =
    Math.min(
      ...[
        text.indexOf("<!DOCTYPE"),
        text.indexOf("<html"),
      ].filter(
        (index) =>
          index >= 0
      )
    );

  if (
    Number.isFinite(htmlIndex) &&
    htmlIndex >= 0
  ) {
    text =
      text.slice(
        0,
        htmlIndex
      );
  }

  try {
    const json =
      JSON.parse(text);

    return Array.isArray(json?.game)
      ? json.game
      : [];
  } catch {
    return [];
  }
}

export async function GET(
  request: Request
) {
  const url =
    new URL(request.url);

  const teamParam =
    url.searchParams.get("team");

  const dateParam =
    url.searchParams.get("date");

  if (!teamParam) {
    return NextResponse.json(
      {
        error:
          "team 파라미터가 필요합니다.",
      },
      {
        status: 400,
      }
    );
  }

  const team =
    normalizeTeamName(
      teamParam
    );

  const baseDate =
    dateParam
      ? new Date(
          `${dateParam}T12:00:00`
        )
      : new Date();

  if (
    Number.isNaN(
      baseDate.getTime()
    )
  ) {
    return NextResponse.json(
      {
        error:
          "date 형식이 잘못되었습니다.",
      },
      {
        status: 400,
      }
    );
  }

  const recentGames:
    TeamGame[] = [];

  /*
    SCORE MODEL V0.8

    예측 당일 경기는 절대 포함하지 않고
    D-1까지 시즌 데이터를 수집한다.

    220일이면 2026 KBO 정규시즌 전체를
    충분히 포함한다.

    기존 avgRuns / avgRunsAllowed는
    하위 호환을 위해 최근 10경기 기준 유지.
  */

  let leagueCompletedGames = 0;
  let leagueTotalRuns = 0;

  for (
    let dayOffset = 1;
    dayOffset <= 220;
    dayOffset++
  ) {
    const date =
      new Date(baseDate);

    date.setDate(
      date.getDate() -
        dayOffset
    );

    const games =
      await fetchGames(date);

    /*
      V0.8 dynamic league environment.

      해당 날짜 전체 KBO 완료경기를 사용한다.
      예측일 당일은 조회하지 않으므로 D-1 safe.
    */
    for (const leagueGame of games) {
      const leagueHomeScore =
        numberValue(
          leagueGame.B_SCORE_CN
        );

      const leagueAwayScore =
        numberValue(
          leagueGame.T_SCORE_CN
        );

      if (
        leagueHomeScore === null ||
        leagueAwayScore === null
      ) {
        continue;
      }

      if (
        leagueGame.CANCEL_SC_ID &&
        leagueGame.CANCEL_SC_ID !== "0"
      ) {
        continue;
      }

      leagueCompletedGames += 1;

      leagueTotalRuns +=
        leagueHomeScore +
        leagueAwayScore;
    }

    for (
      const game of games
    ) {
      const home =
        normalizeTeamName(
          game.HOME_NM
        );

      const away =
        normalizeTeamName(
          game.AWAY_NM
        );

      if (
        home !== team &&
        away !== team
      ) {
        continue;
      }

      const homeScore =
        numberValue(
          game.B_SCORE_CN
        );

      const awayScore =
        numberValue(
          game.T_SCORE_CN
        );

      /*
        점수가 없으면
        경기 전/취소/미완료로 간주
      */

      if (
        homeScore === null ||
        awayScore === null
      ) {
        continue;
      }

      if (
        game.CANCEL_SC_ID &&
        game.CANCEL_SC_ID !== "0"
      ) {
        continue;
      }

      const isHome =
        home === team;

      const runs =
        isHome
          ? homeScore
          : awayScore;

      const runsAllowed =
        isHome
          ? awayScore
          : homeScore;

      const result:
        "W" | "L" | "D" =
          runs > runsAllowed
            ? "W"
            : runs < runsAllowed
              ? "L"
              : "D";

      recentGames.push({
        gameId:
          game.G_ID ?? "",

        date:
          isoDate(date),

        opponent:
          isHome
            ? away
            : home,

        homeAway:
          isHome
            ? "HOME"
            : "AWAY",

        runs,
        runsAllowed,
        result,
      });
    }
  }

  /*
    ----------------------------------------------------------
    SCORE MODEL V0.8 TEAM FORM
    ----------------------------------------------------------
  */

  const seasonGames =
    recentGames;

  const recent5Games =
    seasonGames.slice(0, 5);

  const recent10Games =
    seasonGames.slice(0, 10);

  const recent20Games =
    seasonGames.slice(0, 20);

  const homeGames =
    seasonGames.filter(
      game =>
        game.homeAway === "HOME"
    );

  const awayGames =
    seasonGames.filter(
      game =>
        game.homeAway === "AWAY"
    );

  function average(
    rows: TeamGame[],
    field:
      | "runs"
      | "runsAllowed"
  ): number | null {
    if (!rows.length) {
      return null;
    }

    return (
      rows.reduce(
        (sum, row) =>
          sum + row[field],
        0
      ) / rows.length
    );
  }

  function formSummary(
    rows: TeamGame[]
  ) {
    if (!rows.length) {
      return {
        games: 0,
        avgRuns: null,
        avgRunsAllowed: null,
        winRate: null,
      };
    }

    const rowWins =
      rows.filter(
        row =>
          row.result === "W"
      ).length;

    return {
      games:
        rows.length,

      avgRuns:
        average(
          rows,
          "runs"
        ),

      avgRunsAllowed:
        average(
          rows,
          "runsAllowed"
        ),

      winRate:
        rowWins /
        rows.length,
    };
  }

  const lastGame =
    seasonGames[0];

  const daysSinceLastGame =
    lastGame
      ? Math.max(
          0,
          Math.round(
            (
              baseDate.getTime() -
              new Date(
                `${lastGame.date}T12:00:00`
              ).getTime()
            ) /
            86400000
          )
        )
      : null;

  /*
    경기 다음날이면
      daysSinceLastGame = 1
      restDays = 0
  */
  const restDays =
    daysSinceLastGame === null
      ? null
      : Math.max(
          0,
          daysSinceLastGame - 1
        );

  /*
    V0.3 / V0.8과 동일한 league prior.

    priorGames = 80
    priorRuns  = 4.50

    completedGames는 실제 경기 수이므로
    team-games 분모는 * 2.
  */
  const leagueRunsPerTeamD1 =
    (
      4.50 * 80 +
      leagueTotalRuns
    ) /
    (
      80 +
      leagueCompletedGames * 2
    );

  const seasonAvgRuns =
    average(
      seasonGames,
      "runs"
    );

  const seasonAvgRunsAllowed =
    average(
      seasonGames,
      "runsAllowed"
    );

  const recent5 =
    formSummary(
      recent5Games
    );

  const recent10 =
    formSummary(
      recent10Games
    );

  const recent20 =
    formSummary(
      recent20Games
    );

  const homeAvgRuns =
    average(
      homeGames,
      "runs"
    );

  const homeAvgRunsAllowed =
    average(
      homeGames,
      "runsAllowed"
    );

  const awayAvgRuns =
    average(
      awayGames,
      "runs"
    );

  const awayAvgRunsAllowed =
    average(
      awayGames,
      "runsAllowed"
    );

  /*
    기존 화면/로직 호환용.
    avgRuns / avgRunsAllowed는 최근10 유지.
  */
  const games =
    recent10Games;

  const wins =
    games.filter(
      (game) =>
        game.result === "W"
    ).length;

  const losses =
    games.filter(
      (game) =>
        game.result === "L"
    ).length;

  const draws =
    games.filter(
      (game) =>
        game.result === "D"
    ).length;

  const totalRuns =
    games.reduce(
      (sum, game) =>
        sum + game.runs,
      0
    );

  const totalRunsAllowed =
    games.reduce(
      (sum, game) =>
        sum +
        game.runsAllowed,
      0
    );

  const count =
    games.length;

  return NextResponse.json({
    fetchedAt:
      new Date().toISOString(),

    team,

    sampleSize:
      count,

    wins,
    losses,
    draws,

    winPct:
      count > 0
        ? Number(
            (
              wins /
              count
            ).toFixed(3)
          )
        : null,

    avgRuns:
      count > 0
        ? Number(
            (
              totalRuns /
              count
            ).toFixed(2)
          )
        : null,

    avgRunsAllowed:
      count > 0
        ? Number(
            (
              totalRunsAllowed /
              count
            ).toFixed(2)
          )
        : null,

    runDifferential:
      totalRuns -
      totalRunsAllowed,

    /*
      SCORE MODEL V0.8 inputs
    */
    seasonGames:
      seasonGames.length,

    seasonAvgRuns,

    seasonAvgRunsAllowed,

    recent5,

    recent10,

    recent20,

    homeGames:
      homeGames.length,

    homeAvgRuns,

    homeAvgRunsAllowed,

    awayGames:
      awayGames.length,

    awayAvgRuns,

    awayAvgRunsAllowed,

    daysSinceLastGame,

    restDays,

    leagueRunsPerTeamD1,

    games,
  });
}

