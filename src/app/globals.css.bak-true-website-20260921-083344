  border-radius: 13px;
  background: #f8fbff;
}

.gameCardPredictionHead {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 10px;
}

.gameCardPredictionHead > div {
  min-width: 0;
  display: grid;
  gap: 3px;
}

.gameCardPredictionHead b {
  font-size: 13px;
  color: #172033;
}

.gameCardPredictionHead small {
  font-size: 10px;
  color: #7b8799;
}

.gameCardPredictionHead > span {
  flex: 0 0 auto;
  padding: 4px 8px;
  border-radius: 999px;
  background: #e9f1ff;
  color: #2563eb;
  font-size: 10px;
  font-weight: 800;
}

.gameCardPredictionMarkets {
  display: grid;
  gap: 9px;
}

.gameCardPredictionMarket {
  display: grid;
  gap: 6px;
}

.gameCardPredictionMarketTitle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.gameCardPredictionMarketTitle > b {
  font-size: 11px;
  color: #475569;
}

.gameCardPredictionMarketTitle > small {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 9px;
  color: #64748b;
}

.gameCardPredictionOptions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 6px;
}

.gameCard .gameCardPredictionOption {
  width: 100%;
  min-width: 0;
  min-height: 72px;
  padding: 8px 9px;
  border: 1px solid #dce5ef;
  border-radius: 10px;
  background: #fff;
  color: #172033;
  text-align: left;
  cursor: pointer;
  transition:
    border-color .15s ease,
    box-shadow .15s ease,
    background .15s ease,
    transform .15s ease;
}

.gameCard .gameCardPredictionOption:hover {
  border-color: #9bbcf5;
  box-shadow: 0 4px 12px rgba(37, 99, 235, .08);
  transform: translateY(-1px);
}

.gameCard .gameCardPredictionOption.isPreferred {
  border-color: #b9cdf6;
  background: #f7faff;
}

.gameCard .gameCardPredictionOption.isSelected {
  border: 2px solid #2563eb;
  background: #eef5ff;
  box-shadow: 0 0 0 2px rgba(37, 99, 235, .08);
}

.gameCardPredictionOptionTop {
  display: grid;
  gap: 5px;
}

.gameCardPredictionOptionTop > strong {
  min-width: 0;
  font-size: 11px;
  line-height: 1.3;
  overflow-wrap: anywhere;
}

.gameCardPredictionBadges {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  align-items: center;
}

.gameCardPredictionBadges span,
.gameCardPredictionBadges em {
  padding: 2px 5px;
  border-radius: 999px;
  font-size: 8px;
  font-style: normal;
  font-weight: 800;
  line-height: 1.4;
}

.gameCardGradeBadge {
  background: #eef2f7;
  color: #475569;
}

.gameCardGradeBadge.grade-A {
  background: #dcfce7;
  color: #15803d;
}

.gameCardGradeBadge.grade-B {
  background: #dbeafe;
  color: #1d4ed8;
}

.gameCardGradeBadge.grade-C {
  background: #f1f5f9;
  color: #64748b;
}

.gameCardFinalBadge {
  background: #fff1dc;
  color: #b45309;
}

.gameCardTopBadge {
  background: #fef3c7;
  color: #92400e;
}

.gameCardPreferredBadge {
  background: #ede9fe;
  color: #6d28d9;
}

.gameCardPredictionMeta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 5px 8px;
  margin-top: 8px;
  font-size: 9px;
  color: #64748b;
}

.gameCardPredictionMeta span b {
  color: #334155;
}

.gameCardPickAction {
  margin-left: auto;
  color: #2563eb;
  font-size: 9px;
  font-weight: 900;
}

.gameCardPickAction.selected {
  color: #1d4ed8;
}

