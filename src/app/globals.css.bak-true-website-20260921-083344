}

.myComboUnifiedGrid
  .bankrollSavedMoney {
  margin-top: 7px;
  padding-top: 7px;
  border-top: 1px solid #e2e8f0;

  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  gap: 8px;

  text-align: left;
}


/* 배분 내부 실제 픽은 그대로 표시하되 조금 더 조밀하게 */
.myComboUnifiedGrid
  .mySavedPickList {
  display: flex;
  flex-direction: column;
  flex-wrap: nowrap;
  gap: 5px;
  margin-top: 7px;
}

.myComboUnifiedGrid
  .mySavedPick {
  width: 100%;
  justify-content: space-between;
  gap: 8px;
  padding: 5px 7px;
}

.myComboUnifiedGrid
  .mySavedPick small {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}


