  .bankrollSavedItems {
  display: flex;
  flex-direction: column;
  gap: 7px;
  margin-top: 10px;
}

.myComboUnifiedGrid
  .bankrollSavedItem {
  display: block;
  padding: 9px 10px;
  border-radius: 9px;
}

.myComboUnifiedGrid
