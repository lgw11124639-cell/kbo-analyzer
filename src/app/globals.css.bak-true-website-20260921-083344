/* =========================================================
   MY COMBOS - UNIFIED DAY CARD GRID
   배분조합 + 개별조합을 날짜별 같은 줄에 최대한 배치
   ========================================================= */

.myComboUnifiedGrid {
  display: grid;
  grid-template-columns:
    repeat(auto-fit, minmax(260px, 1fr));
  gap: 12px;
  align-items: stretch;
  margin-top: 14px;
}

/*
  기존 배분 / 개별 섹션 wrapper는 유지하되
  레이아웃상 존재하지 않는 것처럼 처리해서
  실제 카드들이 공용 grid의 직접 item처럼 배치되게 함
*/
.myComboUnifiedGrid > .myComboDayBlock {
  display: contents;
}

.myComboUnifiedGrid
  .myComboDayBlockHead {
  display: none;
}

.myComboUnifiedGrid
  .bankrollSavedList,
.myComboUnifiedGrid
  .manualSavedGrid {
  display: contents;
}


/* =========================================================
   공통 카드 크기 통일
   ========================================================= */

.myComboUnifiedGrid
  .bankrollSavedGroup,
.myComboUnifiedGrid
  .manualSavedCard {
  width: 100%;
  min-width: 0;
  height: 100%;
  margin: 0;
  padding: 13px;
  border-radius: 14px;
  box-sizing: border-box;

  display: flex;
  flex-direction: column;
}


/* 배분카드도 개별카드와 비슷한 밀도로 압축 */
