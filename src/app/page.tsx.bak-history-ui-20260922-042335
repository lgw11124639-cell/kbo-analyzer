      VENUE_DEFENSE    -0.10
      BULLPEN_FATIGUE  -0.30
      LINEUP_OPS       -0.30
      RECENT5_WINRATE  +0.30
      REST_DAYS        +0.30
      RECENT10_WINRATE +0.30

    V0.8 A
      LEAGUE_D1 residual correction
      OWN_SEASON_RUNS common-only
      marginFactor = 0.00

    V3.7 HANDICAP engine is NOT changed here.
    ============================================================
  */

  const clamp = (
    value: number,
    lo: number,
    hi: number
  ) =>
    Math.max(
      lo,
      Math.min(
        hi,
        value
      )
    );

  const num = (
    value:
      | number
      | null
      | undefined
  ): number | null => {
    if (
      value === null ||
      value === undefined
    ) {
      return null;
    }

    const n =
      Number(value);

    return Number.isFinite(n)
      ? n
      : null;
  };


  // ==========================================================
  // REQUIRED BASE INPUTS
  // ==========================================================

  const ar =
    num(
      awayForm?.avgRuns
    );

  const ara =
    num(
      awayForm?.avgRunsAllowed
    );

  const hr =
    num(
      homeForm?.avgRuns
    );

  const hra =
    num(
      homeForm?.avgRunsAllowed
    );

  const awayLeague =
    num(
      awayForm
        ?.leagueRunsPerTeamD1
    );

  const homeLeague =
    num(
      homeForm
        ?.leagueRunsPerTeamD1
    );

  /*
    같은 날짜의 리그 환경이므로
    정상 상태에서는 양쪽 값이 동일하다.

    한쪽 API가 비어 있어도
    다른 쪽 값으로 복구한다.
  */
  const league =
    awayLeague ??
    homeLeague;

  if (
    ar === null ||
    ara === null ||
    hr === null ||
    hra === null ||
    league === null
  ) {
    return null;
  }


  // ==========================================================
  // V0.3 BASE
  // P80 / W0.40 / STARTER
  // ==========================================================

  const awayTeamExpectation =
    (
      ar +
      hra
    ) / 2;

  const homeTeamExpectation =
    (
      hr +
      ara
    ) / 2;


  let away =
    league * 0.60 +
    awayTeamExpectation *
      0.40;

  let home =
    league * 0.60 +
    homeTeamExpectation *
      0.40;


  const blendedEra = (
    stats:
      PitcherStats |
      undefined
  ): number | null => {
    if (!stats) {
      return null;
    }

    const season =
      num(
        stats.era
      );

    const recent =
      num(
        stats.recent5
          ?.era
      );

    if (
      season === null &&
      recent === null
    ) {
      return null;
    }

    if (
      season !== null &&
      recent !== null
    ) {
      return (
        season * 0.60 +
        recent * 0.40
      );
    }

    return (
      season ??
      recent
    );
  };


  const homeStarterEra =
    blendedEra(
      homeStarter
    );

  const awayStarterEra =
    blendedEra(
      awayStarter
    );


  /*
    ERA neutral point도
    당일 D-1 dynamic league.
  */
  if (
    homeStarterEra !== null
  ) {
    away +=
      clamp(
        (
          homeStarterEra -
          league
        ) * 0.09,
        -0.40,
        0.40
      );
  }

  if (
    awayStarterEra !== null
  ) {
    home +=
      clamp(
        (
          awayStarterEra -
          league
        ) * 0.09,
        -0.40,
        0.40
      );
  }


  /*
    V0.3 base clamp
  */
  away =
    clamp(
      away,
      2.25,
      7.25
    );

  home =
    clamp(
      home,
      2.25,
      7.25
    );


  // ==========================================================
  // V0.3 CHAMPION
  // ML NO-VIG MARKET MARGIN
  //
  // FORM = 0
  // MARKET RUNS = 4.50
  //
  // 총점은 유지하고 점수차만 이동.
  // ==========================================================

  const awayMl =
    num(
      odds?.awayMl
    );

  const homeMl =
    num(
      odds?.homeMl
    );


  if (
    awayMl !== null &&
    homeMl !== null &&
    awayMl > 1 &&
    homeMl > 1
  ) {
    const awayImplied =
      1 / awayMl;

    const homeImplied =
      1 / homeMl;

    const impliedSum =
      awayImplied +
      homeImplied;

    if (
      impliedSum > 0
    ) {
      const awayFair =
        awayImplied /
        impliedSum;

      const marketEdge =
        (
          awayFair -
          0.50
        ) * 2;

      const marketShift =
        marketEdge *
        4.50;

      away =
        clamp(
          away +
            marketShift / 2,
          1.75,
          7.75
        );

      home =
        clamp(
          home -
            marketShift / 2,
          1.75,
          7.75
        );
    }
  }


  // ==========================================================
  // ROUND2
  //
  // All corrections are calculated against champion.
  // Then corrections are stacked ONCE.
  // ==========================================================

  let r2AwayDelta = 0;
  let r2HomeDelta = 0;


  const applyR2Pair = (
    awayValue:
      number |
      null |
      undefined,

    homeValue:
      number |
      null |
      undefined,

    coef: number
  ) => {
    const av =
      num(
        awayValue
      );

    const hv =
      num(
        homeValue
      );

    /*
      Original v07DirectPredictor:
      if either side is missing,
      this feature is skipped entirely.
    */
    if (
      av === null ||
      hv === null
    ) {
      return;
    }

    const aSignal =
      clamp(
        av -
          league,
        -4,
        4
      );

    const hSignal =
      clamp(
        hv -
          league,
        -4,
        4
      );

    r2AwayDelta +=
      aSignal *
      coef;

    r2HomeDelta +=
      hSignal *
      coef;
  };


  /*
    R5 DEFENSE +0.20
  */
  applyR2Pair(
    awayForm?.recent5
      ?.avgRunsAllowed,
    homeForm?.recent5
      ?.avgRunsAllowed,
    0.20
  );


  /*
    VENUE OFFENSE -0.20

    Away team -> away games
    Home team -> home games
  */
  applyR2Pair(
    awayForm
      ?.awayAvgRuns,
    homeForm
      ?.homeAvgRuns,
    -0.20
  );


  /*
    VENUE DEFENSE -0.10
  */
  applyR2Pair(
    awayForm
      ?.awayAvgRunsAllowed,
    homeForm
      ?.homeAvgRunsAllowed,
    -0.10
  );


  away =
    clamp(
      away +
        r2AwayDelta,
      1.50,
      8.00
    );

  home =
    clamp(
      home +
        r2HomeDelta,
      1.50,
      8.00
    );


  // ==========================================================
  // ROUND4 / ROUND5 FROZEN BASE
  //
  // BULLPEN_FATIGUE -0.30
  // LINEUP_OPS      -0.30
  //
  // Applied sequentially.
  // ==========================================================

  const awayFatigue =
    num(
      awayBullpen
        ?.summary
        ?.fatigueIndex
    );

  const homeFatigue =
    num(
      homeBullpen
        ?.summary
        ?.fatigueIndex
    );


  if (
    awayFatigue !== null &&
    homeFatigue !== null
  ) {
    const aSignal =
      clamp(
        (
          awayFatigue -
          50
        ) * 0.02,
        -3,
        3
      );

    const hSignal =
      clamp(
        (
          homeFatigue -
          50
        ) * 0.02,
        -3,
        3
      );

    /*
      kind = opponent

      away bullpen -> home offense
      home bullpen -> away offense
    */
    home +=
      aSignal *
      -0.30;

    away +=
      hSignal *
      -0.30;

    away =
      clamp(
        away,
        1.50,
        8.00
      );

    home =
      clamp(
        home,
        1.50,
        8.00
      );
  }


  const awayOps =
    num(
      lineupMatchup
        ?.away
        ?.baseSummary
        ?.avgOps
    );

  const homeOps =
    num(
      lineupMatchup
        ?.home
        ?.baseSummary
        ?.avgOps
    );


  if (
    awayOps !== null &&
    homeOps !== null
  ) {
    const aSignal =
      clamp(
        (
          awayOps -
          0.700
        ) * 5.0,
        -3,
        3
      );

    const hSignal =
      clamp(
        (
          homeOps -
          0.700
        ) * 5.0,
        -3,
        3
      );

    away +=
      aSignal *
      -0.30;

    home +=
      hSignal *
      -0.30;

    away =
      clamp(
        away,
        1.50,
        8.00
      );

    home =
      clamp(
        home,
        1.50,
        8.00
      );
  }


  // ==========================================================
  // ROUND7
  //
  // Discovery-frozen centers:
  //
  // REST_DAYS
  //   0.5714285714285714
  //
  // RECENT5_WINRATE
  //   0.4915079365079364
  //
  // RECENT10_WINRATE
  //   0.49081443688586546
  // ==========================================================

  let r7Away =
    away;

  let r7Home =
    home;


  const applyR7Pair = (
    awayValue:
      number |
      null |
      undefined,

    homeValue:
      number |
      null |
      undefined,

    center: number,
    scale: number,
    coef: number
  ) => {
    const av =
      num(
        awayValue
      );

    const hv =
      num(
        homeValue
      );

    /*
      Original r7Predictor also requires
      both sides before applying feature.
    */
    if (
      av === null ||
      hv === null
    ) {
      return;
    }

    const aSignal =
      clamp(
        (
          av -
          center
        ) * scale,
        -3,
        3
      );

    const hSignal =
      clamp(
        (
          hv -
          center
        ) * scale,
        -3,
        3
      );

    r7Away +=
      aSignal *
      coef;

    r7Home +=
      hSignal *
      coef;
  };


  /*
    RECENT5 WINRATE +0.30
  */
  applyR7Pair(
    awayForm
      ?.recent5
      ?.winRate,
    homeForm
      ?.recent5
      ?.winRate,
    0.4915079365079364,
    1.0,
    0.30
  );


  /*
    REST DAYS +0.30
  */
  applyR7Pair(
    awayForm
      ?.restDays,
    homeForm
      ?.restDays,
    0.5714285714285714,
    0.20,
    0.30
  );


  /*
    RECENT10 WINRATE +0.30
  */
  applyR7Pair(
    awayForm
      ?.recent10
      ?.winRate,
    homeForm
      ?.recent10
      ?.winRate,
    0.49081443688586546,
    1.0,
    0.30
  );


  away =
    clamp(
      r7Away,
      1.50,
      8.00
    );

  home =
    clamp(
      r7Home,
      1.50,
      8.00
    );


  // ==========================================================
  // V0.8 CANDIDATE A
  //
  // LEAGUE_D1
  // Discovery-fitted:
  //
  // meanX =
  //   4.948761292129035
  //
  // beta =
  //   -3.284247801595127
  //
  // Applied independently to both teams.
  // ==========================================================

  const LEAGUE_MEAN =
    4.948761292129035;

  const LEAGUE_BETA =
    -3.284247801595127;


  const leagueCorrection = (
    feature:
      number |
      null
  ) => {
    if (
      feature === null
    ) {
      return 0;
    }

    return (
      LEAGUE_BETA *
      (
        feature -
        LEAGUE_MEAN
      )
    );
  };


  const awayLeagueCorrection =
    leagueCorrection(
      awayLeague
    );

  const homeLeagueCorrection =
    leagueCorrection(
      homeLeague
    );


  // ==========================================================
  // OWN_SEASON_RUNS
  //
  // Discovery-fitted after league correction.
  //
  // meanX =
  //   5.5353028724473905
  //
  // beta =
  //   0.17970426271874573
  //
  // Candidate A:
  //   COMMON COMPONENT ONLY
  //   marginFactor = 0.00
  // ==========================================================

  const SEASON_MEAN =
    5.5353028724473905;

  const SEASON_BETA =
    0.17970426271874573;


  const seasonCorrection = (
    feature:
      number |
      null
  ) => {
    if (
      feature === null
    ) {
      return 0;
    }

    return (
      SEASON_BETA *
      (
        feature -
        SEASON_MEAN
      )
    );
  };


  const awaySeasonCorrection =
    seasonCorrection(
      num(
        awayForm
          ?.seasonAvgRuns
      )
    );

  const homeSeasonCorrection =
    seasonCorrection(
      num(
        homeForm
          ?.seasonAvgRuns
      )
    );


  const seasonCommon =
    (
      awaySeasonCorrection +
      homeSeasonCorrection
    ) / 2;


  /*
    marginFactor = 0.00

    따라서 differential은
    의도적으로 적용하지 않는다.
  */

  away =
    away +
    awayLeagueCorrection +
    seasonCommon;

  home =
    home +
    homeLeagueCorrection +
    seasonCommon;


  /*
    SR29 / Candidate A와 동일하게
    V0.8 residual correction 뒤에는
    추가 score clamp를 넣지 않는다.
  */

  const total =
    away +
    home;


  return {
    awayRuns:
      Number(
        away.toFixed(2)
      ),

    homeRuns:
      Number(
        home.toFixed(2)
      ),

    total:
      Number(
        total.toFixed(2)
      ),
  };
}


function estimateProjectedTotal(
  awayForm: TeamForm | undefined,
  homeForm: TeamForm | undefined,
  awayStarter: PitcherStats | undefined,
  homeStarter: PitcherStats | undefined,
  awayBullpen: BullpenData | undefined,
  homeBullpen: BullpenData | undefined,
  lineupMatchup: LineupMatchupData | undefined
): number | null {
  return (
    estimateProjectedScores(
      awayForm,
      homeForm,
      awayStarter,
      homeStarter,
      awayBullpen,
      homeBullpen,
      lineupMatchup
    )?.total ?? null
  );
}



function stat3(
  value: number | null | undefined
) {
  return typeof value === "number"
    ? value.toFixed(3).replace(/^0/, "")
    : "-";
}


function lineupPlayerVerdict(
  player: LineupMatchupPlayer
) {
  const adjustment =
    player.adjustment ?? 0;

  if (adjustment >= 4) {
    return {
      label: "▲ 상대 선발 강한 우위",
      tone: "strongPlus",
    };
  }

  if (adjustment >= 1.5) {
    return {
      label: "▲ 상대 선발 상성 플러스",
      tone: "plus",
    };
  }

  if (adjustment <= -4) {
    return {
      label: "▼ 상대 선발 강한 열세",
      tone: "strongMinus",
    };
  }

  if (adjustment <= -1.5) {
    return {
      label: "▼ 상대 선발 상성 마이너스",
      tone: "minus",
    };
  }

  return {
    label: "― 상대 선발 상성 중립",
    tone: "neutral",
  };
}


function lineupTeamReasons(
  team:
    LineupMatchupData["away"] |
    LineupMatchupData["home"],
  opponent:
    LineupMatchupData["away"] |
    LineupMatchupData["home"]
) {
  const reasons: string[] = [];

  const teamScore =
    team.matchupSummary?.score;

  const oppScore =
    opponent.matchupSummary?.score;

  const teamOps =
    team.baseSummary?.avgOps;

  const oppOps =
    opponent.baseSummary?.avgOps;

  if (
    typeof teamScore === "number" &&
    typeof oppScore === "number"
  ) {
    const diff =
      teamScore - oppScore;

    if (diff >= 1) {
      reasons.push(
        `최종 타선 매치업 점수 +${diff.toFixed(1)} 우위`
      );
    } else if (diff <= -1) {
      reasons.push(
        `최종 타선 매치업 점수 ${diff.toFixed(1)} 열세`
      );
    } else {
      reasons.push(
        "최종 타선 매치업 점수는 대등"
      );
    }
  }

  if (
    typeof teamOps === "number" &&
    typeof oppOps === "number"
  ) {
    const opsDiff =
      teamOps - oppOps;

    if (opsDiff >= 0.025) {
      reasons.push(
        `선발 라인업 시즌 OPS 우위 (${stat3(teamOps)} vs ${stat3(oppOps)})`
      );
    } else if (opsDiff <= -0.025) {
      reasons.push(
        `선발 라인업 시즌 OPS 열세 (${stat3(teamOps)} vs ${stat3(oppOps)})`
      );
    }
  }

  const players =
    team.players ?? [];

  const plusCount =
    players.filter(
      (player) =>
        (player.adjustment ?? 0) >= 1.5
    ).length;

  const minusCount =
    players.filter(
      (player) =>
        (player.adjustment ?? 0) <= -1.5
    ).length;

  if (plusCount > 0) {
    reasons.push(
      `상대 선발 상성 플러스 타자 ${plusCount}명`
    );
  }

  if (minusCount > 0) {
    reasons.push(
      `상대 선발 상성 마이너스 타자 ${minusCount}명`
    );
  }

  const meaningfulBvp =
    players.filter(
      (player) =>
        (player.bvp?.pa ?? 0) >= 5
    ).length;

  if (meaningfulBvp > 0) {
    reasons.push(
      `상대 선발 BvP 5타석 이상 표본 ${meaningfulBvp}명 반영`
    );
  }

  return reasons;
}

