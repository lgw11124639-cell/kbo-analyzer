              index += 1;

              results.push(
                makeCandidate(
                  selected,
                  leg,
                  index
                )
              );

              return;
            }

            const needed =
              leg -
              selected.length;

            for (
              let i = start;
              i <=
              eligiblePicks.length -
                needed;
              i += 1
            ) {
              const pick =
                eligiblePicks[i];

              /*
