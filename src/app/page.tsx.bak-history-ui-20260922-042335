  const myComboMonthlyStats =
    useMemo(() => {
      let wins = 0;
      let losses = 0;

      let pickWins = 0;
      let pickLosses = 0;

      let realizedProfit = 0;
      let resolvedCount = 0;

      for (
        const item of
        myComboMonthItems
      ) {
        const settlement =
          myComboSettlements.get(
            item.id
          );

        if (!settlement) {
          continue;
        }

        /*
          픽 적중률은 실제 승/패가 결정된 픽만 계산.
          PENDING / LIVE / PUSH / VOID는 분모에서 제외.
        */
        for (
          const pickResult of
          settlement.pickResults
        ) {
          if (
            pickResult === "WIN"
          ) {
            pickWins += 1;
          } else if (
            pickResult === "LOSS"
          ) {
            pickLosses += 1;
          }
        }

        const stake =
          item.stakeAmount || 0;

        if (
          settlement.status ===
          "WIN"
        ) {
          wins += 1;
          resolvedCount += 1;

          realizedProfit +=
            Math.round(
              stake *
                settlement.effectiveOdds
            ) - stake;

        } else if (
          settlement.status ===
          "LOSS"
        ) {
          losses += 1;
          resolvedCount += 1;

          realizedProfit -=
            stake;

        } else if (
          settlement.status ===
          "VOID"
        ) {
          resolvedCount += 1;
        }
      }

      const decided =
        wins + losses;

      const pickDecided =
        pickWins + pickLosses;

      return {
        wins,
        losses,

        pickWins,
        pickLosses,
        pickDecided,

        resolvedCount,

        hitRate:
          decided > 0
            ? (
                wins /
                decided *
                100
              )
            : null,

        pickHitRate:
          pickDecided > 0
