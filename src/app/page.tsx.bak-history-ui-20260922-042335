  selectedPickKeys: string[];
  onTogglePick: (pick: Pick) => void;
  frozenPicks: Pick[];
}) {

  const awayStarterStats =
    game.startingPitchers.away?.id
      ? pitcherStats[
          game.startingPitchers.away.id
        ]
      : undefined;

  const homeStarterStats =
    game.startingPitchers.home?.id
      ? pitcherStats[
          game.startingPitchers.home.id
        ]
      : undefined;

  const awayStarterRating =
    starterRating(
      awayStarterStats
    );

  const homeStarterRating =
    starterRating(
      homeStarterStats
    );

  const starterEdge =
    starterEdgeText(
      awayStarterStats,
      homeStarterStats,
      game.startingPitchers.away?.name ??
        game.awayTeamName,
      game.startingPitchers.home?.name ??
        game.homeTeamName
    );

  const starterScoreEdge =
    awayStarterRating &&
    homeStarterRating
      ? awayStarterRating.score -
        homeStarterRating.score
      : 0;

  const awayTeamForm =
    teamForms[
      game.awayTeamName
    ];

  const homeTeamForm =
    teamForms[
      game.homeTeamName
    ];

  const awayTeamFormRating =
    teamFormRating(
      awayTeamForm
    );

  const homeTeamFormRating =
    teamFormRating(
      homeTeamForm
    );

  const teamFormEdgeScore =
    awayTeamFormRating &&
    homeTeamFormRating
      ? awayTeamFormRating.score -
        homeTeamFormRating.score
      : 0;

  const awayBullpen =
    bullpens[
      game.awayTeamName
    ];

  const homeBullpen =
    bullpens[
      game.homeTeamName
    ];

  const awayBullpenRating =
    bullpenRating(
      awayBullpen
    );

  const homeBullpenRating =
    bullpenRating(
      homeBullpen
    );

  const bullpenEdgeScore =
    awayBullpenRating &&
    homeBullpenRating
      ? awayBullpenRating.score -
        homeBullpenRating.score
      : 0;

  const lineupMatchup =
    lineupMatchups[
      game.gameId
    ];

  const lineupMatchupEdgeScore =
    lineupMatchup?.ready &&
    typeof lineupMatchup.edge ===
      "number"
      ? lineupMatchup.edge
      : 0;

  const projectedScores =
    estimateProjectedScores(
      awayTeamForm,
      homeTeamForm,
      awayStarterStats,
      homeStarterStats,
      awayBullpen,
      homeBullpen,
      lineupMatchup,
      odds
    );

  const projectedTotal =
    projectedScores?.total ?? null;

  /*
    SCORE DISPLAY V1

    KBO API는 경기 전에도 score가 0:0으로 들어오므로
    score null 여부로 LIVE를 판단하지 않는다.

    scoreAvailable + inning 존재 시 실제 경기 진행으로 판단.
  */
  /*
    KBO GAME STATUS

    stateCode "1" = 경기 전
    stateCode "3" = 경기 종료

    LIVE는 종료 상태가 아니면서
    실제 스코어가 제공되고 이닝이 존재할 때만.
  */
  const isPregameGame =
    game.status.stateCode === "1";

  const isFinishedGame =
    game.status.stateCode === "3";

  const liveInning =
    Number(game.status.inning ?? 0);

  const isLiveGame =
    !isPregameGame &&
    !isFinishedGame &&
    game.flags.scoreAvailable &&
    liveInning > 0;

  const hasActualScore =
    isLiveGame || isFinishedGame;

  const awayDisplayScore =
    hasActualScore
      ? game.score.away ?? 0
      : projectedScores
        ? projectedScores.awayRuns.toFixed(1)
        : null;

  const homeDisplayScore =
    hasActualScore
      ? game.score.home ?? 0
      : projectedScores
        ? projectedScores.homeRuns.toFixed(1)
        : null;

  const liveInningLabel =
    isLiveGame
      ? [
          game.status.inning
            ? `${game.status.inning}회`
            : "",
          game.status.topBottom || "",
        ]
          .filter(Boolean)
          .join("")
      : "";

  const computedPicks = analyzeGame(
    game,
    odds,
    starterScoreEdge,
    teamFormEdgeScore,
    bullpenEdgeScore,
    lineupMatchupEdgeScore,
    projectedTotal
  );

  /* GAME_CARD_FROZEN_PREDICTION_V1 */
  const useFrozenPrediction =
    game.status.stateCode === "2" ||
    game.status.stateCode === "3";

  const picks = computedPicks.map((pick) => {
    if (!useFrozenPrediction) {
      return pick;
    }

    const frozen = frozenPicks.find(
      (item) =>
        item.market === pick.market &&
        item.label === pick.label
    );

    if (!frozen) {
      return pick;
    }

    return {
      ...pick,
      odds: frozen.odds,
      grade: frozen.grade,
      confidence: frozen.confidence,
      ev: frozen.ev,
    };
  });

  /*
    추천 자격:
    - 배당 존재
    - 기대수익률 양수
    - A/B급

    조건을 못 넘으면 억지 추천 대신 관망.
  */
  // 전체 시장 중 종합점수가 가장 높은 후보
  const topCandidate =
    picks.find(
      (pick) =>
        !!pick.odds &&
        pick.ev !== null
    );

  /*
    GAME_DETAIL_MARKET_RECOMMENDATION_V1

    경기 상세 추천과 AI 추천픽을 분리한다.

    경기 상세:
    - ML: confidence >= 62%
    - HANDICAP: 정식 추천 제외, 참고 방향만 제공
    - TOTAL: confidence >= 65%
             + projectedTotal / totalLine 차이 >= 0.8

    EV는 경기 상세 추천 차단 조건으로 사용하지 않는다.
    AI 추천픽의 기존 EV > 0 필터는 별도 로직이므로 유지한다.
  */
  const best =
    picks.find((pick) => {
      if (!pick.odds) {
        return false;
      }

      if (
        pick.market === "ML"
      ) {
        return (
          pick.confidence >= 0.62
        );
      }

      if (
        pick.market === "HANDICAP"
      ) {
        return false;
      }

      if (
        pick.market === "TOTAL"
      ) {
        if (
          pick.confidence < 0.65
        ) {
          return false;
        }

        if (
          projectedTotal !== null &&
          odds.totalLine !== null
        ) {
          const totalEdge =
            Math.abs(
              projectedTotal -
              odds.totalLine
            );

          if (
            totalEdge < 0.8
          ) {
            return false;
          }
        }

        return true;
      }

      return false;
    });

  const hasAnyOdds =
    picks.some(
      (pick) =>
        !!pick.odds
    );

  const awayMlPick =
    picks.find(
      (pick) =>
        pick.market === "ML" &&
        pick.label === `${game.awayTeamName} 승`
    );

  const homeMlPick =
    picks.find(
      (pick) =>
        pick.market === "ML" &&
        pick.label === `${game.homeTeamName} 승`
    );

  const awayHandicapPick =
    picks.find(
      (pick) =>
        pick.market === "HANDICAP" &&
        pick.label.startsWith(
          `${game.awayTeamName} `
        )
    );

  const homeHandicapPick =
    picks.find(
      (pick) =>
        pick.market === "HANDICAP" &&
        pick.label.startsWith(
          `${game.homeTeamName} `
        )
    );

  const overPick =
    picks.find(
      (pick) =>
        pick.market === "TOTAL" &&
        pick.label.startsWith("오버")
    );

  const underPick =
    picks.find(
      (pick) =>
        pick.market === "TOTAL" &&
        pick.label.startsWith("언더")
    );
  /*
    GAME_CARD_ALL_PICK_SELECTOR_V1

    경기카드에서 모든 방향을 직접 선택한다.

    - ML 양방향
    - HANDICAP 양방향
    - TOTAL O/U 양방향
    - 추천 방향만 강조하고 선택은 제한하지 않는다.
  */
  const cardPickKey = (
    pick: Pick
  ) =>
    `${pick.gameId}::${pick.market}::${pick.label}`;

  const cardPickScore = (
    pick: Pick
  ) => {
    const gradeScore =
      pick.grade === "A"
        ? 300
        : pick.grade === "B"
          ? 200
          : 100;

    return (
      gradeScore +
      pick.confidence * 100 +
      (pick.ev ?? -1) * 100
    );
  };

  const preferredMarketPick = (
    market:
      | "ML"
      | "HANDICAP"
      | "TOTAL"
  ) => {
    /* FROZEN_MARKET_PRIORITY_V2 */
    if (useFrozenPrediction) {
      const frozen =
        frozenPicks.find(
          (item) =>
            item.market === market
        );

      if (frozen) {
        return frozen;
      }
    }

    if (market === "HANDICAP") {
      const preferredHandicap =
        selectHandicap15Direction(
          picks,
          game
        );

      if (preferredHandicap) {
        return preferredHandicap;
      }
    }

    return [
      ...picks.filter(
        (pick) =>
          pick.market === market
      ),
    ].sort(
      (a, b) => {
        const confidenceDiff =
          b.confidence -
          a.confidence;

        if (
          Math.abs(
            confidenceDiff
          ) > 1e-12
        ) {
          return confidenceDiff;
        }

        return (
          cardPickScore(b) -
          cardPickScore(a)
        );
      }
    )[0];
  };

  /* GAME_CARD_HOME_RIGHT_ORDER_V1 */
  const sortPredictionPicks = (
    market:
      | "ML"
      | "HANDICAP"
      | "TOTAL",
    groupPicks: Pick[]
  ) => {
    const copy = [...groupPicks];

    if (market === "TOTAL") {
      return copy.sort(
        (a, b) => {
          const aOrder =
            a.label.includes(
              "오버"
            )
              ? 0
              : a.label.includes(
                    "언더"
                  )
                ? 1
                : 9;

          const bOrder =
            b.label.includes(
              "오버"
            )
              ? 0
              : b.label.includes(
                    "언더"
                  )
                ? 1
                : 9;

          return aOrder - bOrder;
        }
      );
    }

    /*
      승패 / 핸디캡:
      원정팀 관련 픽 = 왼쪽
      홈팀 관련 픽 = 오른쪽
    */
    if (
      market === "ML" ||
      market === "HANDICAP"
    ) {
      return copy.sort(
        (a, b) => {
          const sideOrder = (
            pick: Pick
          ) => {
            const label =
              pick.label || "";

            const isAway =
              label.includes(
                game.awayTeamName
              );

            const isHome =
              label.includes(
                game.homeTeamName
              );

            if (isAway && !isHome) {
              return 0;
            }

            if (isHome && !isAway) {
              return 1;
            }

            return 9;
          };

          const sideDiff =
            sideOrder(a) -
            sideOrder(b);

          if (sideDiff !== 0) {
            return sideDiff;
          }

          return a.label.localeCompare(
            b.label,
            "ko"
          );
        }
      );
    }

    return copy;
  };

  const predictionMarketGroups = [
    {
      market:
        "ML" as const,
      title:
        "승패",
      picks:
        sortPredictionPicks(
          "ML",
          picks.filter(
            (pick) =>
              pick.market === "ML"
          )
        ),
    },
    {
      market:
        "HANDICAP" as const,
      title:
        "핸디캡",
      picks:
        sortPredictionPicks(
          "HANDICAP",
          picks.filter(
            (pick) =>
              pick.market ===
              "HANDICAP"
          )
        ),
    },
    {
      market:
        "TOTAL" as const,
      title:
        "오버/언더",
      picks:
        sortPredictionPicks(
          "TOTAL",
          picks.filter(
            (pick) =>
              pick.market ===
              "TOTAL"
          )
        ),
    },
  ];

  /*
    GAME_CARD_HIGHEST_FROM_PREFERRED_V1

    최고후보는 raw 전체 픽에서 뽑지 않는다.

    각 시장별 confidence 우세 방향:
    - ML 1개
    - HANDICAP 1개
    - TOTAL 1개

    이 3개만 비교해 최고후보 1개를 선정한다.
  */
  const cardPreferredCandidates =
    (
      [
        preferredMarketPick("ML"),
        preferredMarketPick("HANDICAP"),
        preferredMarketPick("TOTAL"),
      ] as Array<Pick | undefined>
    )
      .filter(
        (
          pick
        ): pick is Pick =>
          Boolean(pick)
      );

  const cardHighestCandidate =
    [...cardPreferredCandidates]
      .sort(
        (a, b) =>
          cardPickScore(b) -
          cardPickScore(a)
      )[0];

  const selectedGamePickCount =
    selectedPickKeys.filter(
      (key) =>
        key.startsWith(
          `${game.gameId}::`
        )
    ).length;

  /* ODDS_COLLAPSE_V1 */
  const [oddsExpanded, setOddsExpanded] =
    useState(false);

  /*
    TRUE_WEBSITE_MODE_V1
    기존 상세 토글 UI는 사용하지 않고
    분석 데이터만 항상 렌더링한다.
  */
  const expanded = true;



  return (
    <article
      id={`match-${game.gameId}`}
      className="analysisWebsiteMatch"
      data-away={teamKey(game.awayTeamName)}
      data-home={teamKey(game.homeTeamName)}
    >
    <div className="cardTop">
      <b>{game.time || "-"}</b>

      <span>
        {game.stadium || "구장 미정"}
        {isLiveGame && (
          <>
            {" · "}
            <strong className="gameLiveBadge">
              🔴 LIVE
              {liveInningLabel
                ? ` · ${liveInningLabel}`
                : ""}
            </strong>
          </>
        )}
      </span>

      <div className="cardTopStatusGroup">
        {!isLiveGame &&
          !isFinishedGame &&
          projectedScores && (
            <span className="cardExpectedScoreLabel">
              예상점수
            </span>
          )}

        <span className="status">
          {isFinishedGame
            ? "경기 종료"
            : isLiveGame
              ? "경기중"
              : game.status.cancelCode &&
                  game.status.cancelCode !== "0"
                ? game.status.cancelName || "경기 취소"
                : "경기 전"}
        </span>
      </div>
    </div>

    <div className="matchup scoreMatchup">
      <div className="scoreMatchupTeam away">
        <strong>{game.awayTeamName}</strong>

        <small>
          {game.awayRank
            ? `${game.awayRank}위`
            : ""}
        </small>
      </div>

      <div className="scoreMatchupCenter">
        <b className="matchupScoreNumber">
          {awayDisplayScore ?? "-"}
        </b>

        <div className="matchupVsWrap">
          <em>VS</em>
        </div>

        <b className="matchupScoreNumber">
          {homeDisplayScore ?? "-"}
        </b>
      </div>

      <div className="scoreMatchupTeam home right">
        <strong>{game.homeTeamName}</strong>

        <small>
          {game.homeRank
            ? `${game.homeRank}위`
            : ""}
        </small>
      </div>
    </div>
    <div className="starterCompare">

      <div className="starterBox awayStarter">
        <div className="starterIdentity">
          <div className="starterPhoto">
            <span>
              {(game.startingPitchers.away?.name || game.awayTeamName || "?").slice(0, 1)}
            </span>

            {game.startingPitchers.away?.id && (
              <img
                src={kboPlayerPhoto(game.startingPitchers.away.id)}
                alt={game.startingPitchers.away?.name || "원정 선발"}
                onError={(e) => {
                  e.currentTarget.style.display = "none";
                }}
              />
            )}
          </div>

          <div className="starterIdentityText">
            <span className="starterLabel">원정 선발</span>
            <b>{game.startingPitchers.away?.name || "미정"}</b>
          </div>
        </div>

        {game.startingPitchers.away?.id ? (
          <>
            {/* STARTER_CARD_LINES_V1 */}
            <small className="starterMainStat">
              ERA{" "}
              {awayStarterStats?.era !== null &&
              awayStarterStats?.era !== undefined
                ? awayStarterStats.era.toFixed(2)
                : "-"}
              {" · "}
              {awayStarterStats?.wins !== null &&
              awayStarterStats?.wins !== undefined &&
              awayStarterStats?.losses !== null &&
              awayStarterStats?.losses !== undefined
                ? `${awayStarterStats.wins}승 ${awayStarterStats.losses}패`
                : "승패 -"}
            </small>

            <small className="starterWhipStat">
              WHIP{" "}
              {awayStarterStats?.whip !== null &&
              awayStarterStats?.whip !== undefined
                ? awayStarterStats.whip.toFixed(2)
                : "-"}
            </small>

            {pitcherStats[
              game.startingPitchers.away.id
            ] && (
              <em>
                {
                  pitcherStats[
                    game.startingPitchers.away.id
                  ].innings || "-"
                }이닝
                {" · "}
                K {
                  pitcherStats[
                    game.startingPitchers.away.id
                  ].strikeouts ?? "-"
                }
                {" · "}
                QS {
                  pitcherStats[
                    game.startingPitchers.away.id
                  ].qs ?? "-"
                }
              </em>
            )}
          </>
        ) : (
          <small>선발 미정</small>
        )}
      </div>

      <div className="starterVs">
        VS
      </div>

      <div className="starterBox right homeStarter">
        <div className="starterIdentity right">
          <div className="starterPhoto">
            <span>
              {(game.startingPitchers.home?.name || game.homeTeamName || "?").slice(0, 1)}
            </span>

            {game.startingPitchers.home?.id && (
              <img
                src={kboPlayerPhoto(game.startingPitchers.home.id)}
                alt={game.startingPitchers.home?.name || "홈 선발"}
                onError={(e) => {
                  e.currentTarget.style.display = "none";
                }}
              />
            )}
          </div>

          <div className="starterIdentityText">
            <span className="starterLabel">홈 선발</span>
            <b>{game.startingPitchers.home?.name || "미정"}</b>
          </div>
        </div>

        {game.startingPitchers.home?.id ? (
          <>
            <small className="starterMainStat">
              ERA{" "}
              {homeStarterStats?.era !== null &&
              homeStarterStats?.era !== undefined
                ? homeStarterStats.era.toFixed(2)
                : "-"}
              {" · "}
              {homeStarterStats?.wins !== null &&
              homeStarterStats?.wins !== undefined &&
              homeStarterStats?.losses !== null &&
              homeStarterStats?.losses !== undefined
                ? `${homeStarterStats.wins}승 ${homeStarterStats.losses}패`
                : "승패 -"}
            </small>

            <small className="starterWhipStat">
              WHIP{" "}
              {homeStarterStats?.whip !== null &&
              homeStarterStats?.whip !== undefined
                ? homeStarterStats.whip.toFixed(2)
                : "-"}
            </small>

            {pitcherStats[
              game.startingPitchers.home.id
            ] && (
              <em>
                {
                  pitcherStats[
                    game.startingPitchers.home.id
                  ].innings || "-"
                }이닝
                {" · "}
                K {
                  pitcherStats[
                    game.startingPitchers.home.id
                  ].strikeouts ?? "-"
                }
                {" · "}
                QS {
                  pitcherStats[
                    game.startingPitchers.home.id
                  ].qs ?? "-"
                }
              </em>
            )}
          </>
        ) : (
          <small>선발 미정</small>
        )}
      </div>

    </div>

    <div className="detailTopGrid">
    {starterEdge && (
      <div className={`starterAnalysis ${starterEdge.className}`}>
        <div className="starterAnalysisTop">
          <b>{starterEdge.text}</b>
          <span>{starterEdge.detail}</span>
        </div>

        <div className="starterMeters">

          <div>
            <span>
              {game.startingPitchers.away?.name}
            </span>

            <strong>
              {awayStarterRating?.score ?? "-"}
            </strong>

            <small>
              시즌 {awayStarterRating?.seasonScore ?? "-"}
              {" · "}
              최근 {awayStarterRating?.recentScore ?? "-"}
            </small>
          </div>

          <div>
            <span>
              {game.startingPitchers.home?.name}
            </span>

            <strong>
              {homeStarterRating?.score ?? "-"}
            </strong>

            <small>
              시즌 {homeStarterRating?.seasonScore ?? "-"}
              {" · "}
              최근 {homeStarterRating?.recentScore ?? "-"}
            </small>
          </div>

        </div>

        <div className="starterReasons">
          {awayStarterRating?.reasons
            .slice(0, 2)
            .map((reason) => (
              <span key={`away-${reason}`}>
                {game.awayTeamName} · {reason}
              </span>
            ))}

          {homeStarterRating?.reasons
            .slice(0, 2)
            .map((reason) => (
              <span key={`home-${reason}`}>
                {game.homeTeamName} · {reason}
              </span>
            ))}
        </div>
      </div>
    )}

    {(awayTeamForm || homeTeamForm) && (
      <div className="teamFormCompare">

        <div className="teamFormTitle">
          최근 10경기 팀 폼
        </div>

        <div className="teamFormGrid">

          <div className="teamFormBox">
            <b>{game.awayTeamName}</b>

            {awayTeamForm ? (
              <>
                <strong>
                  {awayTeamForm.wins}승
                  {" "}
                  {awayTeamForm.losses}패
                  {awayTeamForm.draws > 0
                    ? ` ${awayTeamForm.draws}무`
                    : ""}
                </strong>

                <span>
                  득점 {awayTeamForm.avgRuns?.toFixed(1) ?? "-"}
                  {" · "}
                  실점 {awayTeamForm.avgRunsAllowed?.toFixed(1) ?? "-"}
                </span>

                <small>
                  득실차{" "}
                  {awayTeamForm.runDifferential > 0 ? "+" : ""}
                  {awayTeamForm.runDifferential}
                  {" · "}
                  폼지수 {awayTeamFormRating?.score ?? "-"}
                </small>
              </>
            ) : (
              <span>불러오는 중</span>
            )}
          </div>

          <div className="teamFormVs">
            VS
          </div>

          <div className="teamFormBox right">
            <b>{game.homeTeamName}</b>

            {homeTeamForm ? (
              <>
                <strong>
                  {homeTeamForm.wins}승
                  {" "}
                  {homeTeamForm.losses}패
                  {homeTeamForm.draws > 0
                    ? ` ${homeTeamForm.draws}무`
                    : ""}
                </strong>

