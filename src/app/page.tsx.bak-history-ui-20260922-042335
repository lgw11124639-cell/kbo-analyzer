                );
              };

              const marketTexts = [
                describePick(
                  "승패",
                  mlPick
                ),
                describePick(
                  "핸디캡",
                  handicapPick
                ),
                describePick(
                  "오버/언더",
                  totalPick
                ),
              ];

              const factors: string[] = [];

              if (starterEdge) {
                factors.push(
                  `선발은 ${starterEdge.text}`
                );
              }

              if (
                awayTeamForm &&
                homeTeamForm
              ) {
                if (
                  Math.abs(
                    teamFormEdgeScore
                  ) < 2
                ) {
                  factors.push(
                    "최근 팀 흐름은 대등"
                  );
                } else {
                  factors.push(
                    `최근 흐름은 ${
                      teamFormEdgeScore > 0
                        ? game.awayTeamName
                        : game.homeTeamName
                    } 우세`
                  );
                }
              }

              if (
                awayBullpen &&
                homeBullpen
              ) {
                if (
                  Math.abs(
                    bullpenEdgeScore
                  ) < 3
                ) {
                  factors.push(
                    "불펜 여력은 비슷"
                  );
                } else {
                  factors.push(
                    `불펜은 ${
                      bullpenEdgeScore > 0
                        ? game.awayTeamName
                        : game.homeTeamName
                    } 우세`
                  );
                }
              }

              if (
                lineupMatchup?.ready &&
                typeof lineupMatchupEdgeScore ===
                  "number"
              ) {
                if (
                  Math.abs(
                    lineupMatchupEdgeScore
                  ) < 1
                ) {
                  factors.push(
                    "확정 라인업 매치업은 대등"
                  );
                } else {
                  factors.push(
                    `확정 라인업은 ${
                      lineupMatchupEdgeScore > 0
                        ? game.awayTeamName
                        : game.homeTeamName
                    } 우세`
                  );
                }
              }

              const totalContext =
                projectedTotal !== null &&
                odds.totalLine !== null
                  ? (
                      projectedTotal >
                      odds.totalLine
                        ? `예상 총점 ${projectedTotal.toFixed(
                            1
                          )}점은 기준점 ${odds.totalLine.toFixed(
                            1
                          )}보다 ${(
                            projectedTotal -
                            odds.totalLine
                          ).toFixed(
                            1
                          )}점 높음`
                        : projectedTotal <
                            odds.totalLine
                          ? `예상 총점 ${projectedTotal.toFixed(
                              1
                            )}점은 기준점 ${odds.totalLine.toFixed(
                              1
                            )}보다 ${(
                              odds.totalLine -
                              projectedTotal
                            ).toFixed(
                              1
                            )}점 낮음`
                          : `예상 총점과 기준점이 ${odds.totalLine.toFixed(
                              1
                            )}점으로 동일`
                    )
                  : "";

              if (totalContext) {
                factors.push(
                  totalContext
                );
              }

              let conclusion = "";

              if (best) {
                conclusion =
                  `세 시장을 종합하면 ${best.label}이 현재 추천 기준을 가장 안정적으로 충족합니다. ` +
                  `모델 확률 ${(best.confidence * 100).toFixed(
                    1
                  )}% ${best.grade}급, ` +
                  `기대수익률 ${
                    best.ev !== null &&
                    best.ev >= 0
                      ? "+"
                      : ""
                  }${
                    best.ev !== null
                      ? (
                          best.ev *
                          100
                        ).toFixed(1)
                      : "-"
                  }% 기준으로 최종 우선 선택입니다.`;
              } else {
                const highest =
                  topCandidate;

                if (highest) {
                  conclusion =
                    `경기 방향상 가장 강한 후보는 ${highest.label} ` +
                    `${(
                      highest.confidence *
                      100
                    ).toFixed(
                      1
                    )}% ${highest.grade}급이지만, ` +
                    `승패·핸디캡·오버/언더를 함께 비교하면 ` +
                    `신뢰도와 배당 가치가 동시에 충족되는 시장이 없어 최종 추천은 보류합니다.`;
                } else {
                  conclusion =
                    "세 시장을 종합할 배당 정보가 부족해 최종 판단을 보류합니다.";
                }
              }

              return (
                <>
                  {/* FINAL_DECISION_READABLE_SAFE_V1 */}
                  <div className="finalDecisionMarketGrid">
                    {marketTexts.map(
                      (
                        text,
                        index
                      ) => {
                        const titles = [
                          "승패",
                          "핸디캡",
                          "오버/언더",
                        ];

                        const title =
                          titles[index] ??
                          "";

                        const body =
                          text.replace(
                            `${title}: `,
                            ""
                          );

                        return (
                          <div
                            className="finalDecisionMarket"
                            key={title}
                          >
                            <span>
                              {title}
                            </span>

                            <strong>
                              {body}
                            </strong>
                          </div>
                        );
                      }
                    )}
                  </div>

                  {factors.length > 0 && (
                    <div className="finalDecisionFactors">
                      <b>
                        전력 요소
                      </b>

                      <span>
                        {factors.join(
                          " · "
                        )}
                      </span>
                    </div>
                  )}

                  <div className="finalDecisionSummary">
                    <b>
                      종합 판단
                    </b>

                    <p>
                      {conclusion}
                    </p>
                  </div>
                </>
              );
            })()}
          </div>
        </div>
      </div>
    )}

    </article>
  );
}


type AutoComboStyle =
  | "SAFE"
  | "TOP"
  | "BALANCED"
  | "AGGRESSIVE"
  | "HIGH_ODDS";

type SavedComboSnapshot = {
  id: string;
  date: string;
  savedAt: string;

  name: string;
  style: AutoComboStyle;

  odds: number;
  probability: number;
  averageConfidence: number;
  averageEv: number | null;

  // 사용자가 입력한 실제 베팅금액
  stakeAmount?: number;

  // 일반 저장 또는 금액 자동배분 저장
  source?: "MANUAL" | "BANKROLL";

  // 같은 배분 저장 버튼으로 함께 저장된 조합 묶음
  batchId?: string;

  // 금액 배분 당시 선택한 투자 성향
  investmentProfile?:
    | "SAFE"
    | "BALANCED"
    | "AGGRESSIVE";

  // 저장 당시 픽을 그대로 동결
  picks: Pick[];

  // 핸디캡 / O-U 결과 판정을 위해
  // 저장 당시 경기별 기준점과 배당도 함께 동결
  oddsByGame: Record<string, OddsInput>;

  // 이후 팀명/구장 표시에 사용할 당시 경기정보
  games: Record<
    string,
    {
      awayTeamName: string;
      homeTeamName: string;
      stadium: string;
    }
  >;
};


type PickSettlement =
  | "PENDING"
  | "LIVE"
  | "WIN"
  | "LOSS"
  | "PUSH"
  | "VOID";

type ComboSettlement =
  | "PENDING"
  | "LIVE"
  | "WIN"
  | "LOSS"
  | "VOID";

function settleSavedPick(
  pick: Pick,
  snapshot: SavedComboSnapshot,
  game: KboGame | undefined
): PickSettlement {
  if (!game) {
    return "PENDING";
  }

  const cancelName =
    (game.status.cancelName || "").trim();

  const cancelled =
    cancelName &&
    cancelName !== "정상경기";

  if (cancelled) {
    return "VOID";
  }

  const awayScore =
    game.score.away;

  const homeScore =
    game.score.home;

  const hasScore =
    awayScore !== null &&
    homeScore !== null;

  const completed =
    game.status.stateCode === "3" &&
    hasScore;

  /*
    PRE_GAME_SETTLEMENT_FIX_V1

    KBO API는 경기 전에도 스코어를 0:0으로
    내려줄 수 있으므로 score 존재 여부만으로
    LIVE를 판단하면 안 된다.

    stateCode "1" = 경기 전
    stateCode "3" = 경기 종료

    실제 이닝/초말 정보가 생긴 경우에만
    진행중으로 판정한다.
  */
  const inning =
    Number(game.status.inning ?? 0);

  const hasLiveProgress =
    inning > 0 ||
    !!game.status.topBottom;

  const started =
    game.status.stateCode !== "1" &&
    game.status.stateCode !== "3" &&
    hasLiveProgress;

  if (!completed) {
    return started
      ? "LIVE"
      : "PENDING";
  }

  const frozenOdds =
    snapshot.oddsByGame[pick.gameId] ||
    emptyOdds;

  const info =
    snapshot.games[pick.gameId];

  if (!info) {
    return "VOID";
  }

  if (pick.market === "ML") {
    const awayLabel =
      `${info.awayTeamName} 승`;

    const homeLabel =
      `${info.homeTeamName} 승`;

    if (pick.label === awayLabel) {
      if (awayScore > homeScore) {
        return "WIN";
      }

      if (awayScore < homeScore) {
        return "LOSS";
      }

      return "PUSH";
    }

    if (pick.label === homeLabel) {
      if (homeScore > awayScore) {
        return "WIN";
      }

      if (homeScore < awayScore) {
        return "LOSS";
      }

      return "PUSH";
    }

    return "VOID";
  }

  if (pick.market === "HANDICAP") {
    const awaySelected =
      pick.label.startsWith(
        `${info.awayTeamName} `
      );

    const homeSelected =
      pick.label.startsWith(
        `${info.homeTeamName} `
      );

    if (
      awaySelected &&
      frozenOdds.awayHandicapLine !== null
    ) {
      const adjusted =
        awayScore +
        frozenOdds.awayHandicapLine;

      if (adjusted > homeScore) {
        return "WIN";
      }

      if (adjusted < homeScore) {
        return "LOSS";
      }

      return "PUSH";
    }

    if (
      homeSelected &&
      frozenOdds.homeHandicapLine !== null
    ) {
      const adjusted =
        homeScore +
        frozenOdds.homeHandicapLine;

      if (adjusted > awayScore) {
        return "WIN";
      }

      if (adjusted < awayScore) {
        return "LOSS";
      }

      return "PUSH";
    }

    return "VOID";
  }

  if (pick.market === "TOTAL") {
    if (frozenOdds.totalLine === null) {
      return "VOID";
    }

    const total =
      awayScore + homeScore;

    if (pick.label.startsWith("오버 ")) {
      if (total > frozenOdds.totalLine) {
        return "WIN";
      }

      if (total < frozenOdds.totalLine) {
        return "LOSS";
      }

      return "PUSH";
    }

    if (pick.label.startsWith("언더 ")) {
      if (total < frozenOdds.totalLine) {
        return "WIN";
      }

      if (total > frozenOdds.totalLine) {
        return "LOSS";
      }

      return "PUSH";
    }

    return "VOID";
  }

  return "VOID";
}

function settleSavedCombo(
  snapshot: SavedComboSnapshot,
  games: KboGame[]
): {
  status: ComboSettlement;
  pickResults: PickSettlement[];
  effectiveOdds: number;
} {
  const pickResults =
    snapshot.picks.map(
      (pick) =>
        settleSavedPick(
          pick,
          snapshot,
          games.find(
            (game) =>
              game.gameId ===
              pick.gameId
          )
        )
    );

  if (
    pickResults.some(
      (result) =>
        result === "LOSS"
    )
  ) {
    return {
      status: "LOSS",
      pickResults,
      effectiveOdds: 0,
    };
  }

  if (
    pickResults.some(
      (result) =>
        result === "LIVE"
    )
  ) {
    return {
      status: "LIVE",
      pickResults,
      effectiveOdds:
        snapshot.odds,
    };
  }

  if (
    pickResults.some(
      (result) =>
        result === "PENDING"
    )
  ) {
    return {
      status: "PENDING",
      pickResults,
      effectiveOdds:
        snapshot.odds,
    };
  }

  const hasWin =
    pickResults.some(
      (result) =>
        result === "WIN"
    );

  const onlyVoidOrPush =
    pickResults.every(
      (result) =>
        result === "VOID" ||
        result === "PUSH"
    );

  if (onlyVoidOrPush) {
    return {
      status: "VOID",
      pickResults,
      effectiveOdds: 1,
    };
  }

  const effectiveOdds =
    snapshot.picks.reduce(
      (acc, pick, index) => {
        const result =
          pickResults[index];

        if (
          result === "PUSH" ||
          result === "VOID"
        ) {
          return acc;
        }

        return acc *
          (pick.odds ?? 1);
      },
      1
    );

  return {
    status:
      hasWin
        ? "WIN"
        : "VOID",
    pickResults,
    effectiveOdds,
  };
}


