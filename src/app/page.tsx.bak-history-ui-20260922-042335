function comboOverlapRisk(
  comboPickKeys: string[],
  allComboPickKeys: string[][]
) {
  /*
    1폴은 다른 픽에 의존하는 조합이 아니므로
    의존도 계산 대상에서 제외한다.
  */
  if (comboPickKeys.length <= 1) {
    return {
      label: "해당 없음",
      className: "none",
    };
  }

  const otherComboCount =
    Math.max(
      1,
      allComboPickKeys.length - 1
    );

  /*
    현재 조합의 각 픽이 다른 조합에 얼마나
    반복되는지 실제 동일 픽 기준으로 계산한다.

    동일 경기라도 시장이나 선택이 다르면
    같은 픽으로 계산하지 않는다.
  */
  const repeatRatios =
    comboPickKeys.map(
      (pickKey) => {
        const includedCount =
          allComboPickKeys.reduce(
            (count, keys) =>
              keys.includes(pickKey)
                ? count + 1
                : count,
            0
          );

        return (
          Math.max(
            0,
            includedCount - 1
          ) /
          otherComboCount
        );
      }
    );

  const repeatRatio =
    repeatRatios.reduce(
      (sum, ratio) =>
        sum + ratio,
      0
    ) /
    comboPickKeys.length;

  if (repeatRatio >= 0.75) {
    return {
      label: "매우 높음",
      className: "veryHigh",
    };
  }

  if (repeatRatio >= 0.50) {
    return {
      label: "높음",
      className: "high",
    };
  }

  if (repeatRatio >= 0.25) {
    return {
      label: "보통",
      className: "medium",
    };
  }

  return {
    label: "낮음",
    className: "low",
  };
}


