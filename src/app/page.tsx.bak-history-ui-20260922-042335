  async function cancelManualSavedCombo(
    savedId: string
  ) {
    const busyKey =
      `manual:${savedId}`;

    const targetItem =
      savedCombos.find(
        (item) =>
          item.id === savedId
      );

    const targetSettlement =
      targetItem
        ? myComboSettlements.get(
            targetItem.id
          )
        : undefined;

    if (
      targetSettlement &&
      targetSettlement.status !== "PENDING"
    ) {
      const confirmed =
        window.confirm(
          "이미 경기 시작 또는 정산된 조합입니다.\n\n" +
          "저장취소하면 이 기록은 내 조합과 월 통계에서 제외됩니다.\n\n" +
          "정말 저장취소하시겠습니까?"
        );

      if (!confirmed) {
        return;
      }
    }

    if (
      savedComboCancelBusy[
        busyKey
      ]
    ) {
      return;
    }

    setSavedComboCancelBusy(
      (prev) => ({
        ...prev,
        [busyKey]: true,
      })
    );

    setSavedComboCancelMessage(
      (prev) => ({
        ...prev,
        [busyKey]:
          "저장취소 중...",
      })
    );

    try {
      /*
        정확히 이 MANUAL snapshot만 삭제한다.
        같은 이름의 BANKROLL은 절대 건드리지 않는다.
      */
      const nextSavedCombos =
        savedCombos.filter(
          (item) =>
            item.id !== savedId
        );

      await persistUserState({
        savedCombos:
          nextSavedCombos,
      });

      setSavedCombos(
        nextSavedCombos
      );

    } catch (error) {
      console.error(
        "manual combo cancel failed",
        error
      );

      setSavedComboCancelMessage(
        (prev) => ({
          ...prev,
          [busyKey]:
            "취소 실패",
        })
      );
    } finally {
      setSavedComboCancelBusy(
        (prev) => ({
          ...prev,
          [busyKey]: false,
        })
      );
    }
  }


  async function cancelBankrollSavedGroup(
    groupKey: string
  ) {
    const busyKey =
      `bankroll:${groupKey}`;

    const targetItems =
      groupKey.startsWith("legacy:")
        ? savedCombos.filter(
            (item) =>
              item.id ===
              groupKey.slice(
                "legacy:".length
              )
          )
        : savedCombos.filter(
            (item) =>
              item.batchId === groupKey
          );

    const hasStartedOrSettled =
      targetItems.some(
        (item) => {
          const settlement =
            myComboSettlements.get(
              item.id
            );

          return (
            !!settlement &&
            settlement.status !== "PENDING"
          );
        }
      );

    if (hasStartedOrSettled) {
      const confirmed =
        window.confirm(
          "이미 경기 시작 또는 정산된 배분조합입니다.\n\n" +
          "저장취소하면 묶음 전체 기록이 내 조합과 월 통계에서 제외됩니다.\n\n" +
          "정말 저장취소하시겠습니까?"
        );

      if (!confirmed) {
        return;
      }
    }

    if (
      savedComboCancelBusy[
        busyKey
      ]
    ) {
      return;
    }

    setSavedComboCancelBusy(
      (prev) => ({
        ...prev,
        [busyKey]: true,
      })
    );

    setSavedComboCancelMessage(
      (prev) => ({
        ...prev,
        [busyKey]:
          "배분조합 취소 중...",
      })
    );

    try {
      let nextSavedCombos:
        SavedComboSnapshot[];

      if (
        groupKey.startsWith(
          "legacy:"
        )
      ) {
        /*
          batchId가 없는 과거 BANKROLL은
          exact id 하나만 제거.
        */
        const legacyId =
          groupKey.slice(
            "legacy:".length
          );

        nextSavedCombos =
          savedCombos.filter(
            (item) =>
              item.id !== legacyId
          );
      } else {
        /*
          새 BANKROLL은 같은 batchId 전체 삭제.
        */
        nextSavedCombos =
          savedCombos.filter(
            (item) =>
              item.batchId !==
              groupKey
          );
      }

      await persistUserState({
        savedCombos:
          nextSavedCombos,
      });

      setSavedCombos(
        nextSavedCombos
      );
    } catch (error) {
      console.error(
        "bankroll combo cancel failed",
        error
      );

      setSavedComboCancelMessage(
        (prev) => ({
          ...prev,
          [busyKey]:
            "취소 실패",
        })
      );
    } finally {
      setSavedComboCancelBusy(
        (prev) => ({
          ...prev,
          [busyKey]: false,
        })
      );
    }
  }


  function buildSavedComboSnapshot(
    combo: (typeof combos)[number],
    options?: {
      stakeAmount?: number;
      source?: "MANUAL" | "BANKROLL";
      profile?:
        | "SAFE"
        | "BALANCED"
        | "AGGRESSIVE";
      batchId?: string;
      savedAt?: string;
      id?: string;
    }
  ): SavedComboSnapshot {
    const oddsByGame:
      Record<string, OddsInput> = {};

    const gameInfo:
      SavedComboSnapshot["games"] = {};

    for (const pick of combo.picks) {
      oddsByGame[pick.gameId] = {
        ...(odds[pick.gameId] || emptyOdds),
      };

      const game = games.find(
        (item) =>
          item.gameId === pick.gameId
      );

      if (game) {
        gameInfo[pick.gameId] = {
          awayTeamName:
            game.awayTeamName,

          homeTeamName:
            game.homeTeamName,

          stadium:
            game.stadium || "",
        };
      }
    }

    const savedAt =
      options?.savedAt ||
      new Date().toISOString();

    return {
      id:
        options?.id ||
        `${date}-${combo.style}-${Date.now()}-${Math.random()
          .toString(36)
          .slice(2, 8)}`,

      date,
      savedAt,

      name:
        combo.name,

      style:
        combo.style,

      odds:
        combo.odds,

      probability:
        combo.probability,

      averageConfidence:
        combo.averageConfidence,

      averageEv:
        combo.averageEv,

      stakeAmount:
        options?.stakeAmount,

      source:
        options?.source ||
        "MANUAL",

      batchId:
        options?.batchId,

      investmentProfile:
        options?.profile,

      picks:
        combo.picks.map(
          (pick) => ({
            ...pick,
          })
        ),

      oddsByGame,

      games:
        gameInfo,
    };
  }


  async function saveAutoCombo(
    combo: (typeof combos)[number],
    options?: {
      stakeAmount?: number;
    }
  ) {
    const saveKey =
      `${date}:${combo.name}`;

    if (
      comboSaveBusy[saveKey]
    ) {
      return;
    }

    if (!authUser) {
      setAuthMode("login");
      setAuthOpen(true);
      return;
    }

    /*
      source가 없는 기존 저장본도 MANUAL로 취급한다.
      BANKROLL에 같은 이름의 조합이 있어도
      개별 저장 여부에는 영향을 주지 않는다.
    */
    const existingManual =
      savedCombos.find(
        (item) =>
          item.date === date &&
          item.name === combo.name &&
          item.source !== "BANKROLL"
      );

    setComboSaveBusy(
      (prev) => ({
        ...prev,
        [saveKey]: true,
      })
    );

    setComboSaveMessage(
      (prev) => ({
        ...prev,
        [saveKey]:
          existingManual
            ? "이미 저장됨 ✓"
            : "저장 중...",
      })
    );

    try {
      /*
        자동조합 화면에서는 삭제하지 않는다.
        이미 저장된 MANUAL 조합이면 중복 저장만 막고
        취소는 "내 조합" 화면에서 처리한다.
      */
      if (existingManual) {
        window.setTimeout(() => {
          setComboSaveMessage(
            (prev) => {
              const next = {
                ...prev,
              };

              delete next[saveKey];

              return next;
            }
          );
        }, 1600);

        return;
      }

      const snapshot =
        buildSavedComboSnapshot(
          combo,
          {
            source: "MANUAL",
            stakeAmount:
              options?.stakeAmount,
          }
        );

      /*
        동일 날짜/이름의 기존 MANUAL만 교체 대상으로 본다.
        BANKROLL 저장본은 절대 제거하지 않는다.
      */
      const filtered =
        savedCombos.filter(
          (item) =>
            !(
              item.date === date &&
              item.name === combo.name &&
              item.source !== "BANKROLL"
            )
        );

      const nextSavedCombos = [
        snapshot,
        ...filtered,
      ];

      await persistUserState({
        savedCombos:
          nextSavedCombos,
      });

      setSavedCombos(
        nextSavedCombos
      );

      setComboSaveMessage(
        (prev) => ({
          ...prev,
          [saveKey]:
            "저장됨 ✓",
        })
      );

      window.setTimeout(() => {
        setComboSaveMessage(
          (prev) => {
            const next = {
              ...prev,
            };

            delete next[saveKey];

            return next;
          }
        );
      }, 1600);
    } catch (error) {
      console.error(
        "combo save failed",
        error
      );

      setComboSaveMessage(
        (prev) => ({
          ...prev,
          [saveKey]:
            "저장 실패",
        })
      );
    } finally {
      setComboSaveBusy(
        (prev) => ({
          ...prev,
          [saveKey]: false,
        })
      );
    }
  }


  async function saveInvestmentPlans() {
    if (
      bankrollSaveBusy ||
      investmentPlans.length === 0 ||
      investmentAmountNumber <= 0
    ) {
      return;
    }

    if (!authUser) {
      setAuthMode("login");
      setAuthOpen(true);
      return;
    }

    if (!userStateReady) {
      setBankrollSaveMessage(
        "계정 데이터 불러오는 중"
      );
      return;
    }

    setBankrollSaveBusy(true);
    setBankrollSaveMessage(
      "AI 추천픽 저장 중..."
    );

    try {
      /*
        한 번의 배분 저장 클릭 = 하나의 batchId.
        2~3개 조합을 전부 만든 뒤
        Supabase에는 단 한 번만 저장한다.
      */
      const now = Date.now();

      const batchId =
        `bankroll-${date}-${now}`;

      const savedAt =
        new Date(now).toISOString();

      const snapshots =
        investmentPlans.map(
          (plan, index) =>
            buildSavedComboSnapshot(
              plan.combo,
              {
                stakeAmount:
                  plan.stakeAmount,

                source:
                  "BANKROLL",

                profile:
                  investmentProfile,

                batchId,

                savedAt,

                id:
                  `${batchId}-${index}`,
              }
            )
        );

      const nextSavedCombos = [
        ...snapshots,
        ...savedCombos,
      ];

      await persistUserState({
        savedCombos:
          nextSavedCombos,
      });

      setSavedCombos(
        nextSavedCombos
      );

      setBankrollSaveMessage(
        `${snapshots.length}개 AI 추천픽 저장됨 ✓`
      );

      window.setTimeout(() => {
        setBankrollSaveMessage("");
      }, 1800);
    } catch (error) {
      console.error(
        "bankroll save failed",
        error
      );

      setBankrollSaveMessage(
        "AI 추천픽 저장 실패"
      );
    } finally {
      setBankrollSaveBusy(false);
    }
  }



