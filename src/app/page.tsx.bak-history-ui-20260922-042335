/*
============================================================
DISPLAY ONLY LIVE PROBABILITY

- 추천 엔진 / V3.7 confidence / 기대수익률 수정 안 함
- 현재 점수 + 이닝 + 초/말만 이용한 표시용 실시간 추정치
============================================================
*/

function liveDisplayProbability(
  pick: Pick,
  game: KboGame
): number {
  const base =
    Math.max(
      0.03,
      Math.min(
        0.97,
        Number.isFinite(pick.confidence)
          ? pick.confidence
          : 0.5
      )
    );

  const awayScore =
    typeof game.score.away === "number"
      ? game.score.away
      : null;

  const homeScore =
    typeof game.score.home === "number"
      ? game.score.home
      : null;

  const inning =
    typeof game.status.inning === "number"
      ? game.status.inning
      : null;

  const isFinished =
    game.status.stateCode === "3";

  /*
    종료된 경기는 이 함수에서 확률 재계산하지 않음.
    실제 적중/미적중 표시는 기존 settlePrediction 영역에서 처리.
  */
  if (isFinished) {
    return base;
  }

  /*
    경기 전
  */
  if (
    awayScore === null ||
    homeScore === null ||
    inning === null
  ) {
    return base;
  }

  const currentTotal =
    awayScore + homeScore;

  /*
    ==========================================================
    TOTAL은 이미 결과가 되돌릴 수 없으면 즉시 확정
    ==========================================================
  */
  if (
    pick.market === "TOTAL"
  ) {
    const match =
      pick.label.match(
        /(\d+(?:\.\d+)?)\s*$/
      );

    const line =
      match
        ? Number(match[1])
        : null;

    if (line !== null) {
      const isOver =
        pick.label.includes("오버");

      /*
        야구 총점은 내려갈 수 없기 때문에
        현재 총점이 기준점을 넘으면:

        오버 = 100%
        언더 = 0%
      */
      if (
        currentTotal > line
      ) {
        return isOver
          ? 1
          : 0;
      }
    }
  }

  const half =
    game.status.topBottom === "말"
      ? 0.5
      : 0;

  const elapsed =
    Math.max(
      0,
      Math.min(
        9,
        inning - 1 + half
      )
    );

  const progress =
    Math.max(
      0,
      Math.min(
        0.985,
        elapsed / 9
      )
    );

  const remaining =
    Math.max(
      0.08,
      1 - progress
    );

  const logit = (
    probability: number
  ) =>
    Math.log(
      probability /
      (1 - probability)
    );

  const logistic = (
    value: number
  ) =>
    1 /
    (
      1 +
      Math.exp(-value)
    );

  let value =
    logit(base);

  const scoreWeight =
    0.34 /
    Math.sqrt(
      remaining
    );

  /*
    승패
  */
  if (
    pick.market === "ML"
  ) {
    const isAway =
      pick.label.includes(
        game.awayTeamName
      );

    const margin =
      isAway
        ? awayScore - homeScore
        : homeScore - awayScore;

    value +=
      margin *
      scoreWeight;
  }

  /*
    핸디캡
  */
  else if (
    pick.market === "HANDICAP"
  ) {
    const match =
      pick.label.match(
        /([+-]?\d+(?:\.\d+)?)\s*$/
      );

    const line =
      match
        ? Number(match[1])
        : 0;

    const isAway =
      pick.label.includes(
        game.awayTeamName
      );

    const margin =
      (
        isAway
          ? awayScore - homeScore
          : homeScore - awayScore
      ) + line;

    value +=
      margin *
      scoreWeight;
  }

  /*
    오버/언더
  */
  else if (
    pick.market === "TOTAL"
  ) {
    const match =
      pick.label.match(
        /(\d+(?:\.\d+)?)\s*$/
      );

    const line =
      match
        ? Number(match[1])
        : null;

    if (line !== null) {
      const effectiveInnings =
        Math.max(
          2,
          elapsed
        );

      const paceTotal =
        currentTotal *
        9 /
        effectiveInnings;

      const projected =
        paceTotal *
          (1 - progress) +
        currentTotal *
          progress;

      const edge =
        projected -
        line;

      const isOver =
        pick.label.includes(
          "오버"
        );

      value +=
        (
          isOver
            ? edge
            : -edge
        ) *
        0.18 /
        Math.sqrt(
          remaining
        );
    }
  }

  return Math.max(
    0.01,
    Math.min(
      0.99,
      logistic(value)
    )
  );
}

