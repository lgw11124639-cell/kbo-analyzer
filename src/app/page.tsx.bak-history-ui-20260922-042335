        FAST_LOAD_V1
        경기카드는 여기서 즉시 공개한다.
        투수/최근전적/불펜/라인업은 이후 백그라운드로 채운다.
      */
      setLoading(false);

      // 이전 날짜의 세부자료가 잠깐 보이지 않게 초기화
      setLineupMatchups({});
      setPitcherStats({});
      setTeamForms({});
      setBullpens({});

      // ------------------------------------------------------
      // 확정 라인업 + 상대 선발 매치업 백그라운드 수집
      // ------------------------------------------------------
      void loadLineupMatchups(
        loadedGames,
        date
      );

      // ------------------------------------------------------
      // 선발투수 시즌 기록 자동수집
      // ------------------------------------------------------

      const starterIds = [
        ...new Set(
          loadedGames.flatMap((game) => [
            game.startingPitchers.away?.id,
            game.startingPitchers.home?.id,
          ])
          .filter(
            (id): id is number =>
              typeof id === "number" &&
              id > 0
          )
        ),
      ];

      if (starterIds.length > 0) {
        const pitcherResults =
          await Promise.all(
            starterIds.map(async (playerId) => {
              try {
                const response = await fetch(
                  /* HISTORICAL_PITCHER_DATE_QUERY_V1 */
                  `/api/kbo/pitcher/${playerId}?date=${encodeURIComponent(date)}`,
                  {
                    cache: "no-store",
                  }
                );

                if (!response.ok) {
                  return null;
                }

                const json =
                  await response.json();

                if (!json.stats) {
                  return null;
                }

                return json.stats as PitcherStats;
              } catch {
                return null;
              }
            })
          );

        const nextPitcherStats:
          Record<number, PitcherStats> = {};

        for (const stats of pitcherResults) {
          if (!stats) continue;

          nextPitcherStats[
            stats.playerId
          ] = stats;
        }

        setPitcherStats((prev) => ({
          ...prev,
          ...nextPitcherStats,
        }));
      }

      // ------------------------------------------------------
      // 오늘 경기 참가팀 최근 10경기 자동수집
      // ------------------------------------------------------

      const teamNames = [
        ...new Set(
          loadedGames.flatMap(
            (game) => [
              game.awayTeamName,
              game.homeTeamName,
            ]
          )
        ),
      ];

      if (teamNames.length > 0) {
        const teamFormResults =
          await Promise.all(
            teamNames.map(
              async (teamName) => {
                try {
                  const response =
                    await fetch(
                      `/api/kbo/team-form?team=${encodeURIComponent(teamName)}&date=${encodeURIComponent(date)}`,
                      {
                        cache: "no-store",
                      }
                    );

                  if (!response.ok) {
                    return null;
                  }

                  const json =
                    await response.json();

                  return json as TeamForm;
                } catch {
                  return null;
                }
              }
            )
          );

        const nextTeamForms:
          Record<string, TeamForm> = {};

        for (
          const form of teamFormResults
        ) {
          if (!form) continue;

          nextTeamForms[
            form.team
          ] = form;
        }

        setTeamForms(
          nextTeamForms
        );
      }

      // ------------------------------------------------------
      // 최근 3일 불펜 자동수집
      // ------------------------------------------------------

      if (teamNames.length > 0) {
        const bullpenResults =
          await Promise.all(
            teamNames.map(
              async (teamName) => {
                try {
                  const response =
                    await fetch(
                      `/api/kbo/bullpen?team=${encodeURIComponent(teamName)}&date=${encodeURIComponent(date)}`,
                      {
                        cache: "no-store",
                      }
                    );

                  if (!response.ok) {
                    return null;
                  }

                  const json =
                    await response.json();

                  return json as BullpenData;
                } catch {
                  return null;
                }
              }
            )
          );

        const nextBullpens:
          Record<string, BullpenData> = {};

        for (
          const bullpen of bullpenResults
        ) {
          if (!bullpen) continue;

          nextBullpens[
            bullpen.team
          ] = bullpen;
        }

        setBullpens(
          nextBullpens
        );
      }


      /* HISTORICAL_ODDS_VIEW_V1
         과거 백테스트에서 복원핔 배닻은
         imported historical snapshot만 사용한다.
         개인 저장 배당이 있으면 개인 저장값이 우선이다.
      */
      if (historyResponse.ok) {
        try {
          type HistoricalOddsSnapshot = {
            id?: string;
            gameId?: string;
            awayMl?: number | null;
            homeMl?: number | null;
            awayHandicapLine?: number | null;
            homeHandicapLine?: number | null;
            awayHandicap?: number | null;
            homeHandicap?: number | null;
            totalLine?: number | null;
            overOdds?: number | null;
            underOdds?: number | null;
          };

          const historyJson =
            (await historyResponse.json()) as {
              snapshots?: HistoricalOddsSnapshot[];
            };

          const historicalSnapshots =
            Array.isArray(historyJson.snapshots)
              ? historyJson.snapshots.filter(
                  (item) =>
                    String(item?.id ?? "").startsWith(
                      "historical-"
                    )
                )
              : [];

          if (historicalSnapshots.length > 0) {
            const historicalByGame =
              new Map<
                string,
                HistoricalOddsSnapshot
              >();

            for (const item of historicalSnapshots) {
              if (!item.gameId) continue;

              historicalByGame.set(
                item.gameId,
                item
              );
            }

            setAllOdds((prev) => {
              const next = { ...prev };

              for (const game of loadedGames) {
                const manuallySaved =
                  savedOdds[game.gameId];

                if (manuallySaved) {
                  next[game.gameId] =
                    manuallySaved;
                  continue;
                }

                const historical =
                  historicalByGame.get(
                    game.gameId
                  );

                if (!historical) {
                  continue;
                }

                next[game.gameId] = {
                  awayMl:
                    historical.awayMl ?? null,

                  homeMl:
                    historical.homeMl ?? null,

                  awayHandicapLine:
                    historical.awayHandicapLine ??
                    null,

                  homeHandicapLine:
                    historical.homeHandicapLine ??
                    null,

                  awayHandicap:
                    historical.awayHandicap ??
                    null,

                  homeHandicap:
                    historical.homeHandicap ??
                    null,

                  totalLine:
                    historical.totalLine ?? null,

                  overOdds:
                    historical.overOdds ?? null,

                  underOdds:
                    historical.underOdds ?? null,
                };
              }

              return next;
            });

            console.log(
              "[HISTORICAL ODDS LOADED]",
              date,
              historicalSnapshots.length
            );
          }
        } catch (error) {
          console.warn(
            "[HISTORICAL ODDS LOAD FAILED]",
            error
          );
        }
      }

      // 배당 API 실패는 경기목록 자체를 막지 않는다.
      if (oddsResponse?.ok) {
        const oddsJson = await oddsResponse.json();
        const autoEvents: AutoOddsEvent[] = oddsJson.events || [];

        /*
          자동으로 수집된 실제 사이트 배당/기준점을
          경기별 히스토리에 별도 저장한다.

          - 화면의 수동 잠금값과 분리
          - 같은 값은 서버에서 중복 제거
          - 향후 최근 30일 배당/적중률/ROI 통계 원본
        */
        const autoOddsSnapshots =
          loadedGames.flatMap((game) => {
            const away =
              normalizeTeamName(
                game.awayTeamName
              );

            const home =
              normalizeTeamName(
                game.homeTeamName
              );

            const matched =
              autoEvents.find((event) => {
                const oddsAway =
                  normalizeTeamName(
                    event.awayTeam
                  );

                const oddsHome =
                  normalizeTeamName(
                    event.homeTeam
                  );

                return (
                  away === oddsAway &&
                  home === oddsHome &&
                  kstDateFromIso(
                    event.commenceTime
                  ) === date
                );
              });

            if (!matched) {
              return [];
            }

            /*
              실제로 받은 시장이 하나도 없으면
              빈 기록은 저장하지 않는다.
            */
            const hasOdds =
              matched.awayMl !== null ||
              matched.homeMl !== null ||
              matched.awaySpreadLine !== null ||
              matched.homeSpreadLine !== null ||
              matched.awayHandicap !== null ||
              matched.homeHandicap !== null ||
              matched.totalLine !== null ||
              matched.overOdds !== null ||
              matched.underOdds !== null;

            if (!hasOdds) {
              return [];
            }

            return [{
              gameId:
                game.gameId,

              date,

              awayTeamName:
                game.awayTeamName,

              homeTeamName:
                game.homeTeamName,

              awayMl:
                matched.awayMl,

              homeMl:
                matched.homeMl,

              awayHandicapLine:
                matched.awaySpreadLine,

              homeHandicapLine:
                matched.homeSpreadLine,

              awayHandicap:
                matched.awayHandicap,

              homeHandicap:
                matched.homeHandicap,

              totalLine:
                matched.totalLine,

              overOdds:
                matched.overOdds,

              underOdds:
                matched.underOdds,

              source: "AUTO",
            }];
          });

        if (autoOddsSnapshots.length) {
          fetch(
            "/api/odds/history",
            {
              method: "POST",

              headers: {
                "Content-Type":
                  "application/json",
              },

              body: JSON.stringify({
                snapshots:
                  autoOddsSnapshots,
              }),
            }
          )
            .then(async (response) => {
              if (!response.ok) {
                throw new Error(
                  `odds history POST ${response.status}`
                );
              }

              return response.json();
            })
            .then((result) => {
              console.log(
                "[AUTO ODDS HISTORY]",
                result
              );
            })
            .catch((error) => {
              /*
                히스토리 저장 실패 때문에
                경기/배당 화면 자체가 실패하면 안 된다.
              */
              console.error(
                "auto odds history save failed",
                error
              );
            });
        }

        setAllOdds((prev) => {
          const next = { ...prev };

          for (const game of loadedGames) {
            const away = normalizeTeamName(game.awayTeamName);
            const home = normalizeTeamName(game.homeTeamName);

            const matched = autoEvents.find((event) => {
              const oddsAway = normalizeTeamName(event.awayTeam);
              const oddsHome = normalizeTeamName(event.homeTeam);

              const sameTeams =
                away === oddsAway &&
                home === oddsHome;

              const sameDate =
                kstDateFromIso(event.commenceTime) === date;

              return sameTeams && sameDate;
            });

            if (!matched) continue;

            const current =
              next[game.gameId] || emptyOdds;

            // 사용자가 저장/잠금한 경기는 자동배당으로 덮어쓰지 않는다.
            if (lockedOdds[game.gameId]) {
              const saved =
                savedOdds[game.gameId];

              if (saved) {
                next[game.gameId] = saved;
              }

              continue;
            }

            // 잠금되지 않은 경기는 최신 자동배당 우선.
            // API에 없는 시장만 현재 입력값을 유지한다.
            next[game.gameId] = {
              awayMl:
                matched.awayMl ??
                current.awayMl,

              homeMl:
                matched.homeMl ??
                current.homeMl,

              awayHandicapLine:
                matched.awaySpreadLine ??
                current.awayHandicapLine,

              homeHandicapLine:
                matched.homeSpreadLine ??
                current.homeHandicapLine,

              awayHandicap:
                matched.awayHandicap ??
                current.awayHandicap,

              homeHandicap:
                matched.homeHandicap ??
                current.homeHandicap,

              totalLine:
                matched.totalLine ??
                current.totalLine,

              overOdds:
                matched.overOdds ??
                current.overOdds,

              underOdds:
                matched.underOdds ??
                current.underOdds,
            };
          }

          return next;
        });
      }
    } catch (e) {
      setError(
        e instanceof Error
          ? e.message
          : "불러오기 실패"
      );
    } finally {
      setLoading(false);
    }
  }


  // 저장된 배당 + 잠금 상태 복원
  useEffect(() => {
    try {
      const savedRaw =
        localStorage.getItem("kbo-analyzer-saved-odds");

      const lockedRaw =
        localStorage.getItem("kbo-analyzer-locked-odds");

      const saved: Record<string, OddsInput> =
        savedRaw ? JSON.parse(savedRaw) : {};

      const locked: Record<string, boolean> =
        lockedRaw ? JSON.parse(lockedRaw) : {};

      setSavedOdds(saved);
      setLockedOdds(locked);

      // 저장된 경기 배당은 화면에도 즉시 복원
      setAllOdds((prev) => ({
        ...prev,
        ...saved,
      }));
    } catch {}

    setOddsStorageReady(true);
  }, []);

  // 저장된 자동조합 스냅샷 복원
  useEffect(() => {
    try {
      const raw =
        localStorage.getItem(
          "kbo-analyzer-saved-combos-v1"
        );

      const parsed: SavedComboSnapshot[] =
        raw ? JSON.parse(raw) : [];

      setSavedCombos(
        Array.isArray(parsed)
          ? parsed
          : []
      );
    } catch {
      setSavedCombos([]);
    }

    setComboStorageReady(true);
  }, []);

  // 자동조합 스냅샷 영구 저장
  useEffect(() => {
    if (!comboStorageReady) return;

    localStorage.setItem(
      "kbo-analyzer-saved-combos-v1",
      JSON.stringify(savedCombos)
    );
  }, [savedCombos, comboStorageReady]);


  /*
    로그인 계정별 Supabase 상태 동기화

    - 자동 수집 경기/배당은 기존 공용 데이터 유지
    - 사용자가 저장한 배당/잠금/조합/설정만 계정별 저장
    - 로그인한 계정의 row가 없으면 현재 브라우저 데이터를
      최초 계정 데이터로 이관
    - 계정 복원이 끝나기 전에는 자동 저장하지 않음
  */
  useEffect(() => {
    if (
      !authReady ||
      !oddsStorageReady ||
      !comboStorageReady ||
      !comboSettingsReady
    ) {
      return;
    }

    let cancelled = false;

    async function restoreUserState() {
      /*
        로그아웃 상태에서는 Supabase 개인 상태를 읽지 않는다.
        경기/자동배당 로딩은 계속 가능하도록 ready 처리한다.
      */
      if (!authUser) {
        if (!cancelled) {
          setUserStateReady(true);
        }

        return;
      }

      /*
        다른 계정으로 바뀌었을 때 이전 계정의 ready 상태를
        그대로 사용하지 않도록 복원 시작 전에 false 처리.
      */
      setUserStateReady(false);

      try {
        const {
          data,
          error,
        } =
          await supabase
            .from("kbo_user_states")
            .select(
              "saved_odds, locked_odds, saved_combos, combo_settings"
            )
            .eq(
              "user_id",
              authUser.id
            )
            .maybeSingle();

        if (error) {
          throw error;
        }

        if (cancelled) {
          return;
        }

        /*
          계정 row가 아직 없으면 현재 브라우저 상태를
          최초 데이터로 올린다.
        */
        if (!data) {
          const initialComboSettings = {
            ...comboSettings,

            investmentAmount,

            investmentProfile,

            avoidInvestmentOverlap,

            investmentPlanCount,
          };

          const {
            error: insertError,
          } =
            await supabase
              .from("kbo_user_states")
              .insert({
                user_id:
                  authUser.id,

                saved_odds:
                  savedOdds,

                locked_odds:
                  lockedOdds,

                saved_combos:
                  savedCombos,

                combo_settings:
                  initialComboSettings,
              });

          if (insertError) {
            throw insertError;
          }

          if (!cancelled) {
            setUserStateReady(true);
          }

          return;
        }

        const userSavedOdds =
          data.saved_odds &&
          typeof data.saved_odds === "object" &&
          !Array.isArray(data.saved_odds)
            ? data.saved_odds as Record<
                string,
                OddsInput
              >
            : {};

        const userLockedOdds =
          data.locked_odds &&
          typeof data.locked_odds === "object" &&
          !Array.isArray(data.locked_odds)
            ? data.locked_odds as Record<
                string,
                boolean
              >
            : {};

        const userSavedCombos =
          Array.isArray(
            data.saved_combos
          )
            ? data.saved_combos as
                SavedComboSnapshot[]
            : [];

        const userComboSettings =
          data.combo_settings &&
          typeof data.combo_settings === "object" &&
          !Array.isArray(
            data.combo_settings
          )
            ? data.combo_settings as
                Record<string, unknown>
            : {};

        setSavedOdds(
          userSavedOdds
        );

        setLockedOdds(
          userLockedOdds
        );

        setSavedCombos(
          userSavedCombos
        );

        /*
          자동 수집된 base odds 위에
          이 계정의 수동 저장 배당만 overlay.
        */
        setAllOdds((prev) => ({
          ...prev,
          ...userSavedOdds,
        }));

        setComboSettings(
          (current) => ({
            ...current,

            ...(userComboSettings as
              Partial<typeof current>),

            legs:
              Array.isArray(
                userComboSettings.legs
              )
                ? userComboSettings.legs as number[]
                : current.legs,
          })
        );

        if (
          typeof
            userComboSettings
              .investmentAmount ===
          "string"
        ) {
          setInvestmentAmount(
            userComboSettings
              .investmentAmount
          );
        }

        if (
          userComboSettings
            .investmentProfile ===
            "SAFE" ||
          userComboSettings
            .investmentProfile ===
            "BALANCED" ||
          userComboSettings
            .investmentProfile ===
            "AGGRESSIVE"
        ) {
          setInvestmentProfile(
            userComboSettings
              .investmentProfile
          );
        }

        if (
          typeof
            userComboSettings
              .avoidInvestmentOverlap ===
          "boolean"
        ) {
          setAvoidInvestmentOverlap(
            userComboSettings
              .avoidInvestmentOverlap
          );
        }

        if (
          userComboSettings
            .investmentPlanCount === 2 ||
          userComboSettings
            .investmentPlanCount === 3
        ) {
          setInvestmentPlanCount(
            userComboSettings.investmentPlanCount
          );
        }
      } catch (error) {
        console.error(
          "user state restore failed",
          error
        );
      } finally {
        if (!cancelled) {
          setUserStateReady(true);
        }
      }
    }

    restoreUserState();

    return () => {
      cancelled = true;
    };
  }, [
    authReady,
    authUser?.id,
    oddsStorageReady,
    comboStorageReady,
    comboSettingsReady,
  ]);


  /*
    Supabase 개인 데이터는 자동 저장하지 않는다.
    배당 저장/저장취소 또는 조합 저장/저장취소 버튼을
    눌렀을 때만 명시적으로 저장한다.
  */

  async function persistUserState(
    overrides?: {
      savedOdds?: Record<string, OddsInput>;
      lockedOdds?: Record<string, boolean>;
      savedCombos?: SavedComboSnapshot[];
    }
  ) {
    if (!authUser) {
      throw new Error(
        "로그인이 필요합니다."
      );
    }

    if (!userStateReady) {
      throw new Error(
        "계정 데이터를 불러오는 중입니다."
      );
    }

    const cloudComboSettings = {
      ...comboSettings,
      investmentAmount,
      investmentProfile,
      avoidInvestmentOverlap,
      investmentPlanCount,
    };

    const {
      error,
    } =
      await supabase
        .from("kbo_user_states")
        .upsert(
          {
            user_id:
              authUser.id,

            saved_odds:
              overrides?.savedOdds ??
              savedOdds,

            locked_odds:
              overrides?.lockedOdds ??
              lockedOdds,

            saved_combos:
              overrides?.savedCombos ??
              savedCombos,

            combo_settings:
              cloudComboSettings,
          },
          {
            onConflict:
              "user_id",
          }
        );

    if (error) {
      throw error;
    }
  }


  // 저장 버튼을 눌러 확정한 값만 영구 저장
  useEffect(() => {
    if (!oddsStorageReady) return;

    localStorage.setItem(
      "kbo-analyzer-saved-odds",
      JSON.stringify(savedOdds)
    );

    localStorage.setItem(
      "kbo-analyzer-locked-odds",
      JSON.stringify(lockedOdds)
    );
  }, [savedOdds, lockedOdds, oddsStorageReady]);

  // 저장값 복원이 끝난 뒤 경기/자동배당 로드
  useEffect(() => {
    if (
      !oddsStorageReady ||
      !userStateReady
    ) {
      return;
    }

    load();
  }, [
    date,
    oddsStorageReady,
    userStateReady,
  ]);

  // ------------------------------------------------------
  // 메인 경기 + 확정 라인업 실시간 갱신
  //
  // 전체 load()를 다시 돌리지 않고
  // 경기정보와 라인업만 조용히 갱신한다.
  // ------------------------------------------------------
  useEffect(() => {
    if (
      !oddsStorageReady ||
      !userStateReady
    ) {
      return;
    }

    // PERFORMANCE_V1:
    // 메인 경기/자동조합 화면이 아닐 때는
    // 경기+라인업 30초 폴링을 돌리지 않는다.
    if (
      activeTab !== "games" &&
      activeTab !== "combos"
    ) {
      return;
    }

    // 오늘 경기가 전부 종료/취소 상태라면
    // 더 이상 실시간 갱신할 필요가 없다.
    if (
      games.length > 0 &&
      games.every(
