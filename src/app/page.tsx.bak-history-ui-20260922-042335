                              item,
                              settlement,
                            }
                          ) => {
                            if (!settlement) {
                              return sum;
                            }

                            const stake =
                              item.stakeAmount ||
                              0;

                            if (
                              settlement.status ===
                              "WIN"
                            ) {
                              return (
                                sum +
                                Math.round(
                                  stake *
                                    settlement.effectiveOdds
                                ) -
                                stake
