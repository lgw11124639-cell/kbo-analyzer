function bullpenRating(
  bullpen: BullpenData | undefined
): BullpenRating | null {
  if (!bullpen) {
    return null;
  }

  const fatigue =
    bullpen.summary.fatigueIndex;

  /*
    피로도 0 = 100점
    피로도 100 = 0점

    피로도가 낮을수록
    오늘 사용할 수 있는 불펜 여력이 높다고 본다.
  */

  const score =
    clampScore(
      100 - fatigue
    );

  let status =
    "보통";

  if (fatigue >= 75) {
    status = "매우 피로";
  } else if (fatigue >= 55) {
    status = "피로";
  } else if (fatigue <= 25) {
    status = "매우 여유";
  } else if (fatigue <= 40) {
    status = "여유";
  }

  return {
    score:
      Number(score.toFixed(1)),

    fatigue:
      Number(fatigue.toFixed(1)),

    status,
  };
}
function h15ShadowInnings(
  value: string | number | null | undefined
): number | null {
  if (value === null || value === undefined || value === "") return null;
  const text = String(value).trim();
  const mixed = text.match(/^(\d+)\s+([12])\/3$/);
  if (mixed) return Number(mixed[1]) + Number(mixed[2]) / 3;
  const fraction = text.match(/^([12])\/3$/);
  if (fraction) return Number(fraction[1]) / 3;
  const n = Number(text);
  if (!Number.isFinite(n)) return null;
  const whole = Math.floor(n);
  const decimal = n - whole;
  if (Math.abs(decimal - 0.1) < 0.02) return whole + 1 / 3;
  if (Math.abs(decimal - 0.2) < 0.02) return whole + 2 / 3;
  return n;
}

function h15ShadowClamp(value: number, lo: number, hi: number) {
  return Math.max(lo, Math.min(hi, value));
}

function h15ShadowStarterEra(stats: PitcherStats | undefined) {
  if (!stats) return null;
  const season = stats.era === null || stats.era === undefined ? null : Number(stats.era);
  const recent = stats.recent5?.era === null || stats.recent5?.era === undefined ? null : Number(stats.recent5.era);
  const s = season !== null && Number.isFinite(season) ? season : null;
  const r = recent !== null && Number.isFinite(recent) ? recent : null;
  if (s === null && r === null) return null;
  if (s !== null && r !== null) return s * 0.5 + r * 0.5;
  return s ?? r;
}

function h15ShadowStarterIp(stats: PitcherStats | undefined) {
  if (!stats) return null;
  const recentGames = Number(stats.recent5?.games ?? 0);
  const recentInnings = h15ShadowInnings(stats.recent5?.innings);
  let expected: number | null = null;
  if (recentGames > 0 && recentInnings !== null && recentInnings > 0) {
    expected = recentInnings / recentGames;
  } else {
    const seasonGames = Number(stats.games ?? 0);
    const seasonInnings = h15ShadowInnings(stats.innings);
    if (seasonGames > 0 && seasonInnings !== null && seasonInnings > 0) {
      expected = seasonInnings / seasonGames;
    }
  }
  return expected === null ? null : h15ShadowClamp(expected, 3.5, 7);
}

function h15ShadowMargins(
  game: KboGame,
  forms: Record<string, TeamForm>,
  pitchers: Record<number, PitcherStats>,
  bullpenQuality: Record<string, H15ShadowBullpenData>
): { starterAwayMargin: number; bullpenAwayMargin: number } | null {
  const awayForm = forms[game.awayTeamName];
  const homeForm = forms[game.homeTeamName];
  const awayStarterId = game.startingPitchers.away?.id;
  const homeStarterId = game.startingPitchers.home?.id;
  const awayStarter = awayStarterId ? pitchers[awayStarterId] : undefined;
  const homeStarter = homeStarterId ? pitchers[homeStarterId] : undefined;
  const awayBp = bullpenQuality[game.awayTeamName];
  const homeBp = bullpenQuality[game.homeTeamName];

  const ar = Number(awayForm?.seasonAvgRuns);
  const ara = Number(awayForm?.seasonAvgRunsAllowed);
  const hr = Number(homeForm?.seasonAvgRuns);
  const hra = Number(homeForm?.seasonAvgRunsAllowed);

  if (
    !awayForm || !homeForm ||
    !Number.isFinite(ar) || !Number.isFinite(ara) ||
    !Number.isFinite(hr) || !Number.isFinite(hra) ||
    !awayStarter || !homeStarter ||
    !awayBp?.ready || !homeBp?.ready
  ) return null;

  const awayStarterEra = h15ShadowStarterEra(awayStarter);
  const homeStarterEra = h15ShadowStarterEra(homeStarter);
  const awayStarterIp = h15ShadowStarterIp(awayStarter);
  const homeStarterIp = h15ShadowStarterIp(homeStarter);

  if (
    awayStarterEra === null || homeStarterEra === null ||
    awayStarterIp === null || homeStarterIp === null
  ) return null;

  const awayBpSeason = Number(awayBp.season?.era);
  const awayBpRecent = Number(awayBp.recent14?.era);
  const homeBpSeason = Number(homeBp.season?.era);
  const homeBpRecent = Number(homeBp.recent14?.era);

  if (
    !Number.isFinite(awayBpSeason) || !Number.isFinite(awayBpRecent) ||
    !Number.isFinite(homeBpSeason) || !Number.isFinite(homeBpRecent)
  ) return null;

  const awayBase = (ar + hra) / 2;
  const homeBase = (hr + ara) / 2;

  const awayStarterScore = h15ShadowClamp(
    awayBase + (homeStarterEra - hra) * (homeStarterIp / 9) * 0.5,
    0.5,
    12
  );

  const homeStarterScore = h15ShadowClamp(
    homeBase + (awayStarterEra - ara) * (awayStarterIp / 9) * 0.5,
    0.5,
    12
  );

  const awayBullpenEra = awayBpSeason * 0.4 + awayBpRecent * 0.6;
  const homeBullpenEra = homeBpSeason * 0.4 + homeBpRecent * 0.6;
  const awayExpectedBpIp = h15ShadowClamp(9 - awayStarterIp, 2, 5.5);
  const homeExpectedBpIp = h15ShadowClamp(9 - homeStarterIp, 2, 5.5);

  const awayBullpenScore = h15ShadowClamp(
    awayStarterScore + (homeBullpenEra - hra) * (homeExpectedBpIp / 9) * 0.75,
    0.5,
    12
  );

  const homeBullpenScore = h15ShadowClamp(
    homeStarterScore + (awayBullpenEra - ara) * (awayExpectedBpIp / 9) * 0.75,
    0.5,
    12
  );

  return {
    starterAwayMargin: awayStarterScore - homeStarterScore,
    bullpenAwayMargin: awayBullpenScore - homeBullpenScore,
  };
}

