                  combo.picks.filter(
                    (pick) =>
                      (pick.ev ?? -1) < 0
                  ).length;

                const gameCounts =
                  new Map<string, number>();

                for (
                  const pick of
                  combo.picks
                ) {
                  gameCounts.set(
                    pick.gameId,
                    (
                      gameCounts.get(
                        pick.gameId
                      ) || 0
                    ) + 1
                  );
                }

                const sameGameExtra =
                  [...gameCounts.values()]
                    .filter(
                      (count) =>
                        count > 1
