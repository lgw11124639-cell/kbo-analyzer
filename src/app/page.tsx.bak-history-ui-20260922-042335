  async function updateSavedComboStake(itemId: string) {
    const raw = savedComboStakeEdits[itemId] ?? "";
    const nextStake = Math.max(
      0,
      Number(raw.replace(/[^0-9]/g, "")) || 0
    );

    if (nextStake <= 0) {
      setSavedComboStakeMessage((prev) => ({
        ...prev,
        [itemId]: "금액을 입력하세요",
      }));
      return;
    }

    if (savedComboStakeBusy[itemId]) return;

    setSavedComboStakeBusy((prev) => ({
      ...prev,
      [itemId]: true,
    }));

    setSavedComboStakeMessage((prev) => ({
      ...prev,
      [itemId]: "저장 중...",
    }));

    try {
      const nextSavedCombos = savedCombos.map((item) =>
        item.id === itemId
          ? { ...item, stakeAmount: nextStake }
          : item
      );

      await persistUserState({
        savedCombos: nextSavedCombos,
      });

      setSavedCombos(nextSavedCombos);

      setSavedComboStakeEditing((prev) => ({
        ...prev,
        [itemId]: false,
      }));

      setSavedComboStakeMessage((prev) => ({
        ...prev,
        [itemId]: "수정됨 ✓",
      }));

      window.setTimeout(() => {
        setSavedComboStakeMessage((prev) => {
          const next = { ...prev };
          delete next[itemId];
          return next;
        });
      }, 1500);
    } catch (error) {
      console.error("saved combo stake update failed", error);
      setSavedComboStakeMessage((prev) => ({
        ...prev,
        [itemId]: "수정 실패",
      }));
    } finally {
      setSavedComboStakeBusy((prev) => ({
        ...prev,
        [itemId]: false,
      }));
    }
  }


