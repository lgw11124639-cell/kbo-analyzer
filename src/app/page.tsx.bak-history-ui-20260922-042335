  async function submitAuth() {
    const login =
      authLogin
        .trim()
        .toLowerCase();

    const email =
      authEmail
        .trim()
        .toLowerCase();

    if (!login) {
      setAuthMessage(
        authMode === "login"
          ? "아이디 또는 이메일을 입력해주세요."
          : "아이디를 입력해주세요."
      );
      return;
    }

    if (
      authMode === "signup" &&
      !email
    ) {
      setAuthMessage(
        "이메일을 입력해주세요."
      );
      return;
    }

    if (
      authMode === "signup" &&
      !email.includes("@")
    ) {
      setAuthMessage(
        "올바른 이메일을 입력해주세요."
      );
      return;
    }

    if (
      authPassword.length < 6
    ) {
      setAuthMessage(
        "비밀번호는 6자 이상 입력해주세요."
      );
      return;
    }

    if (
      authMode === "signup" &&
      !/^[a-z0-9._-]{3,30}$/.test(
        login
      )
    ) {
      setAuthMessage(
        "아이디는 영문 소문자, 숫자, ., _, - 조합으로 3~30자 입력해주세요."
      );
      return;
    }

    setAuthBusy(true);
    setAuthMessage("");

    try {
      if (
        authMode === "signup"
      ) {
        const {
          data,
          error,
        } =
          await supabase.auth.signUp({
            email,
            password:
              authPassword,

            options: {
              data: {
                login_id:
                  login,
              },
            },
          });

        if (error) {
          throw error;
        }

        if (data.session) {
          setAuthMessage(
            "회원가입과 로그인이 완료되었습니다."
          );

          setAuthLogin("");
          setAuthEmail("");
          setAuthPassword("");

          setAuthOpen(false);
        } else {
          setAuthMessage(
            "회원가입 완료. 이메일 인증 후 로그인해주세요."
          );

          setAuthMode("login");
          setAuthLogin(login);
          setAuthPassword("");
        }

        return;
      }

      const response =
        await fetch(
          "/api/auth/login",
          {
            method: "POST",

            headers: {
              "Content-Type":
                "application/json",
            },

            body:
              JSON.stringify({
                login,
                password:
                  authPassword,
              }),
          }
        );

      const result =
        await response.json();

      if (
        !response.ok ||
        !result?.session
      ) {
        throw new Error(
          result?.error ||
          "아이디 또는 비밀번호를 확인해주세요."
        );
      }

      const {
        error,
      } =
        await supabase.auth
          .setSession({
            access_token:
              result.session
                .access_token,

            refresh_token:
              result.session
                .refresh_token,
          });

      if (error) {
        throw error;
      }

      setAuthLogin("");
      setAuthEmail("");
      setAuthPassword("");
      setAuthOpen(false);

    } catch (error) {
      setAuthMessage(
        error instanceof Error
          ? error.message
          : "인증 처리 중 오류가 발생했습니다."
      );
    } finally {
      setAuthBusy(false);
    }
  }

