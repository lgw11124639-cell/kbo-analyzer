          ) {
            wholeGamePredictionMap.set(
              key,
              pick
            );
          }
        }


        /* HANDICAP_15_AI_DIRECTION_V1 */
        for (const game of games) {
          const gamePicks = allPicks.filter(
            (pick) => pick.gameId === game.gameId
          );

          const preferredHandicap =
            selectHandicap15Direction(
              gamePicks,
              game
            );

          if (preferredHandicap) {
            wholeGamePredictionMap.set(
              `${game.gameId}:HANDICAP`,
              preferredHandicap
            );
          }
        }

        const eligiblePicks =
          [
            ...wholeGamePredictionMap.values(),
          ].filter(
            (pick) =>
              typeof pick.confidence ===
                "number" &&
              pick.confidence > 0 &&
              typeof pick.odds ===
                "number" &&
              pick.odds > 1
          );

        const results:
          Array<
            (typeof practicalComboCandidates)[number]
          > = [];

        const makeCandidate = (
          picks: Pick[],
          leg: number,
          index: number
        ) => {
          const odds =
            picks.reduce(
              (value, pick) =>
                value *
                (
                  pick.odds ??
                  1
                ),
              1
            );

          const probability =
            picks.reduce(
              (value, pick) =>
                value *
                pick.confidence,
              1
            );

          const averageConfidence =
            picks.reduce(
              (value, pick) =>
                value +
                pick.confidence,
              0
            ) /
            Math.max(
              1,
              picks.length
            );

          const evValues =
            picks
              .map(
                (pick) =>
                  pick.ev
              )
              .filter(
                (
                  value
                ): value is number =>
                  typeof value ===
                  "number"
              );

          const averageEv =
            evValues.length
              ? evValues.reduce(
                  (
                    value,
                    ev
                  ) =>
                    value + ev,
                  0
                ) /
                evValues.length
              : null;

          return {
            name:
              `AI 후보 ${leg}폴 ${index}`,
