                      const dayComboWins =
                        daySettlements.filter(
                          ({ settlement }) =>
                            settlement?.status ===
                            "WIN"
                        ).length;

                      const dayComboLosses =
                        daySettlements.filter(
                          ({ settlement }) =>
                            settlement?.status ===
                            "LOSS"
                        ).length;

                      const dayComboDecided =
                        dayComboWins +
                        dayComboLosses;

                      let dayPickWins = 0;
                      let dayPickLosses = 0;

                      for (
                        const {
                          settlement,
                        } of daySettlements
                      ) {
                        if (!settlement) {
                          continue;
                        }

                        for (
                          const result of
                          settlement.pickResults
                        ) {
                          if (
                            result === "WIN"
                          ) {
                            dayPickWins += 1;
                          } else if (
                            result === "LOSS"
                          ) {
                            dayPickLosses += 1;
                          }
                        }
                      }

                      const dayPickDecided =
                        dayPickWins +
                        dayPickLosses;

                      const dayComboHitRate =
                        dayComboDecided > 0
                          ? (
                              dayComboWins /
                              dayComboDecided *
                              100
                            )
                          : null;

                      const dayPickHitRate =
                        dayPickDecided > 0
                          ? (
                              dayPickWins /
                              dayPickDecided *
                              100
                            )
                          : null;


                      const dayRealizedProfit =
