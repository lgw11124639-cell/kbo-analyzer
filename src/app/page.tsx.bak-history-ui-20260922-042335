  const frozenABRecoveryRatio =
    frozenABCombo &&
    frozenABCombo.odds > 1
      ? Math.max(
          0,
          Math.min(
            1,
            1 /
              frozenABCombo.odds
          )
        )
      : 0;

  const investmentPlanRatio = (
    key: string,
    defaultRatio: number
  ) => {
    if (
      investmentPlanCount !== 2
    ) {
      return defaultRatio;
    }

    if (
      investmentProfile === "SAFE"
    ) {
      if (
        key === "defense" ||
        key === "defense2"
      ) {
        return 0.5;
      }

      return 0;
    }

    if (
      investmentProfile ===
      "BALANCED"
    ) {
      if (key === "defense") {
        return (
          frozenABRecoveryRatio
        );
      }

      if (key === "balance") {
        return (
          1 -
          frozenABRecoveryRatio
        );
      }

      return 0;
    }

    if (
      investmentProfile ===
      "AGGRESSIVE"
    ) {
      if (key === "defense") {
        return (
          frozenABRecoveryRatio
        );
      }

      if (key === "attack") {
        return (
          1 -
          frozenABRecoveryRatio
        );
      }

      return 0;
    }

    return defaultRatio;
  };

