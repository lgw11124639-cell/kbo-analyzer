                      pick.grade === "A"
                        ? 300
                        : pick.grade === "B"
                          ? 200
                          : 100;
      
                    return (
                      gradeScore +
                      pick.confidence * 100 +
                      (pick.ev ?? -1) * 100
                    );
                  };
      
                  /*
                    MARKET_DIRECTION_CONFIDENCE_V1

                    경기별 전체예측의 각 시장 방향은
                    LIVE 통계 저장 규칙과 동일하게
                    confidence가 가장 높은 방향 1개를 사용한다.

                    EV/등급은 시장 내부 방향을 뒤집는 용도가 아니다.

                    confidence가 완전히 같을 때만
                    기존 종합점수를 tie-break로 사용한다.
                  */
                  const selectMarketPick = (
                    market: "ML" | "HANDICAP" | "TOTAL"
                  ) => {
                    if (market === "HANDICAP") {
