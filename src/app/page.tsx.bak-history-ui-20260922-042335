/* HANDICAP_15_DIRECTION_SHARED_V1
   +/-1.5 시장 방향 통일:
   - -1.5 팀의 ML 모델확률 >= 67.5% -> -1.5
   - 그 미만 -> 반대편 +1.5
   - +/-1.5 쌍이 아니면 기존 confidence 우선
*/
function selectHandicap15Direction(
  picks: Pick[],
  game: { awayTeamName: string; homeTeamName: string }
): Pick | undefined {
  const handicapPicks = picks.filter(
    (pick) => pick.market === "HANDICAP"
  );

  const minus15 = handicapPicks.find(
    (pick) => pick.label.includes("-1.5")
  );

  const plus15 = handicapPicks.find(
    (pick) => pick.label.includes("+1.5")
  );

  if (minus15 && plus15) {
    const minusTeam = minus15.label.startsWith(game.awayTeamName)
      ? game.awayTeamName
      : minus15.label.startsWith(game.homeTeamName)
        ? game.homeTeamName
        : null;

    if (minusTeam) {
      const minusMl = picks.find(
        (pick) =>
          pick.market === "ML" &&
          pick.label === `${minusTeam} 승`
      );

      if (minusMl) {
        return minusMl.confidence >= 0.675
          ? minus15
          : plus15;
      }
    }
  }

  return [...handicapPicks].sort(
    (a, b) => b.confidence - a.confidence
  )[0];
}

