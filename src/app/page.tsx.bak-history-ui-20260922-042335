                동일 경기 두 번 선택 금지.
              */
              if (
                selected.some(
                  (current) =>
                    current.gameId ===
                    pick.gameId
                )
              ) {
                continue;
              }

              build(
                i + 1,
                [
                  ...selected,
                  pick,
                ]
              );
            }
          };

          build(
            0,
            []
          );
        }

        return results;
      },
      [
