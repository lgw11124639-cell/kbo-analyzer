}

.bullpenBox {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.bullpenBox.right {
  text-align: right;
  align-items: flex-end;
}

.bullpenBox b {
  font-size: 12px;
}

.bullpenBox strong {
  font-size: 13px;
}

.bullpenBox span {
  font-size: 10px;
  color: #cbd5e1;
}

.bullpenBox small {
  font-size: 9px;
  color: #94a3b8;
}

.bullpenVs {
  text-align: center;
  font-size: 9px;
  font-weight: 800;
  color: #64748b;
}

.bullpenEdge {
  margin-top: 8px;
  padding-top: 7px;
  border-top: 1px solid rgba(148,163,184,.12);
  text-align: center;
  font-size: 10px;
  font-weight: 700;
}

@media (max-width: 720px) {
  .bullpenGrid {
    grid-template-columns: 1fr;
  }

  .bullpenVs {
    display: none;
  }

  .bullpenBox.right {
    padding-top: 7px;
    border-top: 1px solid rgba(148,163,184,.1);
