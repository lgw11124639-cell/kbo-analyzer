};

function bullpenRating(
  bullpen: BullpenData | undefined
): BullpenRating | null {
  if (!bullpen) {
    return null;
  }

  const fatigue =
    bullpen.summary.fatigueIndex;

  /*
    피로도 0 = 100점
    피로도 100 = 0점

    피로도가 낮을수록
    오늘 사용할 수 있는 불펜 여력이 높다고 본다.
  */

  const score =
    clampScore(
      100 - fatigue
    );

  let status =
    "보통";

  if (fatigue >= 75) {
    status = "매우 피로";
  } else if (fatigue >= 55) {
    status = "피로";
  } else if (fatigue <= 25) {
    status = "매우 여유";
  } else if (fatigue <= 40) {
    status = "여유";
  }

  return {
    score:
      Number(score.toFixed(1)),

    fatigue:
      Number(fatigue.toFixed(1)),

    status,
  };
}
