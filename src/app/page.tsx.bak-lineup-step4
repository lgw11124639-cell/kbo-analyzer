type TeamFormRating = {
  score: number;
  offenseScore: number;
  defenseScore: number;
  resultScore: number;
};

function teamFormRating(
  form: TeamForm | undefined
): TeamFormRating | null {
  if (
    !form ||
    form.sampleSize < 5
  ) {
    return null;
  }

  /*
    최근 10경기 상대평가 v0.4

    승률      35%
    득점력    35%
    실점억제  30%

    KBO 평균값을 아직 자동 계산하지 않으므로
    초기 기준구간으로 상대점수를 만든다.
    추후 전체 리그 평균으로 동적 보정 예정.
  */

  const winPct =
    form.winPct ?? 0.5;

  const avgRuns =
    form.avgRuns ?? 4.5;

  const avgRunsAllowed =
    form.avgRunsAllowed ?? 4.5;

  const resultScore =
    clampScore(
      winPct * 100
    );

  const offenseScore =
    clampScore(
      50 +
        (avgRuns - 4.5) * 12
    );

  const defenseScore =
    clampScore(
      50 +
        (4.5 - avgRunsAllowed) * 12
    );

  const score =
    clampScore(
      resultScore * 0.35 +
      offenseScore * 0.35 +
      defenseScore * 0.30
    );

  return {
    score:
      Number(score.toFixed(1)),

    offenseScore:
      Number(
        offenseScore.toFixed(1)
      ),

    defenseScore:
      Number(
        defenseScore.toFixed(1)
      ),

    resultScore:
      Number(
        resultScore.toFixed(1)
      ),
  };
}
type StarterRating = {
  score: number;
  seasonScore: number;
  recentScore: number;
  reasons: string[];
};

function clampScore(value: number) {
  return Math.max(
    0,
    Math.min(100, value)
  );
}

function starterRating(
  stats: PitcherStats | undefined
): StarterRating | null {
  if (!stats) return null;

  /*
    v0.3 선발 평가

    시즌 60%
    최근 5경기 40%

    시즌:
    ERA  25점
    WHIP 20점
    QS율 10점
    K/BB 5점

    최근:
    ERA  20점
    WHIP 12점
    K/BB 8점

    이 값은 현재 초기 모델이며
    추후 실제 적중 데이터로 보정한다.
  */

  const era =
    stats.era ?? 5;

  const whip =
    stats.whip ?? 1.6;

  const qsRate =
    stats.games &&
    stats.games > 0 &&
    stats.qs !== null
      ? stats.qs / stats.games
      : 0.4;

  const seasonKbb =
    stats.walks &&
    stats.walks > 0 &&
    stats.strikeouts !== null
      ? stats.strikeouts /
        stats.walks
      : 2;

  const seasonEraScore =
    clampScore(
      100 -
        (era - 2) * 22
    );

  const seasonWhipScore =
    clampScore(
      100 -
        (whip - 0.9) * 100
    );

  const qsScore =
    clampScore(
      qsRate * 125
    );

  const kbbScore =
    clampScore(
      seasonKbb * 22
    );

  const seasonScore =
    seasonEraScore * 0.4167 +
    seasonWhipScore * 0.3333 +
    qsScore * 0.1667 +
    kbbScore * 0.0833;


  const r5 =
    stats.recent5;

  let recentScore =
    seasonScore;

  if (
    r5 &&
    r5.games >= 3
  ) {
    const recentEra =
      r5.era ?? era;

    const recentWhip =
      r5.whip ?? whip;

    const recentKbb =
      r5.kbb ?? seasonKbb;

    const recentEraScore =
      clampScore(
        100 -
          (recentEra - 2) * 22
      );

    const recentWhipScore =
      clampScore(
        100 -
          (recentWhip - 0.9) * 100
      );

    const recentKbbScore =
      clampScore(
        recentKbb * 22
      );

    recentScore =
      recentEraScore * 0.50 +
      recentWhipScore * 0.30 +
      recentKbbScore * 0.20;
  }


  const score =
    clampScore(
      seasonScore * 0.60 +
      recentScore * 0.40
    );


  const reasons: string[] = [];

  if (era <= 3.2) {
    reasons.push("시즌 ERA 우수");
  }

  if (whip <= 1.25) {
    reasons.push("WHIP 우수");
  }

  if (qsRate >= 0.6) {
    reasons.push("QS 안정성");
  }

  if (
    r5?.era !== null &&
    r5?.era !== undefined
  ) {
    if (r5.era <= 3) {
      reasons.push("최근 ERA 강세");
    }

    if (
      r5.era >= 5
    ) {
      reasons.push("최근 ERA 부진");
    }
  }

  if (
    r5?.whip !== null &&
    r5?.whip !== undefined &&
    r5.whip <= 1.2
  ) {
    reasons.push("최근 WHIP 강세");
  }

  return {
    score:
      Number(score.toFixed(1)),

    seasonScore:
      Number(
        seasonScore.toFixed(1)
      ),

    recentScore:
      Number(
        recentScore.toFixed(1)
      ),

    reasons,
  };
}

function starterEdgeText(
  away: PitcherStats | undefined,
  home: PitcherStats | undefined,
  awayName: string,
  homeName: string
) {
  const awayRating =
    starterRating(away);

  const homeRating =
    starterRating(home);

  if (
    !awayRating ||
    !homeRating
  ) {
    return null;
  }

  const diff =
    Number(
      (
        awayRating.score -
        homeRating.score
      ).toFixed(1)
    );

  if (
    Math.abs(diff) < 2
  ) {
    return {
      text: "선발 대등",
      detail:
        `${awayName} ${awayRating.score} · ` +
        `${homeName} ${homeRating.score}`,
      className: "even",
    };
  }

  const awayBetter =
    diff > 0;

  return {
    text:
      `선발 우위: ` +
      `${awayBetter ? awayName : homeName} ` +
      `+${Math.abs(diff).toFixed(1)}`,

    detail:
      `${awayName} ${awayRating.score} · ` +
      `${homeName} ${homeRating.score}`,

    className:
      awayBetter
        ? "away"
        : "home",
  };
}
function pitcherStatText(
  stats: PitcherStats | undefined
) {
  if (!stats) return "기록 불러오는 중";

  const parts: string[] = [];

  if (stats.era !== null) {
    parts.push(`ERA ${stats.era.toFixed(2)}`);
  }

  if (stats.whip !== null) {
    parts.push(`WHIP ${stats.whip.toFixed(2)}`);
  }

  if (
    stats.wins !== null &&
    stats.losses !== null
  ) {
    parts.push(
      `${stats.wins}승 ${stats.losses}패`
    );
  }

  return parts.length
    ? parts.join(" · ")
    : "시즌 기록 없음";
}

