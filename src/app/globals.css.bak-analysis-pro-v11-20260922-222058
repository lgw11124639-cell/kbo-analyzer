.manualSavedCardHead {
  margin: 0 !important;
  padding: 10px 11px !important;
  min-height: 52px !important;
}

.manualSavedCard[open] > .manualSavedCardHead {
  border-bottom: 1px solid #edf1f6 !important;
}

.manualSavedCardHead h3 {
