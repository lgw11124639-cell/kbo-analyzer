/* ===== PREMIUM DETAIL WEBSITE V1 ===== */
.gameCard.isExpanded {
  position: fixed !important;
  inset: 0 !important;
  z-index: 9999 !important;
  width: 100vw !important;
  max-width: none !important;
  height: 100dvh !important;
  margin: 0 !important;
  border-radius: 0 !important;
  overflow-y: auto !important;
  background:
    radial-gradient(circle at 50% -10%, rgba(37,99,235,.13), transparent 32%),
    #070b14 !important;
  color: #f8fafc;
}

.gameCard.isExpanded > *:not(.detailStickyBar) {
  width: min(1480px, calc(100% - 40px));
  margin-left: auto;
  margin-right: auto;
}

.gameCard.isExpanded .detailStickyBar {
  position: sticky;
  top: 0;
  z-index: 100;
  min-height: 64px;
  padding: 0 28px;
  border-bottom: 1px solid rgba(148,163,184,.18);
  background: rgba(7,11,20,.92);
  backdrop-filter: blur(18px);
}

.premiumDetailHub {
  padding: 28px 0 22px;
}

.premiumHero {
  position: relative;
  overflow: hidden;
  padding: 34px;
  border: 1px solid rgba(148,163,184,.16);
  border-radius: 28px;
  background:
    linear-gradient(135deg, rgba(15,23,42,.98), rgba(9,14,26,.98));
  box-shadow: 0 20px 60px rgba(0,0,0,.28);
}

.premiumHero::after {
  content: "";
  position: absolute;
  inset: auto -140px -180px auto;
  width: 420px;
  height: 420px;
  border-radius: 999px;
  background: rgba(37,99,235,.12);
  filter: blur(20px);
}

.premiumHeroEyebrow {
  margin-bottom: 22px;
  text-align: center;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: .22em;
  color: #60a5fa;
}

.premiumHeroTeams {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 1fr minmax(260px, .8fr) 1fr;
  align-items: center;
  gap: 28px;
}

.premiumHeroTeam {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.premiumHeroTeam.home {
  text-align: right;
  align-items: flex-end;
}

.premiumHeroTeam small {
  font-size: 11px;
  font-weight: 900;
  letter-spacing: .14em;
  color: #64748b;
}

.premiumHeroTeam strong {
  font-size: clamp(26px, 3vw, 42px);
  line-height: 1;
  color: #fff;
}

.premiumHeroTeam span {
  font-size: 14px;
  color: #94a3b8;
}

.premiumHeroCenter {
  text-align: center;
}

.premiumHeroMeta {
  font-size: 13px;
  color: #94a3b8;
}

.premiumHeroScore {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 18px;
  margin: 10px 0 4px;
}

.premiumHeroScore b {
  font-size: clamp(40px, 5vw, 68px);
  line-height: 1;
  color: #fff;
}

.premiumHeroScore em {
  font-style: normal;
  font-size: 30px;
  color: #475569;
}

.premiumHeroCenter small {
  color: #64748b;
}

.premiumWinProbability {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 150px 1fr 150px;
  align-items: center;
  gap: 16px;
  margin-top: 30px;
}

.premiumWinProbability > div:first-child,
.premiumWinProbability > div:last-child {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  color: #cbd5e1;
}

.premiumWinProbability .right {
  text-align: right;
}

.premiumProbabilityBar {
  height: 8px;
  overflow: hidden;
  border-radius: 999px;
  background: rgba(239,68,68,.8);
}

.premiumProbabilityBar i {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: #3b82f6;
}

.premiumOutlook,
.premiumVerdict {
  margin-top: 20px;
  padding: 28px;
  border: 1px solid rgba(148,163,184,.14);
  border-radius: 24px;
  background: rgba(15,23,42,.72);
}

.premiumSectionTitle {
  display: flex;
  gap: 14px;
  align-items: center;
  margin-bottom: 16px;
}

.premiumSectionTitle > span,
.premiumMetricHead span {
  display: inline-grid;
  place-items: center;
  min-width: 38px;
  height: 38px;
  padding: 0 10px;
  border-radius: 12px;
  background: rgba(59,130,246,.14);
  color: #60a5fa;
  font-weight: 900;
  font-size: 12px;
}

.premiumSectionTitle div {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.premiumSectionTitle b {
  font-size: 19px;
  color: #fff;
}

.premiumSectionTitle small {
  color: #64748b;
}

.premiumSectionTitle.compact {
  margin-bottom: 18px;
}

.premiumOutlook p,
.premiumDeepCard p,
.premiumVerdict p {
  margin: 0;
  font-size: 15px;
  line-height: 1.85;
  color: #cbd5e1;
}

.premiumMetricGrid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0,1fr));
  gap: 16px;
  margin-top: 20px;
}

.premiumMetricCard,
.premiumDeepCard {
  padding: 22px;
  border: 1px solid rgba(148,163,184,.14);
  border-radius: 22px;
  background: rgba(15,23,42,.7);
}

.premiumMetricHead {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 18px;
}

.premiumMetricHead b {
  color: #e2e8f0;
  font-size: 15px;
}

.premiumMetricCard > strong {
  display: block;
  min-height: 24px;
  margin-bottom: 10px;
  font-size: 18px;
  color: #fff;
}

.premiumMetricCard > p {
  min-height: 84px;
  margin: 0;
  font-size: 13px;
  line-height: 1.7;
  color: #94a3b8;
}

.premiumMetricFoot {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  margin-top: 16px;
}

.premiumMetricFoot span {
  padding: 6px 9px;
  border-radius: 9px;
  background: rgba(30,41,59,.9);
  color: #cbd5e1;
  font-size: 11px;
}

.premiumDeepGrid {
  display: grid;
  grid-template-columns: repeat(2,minmax(0,1fr));
  gap: 16px;
  margin-top: 20px;
}

.premiumProjectedScore {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: end;
  gap: 20px;
  margin: 10px 0 20px;
}

.premiumProjectedScore > div {
  display: flex;
  flex-direction: column;
  gap: 4px;
  text-align: center;
}

.premiumProjectedScore span {
  color: #94a3b8;
}

.premiumProjectedScore b {
  font-size: 40px;
  color: #fff;
}

.premiumProjectedScore em {
  padding-bottom: 7px;
  font-style: normal;
  font-size: 24px;
  color: #475569;
}

.premiumTimeline {
  display: grid;
  gap: 12px;
}

.premiumTimeline > div {
  display: grid;
  grid-template-columns: 78px 1fr;
  align-items: center;
  gap: 12px;
  padding: 13px 14px;
  border-radius: 14px;
  background: rgba(30,41,59,.72);
}

.premiumTimeline b {
  color: #60a5fa;
}

.premiumTimeline span {
  color: #cbd5e1;
  font-size: 13px;
}

.premiumVolatility {
  display: inline-flex;
  margin: 2px 0 14px;
  padding: 7px 13px;
  border-radius: 999px;
  background: rgba(245,158,11,.14);
  color: #fbbf24;
}

.premiumVolatility.high {
  background: rgba(239,68,68,.14);
  color: #f87171;
}

.premiumCheckList {
  display: grid;
  gap: 10px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.premiumCheckList li {
  position: relative;
  padding-left: 22px;
  font-size: 13px;
  line-height: 1.65;
  color: #cbd5e1;
}

.premiumCheckList li::before {
  content: "✓";
  position: absolute;
  left: 0;
  color: #60a5fa;
  font-weight: 900;
}

.premiumVerdict {
  display: grid;
  grid-template-columns: 190px 1fr;
  gap: 22px;
  align-items: center;
  background:
    linear-gradient(135deg, rgba(30,58,138,.26), rgba(15,23,42,.82));
}

.premiumVerdict > div {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.premiumVerdict span {
  font-size: 10px;
  letter-spacing: .12em;
  color: #60a5fa;
}

.premiumVerdict b {
  font-size: 20px;
  color: #fff;
}

.gameCard.isExpanded .detailedOverallAnalysis {
  margin-top: 20px !important;
  border-radius: 24px !important;
  border-color: rgba(148,163,184,.14) !important;
  background: rgba(15,23,42,.72) !important;
}

@media (max-width: 1100px) {
  .premiumMetricGrid {
    grid-template-columns: repeat(2,minmax(0,1fr));
  }

  .premiumHeroTeams {
    grid-template-columns: 1fr 220px 1fr;
  }
}

@media (max-width: 720px) {
  .gameCard.isExpanded > *:not(.detailStickyBar) {
    width: min(100% - 24px, 1480px);
  }

  .gameCard.isExpanded .detailStickyBar {
    padding: 0 14px;
  }

  .premiumDetailHub {
    padding-top: 16px;
  }

  .premiumHero {
    padding: 22px 16px;
    border-radius: 20px;
  }

  .premiumHeroTeams {
    grid-template-columns: 1fr;
    gap: 18px;
  }

  .premiumHeroTeam,
  .premiumHeroTeam.home {
    align-items: center;
    text-align: center;
  }

  .premiumHeroCenter {
    order: -1;
  }

  .premiumWinProbability {
    grid-template-columns: 1fr;
    gap: 9px;
  }

  .premiumProbabilityBar {
    order: 2;
  }

  .premiumWinProbability > div:first-child,
  .premiumWinProbability > div:last-child {
    justify-content: center;
  }

  .premiumMetricGrid,
  .premiumDeepGrid {
    grid-template-columns: 1fr;
  }

  .premiumMetricCard > p {
    min-height: 0;
  }

  .premiumVerdict {
    grid-template-columns: 1fr;
  }

  .premiumHeroScore b {
    font-size: 46px;
  }
}

/* ===== HOMEPAGE ANALYSIS MODE V1 ===== */

:root {
  --home-bg: #f3f6fb;
  --home-card: #ffffff;
  --home-border: #dde5ef;
  --home-text: #111827;
  --home-muted: #68758a;
  --home-navy: #08111f;
  --home-blue: #2563eb;
}

body {
  background: var(--home-bg);
}

.content {
  max-width: 1680px;
  margin: 0 auto;
  padding: 30px 34px 70px;
}

header {
  position: sticky;
  top: 0;
  z-index: 80;
  margin: -30px -34px 28px;
  padding: 18px 34px;
  border-bottom: 1px solid rgba(203,213,225,.8);
  background: rgba(243,246,251,.94);
  backdrop-filter: blur(16px);
}

.gameGrid {
  display: grid !important;
  grid-template-columns: minmax(0,1fr) !important;
  gap: 34px !important;
  width: 100%;
}

.gameGrid > * {
  min-width: 0;
}

.gameCard.homepageGameSection {
  position: relative !important;
  inset: auto !important;
  width: 100% !important;
  max-width: none !important;
  height: auto !important;
  min-height: 0 !important;
  margin: 0 !important;
  padding: 0 !important;
  overflow: visible !important;
  border: 1px solid var(--home-border) !important;
  border-radius: 26px !important;
  background: var(--home-card) !important;
  color: var(--home-text) !important;
  box-shadow:
    0 2px 4px rgba(15,23,42,.03),
    0 18px 50px rgba(15,23,42,.06) !important;
}

.gameCard.homepageGameSection:hover {
  transform: none !important;
}

/*
  프리미엄 홈페이지 영역이 메인 요약 역할을 하므로
  예전 카드형 중복 헤더/요약은 숨긴다.
*/
.homepageGameSection > .cardTop,
.homepageGameSection > .scoreMatchup,
.homepageGameSection > .starterCompare,
.homepageGameSection > .detailTopGrid {
  display: none !important;
}

.homepageGameSection .premiumDetailHub {
  display: block !important;
  width: 100% !important;
  margin: 0 !important;
  padding: 24px !important;
  border-radius: 26px 26px 0 0;
  background:
    linear-gradient(180deg,#07101e 0,#0b1322 100%);
}

.homepageGameSection .premiumHero {
  margin: 0;
}

.homepageGameSection .premiumOutlook,
.homepageGameSection .premiumMetricGrid,
.homepageGameSection .premiumDeepGrid,
.homepageGameSection .premiumVerdict {
  max-width: none;
}

/*
  기존 분석 기능들은 삭제하지 않고
  프리미엄 헤더 아래의 홈페이지 섹션으로 재배치한다.
*/
.homepageGameSection .lineupAnalysis,
.homepageGameSection .detailBottomGrid,
.homepageGameSection .gameCardPredictionPicker,
.homepageGameSection .detailedOverallAnalysis {
  width: calc(100% - 48px) !important;
  margin-left: 24px !important;
  margin-right: 24px !important;
}

.homepageGameSection .lineupAnalysis {
  margin-top: 26px !important;
}

.homepageGameSection .detailBottomGrid {
  margin-top: 24px !important;
}

.homepageGameSection .gameCardPredictionPicker {
  margin-top: 24px !important;
}

.homepageGameSection .detailedOverallAnalysis {
  margin-top: 24px !important;
  margin-bottom: 28px !important;
}

/*
  기존 isExpanded 전용 CSS가 남아 있어도
  홈페이지 모드에서는 fixed/modal 동작을 무효화한다.
*/
.gameCard.homepageGameSection.isExpanded,
.gameGrid > .gameCard.homepageGameSection {
  position: relative !important;
  inset: auto !important;
  width: 100% !important;
  max-width: none !important;
  height: auto !important;
  overflow: visible !important;
  border-radius: 26px !important;
}

/* 경기 사이를 명확하게 구분 */
.homepageGameSection + .homepageGameSection {
  margin-top: 0;
}

/* 메인 페이지 상단을 스포츠 분석 사이트처럼 */
header h1 {
  font-size: 30px;
  letter-spacing: -.04em;
}

header p {
  color: #69778d;
}

.headerActions input,
.headerActions button {
  min-height: 42px;
  border-radius: 11px;
}

/* 하단 분석 카드들도 좀 더 홈페이지형으로 */
.homepageGameSection .gameCardPredictionPicker,
.homepageGameSection .detailedOverallAnalysis,
.homepageGameSection .lineupAnalysis,
.homepageGameSection .marketProbabilitySection,
.homepageGameSection .totalAnalysis {
  border-radius: 20px !important;
}

/* 직접조합은 경기목록과 시각적으로 분리 */
.manualGameComboBuilder {
  margin-top: 42px !important;
}

