.oddsMarkets {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 14px;
}

.marketBlock {
  border: 1px solid rgba(148, 163, 184, 0.18);
  background: rgba(15, 23, 42, 0.35);
  border-radius: 12px;
  padding: 12px;
}

.marketTitle {
  display: block;
  font-size: 13px;
  margin-bottom: 8px;
  color: #cbd5e1;
}

.marketBlock .oddsRow {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
}

.marketBlock .oddsRow label {
  min-width: 0;
}

@media (max-width: 720px) {
  .marketBlock .oddsRow {
    grid-template-columns: 1fr;
  }
}


.starterCompare {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 32px minmax(0, 1fr);
  gap: 10px;
  align-items: center;
  margin: 12px 0;
  padding: 12px;
  border-radius: 12px;
  background: rgba(15, 23, 42, 0.45);
  border: 1px solid rgba(148, 163, 184, 0.14);
}

.starterBox {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.starterBox.right {
  text-align: right;
  align-items: flex-end;
}

.starterLabel {
  font-size: 11px;
  color: #94a3b8;
}

.starterBox b {
  font-size: 14px;
}

.starterBox small {
  font-size: 11px;
  color: #cbd5e1;
  line-height: 1.4;
}

.starterBox em {
  font-size: 10px;
  font-style: normal;
  color: #94a3b8;
}

.starterVs {
  text-align: center;
  font-size: 11px;
  font-weight: 800;
  color: #64748b;
}

@media (max-width: 720px) {
  .starterCompare {
    grid-template-columns: 1fr;
  }

  .starterVs {
    display: none;
  }

  .starterBox.right {
    text-align: left;
    align-items: flex-start;
    padding-top: 8px;
    border-top: 1px solid rgba(148, 163, 184, 0.12);
  }
}


.starterAnalysis {
  margin: -3px 0 12px;
  padding: 10px 12px;
  border: 1px solid rgba(148, 163, 184, 0.16);
  border-radius: 10px;
  background: rgba(15, 23, 42, 0.06);
}

.starterAnalysisTop {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 8px;
}

.starterAnalysisTop b {
  font-size: 12px;
}

.starterAnalysisTop span {
  font-size: 10px;
  color: #64748b;
}

.starterMeters {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
}

.starterMeters > div {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 1px 8px;
  padding: 7px 8px;
  background: rgba(255,255,255,.55);
  border-radius: 8px;
}

.starterMeters span {
  font-size: 10px;
  color: #64748b;
}

.starterMeters strong {
  grid-row: span 2;
  font-size: 18px;
}

.starterMeters small {
  font-size: 9px;
  color: #94a3b8;
}

.starterReasons {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  margin-top: 7px;
}

.starterReasons span {
  padding: 3px 6px;
  border-radius: 999px;
  background: rgba(148,163,184,.12);
  font-size: 9px;
  color: #64748b;
}

@media (max-width: 720px) {
  .starterAnalysisTop {
    align-items: flex-start;
    flex-direction: column;
  }

  .starterMeters {
    grid-template-columns: 1fr;
  }
}


.teamFormCompare {
  margin: 0 0 12px;
  padding: 11px 12px;
  border-radius: 10px;
  background: rgba(15, 23, 42, 0.18);
  border: 1px solid rgba(148, 163, 184, 0.14);
}

.teamFormTitle {
  margin-bottom: 8px;
  font-size: 10px;
  font-weight: 800;
  color: #94a3b8;
}

.teamFormGrid {
  display: grid;
  grid-template-columns: 1fr 28px 1fr;
  align-items: center;
  gap: 8px;
}

.teamFormBox {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.teamFormBox.right {
  text-align: right;
  align-items: flex-end;
}

.teamFormBox b {
  font-size: 12px;
}

.teamFormBox strong {
  font-size: 13px;
}

.teamFormBox span {
  font-size: 10px;
  color: #cbd5e1;
}

.teamFormBox small {
  font-size: 9px;
  color: #94a3b8;
}

.teamFormVs {
  text-align: center;
  font-size: 9px;
  font-weight: 800;
  color: #64748b;
}

.teamFormEdge {
  margin-top: 8px;
  padding-top: 7px;
  border-top: 1px solid rgba(148, 163, 184, 0.12);
  text-align: center;
  font-size: 10px;
  font-weight: 700;
}

@media (max-width: 720px) {
  .teamFormGrid {
    grid-template-columns: 1fr;
  }

  .teamFormVs {
    display: none;
  }

  .teamFormBox.right {
    padding-top: 7px;
    border-top: 1px solid rgba(148,163,184,.1);
    text-align: left;
    align-items: flex-start;
  }
}


.bullpenCompare {
  margin: 0 0 12px;
  padding: 11px 12px;
  border-radius: 10px;
  background: rgba(15,23,42,.13);
  border: 1px solid rgba(148,163,184,.13);
}

.bullpenTitle {
  margin-bottom: 8px;
  font-size: 10px;
  font-weight: 800;
  color: #94a3b8;
}

.bullpenGrid {
  display: grid;
  grid-template-columns: 1fr 28px 1fr;
  align-items: center;
  gap: 8px;
}

.bullpenBox {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.bullpenBox.right {
  text-align: right;
  align-items: flex-end;
}

.bullpenBox b {
  font-size: 12px;
}

.bullpenBox strong {
  font-size: 13px;
}

.bullpenBox span {
  font-size: 10px;
  color: #cbd5e1;
}

.bullpenBox small {
  font-size: 9px;
  color: #94a3b8;
}

.bullpenVs {
  text-align: center;
  font-size: 9px;
  font-weight: 800;
  color: #64748b;
}

.bullpenEdge {
  margin-top: 8px;
  padding-top: 7px;
  border-top: 1px solid rgba(148,163,184,.12);
  text-align: center;
  font-size: 10px;
  font-weight: 700;
}

@media (max-width: 720px) {
  .bullpenGrid {
    grid-template-columns: 1fr;
  }

  .bullpenVs {
    display: none;
  }

  .bullpenBox.right {
    padding-top: 7px;
    border-top: 1px solid rgba(148,163,184,.1);
    text-align: left;
    align-items: flex-start;
  }
}


/* =========================================================
   LINEUP MATCHUP MINI
   ========================================================= */

.lineupMini {
  margin-top: 12px;
  padding: 12px 14px;
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 12px;
  background: rgba(15, 23, 42, 0.05);
}

.lineupMiniHead {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  margin-bottom: 10px;
}

.lineupMiniHead b {
  font-size: 13px;
}

.lineupMiniHead span {
  font-size: 11px;
  opacity: 0.65;
}

.lineupMiniTeams {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 10px;
}

.lineupMiniTeams > div {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
}

.lineupMiniTeams .right {
  flex-direction: row-reverse;
}

.lineupMiniTeams strong {
  font-size: 13px;
}

.lineupMiniTeams b {
  font-size: 18px;
}

.lineupMiniTeams em {
  font-size: 10px;
  opacity: 0.4;
  font-style: normal;
  font-weight: 800;
}

.lineupMiniEdge {
  margin-top: 9px;
  padding-top: 8px;
  border-top: 1px solid rgba(148, 163, 184, 0.15);
  text-align: center;
  font-size: 12px;
  font-weight: 700;
}

.lineupMiniWaiting {
  padding: 5px 0;
  text-align: center;
  font-size: 12px;
  opacity: 0.6;
}

@media (max-width: 700px) {
  .lineupMini {
    padding: 11px;
  }

  .lineupMiniHead span {
    font-size: 10px;
  }
}




/* =========================================================

   KBO ANALYZER UI REDESIGN v1

   ========================================================= */



:root {

  --ui-bg: #f4f7fb;

  --ui-card: #ffffff;

  --ui-sidebar: #0b1830;

  --ui-sidebar-2: #102443;

  --ui-primary: #2563eb;

  --ui-primary-soft: #eff6ff;

  --ui-border: #e4eaf2;

  --ui-text: #152033;

  --ui-muted: #7d899c;

  --ui-shadow: 0 10px 30px rgba(15, 31, 55, 0.07);

}



/* 전체 레이아웃 */

html,

body {

  background: var(--ui-bg);

}



body {

  margin: 0;

  color: var(--ui-text);

}



.shell {

  min-height: 100vh;

  background: var(--ui-bg);

}



/* 왼쪽 네비게이션 */

.sidebar {

  background:

    linear-gradient(180deg, var(--ui-sidebar) 0%, var(--ui-sidebar-2) 100%);

  border-right: 0;

  box-shadow: 6px 0 24px rgba(8, 24, 48, 0.08);

}



.sidebar .brand {

  padding: 26px 22px 22px;

  border-bottom: 1px solid rgba(255, 255, 255, 0.08);

}



.sidebar .brand b {

  font-size: 18px;

  letter-spacing: -0.4px;

}



.sidebar .brand small {

  opacity: 0.5;

  margin-left: 6px;

}



.sidebar nav {

  padding: 18px 12px;

}



.sidebar nav a {

  margin-bottom: 6px;

  border-radius: 10px;

  padding: 12px 14px;

  font-size: 14px;

  font-weight: 700;

  transition: 0.18s ease;

}



.sidebar nav a:hover {

  background: rgba(255, 255, 255, 0.07);

}



.sidebar nav a.active {

  background: linear-gradient(135deg, #2563eb, #3b82f6);

  box-shadow: 0 6px 18px rgba(37, 99, 235, 0.28);

}



/* 본문 */

.content {

  padding: 28px 32px 48px;

  max-width: 1600px;

  width: 100%;

  margin: 0 auto;

}



/* 상단 헤더 */

.header {

  background: var(--ui-card);

  border: 1px solid var(--ui-border);

  border-radius: 18px;

  padding: 22px 24px;

  margin-bottom: 22px;

  box-shadow: var(--ui-shadow);

}



.header h1 {

  margin: 0;

  font-size: 26px;

  line-height: 1.2;

  letter-spacing: -0.7px;

}



.header p {

  color: var(--ui-muted);

  margin-top: 7px;

  margin-bottom: 0;

  font-size: 13px;

}



.headerActions {

  gap: 10px;

}



.headerActions input,

.headerActions button {

  min-height: 42px;

  border-radius: 10px;

}



.headerActions button {

  border: 1px solid var(--ui-border);

  background: #fff;

  font-weight: 700;

  padding: 0 15px;

  transition: 0.15s ease;

}



.headerActions button:hover {

  border-color: #b8c7dc;

  background: #f8fafc;

}



/* 경기 카드 그리드 */

.gameGrid {

  display: grid;

  grid-template-columns: repeat(3, minmax(0, 1fr));

  gap: 18px;

  align-items: start;

}



/* GameCard 루트가 어떤 클래스든 첫 레벨 카드 공통 스타일 */

.gameGrid > * {

  background: var(--ui-card);

  border: 1px solid var(--ui-border);

  border-radius: 18px;

  box-shadow: var(--ui-shadow);

  overflow: hidden;

  transition:

    transform 0.18s ease,

    box-shadow 0.18s ease,

    border-color 0.18s ease;

}



.gameGrid > *:hover {

  transform: translateY(-2px);

  border-color: #cad6e6;

  box-shadow: 0 16px 38px rgba(15, 31, 55, 0.1);

}



/* 카드 내부 공통 요소를 조금 더 촘촘하게 */

.gameGrid section {

  border-color: var(--ui-border);

}



.gameGrid input {

  border-radius: 8px;

}



.gameGrid button {

  border-radius: 9px;

}



/* 타선 매치업 */

.lineupMini {

  margin: 10px 12px;

  padding: 12px 13px;

  background: #f8fafc;

  border: 1px solid var(--ui-border);

  border-radius: 12px;

}



.lineupMiniHead {

  margin-bottom: 9px;

}



.lineupMiniTeams {

  gap: 8px;

}



.lineupMiniTeams strong {

  font-size: 12px;

  color: #475569;

}



.lineupMiniTeams b {

  font-size: 19px;

  letter-spacing: -0.5px;

}



.lineupMiniTeams em {

  color: #94a3b8;

  opacity: 1;

}



.lineupMiniEdge {

  border-top-color: #e5eaf1;

  color: #334155;

}



/* 오류/로딩 */

.error,

.loading {

  background: #fff;

  border: 1px solid var(--ui-border);

  border-radius: 14px;

  padding: 24px;

  box-shadow: var(--ui-shadow);

}



/* 태블릿 */

@media (max-width: 1250px) {

  .gameGrid {

    grid-template-columns: repeat(2, minmax(0, 1fr));

  }



  .content {

    padding: 24px;

  }

}



/* 모바일 */

@media (max-width: 760px) {

  .shell {

    display: block;

  }



  .sidebar {

    position: static;

    width: 100%;

    min-height: auto;

  }



  .sidebar .brand {

    padding: 16px 18px;

  }



  .sidebar nav {

    display: flex;

    overflow-x: auto;

    padding: 8px 12px 12px;

    gap: 7px;

  }



  .sidebar nav a {

    flex: 0 0 auto;

    margin: 0;

    white-space: nowrap;

    padding: 10px 13px;

  }



  .content {

    padding: 16px 12px 32px;

  }



  .header {

    border-radius: 14px;

    padding: 17px;

  }



  .header h1 {

    font-size: 22px;

  }



  .gameGrid {

    grid-template-columns: 1fr;

    gap: 13px;

  }



  .gameGrid > * {

    border-radius: 14px;

  }

}






/* =========================================================

   KBO ANALYZER - COMPACT GAME CARD UI v1

   ========================================================= */



.gameCard {

  position: relative;

  overflow: hidden;

  border-radius: 18px;

  border: 1px solid #dbe3ee;

  background: #ffffff;

  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);

  transition:

    box-shadow 0.2s ease,

    transform 0.2s ease,

    border-color 0.2s ease;

}



.gameCard:hover {

  border-color: #c5d3e5;

  box-shadow: 0 12px 30px rgba(15, 23, 42, 0.09);

}



/* 접힌 상태에서는 핵심 정보만 */

.gameCard.isCompact .teamFormCompare,

.gameCard.isCompact .bullpenCompare,

.gameCard.isCompact .lineupMini,

.gameCard.isCompact .oddsSection,

.gameCard.isCompact .oddsBox,

.gameCard.isCompact .analysisBox {

  display: none !important;

}



/* 선발 영역은 요약 정보라 항상 표시 */

.gameCard.isCompact .starterCompare {

  margin-top: 10px;

}



/* 상세 버튼 */

.gameDetailToggle {

  width: calc(100% - 24px);

  margin: 12px 12px 8px;

  min-height: 42px;

  padding: 0 14px;



  display: flex;

  align-items: center;

  justify-content: space-between;



  border: 1px solid #d9e2ef;

  border-radius: 11px;

  background: #f8fafc;



  color: #334155;

  font-size: 12px;

  font-weight: 800;



  cursor: pointer;

  transition:

    background 0.15s ease,

    border-color 0.15s ease;

}



.gameDetailToggle:hover {

  background: #f1f5f9;

  border-color: #bfcee0;

}



.gameDetailToggle b {

  font-size: 10px;

  color: #64748b;

}



/* 추천픽을 카드 핵심 CTA처럼 */

.gameCard .recommend {

  margin: 8px 12px 12px;

  min-height: 52px;

  border-radius: 12px;

  padding: 10px 12px;



  display: grid;

  grid-template-columns: auto 1fr auto;

  align-items: center;

  gap: 9px;

}



.gameCard .recommend > span {

  font-size: 10px;

  font-weight: 900;

  letter-spacing: 0.04em;

}



.gameCard .recommend > b {

  font-size: 14px;

  font-weight: 900;

}



.gameCard .recommend > small {

  font-size: 10px;

  font-weight: 700;

}



/* 펼쳐진 카드 */

.gameCard.isExpanded {

  box-shadow: 0 16px 40px rgba(15, 23, 42, 0.11);

}



.gameCard.isExpanded .gameDetailToggle {

  background: #eef4ff;

  border-color: #c7d7f5;

  color: #2563eb;

}



/* 모바일 */

@media (max-width: 700px) {

  .gameCard {

    border-radius: 15px;

  }



  .gameDetailToggle {

    margin-left: 10px;

    margin-right: 10px;

    width: calc(100% - 20px);

  }



  .gameCard .recommend {

    margin-left: 10px;

    margin-right: 10px;

  }

}




/* =========================================================
   KBO CARD VISUAL UPGRADE
   ========================================================= */

.gameCard {
  --away-color: #334155;
  --away-soft: #f1f5f9;
