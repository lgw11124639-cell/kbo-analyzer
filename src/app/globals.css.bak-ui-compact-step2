.oddsMarkets {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 14px;
}

.marketBlock {
  border: 1px solid rgba(148, 163, 184, 0.18);
  background: rgba(15, 23, 42, 0.35);
  border-radius: 12px;
  padding: 12px;
}

.marketTitle {
  display: block;
  font-size: 13px;
  margin-bottom: 8px;
  color: #cbd5e1;
}

.marketBlock .oddsRow {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
}

.marketBlock .oddsRow label {
  min-width: 0;
}

@media (max-width: 720px) {
  .marketBlock .oddsRow {
    grid-template-columns: 1fr;
  }
}


.starterCompare {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 32px minmax(0, 1fr);
  gap: 10px;
  align-items: center;
  margin: 12px 0;
  padding: 12px;
  border-radius: 12px;
  background: rgba(15, 23, 42, 0.45);
  border: 1px solid rgba(148, 163, 184, 0.14);
}

.starterBox {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.starterBox.right {
  text-align: right;
  align-items: flex-end;
}

.starterLabel {
  font-size: 11px;
  color: #94a3b8;
}

.starterBox b {
  font-size: 14px;
}

.starterBox small {
  font-size: 11px;
  color: #cbd5e1;
  line-height: 1.4;
}

.starterBox em {
  font-size: 10px;
  font-style: normal;
  color: #94a3b8;
}

.starterVs {
  text-align: center;
  font-size: 11px;
  font-weight: 800;
  color: #64748b;
}

@media (max-width: 720px) {
  .starterCompare {
    grid-template-columns: 1fr;
  }

  .starterVs {
    display: none;
  }

  .starterBox.right {
    text-align: left;
    align-items: flex-start;
    padding-top: 8px;
    border-top: 1px solid rgba(148, 163, 184, 0.12);
  }
}


.starterAnalysis {
  margin: -3px 0 12px;
  padding: 10px 12px;
  border: 1px solid rgba(148, 163, 184, 0.16);
  border-radius: 10px;
  background: rgba(15, 23, 42, 0.06);
}

.starterAnalysisTop {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 8px;
}

.starterAnalysisTop b {
  font-size: 12px;
}

.starterAnalysisTop span {
  font-size: 10px;
  color: #64748b;
}

.starterMeters {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
}

.starterMeters > div {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 1px 8px;
  padding: 7px 8px;
  background: rgba(255,255,255,.55);
  border-radius: 8px;
}

.starterMeters span {
  font-size: 10px;
  color: #64748b;
}

.starterMeters strong {
  grid-row: span 2;
  font-size: 18px;
}

.starterMeters small {
  font-size: 9px;
  color: #94a3b8;
}

.starterReasons {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  margin-top: 7px;
}

.starterReasons span {
  padding: 3px 6px;
  border-radius: 999px;
  background: rgba(148,163,184,.12);
  font-size: 9px;
  color: #64748b;
}

@media (max-width: 720px) {
  .starterAnalysisTop {
    align-items: flex-start;
    flex-direction: column;
  }

  .starterMeters {
    grid-template-columns: 1fr;
  }
}


