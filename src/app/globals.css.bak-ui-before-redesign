/* =========================================================
   LINEUP MATCHUP MINI
   ========================================================= */

.lineupMini {
  margin-top: 12px;
  padding: 12px 14px;
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 12px;
  background: rgba(15, 23, 42, 0.05);
}

.lineupMiniHead {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  margin-bottom: 10px;
}

.lineupMiniHead b {
  font-size: 13px;
}

.lineupMiniHead span {
  font-size: 11px;
  opacity: 0.65;
}

.lineupMiniTeams {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 10px;
}

.lineupMiniTeams > div {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
}

.lineupMiniTeams .right {
  flex-direction: row-reverse;
}

.lineupMiniTeams strong {
  font-size: 13px;
}

.lineupMiniTeams b {
  font-size: 18px;
}

.lineupMiniTeams em {
  font-size: 10px;
  opacity: 0.4;
  font-style: normal;
  font-weight: 800;
}

.lineupMiniEdge {
  margin-top: 9px;
  padding-top: 8px;
  border-top: 1px solid rgba(148, 163, 184, 0.15);
  text-align: center;
  font-size: 12px;
  font-weight: 700;
}

.lineupMiniWaiting {
  padding: 5px 0;
  text-align: center;
  font-size: 12px;
  opacity: 0.6;
}

@media (max-width: 700px) {
  .lineupMini {
    padding: 11px;
  }

  .lineupMiniHead span {
    font-size: 10px;
  }
}

