function estimateProjectedTotal(
  awayForm: TeamForm | undefined,
  homeForm: TeamForm | undefined,
  awayStarter: PitcherStats | undefined,
  homeStarter: PitcherStats | undefined,
  awayBullpen: BullpenData | undefined,
  homeBullpen: BullpenData | undefined,
  lineupMatchup: LineupMatchupData | undefined
): number | null {
  if (
    awayForm?.avgRuns === null ||
    awayForm?.avgRuns === undefined ||
    awayForm.avgRunsAllowed === null ||
    awayForm.avgRunsAllowed === undefined ||
    homeForm?.avgRuns === null ||
    homeForm?.avgRuns === undefined ||
    homeForm.avgRunsAllowed === null ||
    homeForm.avgRunsAllowed === undefined
  ) {
    return null;
  }

  /*
    TOTAL MODEL V0.2

    핵심 변경:
    1. 최근 득실점을 그대로 사용하지 않고 리그 중립값으로 회귀
    2. 최근 폼 55% / 중립값 45%
    3. 선발·불펜·라인업 보정 강도 축소
    4. 팀별 예상득점/총득점 극단값 제한

    현재 임시 중립값:
      팀당 4.50점
      총 9.00점

    추후 KBO 시즌 실제 리그 평균으로 자동 교체 예정.
  */

  const LEAGUE_TEAM_RUNS = 4.50;

  const awayRecentExpectation =
    (
      awayForm.avgRuns +
      homeForm.avgRunsAllowed
    ) / 2;

  const homeRecentExpectation =
    (
      homeForm.avgRuns +
      awayForm.avgRunsAllowed
    ) / 2;

  // 최근 폼을 55%만 사용하고 45%는 리그 평균으로 회귀
  let awayRuns =
    LEAGUE_TEAM_RUNS * 0.45 +
    awayRecentExpectation * 0.55;

  let homeRuns =
    LEAGUE_TEAM_RUNS * 0.45 +
    homeRecentExpectation * 0.55;


  // ----------------------------------------------------------
  // 선발 ERA
  // 시즌 60% + 최근5 40%
  //
  // 기존 보정보다 약 50% 축소.
  // 상대 선발 ERA가 4.50보다 높으면 공격팀 예상득점 +
  // 낮으면 -
  // ----------------------------------------------------------

  const blendedEra = (
    stats: PitcherStats | undefined
  ) => {
    if (!stats) return null;

    const season = stats.era;
    const recent = stats.recent5?.era;

    if (
      season === null &&
      (recent === null ||
       recent === undefined)
    ) {
      return null;
    }

    if (
      season !== null &&
      recent !== null &&
      recent !== undefined
    ) {
      return (
        season * 0.60 +
        recent * 0.40
      );
    }

    return season ?? recent ?? null;
  };

  const homeStarterEra =
    blendedEra(homeStarter);

  const awayStarterEra =
    blendedEra(awayStarter);

  if (homeStarterEra !== null) {
    awayRuns +=
      Math.max(
        -0.40,
        Math.min(
          0.40,
          (homeStarterEra - 4.50) *
            0.09
        )
      );
  }

  if (awayStarterEra !== null) {
    homeRuns +=
      Math.max(
        -0.40,
        Math.min(
          0.40,
          (awayStarterEra - 4.50) *
            0.09
        )
      );
  }


  // ----------------------------------------------------------
  // 불펜 피로
  //
  // 50 = 중립
  // 기존 보정 강도의 약 절반
  // ----------------------------------------------------------

  if (homeBullpen) {
    awayRuns +=
      Math.max(
        -0.18,
        Math.min(
          0.18,
          (
            homeBullpen.summary
              .fatigueIndex -
            50
          ) * 0.003
        )
      );
  }

  if (awayBullpen) {
    homeRuns +=
      Math.max(
        -0.18,
        Math.min(
          0.18,
          (
            awayBullpen.summary
              .fatigueIndex -
            50
          ) * 0.003
        )
      );
  }


  // ----------------------------------------------------------
  // 라인업 OPS
  //
  // OPS .750 = 중립
  // 기존 2.0배 -> 1.0배
  // ----------------------------------------------------------

  const awayOps =
    lineupMatchup?.away
      ?.baseSummary
      ?.avgOps;

  const homeOps =
    lineupMatchup?.home
      ?.baseSummary
      ?.avgOps;

  if (typeof awayOps === "number") {
    awayRuns +=
      Math.max(
        -0.20,
        Math.min(
          0.20,
          (awayOps - 0.750) *
            1.0
        )
      );
  }

  if (typeof homeOps === "number") {
    homeRuns +=
      Math.max(
        -0.20,
        Math.min(
          0.20,
          (homeOps - 0.750) *
            1.0
        )
      );
  }


  // 팀별 극단값 억제
  awayRuns =
    Math.max(
      2.75,
      Math.min(6.25, awayRuns)
    );

  homeRuns =
    Math.max(
      2.75,
      Math.min(6.25, homeRuns)
    );

  // 총득점도 개발 단계에서는 안전 범위 제한
  const total =
    Math.max(
      6.50,
      Math.min(
        12.50,
        awayRuns + homeRuns
      )
    );

  return Number(
    total.toFixed(2)
  );
}



