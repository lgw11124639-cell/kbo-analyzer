      {error && <div className="error">KBO 데이터 연결 오류: {error}</div>}
      {loading ? <div className="loading">KBO 경기 정보를 불러오는 중…</div> : games.length === 0 ? <div className="loading">이 날짜에는 KBO 경기가 없습니다.</div> : <div className="gameGrid">{games.map(g=><GameCard
  key={g.gameId}
