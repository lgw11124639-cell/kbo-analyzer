  /*
    폴 수별 실전 추천

    일반 자동조합의 핵심픽 고정 여부와 독립적으로
    더 넓은 후보를 생성한 뒤 실전 점수로 다시 선정한다.
  */
  const practicalComboCandidates =
    useMemo(
      () => {
        const distributed =
          makeFlexibleAutoCombos(
            allPicks,
            {
              ...comboSettings,
              useAnchor: false,
              combosPerLeg: 9,
            }
          );

        const anchored =
          makeFlexibleAutoCombos(
            allPicks,
            {
              ...comboSettings,
              useAnchor: true,
              combosPerLeg: 9,
            }
          );

        const unique =
          new Map<
            string,
            (typeof distributed)[number]
          >();

        for (
          const combo of
          [...distributed, ...anchored]
        ) {
          const key =
            combo.picks
              .map(
                (pick) =>
                  `${pick.gameId}:${pick.market}:${pick.label}`
              )
              .sort()
              .join("|");

          if (!unique.has(key)) {
            unique.set(key, combo);
          }
        }

        return [...unique.values()];
      },
      [
        allPicks,
        comboSettings,
      ]
    );

  const featuredCombos =
    useMemo(
      () => {
        const selected:
          typeof practicalComboCandidates = [];

        const usedPickCounts =
          new Map<string, number>();

        const pickKey = (
          pick: Pick
        ) =>
          `${pick.gameId}:${pick.market}:${pick.label}`;

        for (
          const leg of
          [1, 2, 3, 4, 5]
        ) {
          const candidates =
            practicalComboCandidates.filter(
              (combo) =>
                combo.picks.length === leg
            );

          /*
            상단 1~5폴 추천 전체에서 같은 픽은
            최대 2번까지만 허용한다.

            조건을 만족하는 후보가 전혀 없을 때만
            원래 후보군으로 되돌아간다.
          */
          const diversifiedCandidates =
            candidates.filter(
              (combo) =>
                combo.picks.every(
                  (pick) =>
                    (
                      usedPickCounts.get(
                        pickKey(pick)
                      ) || 0
                    ) < 2
                )
            );

          const recommendationPool =
            diversifiedCandidates.length
              ? diversifiedCandidates
              : candidates;

          const ranked =
            recommendationPool
              .map((combo) => {
                const gradeAverage =
                  combo.picks.reduce(
                    (sum, pick) =>
                      sum +
                      (
                        pick.grade === "A"
                          ? 3
                          : pick.grade === "B"
                            ? 2
                            : 1
                      ),
                    0
                  ) /
                  Math.max(
                    1,
                    combo.picks.length
                  );

                const negativeEvCount =
                  combo.picks.filter(
                    (pick) =>
                      (pick.ev ?? -1) < 0
                  ).length;

                const gameCounts =
                  new Map<string, number>();

                for (
                  const pick of
                  combo.picks
                ) {
                  gameCounts.set(
                    pick.gameId,
                    (
                      gameCounts.get(
                        pick.gameId
                      ) || 0
                    ) + 1
                  );
                }

                const sameGameExtra =
                  [...gameCounts.values()]
                    .filter(
                      (count) =>
                        count > 1
                    ).length;

                const repeatedPickPenalty =
                  combo.picks.reduce(
                    (sum, pick) =>
                      sum +
                      (
                        usedPickCounts.get(
                          pickKey(pick)
                        ) || 0
                      ),
                    0
                  );

                /*
                  폴 수별 후보 안에서만 비교한다.

                  예상 적중률을 기본으로 하되
                  EV·등급·배당 효율을 반영하고,
                  음수 EV·같은 경기 집중·반복 픽을 감점한다.
                */
                const score =
                  combo.probability * 100 * 0.48 +
                  combo.averageConfidence * 100 * 0.18 +
                  (combo.averageEv ?? -1) * 100 * 0.22 +
                  gradeAverage * 2.2 +
                  Math.log(
                    Math.max(
                      1,
                      combo.odds
                    )
                  ) * 2.5 -
                  negativeEvCount * 2.5 -
                  sameGameExtra * 2 -
                  repeatedPickPenalty * 3.5;

                return {
                  combo,
                  score,
                };
              })
              .sort(
                (a, b) =>
                  b.score - a.score
              );

          const best =
            ranked[0]?.combo;

          if (!best) {
            continue;
          }

          selected.push(best);

          for (
            const pick of
            best.picks
          ) {
            const key =
              pickKey(pick);

            usedPickCounts.set(
              key,
              (
                usedPickCounts.get(key) ||
                0
              ) + 1
            );
          }
        }

        return selected;
      },
      [practicalComboCandidates]
    );

  const featuredComboTitle = (
    legCount: number
  ) => {
    if (legCount === 1) {
      return "단일 핵심 추천";
    }

    if (legCount === 2) {
      return "방어 조합";
    }

    if (legCount === 3) {
      return "균형 조합";
    }

    if (legCount === 4) {
      return "가치 조합";
    }

    return "공격 조합";
  };


  const featuredComboReason = (
    combo: (typeof featuredCombos)[number]
  ) => {
    const positiveEvCount =
      combo.picks.filter(
        (pick) =>
          (pick.ev ?? -1) >= 0
      ).length;

    const highGradeCount =
      combo.picks.filter(
        (pick) =>
          pick.grade === "A" ||
          pick.grade === "B"
      ).length;

    const repeatedGames =
      combo.picks.length -
      new Set(
        combo.picks.map(
          (pick) =>
            pick.gameId
        )
      ).size;

    const parts: string[] = [];

    if (highGradeCount > 0) {
      parts.push(
        `A·B등급 ${highGradeCount}픽`
      );
    }

    if (positiveEvCount > 0) {
      parts.push(
        `양수 EV ${positiveEvCount}픽`
      );
    }

    parts.push(
      `예상 적중 ${(combo.probability * 100).toFixed(1)}%`
    );

    parts.push(
      `예상 배당 ${combo.odds.toFixed(2)}`
    );

    if (repeatedGames > 0) {
      parts.push(
        "동일 경기 시장 조합 포함"
      );
    } else {
      parts.push(
        "경기 분산 구성"
      );
    }

    return `${parts.join(" · ")}을 종합한 실전 추천입니다.`;
  };


  /*
    폴 수별 최우선 추천도 저장 여부와 관계없이
    현재 실제 점수로 즉시 적중 판정한다.
  */
  const featuredComboSettlements =
    useMemo(
      () => {
        const resultMap =
          new Map<
