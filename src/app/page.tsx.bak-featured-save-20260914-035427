type AutoComboStyle =
  | "SAFE"
  | "TOP"
  | "BALANCED"
  | "AGGRESSIVE"
  | "HIGH_ODDS";

type SavedComboSnapshot = {
  id: string;
  date: string;
  savedAt: string;

  name: string;
  style: AutoComboStyle;

  odds: number;
  probability: number;
  averageConfidence: number;
  averageEv: number | null;

  // 저장 당시 픽을 그대로 동결
  picks: Pick[];

  // 핸디캡 / O-U 결과 판정을 위해
  // 저장 당시 경기별 기준점과 배당도 함께 동결
  oddsByGame: Record<string, OddsInput>;

  // 이후 팀명/구장 표시에 사용할 당시 경기정보
  games: Record<
    string,
    {
      awayTeamName: string;
      homeTeamName: string;
      stadium: string;
    }
  >;
};


type PickSettlement =
  | "PENDING"
  | "LIVE"
  | "WIN"
  | "LOSS"
  | "PUSH"
  | "VOID";

type ComboSettlement =
  | "PENDING"
  | "LIVE"
  | "WIN"
  | "LOSS"
  | "VOID";

function settleSavedPick(
  pick: Pick,
  snapshot: SavedComboSnapshot,
  game: KboGame | undefined
): PickSettlement {
  if (!game) {
    return "PENDING";
  }

  const cancelName =
    (game.status.cancelName || "").trim();

  const cancelled =
    cancelName &&
    cancelName !== "정상경기";

  if (cancelled) {
    return "VOID";
  }

  const awayScore =
    game.score.away;

  const homeScore =
    game.score.home;

  const hasScore =
    awayScore !== null &&
    homeScore !== null;

  const completed =
    game.status.stateCode === "3" &&
    hasScore;

  if (!completed) {
    return hasScore
      ? "LIVE"
      : "PENDING";
  }

  const frozenOdds =
    snapshot.oddsByGame[pick.gameId] ||
    emptyOdds;

  const info =
    snapshot.games[pick.gameId];

  if (!info) {
    return "VOID";
  }

  if (pick.market === "ML") {
    const awayLabel =
      `${info.awayTeamName} 승`;

    const homeLabel =
      `${info.homeTeamName} 승`;

    if (pick.label === awayLabel) {
      if (awayScore > homeScore) {
        return "WIN";
      }

      if (awayScore < homeScore) {
        return "LOSS";
      }

      return "PUSH";
    }

    if (pick.label === homeLabel) {
      if (homeScore > awayScore) {
        return "WIN";
      }

      if (homeScore < awayScore) {
        return "LOSS";
      }

      return "PUSH";
    }

    return "VOID";
  }

  if (pick.market === "HANDICAP") {
    const awaySelected =
      pick.label.startsWith(
        `${info.awayTeamName} `
      );

    const homeSelected =
      pick.label.startsWith(
        `${info.homeTeamName} `
      );

    if (
      awaySelected &&
      frozenOdds.awayHandicapLine !== null
    ) {
      const adjusted =
        awayScore +
        frozenOdds.awayHandicapLine;

      if (adjusted > homeScore) {
        return "WIN";
      }

      if (adjusted < homeScore) {
        return "LOSS";
      }

      return "PUSH";
    }

    if (
      homeSelected &&
      frozenOdds.homeHandicapLine !== null
    ) {
      const adjusted =
        homeScore +
        frozenOdds.homeHandicapLine;

      if (adjusted > awayScore) {
        return "WIN";
      }

      if (adjusted < awayScore) {
        return "LOSS";
      }

      return "PUSH";
    }

    return "VOID";
  }

  if (pick.market === "TOTAL") {
    if (frozenOdds.totalLine === null) {
      return "VOID";
    }

    const total =
      awayScore + homeScore;

    if (pick.label.startsWith("오버 ")) {
      if (total > frozenOdds.totalLine) {
        return "WIN";
      }

      if (total < frozenOdds.totalLine) {
        return "LOSS";
      }

      return "PUSH";
    }

    if (pick.label.startsWith("언더 ")) {
      if (total < frozenOdds.totalLine) {
        return "WIN";
      }

      if (total > frozenOdds.totalLine) {
        return "LOSS";
      }

      return "PUSH";
    }

    return "VOID";
  }

  return "VOID";
}

function settleSavedCombo(
  snapshot: SavedComboSnapshot,
  games: KboGame[]
): {
  status: ComboSettlement;
  pickResults: PickSettlement[];
  effectiveOdds: number;
} {
  const pickResults =
    snapshot.picks.map(
      (pick) =>
        settleSavedPick(
          pick,
          snapshot,
          games.find(
            (game) =>
              game.gameId ===
              pick.gameId
          )
        )
    );

  if (
    pickResults.some(
      (result) =>
        result === "LOSS"
    )
  ) {
    return {
      status: "LOSS",
      pickResults,
      effectiveOdds: 0,
    };
  }

  if (
    pickResults.some(
      (result) =>
        result === "LIVE"
    )
  ) {
    return {
      status: "LIVE",
      pickResults,
      effectiveOdds:
        snapshot.odds,
    };
  }

  if (
    pickResults.some(
      (result) =>
        result === "PENDING"
    )
  ) {
    return {
      status: "PENDING",
      pickResults,
      effectiveOdds:
        snapshot.odds,
    };
  }

  const hasWin =
    pickResults.some(
      (result) =>
        result === "WIN"
    );

  const onlyVoidOrPush =
    pickResults.every(
      (result) =>
        result === "VOID" ||
        result === "PUSH"
    );

  if (onlyVoidOrPush) {
    return {
      status: "VOID",
      pickResults,
      effectiveOdds: 1,
    };
  }

  const effectiveOdds =
    snapshot.picks.reduce(
      (acc, pick, index) => {
        const result =
          pickResults[index];

        if (
          result === "PUSH" ||
          result === "VOID"
        ) {
          return acc;
        }

        return acc *
          (pick.odds ?? 1);
      },
      1
    );

  return {
    status:
      hasWin
        ? "WIN"
        : "VOID",
    pickResults,
    effectiveOdds,
  };
}


function comboSettlementLabel(
  status: ComboSettlement
) {
  if (status === "WIN") return "✅ 적중";
  if (status === "LOSS") return "❌ 미적중";
  if (status === "LIVE") return "⏳ 진행중";
  if (status === "VOID") return "↔ 무효";
  return "⏸ 대기";
}

function pickSettlementLabel(
  status: PickSettlement
) {
  if (status === "WIN") return "✅ 적중";
  if (status === "LOSS") return "❌ 미적중";
  if (status === "LIVE") return "⏳ 진행중";
  if (status === "PUSH") return "↔ 적특";
  if (status === "VOID") return "↔ 무효";
  return "⏸ 대기";
}


