            const hasScore =
              game.score.away !== null &&
              game.score.home !== null;

            const finalResult =
              !hasScore ||
              predictionResults.length === 0
                ? "WAITING"
                : predictionResults.every(
                    (result) =>
                      result === "WIN"
                  )
                  ? "WIN"
                  : predictionResults.every(
                      (result) =>
