              );

            if (linkedGame) {
              gameInfo[pick.gameId] = {
                awayTeamName:
                  linkedGame.awayTeamName,

                homeTeamName:
                  linkedGame.homeTeamName,

                stadium:
                  linkedGame.stadium || "",
              };
            }
          }

          const snapshot:
            SavedComboSnapshot = {
              id:
                `${date}-${combo.name}-featured`,

              date,

              savedAt:
                new Date().toISOString(),

              name: combo.name,
              style: combo.style,
              odds: combo.odds,

              probability:
                combo.probability,

              averageConfidence:
                combo.averageConfidence,

              averageEv:
                combo.averageEv,

              picks:
                combo.picks.map(
                  (pick) => ({
                    ...pick,
                  })
                ),

              oddsByGame,
              games: gameInfo,
            };

          resultMap.set(
            combo.name,
            settleSavedCombo(
              snapshot,
              games
            )
          );
        }

        return resultMap;
      },
      [
        featuredCombos,
        games,
        odds,
        date,
      ]
    );


  const comboPickKeySets =
    useMemo(
      () =>
        combos.map(
          (combo) =>
            combo.picks.map(
