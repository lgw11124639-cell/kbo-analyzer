function comboConfidenceGrade(
  averageConfidence: number
) {
  if (averageConfidence >= 0.64) {
    return "A";
  }

  if (averageConfidence >= 0.60) {
    return "A-";
  }

  if (averageConfidence >= 0.57) {
    return "B+";
  }

  if (averageConfidence >= 0.54) {
    return "B";
  }

  if (averageConfidence >= 0.51) {
    return "C+";
  }

  return "C";
}


function comboOverlapRisk(
  comboPickKeys: string[],
  allComboPickKeys: string[][]
) {
  /*
    1폴은 다른 픽에 의존하는 조합이 아니므로
    의존도 계산 대상에서 제외한다.
  */
  if (comboPickKeys.length <= 1) {
    return {
      label: "해당 없음",
      className: "none",
    };
  }

  const otherComboCount =
    Math.max(
      1,
      allComboPickKeys.length - 1
    );

  /*
    현재 조합의 각 픽이 다른 조합에 얼마나
    반복되는지 실제 동일 픽 기준으로 계산한다.

    동일 경기라도 시장이나 선택이 다르면
    같은 픽으로 계산하지 않는다.
  */
  const repeatRatios =
    comboPickKeys.map(
      (pickKey) => {
        const includedCount =
          allComboPickKeys.reduce(
            (count, keys) =>
              keys.includes(pickKey)
                ? count + 1
                : count,
            0
          );

        return (
          Math.max(
            0,
            includedCount - 1
          ) /
          otherComboCount
        );
      }
    );

  const repeatRatio =
    repeatRatios.reduce(
      (sum, ratio) =>
        sum + ratio,
      0
    ) /
    comboPickKeys.length;

  if (repeatRatio >= 0.75) {
    return {
      label: "매우 높음",
      className: "veryHigh",
    };
  }

  if (repeatRatio >= 0.50) {
    return {
      label: "높음",
      className: "high",
    };
  }

  if (repeatRatio >= 0.25) {
    return {
      label: "보통",
      className: "medium",
    };
  }

  return {
    label: "낮음",
    className: "low",
  };
}


function pickMarketLabel(
  market: Pick["market"]
) {
  if (market === "ML") {
    return "승패";
  }

  if (market === "HANDICAP") {
    return "핸디";
  }

  return "O/U";
}

export default function Home() {
  const [activeTab, setActiveTab] =
    useState<"games" | "combos">("games");

  const [comboSettings, setComboSettings] =
    useState({
      legs: [1, 2, 3, 4, 5],
      combosPerLeg: 3,
      useAnchor: false,
      minimumGrade: "ALL" as
        | "A"
        | "B"
        | "ALL",
      minimumConfidence: 0.50,
      minimumEv: -0.15,
    });

  const [comboSettingsReady, setComboSettingsReady] =
    useState(false);

  const [comboLegFilter, setComboLegFilter] =
    useState<"ALL" | number>("ALL");

  useEffect(() => {
    try {
      const raw =
        localStorage.getItem(
          "kbo-auto-combo-settings-v1"
        );

      if (raw) {
        const parsed =
          JSON.parse(raw);

        setComboSettings(
          (current) => ({
            ...current,
            ...parsed,
            legs:
              Array.isArray(parsed.legs)
                ? parsed.legs
                : current.legs,
          })
        );
      }
    } catch {
      // 저장 설정이 손상되면 기본값 사용
    } finally {
      setComboSettingsReady(true);
    }
  }, []);

  useEffect(() => {
    if (!comboSettingsReady) {
      return;
    }

    localStorage.setItem(
      "kbo-auto-combo-settings-v1",
      JSON.stringify(comboSettings)
    );
  }, [
    comboSettings,
    comboSettingsReady,
  ]);
  const [games,setGames] = useState<KboGame[]>([]);
  const [odds,setAllOdds] = useState<Record<string,OddsInput>>({});

  // 사용자가 직접 저장한 경기별 배당
  const [savedOdds, setSavedOdds] =
    useState<Record<string, OddsInput>>({});

  // 저장 후 자동배당이 덮어쓰지 못하도록 잠금
  const [lockedOdds, setLockedOdds] =
    useState<Record<string, boolean>>({});

  // localStorage 복원이 끝난 뒤에만 저장/데이터 로드
  const [oddsStorageReady, setOddsStorageReady] =
    useState(false);

  // 자동조합 저장 스냅샷
  const [savedCombos, setSavedCombos] =
    useState<SavedComboSnapshot[]>([]);

  // 조합 localStorage 복원이 끝나기 전에
  // 빈 배열로 덮어쓰는 것을 방지
  const [comboStorageReady, setComboStorageReady] =
    useState(false);

  // PC / 모바일 공용 서버 상태 복원 완료 여부
  const [sharedStateReady, setSharedStateReady] =
    useState(false);
  const [pitcherStats,setPitcherStats] = useState<Record<number,PitcherStats>>({});
  const [teamForms,setTeamForms] = useState<Record<string,TeamForm>>({});
  const [bullpens,setBullpens] = useState<Record<string,BullpenData>>({});

  const [
    lineupMatchups,
    setLineupMatchups,
  ] = useState<
    Record<
      string,
      LineupMatchupData
    >
  >({});
  const [loading,setLoading] = useState(true);
  const [error,setError] = useState("");
  const [date,setDate] = useState(() => new Intl.DateTimeFormat("en-CA",{timeZone:"Asia/Seoul",year:"numeric",month:"2-digit",day:"2-digit"}).format(new Date()));

  async function loadLineupMatchups(
    targetGames: KboGame[],
    targetDate: string
  ) {
    if (
      targetGames.length === 0
    ) {
      setLineupMatchups({});
      return;
    }

    const next:
      Record<
        string,
        LineupMatchupData
      > = {};

    /*
      동시에 전 경기 호출하지 않고
      한 경기씩 순차 처리한다.

      KBO / BvP 요청 폭주 방지용.
    */
    for (
      const game of targetGames
    ) {
      try {
        const response =
          await fetch(
            `/api/kbo/lineup-matchup?away=${encodeURIComponent(game.awayTeamName)}&home=${encodeURIComponent(game.homeTeamName)}&date=${encodeURIComponent(targetDate)}`,
            {
              cache:
                "no-store",
            }
          );

        if (!response.ok) {
          continue;
        }

        const json =
          await response.json();

        next[
          game.gameId
        ] =
          json as LineupMatchupData;

        /*
          한 경기 끝날 때마다
          UI에 즉시 반영
        */
        setLineupMatchups(
          (prev) => ({
            ...prev,
            [game.gameId]:
              json as LineupMatchupData,
          })
        );

        /*
          서버 부담 분산
        */
        await new Promise(
          (resolve) =>
            setTimeout(
              resolve,
              250
            )
        );

      } catch {
        continue;
      }
    }

    console.log(
      "[LINEUP MATCHUPS]",
      next
    );
  }

  async function load() {
    setLoading(true);
    setError("");

    try {
      const [gameResponse, oddsResponse] = await Promise.all([
        fetch(`/api/kbo/today?date=${date}`, {
          cache: "no-store",
        }),
        fetch(
          `/api/odds/kbo?date=${encodeURIComponent(date)}`,
          {
            cache: "no-store",
          }
        ),
      ]);

      const gameJson = await gameResponse.json();

      if (!gameResponse.ok) {
        throw new Error(gameJson.error || "KBO 경기 불러오기 실패");
      }

      const loadedGames: KboGame[] = gameJson.games || [];

      setGames(loadedGames);

      // ------------------------------------------------------
      // 확정 라인업 + 상대 선발 매치업 자동수집
      // ------------------------------------------------------
      await loadLineupMatchups(
        loadedGames,
        date
      );

      // ------------------------------------------------------
      // 선발투수 시즌 기록 자동수집
      // ------------------------------------------------------

      const starterIds = [
        ...new Set(
          loadedGames.flatMap((game) => [
            game.startingPitchers.away?.id,
            game.startingPitchers.home?.id,
          ])
          .filter(
            (id): id is number =>
              typeof id === "number" &&
              id > 0
          )
        ),
      ];

      if (starterIds.length > 0) {
        const pitcherResults =
          await Promise.all(
            starterIds.map(async (playerId) => {
              try {
                const response = await fetch(
                  `/api/kbo/pitcher/${playerId}`,
                  {
                    cache: "no-store",
                  }
                );

                if (!response.ok) {
                  return null;
                }

                const json =
                  await response.json();

                if (!json.stats) {
                  return null;
                }

                return json.stats as PitcherStats;
              } catch {
                return null;
              }
            })
          );

        const nextPitcherStats:
          Record<number, PitcherStats> = {};

        for (const stats of pitcherResults) {
          if (!stats) continue;

          nextPitcherStats[
            stats.playerId
          ] = stats;
        }

        setPitcherStats((prev) => ({
          ...prev,
          ...nextPitcherStats,
        }));
      }

      // ------------------------------------------------------
      // 오늘 경기 참가팀 최근 10경기 자동수집
      // ------------------------------------------------------

      const teamNames = [
        ...new Set(
          loadedGames.flatMap(
            (game) => [
              game.awayTeamName,
              game.homeTeamName,
            ]
          )
        ),
      ];

      if (teamNames.length > 0) {
        const teamFormResults =
          await Promise.all(
            teamNames.map(
              async (teamName) => {
                try {
                  const response =
                    await fetch(
                      `/api/kbo/team-form?team=${encodeURIComponent(teamName)}&date=${encodeURIComponent(date)}`,
                      {
                        cache: "no-store",
                      }
                    );

                  if (!response.ok) {
                    return null;
                  }

                  const json =
                    await response.json();

                  return json as TeamForm;
                } catch {
                  return null;
                }
              }
            )
          );

        const nextTeamForms:
          Record<string, TeamForm> = {};

        for (
          const form of teamFormResults
        ) {
          if (!form) continue;

          nextTeamForms[
            form.team
          ] = form;
        }

        setTeamForms(
          nextTeamForms
        );
      }

      // ------------------------------------------------------
      // 최근 3일 불펜 자동수집
      // ------------------------------------------------------

      if (teamNames.length > 0) {
        const bullpenResults =
          await Promise.all(
            teamNames.map(
              async (teamName) => {
                try {
                  const response =
                    await fetch(
                      `/api/kbo/bullpen?team=${encodeURIComponent(teamName)}&date=${encodeURIComponent(date)}`,
                      {
                        cache: "no-store",
                      }
                    );

                  if (!response.ok) {
                    return null;
                  }

                  const json =
                    await response.json();

                  return json as BullpenData;
                } catch {
                  return null;
                }
              }
            )
          );

        const nextBullpens:
          Record<string, BullpenData> = {};

        for (
          const bullpen of bullpenResults
        ) {
          if (!bullpen) continue;

          nextBullpens[
            bullpen.team
          ] = bullpen;
        }

        setBullpens(
          nextBullpens
        );
      }

      // 배당 API 실패는 경기목록 자체를 막지 않는다.
      if (oddsResponse.ok) {
        const oddsJson = await oddsResponse.json();
        const autoEvents: AutoOddsEvent[] = oddsJson.events || [];

        /*
          자동으로 수집된 실제 사이트 배당/기준점을
          경기별 히스토리에 별도 저장한다.

          - 화면의 수동 잠금값과 분리
          - 같은 값은 서버에서 중복 제거
          - 향후 최근 30일 배당/적중률/ROI 통계 원본
        */
        const autoOddsSnapshots =
          loadedGames.flatMap((game) => {
            const away =
              normalizeTeamName(
                game.awayTeamName
              );

            const home =
              normalizeTeamName(
                game.homeTeamName
              );

            const matched =
              autoEvents.find((event) => {
                const oddsAway =
                  normalizeTeamName(
                    event.awayTeam
                  );

                const oddsHome =
                  normalizeTeamName(
                    event.homeTeam
                  );

                return (
                  away === oddsAway &&
                  home === oddsHome &&
                  kstDateFromIso(
                    event.commenceTime
                  ) === date
                );
              });

            if (!matched) {
              return [];
            }

            /*
              실제로 받은 시장이 하나도 없으면
              빈 기록은 저장하지 않는다.
            */
            const hasOdds =
              matched.awayMl !== null ||
              matched.homeMl !== null ||
              matched.awaySpreadLine !== null ||
              matched.homeSpreadLine !== null ||
              matched.awayHandicap !== null ||
              matched.homeHandicap !== null ||
              matched.totalLine !== null ||
              matched.overOdds !== null ||
              matched.underOdds !== null;

            if (!hasOdds) {
              return [];
            }

            return [{
              gameId:
                game.gameId,

              date,

              awayTeamName:
                game.awayTeamName,

              homeTeamName:
                game.homeTeamName,

              awayMl:
                matched.awayMl,

              homeMl:
                matched.homeMl,

              awayHandicapLine:
                matched.awaySpreadLine,

              homeHandicapLine:
                matched.homeSpreadLine,

              awayHandicap:
                matched.awayHandicap,

              homeHandicap:
                matched.homeHandicap,

              totalLine:
                matched.totalLine,

              overOdds:
                matched.overOdds,

              underOdds:
                matched.underOdds,

              source: "AUTO",
            }];
          });

        if (autoOddsSnapshots.length) {
          fetch(
            "/api/odds/history",
            {
              method: "POST",

              headers: {
                "Content-Type":
                  "application/json",
              },

              body: JSON.stringify({
                snapshots:
                  autoOddsSnapshots,
              }),
            }
          )
            .then(async (response) => {
              if (!response.ok) {
                throw new Error(
                  `odds history POST ${response.status}`
                );
              }

              return response.json();
            })
            .then((result) => {
              console.log(
                "[AUTO ODDS HISTORY]",
                result
              );
            })
            .catch((error) => {
              /*
                히스토리 저장 실패 때문에
                경기/배당 화면 자체가 실패하면 안 된다.
              */
              console.error(
                "auto odds history save failed",
                error
              );
            });
        }

        setAllOdds((prev) => {
          const next = { ...prev };

          for (const game of loadedGames) {
            const away = normalizeTeamName(game.awayTeamName);
            const home = normalizeTeamName(game.homeTeamName);

            const matched = autoEvents.find((event) => {
              const oddsAway = normalizeTeamName(event.awayTeam);
              const oddsHome = normalizeTeamName(event.homeTeam);

              const sameTeams =
                away === oddsAway &&
                home === oddsHome;

              const sameDate =
                kstDateFromIso(event.commenceTime) === date;

              return sameTeams && sameDate;
            });

            if (!matched) continue;

            const current =
              next[game.gameId] || emptyOdds;

            // 사용자가 저장/잠금한 경기는 자동배당으로 덮어쓰지 않는다.
            if (lockedOdds[game.gameId]) {
              const saved =
                savedOdds[game.gameId];

              if (saved) {
                next[game.gameId] = saved;
              }

              continue;
            }

            // 잠금되지 않은 경기는 최신 자동배당 우선.
            // API에 없는 시장만 현재 입력값을 유지한다.
            next[game.gameId] = {
              awayMl:
                matched.awayMl ??
                current.awayMl,

              homeMl:
                matched.homeMl ??
                current.homeMl,

              awayHandicapLine:
                matched.awaySpreadLine ??
                current.awayHandicapLine,

              homeHandicapLine:
                matched.homeSpreadLine ??
                current.homeHandicapLine,

              awayHandicap:
                matched.awayHandicap ??
                current.awayHandicap,

              homeHandicap:
                matched.homeHandicap ??
                current.homeHandicap,

              totalLine:
                matched.totalLine ??
                current.totalLine,

              overOdds:
                matched.overOdds ??
                current.overOdds,

              underOdds:
                matched.underOdds ??
                current.underOdds,
            };
          }

          return next;
        });
      }
    } catch (e) {
      setError(
        e instanceof Error
          ? e.message
          : "불러오기 실패"
      );
    } finally {
      setLoading(false);
    }
  }


  // 저장된 배당 + 잠금 상태 복원
  useEffect(() => {
    try {
      const savedRaw =
        localStorage.getItem("kbo-analyzer-saved-odds");

      const lockedRaw =
        localStorage.getItem("kbo-analyzer-locked-odds");

      const saved: Record<string, OddsInput> =
        savedRaw ? JSON.parse(savedRaw) : {};

      const locked: Record<string, boolean> =
        lockedRaw ? JSON.parse(lockedRaw) : {};

      setSavedOdds(saved);
      setLockedOdds(locked);

      // 저장된 경기 배당은 화면에도 즉시 복원
      setAllOdds((prev) => ({
        ...prev,
        ...saved,
      }));
    } catch {}

    setOddsStorageReady(true);
  }, []);

  // 저장된 자동조합 스냅샷 복원
  useEffect(() => {
    try {
      const raw =
        localStorage.getItem(
          "kbo-analyzer-saved-combos-v1"
        );

      const parsed: SavedComboSnapshot[] =
        raw ? JSON.parse(raw) : [];

      setSavedCombos(
        Array.isArray(parsed)
          ? parsed
          : []
      );
    } catch {
      setSavedCombos([]);
    }

    setComboStorageReady(true);
  }, []);

  // 자동조합 스냅샷 영구 저장
  useEffect(() => {
    if (!comboStorageReady) return;

    localStorage.setItem(
      "kbo-analyzer-saved-combos-v1",
      JSON.stringify(savedCombos)
    );
  }, [savedCombos, comboStorageReady]);


  /*
    PC / 모바일 공용 상태 동기화

    1. 먼저 각 브라우저 localStorage 복원을 기다림
    2. 서버에 기존 데이터가 있으면 서버값 우선
    3. 서버가 비어 있으면 현재 localStorage 값을 유지
    4. 이후 변경값은 서버에도 자동 저장
  */
  useEffect(() => {
    if (
      !oddsStorageReady ||
      !comboStorageReady ||
      sharedStateReady
    ) {
      return;
    }

    let cancelled = false;

    async function restoreSharedState() {
      try {
        const response =
          await fetch(
            "/api/sync/state",
            {
              method: "GET",
              cache: "no-store",
            }
          );

        if (!response.ok) {
          throw new Error(
            `shared state GET ${response.status}`
          );
        }

        const data = await response.json() as {
          updatedAt?: string | null;

          savedOdds?: Record<
            string,
            OddsInput
          >;

          lockedOdds?: Record<
            string,
            boolean
          >;

          savedCombos?:
            SavedComboSnapshot[];
        };

        if (cancelled) return;

        const serverSavedOdds =
          data.savedOdds &&
          typeof data.savedOdds === "object"
            ? data.savedOdds
            : {};

        const serverLockedOdds =
          data.lockedOdds &&
          typeof data.lockedOdds === "object"
            ? data.lockedOdds
            : {};

        const serverSavedCombos =
          Array.isArray(
            data.savedCombos
          )
            ? data.savedCombos
            : [];

        const serverHasData =
          !!data.updatedAt ||
          Object.keys(
            serverSavedOdds
          ).length > 0 ||
          Object.keys(
            serverLockedOdds
          ).length > 0 ||
          serverSavedCombos.length > 0;

        /*
          서버가 이미 사용 중이면 서버값 우선.
          서버가 완전히 비어 있으면
          현재 PC localStorage 값을 그대로 유지해서
          아래 PUT effect가 최초 서버 데이터로 올린다.
        */
        if (serverHasData) {
          setSavedOdds(
            serverSavedOdds
          );

          setLockedOdds(
            serverLockedOdds
          );

          setSavedCombos(
            serverSavedCombos
          );

          setAllOdds((prev) => ({
            ...prev,
            ...serverSavedOdds,
          }));
        }
      } catch (error) {
        console.error(
          "shared state restore failed",
          error
        );
      } finally {
        if (!cancelled) {
          setSharedStateReady(true);
        }
      }
    }

    restoreSharedState();

    return () => {
      cancelled = true;
    };
  }, [
    oddsStorageReady,
    comboStorageReady,
    sharedStateReady,
  ]);


  useEffect(() => {
    if (!sharedStateReady) {
      return;
    }

    const controller =
      new AbortController();

    async function saveSharedState() {
      try {
        const response =
          await fetch(
            "/api/sync/state",
            {
              method: "PUT",

              headers: {
                "Content-Type":
                  "application/json",
              },

              body: JSON.stringify({
                savedOdds,
                lockedOdds,
                savedCombos,
              }),

              signal:
                controller.signal,
            }
          );

        if (!response.ok) {
          throw new Error(
            `shared state PUT ${response.status}`
          );
        }
      } catch (error) {
        if (
          error instanceof DOMException &&
          error.name === "AbortError"
        ) {
          return;
        }

        console.error(
          "shared state save failed",
          error
        );
      }
    }

    saveSharedState();

    return () => {
      controller.abort();
    };
  }, [
    savedOdds,
    lockedOdds,
    savedCombos,
    sharedStateReady,
  ]);


  // 저장 버튼을 눌러 확정한 값만 영구 저장
  useEffect(() => {
    if (!oddsStorageReady) return;

    localStorage.setItem(
      "kbo-analyzer-saved-odds",
      JSON.stringify(savedOdds)
    );

    localStorage.setItem(
      "kbo-analyzer-locked-odds",
      JSON.stringify(lockedOdds)
    );
  }, [savedOdds, lockedOdds, oddsStorageReady]);

  // 저장값 복원이 끝난 뒤 경기/자동배당 로드
  useEffect(() => {
    if (
      !oddsStorageReady ||
      !sharedStateReady
    ) {
      return;
    }

    load();
  }, [
    date,
    oddsStorageReady,
    sharedStateReady,
  ]);

  const allPicks: Pick[] = useMemo(
    () =>
      games.flatMap((g) => {
        const awayStarter =
          g.startingPitchers.away?.id
            ? pitcherStats[
                g.startingPitchers.away.id
              ]
            : undefined;

        const homeStarter =
          g.startingPitchers.home?.id
            ? pitcherStats[
                g.startingPitchers.home.id
              ]
            : undefined;

        const awayStarterScore =
          starterRating(
            awayStarter
          )?.score ?? 0;

        const homeStarterScore =
          starterRating(
            homeStarter
          )?.score ?? 0;

        const starterEdge =
          awayStarter &&
          homeStarter
            ? awayStarterScore -
              homeStarterScore
            : 0;

        const awayFormScore =
          teamFormRating(
            teamForms[
              g.awayTeamName
            ]
          )?.score ?? 0;

        const homeFormScore =
          teamFormRating(
            teamForms[
              g.homeTeamName
            ]
          )?.score ?? 0;

        const formEdge =
          teamForms[
            g.awayTeamName
          ] &&
          teamForms[
            g.homeTeamName
          ]
            ? awayFormScore -
              homeFormScore
            : 0;

        const awayBullpenScore =
          bullpenRating(
            bullpens[
              g.awayTeamName
            ]
          )?.score ?? 0;

        const homeBullpenScore =
          bullpenRating(
            bullpens[
              g.homeTeamName
            ]
          )?.score ?? 0;

        const bullpenEdge =
          bullpens[
            g.awayTeamName
          ] &&
          bullpens[
            g.homeTeamName
          ]
            ? awayBullpenScore -
              homeBullpenScore
            : 0;

        const lineupEdge =
          lineupMatchups[
            g.gameId
          ]?.ready &&
          typeof lineupMatchups[
            g.gameId
          ]?.edge === "number"
            ? lineupMatchups[
                g.gameId
              ].edge ?? 0
            : 0;

        const projectedTotal =
          estimateProjectedTotal(
            teamForms[g.awayTeamName],
            teamForms[g.homeTeamName],
            awayStarter,
            homeStarter,
            bullpens[g.awayTeamName],
            bullpens[g.homeTeamName],
            lineupMatchups[g.gameId]
          );

        return analyzeGame(
          g,
          odds[g.gameId] ||
            emptyOdds,
          starterEdge,
          formEdge,
          bullpenEdge,
          lineupEdge,
          projectedTotal
        );
      }),
    [
      games,
      odds,
      pitcherStats,
      teamForms,
      bullpens,
      lineupMatchups,
    ]
  );
  const combos =
    useMemo(
      () =>
        makeFlexibleAutoCombos(
          allPicks,
          comboSettings
        ),
