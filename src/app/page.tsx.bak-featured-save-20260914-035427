  function saveAutoCombo(
    combo: (typeof combos)[number]
  ) {
    const oddsByGame:
      Record<string, OddsInput> = {};

    const gameInfo:
      SavedComboSnapshot["games"] = {};

    for (const pick of combo.picks) {
      oddsByGame[pick.gameId] = {
        ...(odds[pick.gameId] || emptyOdds),
      };

      const game = games.find(
        (item) =>
          item.gameId === pick.gameId
      );

      if (game) {
        gameInfo[pick.gameId] = {
          awayTeamName:
            game.awayTeamName,
          homeTeamName:
            game.homeTeamName,
          stadium:
            game.stadium || "",
        };
      }
    }

    const snapshot:
      SavedComboSnapshot = {
        id:
          `${date}-${combo.style}-${Date.now()}`,

        date,
        savedAt:
          new Date().toISOString(),

        name: combo.name,
        style: combo.style,

        odds: combo.odds,
        probability:
          combo.probability,
        averageConfidence:
          combo.averageConfidence,
        averageEv:
          combo.averageEv,

        picks:
          combo.picks.map(
            (pick) => ({ ...pick })
          ),

        oddsByGame,
        games: gameInfo,
      };

    setSavedCombos((prev) => {
      /*
        같은 날짜 + 같은 스타일은
        최신 저장본 1개만 유지.
        예:
        오늘 안정형 2폴을 다시 저장하면
        이전 오늘 안정형 2폴을 교체.
      */
      const filtered =
        prev.filter(
          (item) =>
            !(
              item.date === date &&
              item.name === combo.name
            )
        );

      return [
        snapshot,
        ...filtered,
      ];
    });
  }


