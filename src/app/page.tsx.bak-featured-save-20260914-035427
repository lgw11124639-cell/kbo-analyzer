function DecimalInput({
  value,
  onValueChange,
  placeholder,
}: {
  value: number | null;
  onValueChange: (value: number | null) => void;
  placeholder: string;
}) {
  const [text, setText] = useState(value === null ? "" : String(value));
  const [focused, setFocused] = useState(false);

  useEffect(() => {
    if (!focused) {
      setText(value === null ? "" : String(value));
    }
  }, [value, focused]);

  return (
    <input
      inputMode="decimal"
      value={text}
      placeholder={placeholder}
      onFocus={() => setFocused(true)}
      onChange={(e) => {
        const next = e.target.value.replace(",", ".");

        // 빈 값 / 음수 / 소수 입력 허용
        // 예: -, -1, -1.5, 1.5
        if (!/^-?\d*(?:\.\d*)?$/.test(next)) return;

        setText(next);

        if (
          next === "" ||
          next === "." ||
          next === "-" ||
          next === "-."
        ) {
          onValueChange(null);
          return;
        }

        const n = Number(next);
        if (Number.isFinite(n)) {
          onValueChange(n);
        }
      }}
      onBlur={() => {
        setFocused(false);

        if (
          text === "" ||
          text === "." ||
          text === "-" ||
          text === "-."
        ) {
          setText("");
          onValueChange(null);
          return;
        }

        const n = Number(text);

        if (Number.isFinite(n)) {
          setText(String(n));
          onValueChange(n);
        }
      }}
    />
  );
}


