function lineupPlayerVerdict(
  player: LineupMatchupPlayer
) {
  const adjustment =
    player.adjustment ?? 0;

  if (adjustment >= 4) {
    return {
      label: "▲ 상대 선발 강한 우위",
      tone: "strongPlus",
    };
  }

  if (adjustment >= 1.5) {
    return {
      label: "▲ 상대 선발 상성 플러스",
      tone: "plus",
    };
  }

  if (adjustment <= -4) {
    return {
      label: "▼ 상대 선발 강한 열세",
      tone: "strongMinus",
    };
  }

  if (adjustment <= -1.5) {
    return {
      label: "▼ 상대 선발 상성 마이너스",
      tone: "minus",
    };
  }

  return {
    label: "― 상대 선발 상성 중립",
    tone: "neutral",
  };
}


function lineupTeamReasons(
  team:
    LineupMatchupData["away"] |
    LineupMatchupData["home"],
  opponent:
    LineupMatchupData["away"] |
    LineupMatchupData["home"]
) {
  const reasons: string[] = [];

  const teamScore =
    team.matchupSummary?.score;

  const oppScore =
    opponent.matchupSummary?.score;

  const teamOps =
    team.baseSummary?.avgOps;

  const oppOps =
    opponent.baseSummary?.avgOps;

  if (
    typeof teamScore === "number" &&
    typeof oppScore === "number"
  ) {
    const diff =
      teamScore - oppScore;

    if (diff >= 1) {
      reasons.push(
        `최종 타선 매치업 점수 +${diff.toFixed(1)} 우위`
      );
    } else if (diff <= -1) {
      reasons.push(
        `최종 타선 매치업 점수 ${diff.toFixed(1)} 열세`
      );
    } else {
      reasons.push(
        "최종 타선 매치업 점수는 대등"
      );
    }
  }

  if (
    typeof teamOps === "number" &&
    typeof oppOps === "number"
  ) {
    const opsDiff =
      teamOps - oppOps;

    if (opsDiff >= 0.025) {
      reasons.push(
        `선발 라인업 시즌 OPS 우위 (${stat3(teamOps)} vs ${stat3(oppOps)})`
      );
    } else if (opsDiff <= -0.025) {
      reasons.push(
        `선발 라인업 시즌 OPS 열세 (${stat3(teamOps)} vs ${stat3(oppOps)})`
      );
    }
  }

  const players =
    team.players ?? [];

  const plusCount =
    players.filter(
      (player) =>
        (player.adjustment ?? 0) >= 1.5
    ).length;

  const minusCount =
    players.filter(
      (player) =>
        (player.adjustment ?? 0) <= -1.5
    ).length;

  if (plusCount > 0) {
    reasons.push(
      `상대 선발 상성 플러스 타자 ${plusCount}명`
    );
  }

  if (minusCount > 0) {
    reasons.push(
      `상대 선발 상성 마이너스 타자 ${minusCount}명`
    );
  }

  const meaningfulBvp =
    players.filter(
      (player) =>
        (player.bvp?.pa ?? 0) >= 5
    ).length;

  if (meaningfulBvp > 0) {
    reasons.push(
      `상대 선발 BvP 5타석 이상 표본 ${meaningfulBvp}명 반영`
    );
  }

  return reasons;
}

function formatLineupPosition(
  position: string | null | undefined
) {
  const raw =
    String(position || "")
      .trim();

  const map:
    Record<string, string> = {

    /* 투수 */
    "투": "투수",
    "投": "투수",
    "P": "투수",

    /* 포수 */
    "포": "포수",
    "捕": "포수",
    "C": "포수",

    /* 1루 */
    "1": "1루수",
    "1B": "1루수",
    "일": "1루수",
    "一": "1루수",

    /* 2루 */
    "2": "2루수",
    "2B": "2루수",
    "이": "2루수",
    "二": "2루수",

    /* 3루 */
    "3": "3루수",
    "3B": "3루수",
    "삼": "3루수",
    "三": "3루수",

    /* 유격 */
    "유": "유격수",
    "遊": "유격수",
    "SS": "유격수",

    /* 외야 */
    "좌": "좌익수",
    "左": "좌익수",
    "LF": "좌익수",

    "중": "중견수",
    "中": "중견수",
    "CF": "중견수",

    "우": "우익수",
    "右": "우익수",
    "RF": "우익수",

    /* 지명타자 */
    "지": "지명타자",
    "指": "지명타자",
    "DH": "지명타자",

    /* 교체 */
    "대": "대타",
    "PH": "대타",

    "주": "대주자",
    "PR": "대주자",

    "-": "포지션 미정",
    "－": "포지션 미정",
    "—": "포지션 미정",
    "?": "포지션 미정",
  };

  if (!raw) {
    return "포지션 미정";
  }

  return (
    map[raw] ||
    raw
  );
}


function GameCard({
  game,
  odds,
  setOdds,
  pitcherStats,
  teamForms,
  bullpens,
  lineupMatchups,
  oddsLocked,
  onSaveOdds,
  onUnlockOdds,
}: {
  game: KboGame;
  odds: OddsInput;
  setOdds: (v: OddsInput) => void;
  pitcherStats: Record<number, PitcherStats>;
  teamForms: Record<string, TeamForm>;
  bullpens: Record<string, BullpenData>;
  lineupMatchups: Record<string, LineupMatchupData>;
  oddsLocked: boolean;
  onSaveOdds: () => void;
  onUnlockOdds: () => void;
}) {

  const awayStarterStats =
    game.startingPitchers.away?.id
      ? pitcherStats[
          game.startingPitchers.away.id
        ]
      : undefined;

  const homeStarterStats =
    game.startingPitchers.home?.id
      ? pitcherStats[
          game.startingPitchers.home.id
        ]
      : undefined;

  const awayStarterRating =
    starterRating(
      awayStarterStats
    );

  const homeStarterRating =
    starterRating(
      homeStarterStats
    );

  const starterEdge =
    starterEdgeText(
      awayStarterStats,
      homeStarterStats,
      game.startingPitchers.away?.name ??
        game.awayTeamName,
      game.startingPitchers.home?.name ??
        game.homeTeamName
    );

  const starterScoreEdge =
    awayStarterRating &&
    homeStarterRating
      ? awayStarterRating.score -
        homeStarterRating.score
      : 0;

  const awayTeamForm =
    teamForms[
      game.awayTeamName
    ];

  const homeTeamForm =
    teamForms[
      game.homeTeamName
    ];

  const awayTeamFormRating =
    teamFormRating(
      awayTeamForm
    );

  const homeTeamFormRating =
    teamFormRating(
      homeTeamForm
    );

  const teamFormEdgeScore =
    awayTeamFormRating &&
    homeTeamFormRating
      ? awayTeamFormRating.score -
        homeTeamFormRating.score
      : 0;

  const awayBullpen =
    bullpens[
      game.awayTeamName
    ];

  const homeBullpen =
    bullpens[
      game.homeTeamName
    ];

  const awayBullpenRating =
    bullpenRating(
      awayBullpen
    );

  const homeBullpenRating =
    bullpenRating(
      homeBullpen
    );

  const bullpenEdgeScore =
    awayBullpenRating &&
    homeBullpenRating
      ? awayBullpenRating.score -
        homeBullpenRating.score
      : 0;

  const lineupMatchup =
    lineupMatchups[
      game.gameId
    ];

  const lineupMatchupEdgeScore =
    lineupMatchup?.ready &&
    typeof lineupMatchup.edge ===
      "number"
      ? lineupMatchup.edge
      : 0;

  const projectedTotal =
    estimateProjectedTotal(
      awayTeamForm,
      homeTeamForm,
      awayStarterStats,
      homeStarterStats,
      awayBullpen,
      homeBullpen,
      lineupMatchup
    );

  const picks = analyzeGame(
    game,
    odds,
    starterScoreEdge,
    teamFormEdgeScore,
    bullpenEdgeScore,
    lineupMatchupEdgeScore,
    projectedTotal
  );

  /*
    추천 자격:
    - 배당 존재
    - EV 양수
    - A/B급

    조건을 못 넘으면 억지 추천 대신 관망.
  */
  // 전체 시장 중 종합점수가 가장 높은 후보
  const topCandidate =
    picks.find(
      (pick) =>
        !!pick.odds &&
        pick.ev !== null
    );

  // 실제 추천은 기존 추천 기준을 통과해야 한다.
  const best =
    picks.find((pick) => {
      if (
        !pick.odds ||
        pick.ev === null ||
        pick.ev <= 0 ||
        pick.grade === "C"
      ) {
        return false;
      }

      // O/U는 예상 총득점과 기준점 차이가
      // 최소 0.8점 이상일 때만 실제 추천 후보로 인정.
      if (
        pick.market === "TOTAL" &&
        projectedTotal !== null &&
        odds.totalLine !== null
      ) {
        const totalEdge =
          Math.abs(
            projectedTotal -
            odds.totalLine
          );

        if (totalEdge < 0.8) {
          return false;
        }
      }

      return true;
    });

  const hasAnyOdds =
    picks.some(
      (pick) =>
        !!pick.odds
    );

  const awayMlPick =
    picks.find(
      (pick) =>
        pick.market === "ML" &&
        pick.label === `${game.awayTeamName} 승`
    );

  const homeMlPick =
    picks.find(
      (pick) =>
        pick.market === "ML" &&
        pick.label === `${game.homeTeamName} 승`
    );

  const awayHandicapPick =
    picks.find(
      (pick) =>
        pick.market === "HANDICAP" &&
        pick.label.startsWith(
          `${game.awayTeamName} `
        )
    );

  const homeHandicapPick =
    picks.find(
      (pick) =>
        pick.market === "HANDICAP" &&
        pick.label.startsWith(
          `${game.homeTeamName} `
        )
    );

  const overPick =
    picks.find(
      (pick) =>
        pick.market === "TOTAL" &&
        pick.label.startsWith("오버")
    );

  const underPick =
    picks.find(
      (pick) =>
        pick.market === "TOTAL" &&
        pick.label.startsWith("언더")
    );
  const [expanded, setExpanded] = useState(false);

  useEffect(() => {
    if (!expanded) {
      return;
    }

    const previousOverflow =
      document.body.style.overflow;

    document.body.style.overflow =
      "hidden";

    const handleEscape = (
      event: KeyboardEvent
    ) => {
      if (event.key === "Escape") {
        setExpanded(false);
      }
    };

    window.addEventListener(
      "keydown",
      handleEscape
    );

    return () => {
      document.body.style.overflow =
        previousOverflow;

      window.removeEventListener(
        "keydown",
        handleEscape
      );
    };
  }, [expanded]);



  return (
