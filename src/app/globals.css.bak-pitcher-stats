.oddsMarkets {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 14px;
}

.marketBlock {
  border: 1px solid rgba(148, 163, 184, 0.18);
  background: rgba(15, 23, 42, 0.35);
  border-radius: 12px;
  padding: 12px;
}

.marketTitle {
  display: block;
  font-size: 13px;
  margin-bottom: 8px;
  color: #cbd5e1;
}

.marketBlock .oddsRow {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
}

.marketBlock .oddsRow label {
  min-width: 0;
}

@media (max-width: 720px) {
  .marketBlock .oddsRow {
    grid-template-columns: 1fr;
  }
}

