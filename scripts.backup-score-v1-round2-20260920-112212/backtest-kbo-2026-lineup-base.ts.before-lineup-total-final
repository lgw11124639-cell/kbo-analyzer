function normalizeTeam(
  name: string
) {
  const n =
    String(name || "")
      .replace(/\s+/g, "")
      .toUpperCase();

  if (n.includes("LG")) return "LG";
  if (n.includes("SSG")) return "SSG";
  if (n.includes("NC")) return "NC";
  if (n.includes("KT")) return "KT";
  if (n.includes("KIA")) return "KIA";

  if (n.includes("삼성")) return "삼성";
  if (n.includes("롯데")) return "롯데";
  if (n.includes("두산")) return "두산";
  if (n.includes("한화")) return "한화";
  if (n.includes("키움")) return "키움";

  return String(name).trim();
}

function gameKey(
  game: BetmanGame
) {
  return [
    game.date,
    normalizeTeam(game.homeTeam),
    normalizeTeam(game.awayTeam),
  ].join("|");
}

async function getJson<T>(
  url: string
): Promise<T | null> {
  try {
    const res =
      await fetch(url);

    if (!res.ok) {
      return null;
    }

    return await res.json() as T;
  } catch {
    return null;
  }
}

function teamFormRating(
  form: TeamForm | null
) {
  if (
    !form ||
    form.sampleSize < 5
  ) {
    return null;
  }

  const clamp =
    (v: number) =>
      Math.max(
        0,
        Math.min(100, v)
      );

  const winPct =
    form.winPct ?? 0.5;

  const avgRuns =
    form.avgRuns ?? 4.5;

  const avgRunsAllowed =
    form.avgRunsAllowed ?? 4.5;

  const resultScore =
    clamp(
      winPct * 100
    );

  const offenseScore =
    clamp(
      50 +
      (avgRuns - 4.5) * 12
    );

  const defenseScore =
    clamp(
      50 +
      (4.5 - avgRunsAllowed) * 12
    );

  const score =
    clamp(
      resultScore * 0.35 +
      offenseScore * 0.35 +
      defenseScore * 0.30
    );

  return {
    score:
      Number(score.toFixed(1)),
  };
}

function clampScore(
  value: number
) {
  return Math.max(
    0,
    Math.min(
      100,
      value
    )
  );
}

function starterRating(
  stats: PitcherStats | undefined
) {
  if (!stats) {
    return null;
  }

  const era =
    stats.era ?? 5;

  const whip =
    stats.whip ?? 1.6;

  const qsRate =
    stats.games &&
    stats.games > 0 &&
    stats.qs !== null
      ? stats.qs /
        stats.games
      : 0.4;

  const seasonKbb =
    stats.walks &&
    stats.walks > 0 &&
    stats.strikeouts !== null
      ? stats.strikeouts /
        stats.walks
      : 2;

  const seasonEraScore =
    clampScore(
      100 -
      (era - 2) * 22
    );

  const seasonWhipScore =
    clampScore(
      100 -
      (whip - 0.9) *
        100
    );

  const qsScore =
    clampScore(
      qsRate * 125
    );

  const kbbScore =
    clampScore(
      seasonKbb * 22
    );

  const seasonScore =
    seasonEraScore * 0.4167 +
    seasonWhipScore * 0.3333 +
    qsScore * 0.1667 +
    kbbScore * 0.0833;

  const r5 =
    stats.recent5;

  let recentScore =
    seasonScore;

  if (
    r5 &&
    r5.games >= 3
  ) {
    const recentEra =
      r5.era ?? era;

    const recentWhip =
      r5.whip ?? whip;

    const recentKbb =
      r5.kbb ??
      seasonKbb;

    const recentEraScore =
      clampScore(
        100 -
        (recentEra - 2) *
          22
      );

    const recentWhipScore =
      clampScore(
        100 -
        (recentWhip - 0.9) *
          100
      );

    const recentKbbScore =
      clampScore(
        recentKbb *
        22
      );

    recentScore =
      recentEraScore * 0.50 +
      recentWhipScore * 0.30 +
      recentKbbScore * 0.20;
  }

  const score =
    clampScore(
      seasonScore * 0.60 +
      recentScore * 0.40
    );

  return {
    score:
      Number(
        score.toFixed(1)
      ),

    seasonScore:
      Number(
        seasonScore.toFixed(1)
      ),

    recentScore:
      Number(
        recentScore.toFixed(1)
      ),
  };
}

function bullpenRating(
  bullpen: BullpenData | null
) {
  if (!bullpen) {
    return null;
  }

  const score =
    Math.max(
      0,
      Math.min(
        100,
        100 -
        bullpen.summary.fatigueIndex
      )
    );

  return {
    score:
      Number(score.toFixed(1)),
  };
}

function estimateProjectedTotal(
  awayForm: TeamForm | null,
  homeForm: TeamForm | null,
  awayStarter: PitcherStats | undefined,
  homeStarter: PitcherStats | undefined,
  awayBullpen: BullpenData | null,
  homeBullpen: BullpenData | null,
  awayLineupOps: number | null,
  homeLineupOps: number | null
) {
  if (
    awayForm?.avgRuns == null ||
    awayForm.avgRunsAllowed == null ||
    homeForm?.avgRuns == null ||
    homeForm.avgRunsAllowed == null
  ) {
    return null;
  }

  const LEAGUE_TEAM_RUNS =
    4.50;

  const awayRecentExpectation =
    (
      awayForm.avgRuns +
      homeForm.avgRunsAllowed
    ) / 2;

  const homeRecentExpectation =
    (
      homeForm.avgRuns +
      awayForm.avgRunsAllowed
    ) / 2;

  let awayRuns =
    LEAGUE_TEAM_RUNS * 0.45 +
    awayRecentExpectation * 0.55;

  let homeRuns =
    LEAGUE_TEAM_RUNS * 0.45 +
    homeRecentExpectation * 0.55;

  const blendedEra = (
    stats: PitcherStats | undefined
  ) => {
    if (!stats) {
      return null;
    }

    const season =
      stats.era;

    const recent =
      stats.recent5?.era;

    if (
      season === null &&
      (
        recent === null ||
        recent === undefined
      )
    ) {
      return null;
    }

    if (
      season !== null &&
      recent !== null &&
      recent !== undefined
    ) {
      return (
        season * 0.60 +
        recent * 0.40
      );
    }

    return (
      season ??
      recent ??
      null
    );
  };

  const homeStarterEra =
    blendedEra(
      homeStarter
    );

  const awayStarterEra =
    blendedEra(
      awayStarter
    );

  /*
    상대 선발이 약하면 공격팀 예상득점 증가,
    강하면 감소.

    현재 앱과 동일:
    기준 ERA 4.50
    계수 0.09
    최대 ±0.40점
  */
  if (
    homeStarterEra !== null
  ) {
    awayRuns +=
      Math.max(
        -0.40,
        Math.min(
          0.40,
          (
            homeStarterEra -
            4.50
          ) * 0.09
        )
      );
  }

  if (
    awayStarterEra !== null
  ) {
    homeRuns +=
      Math.max(
        -0.40,
        Math.min(
          0.40,
          (
            awayStarterEra -
            4.50
          ) * 0.09
        )
      );
  }

  if (homeBullpen) {
    awayRuns +=
      Math.max(
        -0.18,
        Math.min(
          0.18,
          (
            homeBullpen
              .summary
              .fatigueIndex -
            50
          ) * 0.003
        )
      );
  }

  if (awayBullpen) {
    homeRuns +=
      Math.max(
        -0.18,
        Math.min(
          0.18,
          (
            awayBullpen
              .summary
              .fatigueIndex -
            50
          ) * 0.003
        )
      );
  }

  /*
    현재 앱과 동일한 라인업 OPS 보정

    OPS .750 = 중립
    최대 ±0.20점
  */
  if (
    typeof awayLineupOps === "number"
  ) {
    awayRuns +=
      Math.max(
        -0.20,
        Math.min(
          0.20,
          (
            awayLineupOps -
            0.750
          ) * 1.0
        )
      );
  }

  if (
    typeof homeLineupOps === "number"
  ) {
    homeRuns +=
      Math.max(
        -0.20,
        Math.min(
          0.20,
          (
            homeLineupOps -
            0.750
          ) * 1.0
        )
      );
  }

  awayRuns =
    Math.max(
      2.75,
      Math.min(
        6.25,
        awayRuns
      )
    );

  homeRuns =
    Math.max(
      2.75,
      Math.min(
        6.25,
        homeRuns
      )
    );

  return Number(
    (
      awayRuns +
      homeRuns
    ).toFixed(2)
  );
}

