        awayStarterRating &&
        homeStarterRating
          ? awayStarterRating.score -
            homeStarterRating.score
          : 0;

      const projectedTotal =
        estimateProjectedTotal(
          awayForm,
          homeForm,
          awayStarterStats,
          homeStarterStats,
          awayBullpen,
          homeBullpen
        );

      if (
        date === "2026-04-10"
      ) {
        console.log(
          "[STARTER CHECK]",
          away,
          "@",
          home,
          "|",
          starterSnapshot
            ?.awayStarter
            ?.name,
          awayStarterRating?.score,
          "vs",
          starterSnapshot
            ?.homeStarter
            ?.name,
          homeStarterRating?.score,
          "| EDGE",
          starterEdge,
          "| TOTAL",
          projectedTotal
        );
      }

      const odds =
        makeOdds(
          betman
        );

      /*
        선발:
        실제 해당 경기 이전 기록으로 재구성.

        라인업:
        아직 historical-safe 복원 전이므로 0.
      */
      const lineupSnapshot =
        historicalLineupByGameId.get(
          kboGame.gameId
        );

      const lineupEdge =
        lineupSnapshot &&
        lineupSnapshot.confirmed &&
        typeof lineupSnapshot.lineupEdge === "number"
          ? lineupSnapshot.lineupEdge
          : 0;

      const picks =
        analyzeGame(
          kboGame,
          odds,
          starterEdge,
          formEdge,
          bullpenEdge,
          lineupEdge,
          projectedTotal
        );

      const recommendation =
        selectRecommendation(
          picks,
          projectedTotal,
          odds
        );

      if (
        !recommendation ||
        !recommendation.odds
      ) {
        continue;
      }

      /*
        실제 정산은 Betman score보다
        공식 KBO 최종 점수를 우선.
      */
      const settlementGame = {
        ...betman,

        actualScore: {
          home:
            kboGame.score.home,

          away:
            kboGame.score.away,
        },
      };

      const result =
        settlePick(
          recommendation,
          settlementGame,
          odds
        );

      const money =
        resultMoney(
          result,
          recommendation.odds
        );

      results.push({
        date,

        month:
          date.slice(
            0,
            7
          ),

        gameId:
          kboGame.gameId,

        round:
          betman.round,

        homeTeam:
          home,

        awayTeam:
          away,

        homeScore:
          kboGame.score.home,

        awayScore:
          kboGame.score.away,

        market:
          recommendation.market,

        label:
          recommendation.label,

        grade:
          recommendation.grade,

        confidence:
          recommendation.confidence,

        ev:
          recommendation.ev,

        odds:
          recommendation.odds,

        projectedTotal,

        result,

        ...money,
      });
    }
  }

  const monthly =
    Object.fromEntries(
      [...new Set(
        results.map(
          (x) => x.month
        )
      )]
        .sort()
        .map(
          (month) => [
            month,
            summary(
              results.filter(
                (x) =>
                  x.month ===
                  month
              )
            ),
          ]
        )
    );

  const markets =
    Object.fromEntries(
      [
        "ML",
        "HANDICAP",
        "TOTAL",
      ].map(
        (market) => [
          market,
          summary(
            results.filter(
              (x) =>
                x.market ===
                market
            )
          ),
        ]
      )
    );

  const grades =
    Object.fromEntries(
      [
        "A",
        "B",
      ].map(
        (grade) => [
          grade,
          summary(
            results.filter(
              (x) =>
                x.grade ===
                grade
            )
          ),
        ]
      )
    );

  const output = {
    generatedAt:
      new Date()
        .toISOString(),

    methodology: {
      stake:
        STAKE,

      model:
        "current-analyzer-v1-no-lookahead",

      included: [
        "Betman odds",
        "historical rank",
        "historical team form",
        "historical bullpen",
      ],

      excluded: [
        "starter rating",
        "lineup matchup",
      ],

      duplicateRule:
        "same date/home/away -> highest Proto round",
    },

    sourceRecords:
      source.length,

    uniqueGames:
      games.length,

    recommendations:
      results.length,

    overall:
      summary(results),

    monthly,

    markets,

    grades,

    results,
  };

  fs.writeFileSync(
    OUTPUT_FILE,
    JSON.stringify(
      output,
      null,
      2
    ),
    "utf8"
  );

  console.log();
  console.log(
    "===== OVERALL ====="
  );
  console.table([
    output.overall,
  ]);

  console.log();
  console.log(
    "===== MONTHLY ====="
  );

  console.table(
    Object.entries(
      monthly
    ).map(
      ([month, stat]) => ({
        month,
        ...(stat as any),
      })
    )
  );

  console.log();
  console.log(
    "===== MARKET ====="
  );

  console.table(
    Object.entries(
      markets
    ).map(
      ([market, stat]) => ({
        market,
        ...(stat as any),
      })
    )
  );

  console.log();
  console.log(
    "===== GRADE ====="
  );

  console.table(
    Object.entries(
      grades
    ).map(
      ([grade, stat]) => ({
        grade,
        ...(stat as any),
      })
    )
  );

  console.log();
  console.log(
    "FILE:",
    OUTPUT_FILE
  );
}

main().catch(
  (error) => {
    console.error(error);
    process.exit(1);
  }
);
