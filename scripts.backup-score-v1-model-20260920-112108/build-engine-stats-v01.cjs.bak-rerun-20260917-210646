const fs = require("fs");
const path = require("path");

const ENGINE_VERSION = "v0.1";
const LIVE_START = "2026-09-16";
const UNIT_STAKE = 10000;

const INPUT = path.join(
  process.cwd(),
  "data",
  "kbo-backtest-2026-all-candidates-lineup-base.json"
);

const OUTPUT = path.join(
  process.cwd(),
  "data",
  "kbo-engine-stats-v0.1-backtest.json"
);

const raw = JSON.parse(
  fs.readFileSync(
    INPUT,
    "utf8"
  )
);

const sourceRows =
  Array.isArray(raw)
    ? raw
    : raw.results || [];

const rows =
  sourceRows.filter(
    (row) =>
      row &&
      typeof row.date === "string" &&
      row.date < LIVE_START &&
      ["ML", "HANDICAP", "TOTAL"]
        .includes(row.market) &&
      ["WIN", "LOSS", "PUSH"]
        .includes(row.result) &&
      Number.isFinite(
        Number(row.confidence)
      )
  );


function profit10k(row) {
  const odds =
    Number(row.odds);

  if (
    !Number.isFinite(odds) ||
    odds <= 1
  ) {
    return null;
  }

  if (row.result === "WIN") {
    return UNIT_STAKE *
      (odds - 1);
  }

  if (row.result === "LOSS") {
    return -UNIT_STAKE;
  }

  if (row.result === "PUSH") {
    return 0;
  }

  return null;
}


function summarizePicks(list) {
  const wins =
    list.filter(
      r => r.result === "WIN"
    ).length;

  const losses =
    list.filter(
      r => r.result === "LOSS"
    ).length;

  const pushes =
    list.filter(
      r => r.result === "PUSH"
    ).length;

  const decided =
    wins + losses;

  const bettable =
    list
      .map(
        row => ({
          row,
          profit:
            profit10k(row),
        })
      )
      .filter(
        x =>
          typeof x.profit ===
          "number"
      );

  const profit =
    bettable.reduce(
      (sum, x) =>
        sum + x.profit,
      0
    );

  const stake =
    bettable.length *
    UNIT_STAKE;

  return {
    count:
      list.length,

    wins,
    losses,
    pushes,
    decided,

    hitRate:
      decided
        ? wins / decided
        : null,

    profit:
      Math.round(profit),

    returnRate:
      stake
        ? profit / stake
        : null,
  };
}


function groupBy(
  list,
  keyFn
) {
  const map =
    new Map();

  for (const row of list) {
    const key =
      keyFn(row);

    if (!map.has(key)) {
      map.set(
        key,
        []
      );
    }

    map.get(key)
      .push(row);
  }

  return map;
}


/*
============================================================
1. 경기 전체 예측
============================================================

각 경기 + 각 시장별로
confidence가 높은 방향 1개만
실제 엔진 예측으로 본다.

경기당 최대:
- ML 1개
- HANDICAP 1개
- TOTAL 1개
*/
const allDirectionMap =
  new Map();

for (
  let index = 0;
  index < rows.length;
  index += 1
) {
  const row =
    rows[index];

  const key =
    `${row.date}:${row.gameId}:${row.market}`;

  const previous =
    allDirectionMap.get(key);

  if (
    !previous ||
    Number(row.confidence) >
    Number(previous.row.confidence)
  ) {
    allDirectionMap.set(
      key,
      {
        row,
        index,
      }
    );
  }
}

const allPredictions =
  [...allDirectionMap.values()]
    .sort(
      (a, b) =>
        a.index - b.index
    )
    .map(
      item => item.row
    );


const allByMarket = {
  ML:
    summarizePicks(
      allPredictions.filter(
        r => r.market === "ML"
      )
    ),

  HANDICAP:
    summarizePicks(
      allPredictions.filter(
        r => r.market ===
          "HANDICAP"
      )
    ),

  TOTAL:
    summarizePicks(
      allPredictions.filter(
        r => r.market ===
          "TOTAL"
      )
    ),
};


const gameMap =
  groupBy(
    allPredictions,
    r =>
      `${r.date}:${r.gameId}`
  );

const allByGame =
  [...gameMap.entries()]
    .map(
      ([key, items]) => {
        const first =
          items[0];

        return {
          key,

          date:
            first.date,

          gameId:
            first.gameId,

          awayTeam:
            first.awayTeam,

          homeTeam:
            first.homeTeam,

          ...summarizePicks(
            items
          ),

          markets:
            items.map(
              r => ({
                market:
                  r.market,

                label:
                  r.label,

                confidence:
                  r.confidence,

                result:
                  r.result,
              })
            ),
        };
      }
    )
    .sort(
      (a, b) =>
        a.date.localeCompare(
          b.date
        ) ||
        a.gameId.localeCompare(
          b.gameId
        )
    );


const monthMap =
  groupBy(
    allPredictions,
    r =>
      r.month ||
      r.date.slice(
        0,
        7
      )
  );

const allByMonth =
  [...monthMap.entries()]
    .map(
      ([month, items]) => ({
        month,

        ...summarizePicks(
          items
        ),
      })
    )
    .sort(
      (a, b) =>
        a.month.localeCompare(
          b.month
        )
    );


/*
============================================================
2. AI 추천 조합
============================================================

실제 화면 aiAllRecommendationCandidates와 동일:

- confidence > 0
- odds > 1
- 한 조합에 같은 경기 중복 금지
- 2/3/4/5폴
- 모든 후보 비교
*/
function gradeValue(
  grade
) {
  if (grade === "A") {
    return 3;
  }

  if (grade === "B") {
    return 2;
  }

  return 1;
}


function comboMetrics(
  picks
) {
  const odds =
    picks.reduce(
      (value, pick) =>
        value *
        Number(pick.odds),
      1
    );

  const probability =
    picks.reduce(
      (value, pick) =>
        value *
        Number(
          pick.confidence
        ),
      1
    );

  const averageConfidence =
    picks.reduce(
      (value, pick) =>
        value +
        Number(
          pick.confidence
        ),
      0
    ) /
    Math.max(
      1,
      picks.length
    );

  const evValues =
    picks
      .map(
        pick =>
          pick.ev
      )
      .filter(
        value =>
          typeof value ===
            "number" &&
          Number.isFinite(
            value
          )
      );

  const averageEv =
    evValues.length
      ? evValues.reduce(
          (sum, value) =>
            sum + value,
          0
        ) /
        evValues.length
      : null;

  const averageGrade =
    picks.reduce(
      (sum, pick) =>
        sum +
        gradeValue(
          pick.grade
        ),
      0
    ) /
    Math.max(
      1,
      picks.length
    );

  const negativeEvCount =
    picks.filter(
      pick =>
        (
          pick.ev ??
          -1
        ) < 0
    ).length;

  return {
    odds,
    probability,
    averageConfidence,
    averageEv,
    averageGrade,
    negativeEvCount,
  };
}


function comboScore(
  metrics,
  mode
) {
  const averageEv =
    metrics.averageEv ??
    -0.20;

  if (mode === "SAFE") {
    return (
      metrics.probability *
        100 *
        0.68 +
      metrics.averageConfidence *
        100 *
        0.24 +
      averageEv *
        100 *
        0.05 +
      metrics.averageGrade *
        1.8 -
      metrics.negativeEvCount *
        1.5
    );
  }

  if (mode === "VALUE") {
    return (
      metrics.probability *
        100 *
        0.40 +
      metrics.averageConfidence *
        100 *
        0.18 +
      averageEv *
        100 *
        0.30 +
      Math.log(
        Math.max(
          1,
          metrics.odds
        )
      ) *
        6 +
      metrics.averageGrade *
        1.6 -
      metrics.negativeEvCount *
        2
    );
  }

  return (
    Math.log(
      Math.max(
        1,
        metrics.odds
      )
    ) *
      18 +
    metrics.probability *
      100 *
      0.28 +
    metrics.averageConfidence *
      100 *
      0.14 +
    averageEv *
      100 *
      0.20 +
    metrics.averageGrade *
      1.2 -
    metrics.negativeEvCount *
      2.5
  );
}


function settleCombo(
  picks
) {
  const results =
    picks.map(
      pick =>
        pick.result
    );

  if (
    results.some(
      result =>
        result === "LOSS"
    )
  ) {
    return {
      result:
        "LOSS",

      effectiveOdds:
        0,
    };
  }

  const wins =
    results.filter(
      result =>
        result === "WIN"
    ).length;

  if (
    wins === 0
  ) {
    return {
      result:
        "VOID",

      effectiveOdds:
        1,
    };
  }

  const effectiveOdds =
    picks.reduce(
      (
        total,
        pick
      ) =>
        pick.result ===
          "PUSH"
          ? total
          : total *
            Number(
              pick.odds
            ),
      1
    );

  return {
    result:
      "WIN",

    effectiveOdds,
  };
}


const byDate =
  groupBy(
    rows,
    r => r.date
  );


const modes = [
  "SAFE",
  "VALUE",
  "HIGH_ODDS",
];

const legs = [
  2,
  3,
  4,
  5,
];

const aiCombos = [];


for (
  const [
    date,
    dateRows,
  ] of byDate
) {
  const eligible =
    dateRows.filter(
      pick =>
        Number.isFinite(
          Number(
            pick.confidence
          )
        ) &&
        Number(
          pick.confidence
        ) > 0 &&
        Number.isFinite(
          Number(
            pick.odds
          )
        ) &&
        Number(
          pick.odds
        ) > 1
    );


  for (
    const leg of legs
  ) {
    let bestSafe = null;
    let bestValue = null;
    let bestHighAll = null;
    let bestHighQuality = null;

    const selected = [];


    const consider = () => {
      const picks =
        [...selected];

      const metrics =
        comboMetrics(
          picks
        );

      const safeScore =
        comboScore(
          metrics,
          "SAFE"
        );

      const valueScore =
        comboScore(
          metrics,
          "VALUE"
        );

      const highScore =
        comboScore(
          metrics,
          "HIGH_ODDS"
        );


      if (
        !bestSafe ||
        safeScore >
          bestSafe.score
      ) {
        bestSafe = {
          score:
            safeScore,

          picks,

          metrics,
        };
      }


      if (
        !bestValue ||
        valueScore >
          bestValue.score
      ) {
        bestValue = {
          score:
            valueScore,

          picks,

          metrics,
        };
      }


      if (
        !bestHighAll ||
        highScore >
          bestHighAll.score
      ) {
        bestHighAll = {
          score:
            highScore,

          picks,

          metrics,
        };
      }


      const quality =
        metrics.averageConfidence >=
          0.52 &&
        (
          metrics.averageEv ??
          -1
        ) >=
          -0.05;

      if (
        quality &&
        (
          !bestHighQuality ||
          highScore >
            bestHighQuality.score
        )
      ) {
        bestHighQuality = {
          score:
            highScore,

          picks,

          metrics,
        };
      }
    };


    const build = (
      start
    ) => {
      if (
        selected.length ===
        leg
      ) {
        consider();
        return;
      }

      const needed =
        leg -
        selected.length;

      for (
        let i = start;
        i <=
          eligible.length -
          needed;
        i += 1
      ) {
        const pick =
          eligible[i];

        if (
          selected.some(
            current =>
              current.gameId ===
              pick.gameId
          )
        ) {
          continue;
        }

        selected.push(
          pick
        );

        build(
          i + 1
        );

        selected.pop();
      }
    };


    build(0);


    const chosen = {
      SAFE:
        bestSafe,

      VALUE:
        bestValue,

      HIGH_ODDS:
        bestHighQuality ||
        bestHighAll,
    };


    for (
      const mode of
      modes
    ) {
      const best =
        chosen[mode];

      if (!best) {
        continue;
      }

      const settlement =
        settleCombo(
          best.picks
        );

      aiCombos.push({
        engineVersion:
          ENGINE_VERSION,

        source:
          "BACKTEST",

        date,

        mode,

        leg,

        odds:
          best.metrics.odds,

        probability:
          best.metrics.probability,

        averageConfidence:
          best.metrics
            .averageConfidence,

        averageEv:
          best.metrics
            .averageEv,

        result:
          settlement.result,

        effectiveOdds:
          settlement.effectiveOdds,

        picks:
          best.picks.map(
            pick => ({
              gameId:
                pick.gameId,

              awayTeam:
                pick.awayTeam,

              homeTeam:
                pick.homeTeam,

              market:
                pick.market,

              label:
                pick.label,

              grade:
                pick.grade,

              confidence:
                pick.confidence,

              ev:
                pick.ev,

              odds:
                pick.odds,

              result:
                pick.result,
            })
          ),
      });
    }
  }
}


function summarizeCombos(
  list
) {
  const wins =
    list.filter(
      combo =>
        combo.result ===
        "WIN"
    ).length;

  const losses =
    list.filter(
      combo =>
        combo.result ===
        "LOSS"
    ).length;

  const voids =
    list.filter(
      combo =>
        combo.result ===
        "VOID"
    ).length;

  const decided =
    wins + losses;

  let returned = 0;

  const stake =
    list.length *
    UNIT_STAKE;

  for (
    const combo of list
  ) {
    if (
      combo.result ===
      "WIN"
    ) {
      returned +=
        UNIT_STAKE *
        combo.effectiveOdds;

    } else if (
      combo.result ===
      "VOID"
    ) {
      returned +=
        UNIT_STAKE;
    }
  }

  const pickRows =
    list.flatMap(
      combo =>
        combo.picks
    );

  const pickWins =
    pickRows.filter(
      pick =>
        pick.result ===
        "WIN"
    ).length;

  const pickLosses =
    pickRows.filter(
      pick =>
        pick.result ===
        "LOSS"
    ).length;

  const pickDecided =
    pickWins +
    pickLosses;

  const averageOdds =
    list.length
      ? list.reduce(
          (sum, combo) =>
            sum +
            combo.odds,
          0
        ) /
        list.length
      : null;

  return {
    count:
      list.length,

    wins,
    losses,
    voids,
    decided,

    hitRate:
      decided
        ? wins /
          decided
        : null,

    pickWins,
    pickLosses,
    pickDecided,

    pickHitRate:
      pickDecided
        ? pickWins /
          pickDecided
        : null,

    averageOdds,

    profit:
      Math.round(
        returned -
        stake
      ),

    returnRate:
      stake
        ? (
            returned -
            stake
          ) /
          stake
        : null,
  };
}


const aiByModeLeg = {};

for (
  const mode of modes
) {
  aiByModeLeg[mode] = {};

  for (
    const leg of legs
  ) {
    aiByModeLeg[
      mode
    ][leg] =
      summarizeCombos(
        aiCombos.filter(
          combo =>
            combo.mode ===
              mode &&
            combo.leg ===
              leg
        )
      );
  }
}


