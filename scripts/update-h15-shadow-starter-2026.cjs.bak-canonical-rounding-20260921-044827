const fs=require("fs"),path=require("path");
const BASE=process.env.KBO_BACKTEST_BASE_URL||"http://127.0.0.1:3200";
const SEED=path.join(process.cwd(),"data","kbo-historical-starter-stats-2026-forward-temp.json");
const FILE=process.env.FILE||path.join(process.cwd(),"data","kbo-h15-shadow-starter-2026.json");
const START=process.env.START_DATE||"2026-09-21";
const END=process.env.END_DATE||START;
const REGULAR=new Set(["KIA","KT","LG","NC","SSG","두산","롯데","삼성","키움","한화"]);
const norm=s=>String(s||"").replace(/\s+/g,"").replace("두산베어스","두산").replace("LG트윈스","LG").replace("삼성라이온즈","삼성").replace("KIA타이거즈","KIA").replace("한화이글스","한화").replace("롯데자이언츠","롯데").replace("KT위즈","KT").replace("NC다이노스","NC").replace("SSG랜더스","SSG").replace("키움히어로즈","키움");
const iso=d=>`${d.getUTCFullYear()}-${String(d.getUTCMonth()+1).padStart(2,"0")}-${String(d.getUTCDate()).padStart(2,"0")}`;
const ymd=d=>iso(d).replaceAll("-","");
function dates(a,b){const out=[],d=new Date(a+"T00:00:00Z"),e=new Date(b+"T00:00:00Z");while(d<=e){out.push(new Date(d));d.setUTCDate(d.getUTCDate()+1)}return out}
function num(v){if(v===null||v===undefined||v==="")return 0;const x=Number(String(v).replace(/,/g,"").trim());return Number.isFinite(x)?x:0}
function outs(v){if(v===null||v===undefined||v==="")return 0;const s=String(v).trim();let m=s.match(/^(\d+)\s+([12])\/3$/);if(m)return Number(m[1])*3+Number(m[2]);m=s.match(/^([12])\/3$/);if(m)return Number(m[1]);const x=Number(s);if(Number.isNaN(x))return 0;const w=Math.floor(x),f=x-w;if(Math.abs(f-.1)<.02)return w*3+1;if(Math.abs(f-.2)<.02)return w*3+2;return Math.round(x*3)}
function ipstr(o){const w=Math.floor(o/3),r=o%3;return r?`${w} ${r}/3`:String(w)}
function ipnum(o){return Number((o/3).toFixed(2))}
function rows(v){if(!v||typeof v!=="string")return[];try{const p=JSON.parse(v);return Array.isArray(p?.rows)?p.rows.map(r=>Array.isArray(r?.row)?r.row.map(c=>String(c?.Text||"").replace(/&nbsp;/g,"").trim()):[]):[]}catch{return[]}}
function pitchers(o){if(!o||typeof o!=="object")return[];return rows(o.table).filter(r=>r.length>=16).map(r=>({name:r[0]||"",entry:r[1]||"",result:r[2]||"",innings:r[6]||"",outs:outs(r[6]),pitches:num(r[8]),hits:num(r[10]),homeRuns:num(r[11]),walks:num(r[12]),strikeouts:num(r[13]),runs:num(r[14]),earnedRuns:num(r[15])}))}
function recent(a){if(!a.length)return null;const O=a.reduce((s,x)=>s+x.outs,0),H=a.reduce((s,x)=>s+x.hits,0),BB=a.reduce((s,x)=>s+x.walks,0),K=a.reduce((s,x)=>s+x.strikeouts,0),ER=a.reduce((s,x)=>s+x.earnedRuns,0);return{games:a.length,innings:ipnum(O),era:O?Number((ER*27/O).toFixed(2)):null,whip:O?Number(((H+BB)*3/O).toFixed(2)):null,strikeouts:K,walks:BB,kbb:BB?Number((K/BB).toFixed(2)):K||null}}
function stats(id,h){const O=h.reduce((s,x)=>s+x.outs,0),H=h.reduce((s,x)=>s+x.hits,0),HR=h.reduce((s,x)=>s+x.homeRuns,0),BB=h.reduce((s,x)=>s+x.walks,0),K=h.reduce((s,x)=>s+x.strikeouts,0),R=h.reduce((s,x)=>s+x.runs,0),ER=h.reduce((s,x)=>s+x.earnedRuns,0),NP=h.reduce((s,x)=>s+x.pitches,0),QS=h.filter(x=>x.qs).length;return{playerId:id,era:O?Number((ER*27/O).toFixed(2)):null,games:h.length,wins:null,losses:null,saves:null,holds:null,winPct:null,battersFaced:null,pitches:NP,innings:O?ipstr(O):null,hits:H,homeRuns:HR,walks:BB,strikeouts:K,runs:R,earnedRuns:ER,whip:O?Number(((H+BB)*3/O).toFixed(2)):null,avg:null,qs:QS,recent5:recent(h.slice(-5)),recent10:recent(h.slice(-10))}}
async function today(date){const r=await fetch(`${BASE}/api/kbo/today?date=${date}`,{cache:"no-store"});if(!r.ok)throw new Error("TODAY_HTTP_"+r.status);const j=await r.json();return Array.isArray(j?.games)?j.games:[]}
async function rawGames(d){const r=await fetch("https://www.koreabaseball.com/ws/Main.asmx/GetKboGameList",{method:"POST",headers:{"Content-Type":"application/json; charset=UTF-8","User-Agent":"Mozilla/5.0",Referer:"https://www.koreabaseball.com/"},body:JSON.stringify({leId:"1",srId:"0,9,6",date:ymd(d)}),cache:"no-store"});if(!r.ok)return[];let t=await r.text();const ix=[t.indexOf("<!DOCTYPE"),t.indexOf("<html")].filter(x=>x>=0);if(ix.length)t=t.slice(0,Math.min(...ix));const j=JSON.parse(t);return Array.isArray(j?.game)?j.game:[]}
async function box(gid,season,sr){const b=new URLSearchParams();b.set("leId","1");b.set("srId",String(sr));b.set("seasonId",String(season));b.set("gameId",gid);const r=await fetch("https://www.koreabaseball.com/ws/Schedule.asmx/GetBoxScoreScroll",{method:"POST",headers:{"Content-Type":"application/x-www-form-urlencoded; charset=UTF-8","X-Requested-With":"XMLHttpRequest",Referer:"https://www.koreabaseball.com/Schedule/GameCenter/Main.aspx","User-Agent":"Mozilla/5.0"},body:b.toString(),cache:"no-store"});return r.ok?await r.json():null}
(async()=>{
if(!fs.existsSync(FILE)){const seed=JSON.parse(fs.readFileSync(SEED,"utf8"));if(seed.endDate!=="2026-09-20")throw new Error("SEED_ENDDATE_NOT_2026_09_20 "+seed.endDate);const base={...seed,generatedAt:new Date().toISOString(),shadow:true,shadowType:"REF-2843543_CANONICAL_STARTER_FORWARD",seedFile:path.basename(SEED),seedEndDate:"2026-09-20"};fs.writeFileSync(FILE,JSON.stringify(base,null,2));console.log("SHADOW_SEED_CREATED",FILE,"SNAPSHOTS",base.snapshots?.length||0,"PITCHERS",Object.keys(base.pitcherHistories||{}).length)}
const base=JSON.parse(fs.readFileSync(FILE,"utf8"));const snapshots=Array.isArray(base.snapshots)?base.snapshots:[];const histObj=base.pitcherHistories&&typeof base.pitcherHistories==="object"?base.pitcherHistories:{};const hist=new Map(Object.entries(histObj).map(([k,v])=>[Number(k),Array.isArray(v)?v:[]]));const snapKeys=new Set(snapshots.map(x=>x.date+"|"+x.gameId));const histKeys=new Set();for(const [id,a] of hist)for(const x of a)histKeys.add(id+"|"+x.gameId);
if(START<"2026-09-21")throw new Error("START_BEFORE_UNSEEN_WINDOW_BLOCKED "+START);if(!/^\d{4}-\d{2}-\d{2}$/.test(START)||!/^\d{4}-\d{2}-\d{2}$/.test(END)||START>END)throw new Error("INVALID_RANGE "+START+" "+END);
let addedSnapshots=0,addedAppearances=0,missingStarterRef=0,notFinal=0,missingRaw=0,missingBox=0,nameMismatch=0;
for(const d of dates(START,END)){const di=iso(d),tg=await today(di),rg=await rawGames(d),rawMap=new Map(rg.map(g=>{const raw=String(g.G_ID||"");const gid=raw.startsWith(ymd(d))?raw:ymd(d)+raw;return[gid,g]}));console.log("DATE",di,"TODAY_GAMES",tg.length,"RAW_GAMES",rg.length);
for(const g of tg){const away=norm(g.awayTeamName),home=norm(g.homeTeamName);if(!REGULAR.has(away)||!REGULAR.has(home))continue;if(g.status?.cancelCode&&g.status.cancelCode!=="0")continue;const gid=String(g.gameId||"");if(!gid)continue;const ar=g.startingPitchers?.away||null,hr=g.startingPitchers?.home||null;if(!ar||!hr){missingStarterRef++;console.log("SKIP_NO_STARTER",gid);continue}
const sk=di+"|"+gid;if(!snapKeys.has(sk)){snapshots.push({date:di,gameId:gid,awayTeam:away,homeTeam:home,awayStarter:{id:Number(ar.id),name:String(ar.name||""),stats:stats(Number(ar.id),hist.get(Number(ar.id))||[])},homeStarter:{id:Number(hr.id),name:String(hr.name||""),stats:stats(Number(hr.id),hist.get(Number(hr.id))||[])}});snapKeys.add(sk);addedSnapshots++;console.log("SNAPSHOT_ADDED",gid,ar.name,"vs",hr.name)}
if(String(g.status?.stateCode)!=="3"){notFinal++;continue}
const raw=rawMap.get(gid);if(!raw){missingRaw++;console.log("MISSING_RAW",gid);continue}const bx=await box(gid,Number(raw.SEASON_ID||2026),Number(raw.SR_ID||0));if(!bx){missingBox++;console.log("MISSING_BOX",gid);continue}const arr=Array.isArray(bx.arrPitcher)?bx.arrPitcher:[],ap=pitchers(arr[0]),hp=pitchers(arr[1]);for(const [ref,actual,team,opp,side] of [[ar,ap[0]||null,away,home,"AWAY"],[hr,hp[0]||null,home,away,"HOME"]]){if(!ref||!actual)continue;const id=Number(ref.id),hk=id+"|"+gid;if(histKeys.has(hk))continue;if(ref.name&&actual.name&&ref.name!==actual.name){nameMismatch++;console.log("STARTER_NAME_MISMATCH",gid,ref.name,actual.name)}const appearance={date:di,gameId:gid,playerId:id,name:String(ref.name||actual.name||""),team,opponent:opp,side,innings:actual.innings,outs:actual.outs,pitches:actual.pitches,hits:actual.hits,homeRuns:actual.homeRuns,walks:actual.walks,strikeouts:actual.strikeouts,runs:actual.runs,earnedRuns:actual.earnedRuns,qs:actual.outs>=18&&actual.earnedRuns<=3};const a=hist.get(id)||[];a.push(appearance);a.sort((x,y)=>x.date.localeCompare(y.date)||x.gameId.localeCompare(y.gameId));hist.set(id,a);histKeys.add(hk);addedAppearances++;console.log("STARTER_APPENDED",gid,side,id,appearance.name,appearance.innings,"ER",appearance.earnedRuns)}}}
snapshots.sort((a,b)=>a.date.localeCompare(b.date)||a.gameId.localeCompare(b.gameId));const pitcherHistories=Object.fromEntries([...hist.entries()].sort((a,b)=>a[0]-b[0]).map(([id,a])=>[String(id),a]));const stamp=new Date().toISOString().replace(/[:.]/g,"-");fs.copyFileSync(FILE,FILE+".bak-"+stamp);const out={...base,generatedAt:new Date().toISOString(),endDate:END,snapshotCount:snapshots.length,pitcherCount:Object.keys(pitcherHistories).length,snapshots,pitcherHistories,shadowDiagnostics:{addedSnapshots,addedAppearances,missingStarterRef,notFinal,missingRaw,missingBox,nameMismatch,lastRun:{start:START,end:END}}};fs.writeFileSync(FILE,JSON.stringify(out,null,2));console.log("UPDATE_DONE",JSON.stringify({start:START,end:END,addedSnapshots,addedAppearances,missingStarterRef,notFinal,missingRaw,missingBox,nameMismatch,totalSnapshots:snapshots.length,pitcherCount:Object.keys(pitcherHistories).length,file:FILE}))})().catch(e=>{console.error("UPDATE_FAILED",e.message);process.exitCode=0});
