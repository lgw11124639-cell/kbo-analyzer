const dot=(a,b)=>a.reduce((s,v,i)=>s+v*b[i],0);const fs=require("fs");const DATA="data/kbo-backtest-2026-all-candidates-lineup-base.json";const root=JSON.parse(fs.readFileSync(DATA,"utf8"));const rows=root.results||[];const n=v=>{const x=Number(v);return Number.isFinite(x)?x:null};const clamp=(x,a,b)=>Math.max(a,Math.min(b,x));const sigmoid=x=>1/(1+Math.exp(-x));const logit=p=>Math.log(clamp(p,.001,.999)/(1-clamp(p,.001,.999)));const games=[...new Map(rows.filter(r=>n(r.awayScore)!==null&&n(r.homeScore)!==null).map(r=>[r.gameId,r])).values()].sort((a,b)=>String(a.date).localeCompare(String(b.date)));const split=g=>{const m=Number(String(g.date).slice(5,7));return m<=4?"DISCOVERY":m<=6?"INTERNAL":"FINAL"};function mean(a){return a.length?a.reduce((s,x)=>s+x,0)/a.length:0}function sd(a){if(a.length<2)return 1;const m=mean(a);return Math.sqrt(mean(a.map(x=>(x-m)**2)))||1}function feat(g){const x=g.scoreModelInputs||{};const ar=n(x.awayAvgRuns),ara=n(x.awayAvgRunsAllowed),hr=n(x.homeAvgRuns),hra=n(x.homeAvgRunsAllowed);if([ar,ara,hr,hra].some(v=>v===null))return null;return [1,(ar+hra)/2,(hr+ara)/2,n(g.starterEdge)||0,n(g.formEdge)||0,n(g.bullpenEdge)||0,n(g.lineupEdge)||0,n(g.awayLineupOps)||0,n(g.homeLineupOps)||0]}function solve(X,y,ridge=.35){const m=X[0].length,A=Array.from({length:m},()=>Array(m).fill(0)),b=Array(m).fill(0);for(let i=0;i<X.length;i++)for(let j=0;j<m;j++){b[j]+=X[i][j]*y[i];for(let k=0;k<m;k++)A[j][k]+=X[i][j]*X[i][k]}for(let j=1;j<m;j++)A[j][j]+=ridge;for(let i=0;i<m;i++){let z=i;for(let r=i+1;r<m;r++)if(Math.abs(A[r][i])>Math.abs(A[z][i]))z=r;[A[i],A[z]]=[A[z],A[i]];[b[i],b[z]]=[b[z],b[i]];let d=A[i][i];if(Math.abs(d)<1e-10)continue;for(let k=i;k<m;k++)A[i][k]/=d;b[i]/=d;for(let r=0;r<m;r++)if(r!==i){const q=A[r][i];for(let k=i;k<m;k++)A[r][k]-=q*A[i][k];b[r]-=q*b[i]}}return b}const train=games.filter(g=>split(g)!=="FINAL").map(g=>({g,f:feat(g)})).filter(x=>x.f);const raw=train.map(x=>x.f);const mu=[],ss=[];for(let j=0;j<raw[0].length;j++){if(j===0){mu[j]=0;ss[j]=1}else{mu[j]=mean(raw.map(r=>r[j]));ss[j]=sd(raw.map(r=>r[j]))}}const Z=raw.map(r=>r.map((v,j)=>j===0?1:(v-mu[j])/ss[j]));const wa=solve(Z,train.map(x=>n(x.g.awayScore)));const wh=solve(Z,train.map(x=>n(x.g.homeScore)));function lambdas(g){const f=feat(g);if(!f)return null;const z=f.map((v,j)=>j===0?1:(v-mu[j])/ss[j]);let a=z.reduce((s,v,j)=>s+v*wa[j],0),h=z.reduce((s,v,j)=>s+v*wh[j],0);return [clamp(a,1.5,9),clamp(h,1.5,9)]}const V44_AWAY_DISP=3.57,V44_HOME_DISP=4.92;function nbin(k,mu,size){let logp=0;for(let i=1;i<=k;i++)logp+=Math.log(size+i-1)-Math.log(i);logp+=size*Math.log(size/(size+mu))+k*Math.log(mu/(size+mu));return Math.exp(logp)}function dist(a,h){const out=[];let mass=0;for(let x=0;x<=30;x++)for(let y=0;y<=30;y++){const p=nbin(x,a,V44_AWAY_DISP)*nbin(y,h,V44_HOME_DISP);out.push([x,y,p]);mass+=p}return out.map(v=>[v[0],v[1],v[2]/mass])}function probs(g,a,h){const D=dist(a,h);let aw=0,hw=0,tie=0;for(const[x,y,p]of D){if(x>y)aw+=p;else if(y>x)hw+=p;else tie+=p}const den=aw+hw;return{awayML:den?aw/den:.5,homeML:den?hw/den:.5,D,tie}}function marketRows(g,P){const rs=rows.filter(r=>r.gameId===g.gameId);const out=[];for(const r of rs){const o=n(r.odds);if(!o||o<=1)continue;let p=null,push=0;if(r.market==="ML"){const away=String(r.label).includes(g.awayTeam);p=away?P.awayML:P.homeML}else if(r.market==="HANDICAP"){const away=String(r.label).includes(g.awayTeam);const mm=String(r.label).match(/([+-]?\d+(?:\.\d+)?)/);if(!mm)continue;const line=Number(mm[1]);let win=0;for(const[x,y,q]of P.D){const z=(away?x-y:y-x)+line;if(z>0)win+=q;else if(z===0)push+=q}p=win/(1-push||1)}else if(r.market==="TOTAL"){const line=n(r.totalLine)??Number(String(r.label).match(/(\d+(?:\.\d+)?)/)?.[1]);if(!Number.isFinite(line))continue;const over=String(r.label).includes("오버");let win=0;for(const[x,y,q]of P.D){const z=x+y-line;if(z===0)push+=q;else if((over&&z>0)||(!over&&z<0))win+=q}p=win/(1-push||1)}if(p!==null)out.push({r,p,ev:p*o-1})}return out}function score(part){const gs=games.filter(g=>split(g)===part);let teamAbs=0,totalAbs=0,diffAbs=0,nG=0,wN=0,wOK=0,viol=0;const M={ML:[],HANDICAP:[],TOTAL:[]};for(const g of gs){const L=lambdas(g);if(!L)continue;const[a,h]=L,P=probs(g,a,h),AS=n(g.awayScore),HS=n(g.homeScore);teamAbs+=(Math.abs(a-AS)+Math.abs(h-HS))/2;totalAbs+=Math.abs(a+h-AS-HS);diffAbs+=Math.abs((a-h)-(AS-HS));nG++;if(AS!==HS){wN++;if((P.awayML>.5)===(AS>HS))wOK++}const mr=marketRows(g,P);for(const x of mr)M[x.r.market]?.push(x);const hc=mr.filter(x=>x.r.market==="HANDICAP");for(const x of hc){const away=String(x.r.label).includes(g.awayTeam);const mm=String(x.r.label).match(/([+-]?\d+(?:\.\d+)?)/);if(mm&&Number(mm[1])<0){const ml=away?P.awayML:P.homeML;if(x.p>ml+1e-9)viol++}}}console.log("\n===== "+part+" =====");console.log("GAMES="+nG+" TEAM_MAE="+(teamAbs/nG).toFixed(3)+" TOTAL_MAE="+(totalAbs/nG).toFixed(3)+" DIFF_MAE="+(diffAbs/nG).toFixed(3)+" WINNER_ACC="+(100*wOK/wN).toFixed(1)+"% CONSISTENCY_VIOLATIONS="+viol);for(const k of Object.keys(M)){const all=M[k],byGame=new Map();for(const x of all){const id=String(x.r.gameId);if(!byGame.has(id)||x.p>byGame.get(id).p)byGame.set(id,x)}const a=[...byGame.values()];let b=0,ll=0,hit=0,roi=0,settled=0;for(const x of a){const AS=n(x.r.awayScore),HS=n(x.r.homeScore);if(AS===null||HS===null)continue;let win=null;if(k==="ML"){const away=String(x.r.label).includes(x.r.awayTeam);if(AS===HS)continue;win=away?(AS>HS?1:0):(HS>AS?1:0)}else if(k==="HANDICAP"){const away=String(x.r.label).includes(x.r.awayTeam);const mm=String(x.r.label).match(/([+-]?[0-9]+(?:[.][0-9]+)?)/);if(!mm)continue;const z=(away?AS-HS:HS-AS)+Number(mm[1]);if(z===0)continue;win=z>0?1:0}else if(k==="TOTAL"){const mm=String(x.r.label).match(/(\\d+(?:\\.\\d+)?)/);const line=n(x.r.totalLine)??(mm?Number(mm[1]):null);if(line===null||!Number.isFinite(line))continue;const z=AS+HS-line;if(z===0)continue;win=String(x.r.label).includes("오버")?(z>0?1:0):(z<0?1:0)}if(win===null)continue;const od=n(x.r.odds);settled++;hit+=win;b+=(x.p-win)**2;ll+=-(win*Math.log(clamp(x.p,.001,.999))+(1-win)*Math.log(clamp(1-x.p,.001,.999)));if(od!==null&&od>1)roi+=win*(od-1)-(1-win)}console.log(k+" N="+settled+" HIT="+(100*hit/(settled||1)).toFixed(1)+"% BRIER="+(b/(settled||1)).toFixed(4)+" LOGLOSS="+(ll/(settled||1)).toFixed(4)+" ROI="+(100*roi/(settled||1)).toFixed(1)+"%")}return{nG,teamAbs,totalAbs,diffAbs,wN,wOK}}console.log("===== KBO ENGINE V4.4 OVERDISPERSED SCORE BACKTEST =====");console.log("ROWS="+rows.length+" GAMES="+games.length+" TRAIN_GAMES="+train.length+" FINAL_GAMES="+games.filter(g=>split(g)==="FINAL").length);console.log("MODEL=Ridge + Negative Binomial joint score distribution; dispersion estimated without FINAL");console.log("AWAY_WEIGHTS="+JSON.stringify(wa));console.log("HOME_WEIGHTS="+JSON.stringify(wh));score("DISCOVERY");score("INTERNAL");score("FINAL");console.log("\n===== V0.8 FINAL BASELINE =====");console.log("TEAM_MAE=2.855 TOTAL_MAE=4.188 DIFF_MAE=4.109 WINNER_ACC=54.0%");console.log("ML_ROI=-15.8% HANDICAP_ROI=-15.5% TOTAL_ROI=-11.2%");console.log("\nIMPORTANT: V4.4 is challenger only. analyzer.ts unchanged.");function wfActual(x){const r=x.r,A=n(r.awayScore),H=n(r.homeScore);if(A===null||H===null)return null;if(r.market==="ML"){if(A===H)return null;return String(r.label).includes(r.awayTeam)?+(A>H):+(H>A)}if(r.market==="HANDICAP"){const m=String(r.label).match(/([+-]?[0-9]+(?:[.][0-9]+)?)/);if(!m)return null;const z=(String(r.label).includes(r.awayTeam)?A-H:H-A)+Number(m[1]);return z===0?null:+(z>0)}if(r.market==="TOTAL"){const m=String(r.label).match(/([0-9]+(?:[.][0-9]+)?)/);const line=n(r.totalLine)??(m?Number(m[1]):null);if(line===null||A+H===line)return null;return String(r.label).includes("오버")?+(A+H>line):+(A+H<line)}return null}function wfCal(k,p){const s=k==="ML"?1:k==="HANDICAP"?.827:.351;return clamp(.5+(p-.5)*s,.001,.999)}function wfMetric(a){let b=0,l=0;for(const x of a){b+=(x.p-x.y)**2;l+=-(x.y*Math.log(x.p)+(1-x.y)*Math.log(1-x.p))}return{n:a.length,b:b/a.length,l:l/a.length}}function wfFit(trainGames){const rows=trainGames.map(g=>{const f=feat(g);return f?[g,f]:null}).filter(Boolean);if(rows.length<50)return null;const X=rows.map(x=>x[1]),mu=X[0].map((_,j)=>mean(X.map(r=>r[j]))),sd=X[0].map((_,j)=>Math.sqrt(mean(X.map(r=>(r[j]-mu[j])**2)))||1),Z=X.map(r=>r.map((v,j)=>j===0?1:(v-mu[j])/sd[j])),wa=solve(Z,rows.map(x=>n(x[0].awayScore)),.35),wh=solve(Z,rows.map(x=>n(x[0].homeScore)),.35);return{mu,sd,wa,wh}}function wfLambda(g,m){const f=feat(g);if(!f||!m)return null;const z=f.map((v,j)=>j===0?1:(v-m.mu[j])/m.sd[j]);return[clamp(dot(m.wa,z),1.5,9),clamp(dot(m.wh,z),1.5,9)]}console.log("\n===== V4.6 시간순 자동학습 검증 =====");const months=[5,6,7,8,9];const all={ML:[],HANDICAP:[],TOTAL:[]};for(const mo of months){const train=games.filter(g=>Number(String(g.date).slice(5,7))<mo),test=games.filter(g=>Number(String(g.date).slice(5,7))===mo),model=wfFit(train);const cur={ML:[],HANDICAP:[],TOTAL:[]};for(const g of test){const L=wfLambda(g,model);if(!L)continue;const P=probs(g,L[0],L[1]);for(const k of Object.keys(cur)){const q=marketRows(g,P).filter(x=>x.r.market===k);if(!q.length)continue;const x=q.reduce((a,b)=>b.p>a.p?b:a),y=wfActual(x);if(y===null)continue;const z={p:wfCal(k,x.p),y};cur[k].push(z);all[k].push(z)}}console.log("\n["+mo+"월] 학습="+train.length+"경기 / 다음달검증="+test.length+"경기");for(const [k,name] of Object.entries({ML:"승패",HANDICAP:"핸디캡",TOTAL:"언더/오버"})){const m=wfMetric(cur[k]);console.log(name+" N="+m.n+" 예측정확성="+m.b.toFixed(4)+" 확률오차="+m.l.toFixed(4))}}console.log("\n===== V4.6 전체 시간순 결과 =====");for(const [k,name] of Object.entries({ML:"승패",HANDICAP:"핸디캡",TOTAL:"언더/오버"})){const m=wfMetric(all[k]);console.log(name+" N="+m.n+" 예측정확성="+m.b.toFixed(4)+" 확률오차="+m.l.toFixed(4))}console.log("\n기준: 숫자가 낮을수록 좋음 / 미래 데이터 학습 금지 / analyzer.ts 변경 없음")
function v47bin(a){const B={};for(const x of a){const lo=Math.floor(x.p*20)*5,hi=Math.min(100,lo+5),k=lo+"-"+hi;if(!B[k])B[k]={n:0,p:0,y:0};B[k].n++;B[k].p+=x.p;B[k].y+=x.y}return B}function v47fit(trainGames){const rr=trainGames.map(g=>{const f=feat(g);return f?[g,f]:null}).filter(Boolean);if(rr.length<50)return null;const X=rr.map(x=>x[1]),m=X[0].map((_,j)=>mean(X.map(r=>r[j]))),s=X[0].map((_,j)=>Math.sqrt(mean(X.map(r=>(r[j]-m[j])**2)))||1),Z=X.map(r=>r.map((v,j)=>j===0?1:(v-m[j])/s[j])),a=solve(Z,rr.map(x=>n(x[0].awayScore)),.35),h=solve(Z,rr.map(x=>n(x[0].homeScore)),.35);return{m,s,a,h}}function v47lam(g,M){const f=feat(g);if(!f||!M)return null;const z=f.map((v,j)=>j===0?1:(v-M.m[j])/M.s[j]);return[clamp(dot(M.a,z),1.5,9),clamp(dot(M.h,z),1.5,9)]}console.log("\n===== V4.7 WALK-FORWARD 진단 =====");const VA={ML:[],HANDICAP:[],TOTAL:[]};for(const mo of [5,6,7,8,9]){const tr=games.filter(g=>Number(String(g.date).slice(5,7))<mo),te=games.filter(g=>Number(String(g.date).slice(5,7))===mo),M=v47fit(tr),A={ML:[],HANDICAP:[],TOTAL:[]};let ta=0,tt=0,td=0,ng=0;for(const g of te){const L=v47lam(g,M);if(!L)continue;const as=n(g.awayScore),hs=n(g.homeScore);if(as===null||hs===null)continue;ta+=(Math.abs(L[0]-as)+Math.abs(L[1]-hs))/2;tt+=Math.abs(L[0]+L[1]-as-hs);td+=Math.abs((L[0]-L[1])-(as-hs));ng++;const P=probs(g,L[0],L[1]);for(const k of Object.keys(A)){const q=marketRows(g,P).filter(x=>x.r.market===k);if(!q.length)continue;const x=q.reduce((a,b)=>b.p>a.p?b:a),y=wfActual(x);if(y===null)continue;const z={p:wfCal(k,x.p),y};A[k].push(z);VA[k].push(z)}}console.log("\n["+mo+"월] 학습="+tr.length+" / 검증="+ng);console.log("팀점수오차="+(ta/ng).toFixed(3)+" 총점오차="+(tt/ng).toFixed(3)+" 점수차오차="+(td/ng).toFixed(3));for(const [k,name] of Object.entries({ML:"승패",HANDICAP:"핸디캡",TOTAL:"언더/오버"})){const m=wfMetric(A[k]);console.log(name+" N="+m.n+" 예측정확성="+m.b.toFixed(4)+" 확률오차="+m.l.toFixed(4));const B=v47bin(A[k]);for(const z of Object.keys(B).sort((a,b)=>Number(a.split("-")[0])-Number(b.split("-")[0]))){const b=B[z];if(b.n>=5)console.log("  "+z+"% N="+b.n+" AI="+(100*b.p/b.n).toFixed(1)+"% 실제="+(100*b.y/b.n).toFixed(1)+"% 차이="+(100*(b.y-b.p)/b.n).toFixed(1)+"%p")}}}console.log("\n===== V4.7 전체 확률구간 =====");for(const [k,name] of Object.entries({ML:"승패",HANDICAP:"핸디캡",TOTAL:"언더/오버"})){console.log("\n["+name+"]");const B=v47bin(VA[k]);for(const z of Object.keys(B).sort((a,b)=>Number(a.split("-")[0])-Number(b.split("-")[0]))){const b=B[z];if(b.n>=10)console.log(z+"% N="+b.n+" AI="+(100*b.p/b.n).toFixed(1)+"% 실제="+(100*b.y/b.n).toFixed(1)+"% 차이="+(100*(b.y-b.p)/b.n).toFixed(1)+"%p")}}console.log("\nV4.7은 진단 전용 / analyzer.ts 변경 없음")
console.log("\n===== V4.8 변수 영향도 / 월별 안정성 검사 =====");const V48_NAMES=["절편","공격/상대수비-A","공격/상대수비-H","선발","최근폼","불펜","라인업","원정라인업OPS","홈라인업OPS"];const V48_H={};for(const mo of [5,6,7,8,9]){const tr=games.filter(g=>Number(String(g.date).slice(5,7))<mo),M=v47fit(tr);if(!M){console.log("["+mo+"월] 모델없음");continue}console.log("\n["+mo+"월 예측용 모델] 학습="+tr.length+"경기");V48_H[mo]={};for(let j=0;j<V48_NAMES.length;j++){const aw=M.a[j],hw=M.h[j],diff=aw-hw;V48_H[mo][j]={aw,hw,diff};console.log(V48_NAMES[j]+" 원정="+aw.toFixed(4)+" 홈="+hw.toFixed(4)+" 점수차영향="+diff.toFixed(4))}}console.log("\n===== 변수 안정성 요약 =====");for(let j=1;j<V48_NAMES.length;j++){const vals=[5,6,7,8,9].filter(m=>V48_H[m]).map(m=>V48_H[m][j].diff),signs=vals.map(v=>Math.sign(v)).filter(v=>v!==0),flips=signs.slice(1).reduce((s,v,i)=>s+(v!==signs[i]?1:0),0),avg=vals.reduce((a,b)=>a+b,0)/vals.length,sd=Math.sqrt(vals.reduce((s,v)=>s+(v-avg)**2,0)/vals.length),cv=Math.abs(avg)>1e-9?sd/Math.abs(avg):999;console.log(V48_NAMES[j]+" 평균영향="+avg.toFixed(4)+" 변동="+sd.toFixed(4)+" 방향전환="+flips+"회 안정도="+(flips===0&&cv<.75?"높음":flips<=1&&cv<1.5?"보통":"낮음"))}console.log("\n===== 변수 제거 Walk-Forward 비교 =====");function v48featDrop(g,drop){const f=feat(g);if(!f)return null;return f.map((v,j)=>drop===j?0:v)}function v48fitDrop(train,drop){const rr=train.map(g=>{const f=v48featDrop(g,drop);return f?[g,f]:null}).filter(Boolean);if(rr.length<50)return null;const X=rr.map(x=>x[1]),m=X[0].map((_,j)=>mean(X.map(r=>r[j]))),s=X[0].map((_,j)=>Math.sqrt(mean(X.map(r=>(r[j]-m[j])**2)))||1),Z=X.map(r=>r.map((v,j)=>j===0?1:(v-m[j])/s[j])),a=solve(Z,rr.map(x=>n(x[0].awayScore)),.35),h=solve(Z,rr.map(x=>n(x[0].homeScore)),.35);return{m,s,a,h,drop}}function v48lam(g,M){const f=v48featDrop(g,M.drop);if(!f)return null;const z=f.map((v,j)=>j===0?1:(v-M.m[j])/M.s[j]);return[clamp(dot(M.a,z),1.5,9),clamp(dot(M.h,z),1.5,9)]}function v48test(drop){const R={ML:[],HANDICAP:[],TOTAL:[]};let team=0,total=0,diff=0,ng=0;for(const mo of [5,6,7,8,9]){const tr=games.filter(g=>Number(String(g.date).slice(5,7))<mo),te=games.filter(g=>Number(String(g.date).slice(5,7))===mo),M=v48fitDrop(tr,drop);for(const g of te){const L=v48lam(g,M);if(!L)continue;const A=n(g.awayScore),H=n(g.homeScore);if(A===null||H===null)continue;team+=(Math.abs(L[0]-A)+Math.abs(L[1]-H))/2;total+=Math.abs(L[0]+L[1]-A-H);diff+=Math.abs((L[0]-L[1])-(A-H));ng++;const P=probs(g,L[0],L[1]);for(const k of Object.keys(R)){const q=marketRows(g,P).filter(x=>x.r.market===k);if(!q.length)continue;const x=q.reduce((a,b)=>b.p>a.p?b:a),y=wfActual(x);if(y!==null)R[k].push({p:wfCal(k,x.p),y})}}}return{ng,team:team/ng,total:total/ng,diff:diff/ng,R}}const base=v48test(-1);function v48print(name,r){const ml=wfMetric(r.R.ML),hc=wfMetric(r.R.HANDICAP),ou=wfMetric(r.R.TOTAL);console.log(name+" TEAM="+r.team.toFixed(3)+" TOTAL="+r.total.toFixed(3)+" DIFF="+r.diff.toFixed(3)+" | 승패="+ml.b.toFixed(4)+" 핸디="+hc.b.toFixed(4)+" O/U="+ou.b.toFixed(4))}v48print("전체변수",base);for(let j=3;j<V48_NAMES.length;j++)v48print(V48_NAMES[j]+" 제거",v48test(j));console.log("\n해석: 변수를 제거했는데 수치가 낮아지면 그 변수는 현재 모델에 오히려 방해 / analyzer.ts 변경 없음")
console.log("\n===== V4.8 변수 조합 제거전 =====");function v48cFeat(g,drops){const f=feat(g);if(!f)return null;return f.map((v,j)=>drops.includes(j)?0:v)}function v48cFit(train,drops){const rr=train.map(g=>{const f=v48cFeat(g,drops);return f?[g,f]:null}).filter(Boolean);if(rr.length<50)return null;const X=rr.map(x=>x[1]),m=X[0].map((_,j)=>mean(X.map(r=>r[j]))),s=X[0].map((_,j)=>Math.sqrt(mean(X.map(r=>(r[j]-m[j])**2)))||1),Z=X.map(r=>r.map((v,j)=>j===0?1:(v-m[j])/s[j])),a=solve(Z,rr.map(x=>n(x[0].awayScore)),.35),h=solve(Z,rr.map(x=>n(x[0].homeScore)),.35);return{m,s,a,h,drops}}function v48cLam(g,M){const f=v48cFeat(g,M.drops);if(!f)return null;const z=f.map((v,j)=>j===0?1:(v-M.m[j])/M.s[j]);return[clamp(dot(M.a,z),1.5,9),clamp(dot(M.h,z),1.5,9)]}function v48cTest(drops){const R={ML:[],HANDICAP:[],TOTAL:[]};let team=0,total=0,diff=0,ng=0;for(const mo of [5,6,7,8,9]){const tr=games.filter(g=>Number(String(g.date).slice(5,7))<mo),te=games.filter(g=>Number(String(g.date).slice(5,7))===mo),M=v48cFit(tr,drops);for(const g of te){const L=v48cLam(g,M);if(!L)continue;const A=n(g.awayScore),H=n(g.homeScore);if(A===null||H===null)continue;team+=(Math.abs(L[0]-A)+Math.abs(L[1]-H))/2;total+=Math.abs(L[0]+L[1]-A-H);diff+=Math.abs((L[0]-L[1])-(A-H));ng++;const P=probs(g,L[0],L[1]);for(const k of Object.keys(R)){const q=marketRows(g,P).filter(x=>x.r.market===k);if(!q.length)continue;const x=q.reduce((a,b)=>b.p>a.p?b:a),y=wfActual(x);if(y!==null)R[k].push({p:wfCal(k,x.p),y})}}}const ml=wfMetric(R.ML),hc=wfMetric(R.HANDICAP),ou=wfMetric(R.TOTAL);return{ng,team:team/ng,total:total/ng,diff:diff/ng,ml,hc,ou}}const C=[["기존",[]],["불펜X",[5]],["라인업X",[6]],["OPS전체X",[7,8]],["불펜+라인업X",[5,6]],["불펜+OPS전체X",[5,7,8]],["라인업계열전체X",[6,7,8]],["불펜+라인업계열전체X",[5,6,7,8]]];const OUT=[];for(const [name,drops] of C){const r=v48cTest(drops);OUT.push({name,...r});console.log(name+" | TEAM="+r.team.toFixed(3)+" TOTAL="+r.total.toFixed(3)+" DIFF="+r.diff.toFixed(3)+" | 승패="+r.ml.b.toFixed(4)+" 핸디="+r.hc.b.toFixed(4)+" O/U="+r.ou.b.toFixed(4)+" | LOGLOSS 승패="+r.ml.l.toFixed(4)+" 핸디="+r.hc.l.toFixed(4)+" O/U="+r.ou.l.toFixed(4))}console.log("\n===== V4.8 종합 순위 =====");const comboBase=OUT[0];for(const r of OUT){const score=(r.ml.b/comboBase.ml.b)+(r.hc.b/comboBase.hc.b)+(r.ou.b/comboBase.ou.b)+(r.team/comboBase.team)+(r.total/comboBase.total)+(r.diff/comboBase.diff);r.score=score}OUT.sort((a,b)=>a.score-b.score).forEach((r,i)=>console.log((i+1)+"위 "+r.name+" 종합="+r.score.toFixed(4)+" 승패="+r.ml.b.toFixed(4)+" 핸디="+r.hc.b.toFixed(4)+" O/U="+r.ou.b.toFixed(4)+" TEAM="+r.team.toFixed(3)+" TOTAL="+r.total.toFixed(3)+" DIFF="+r.diff.toFixed(3)));console.log("\n주의: 종합점수는 비교용이며 낮을수록 좋음 / 미래 데이터 학습 없음 / analyzer.ts 변경 없음")
console.log("\n===== V4.9 기존 vs V4.8 Challenger 월별 정면검증 =====");function v49run(drops){const O={};for(const mo of [5,6,7,8,9]){const tr=games.filter(g=>Number(String(g.date).slice(5,7))<mo),te=games.filter(g=>Number(String(g.date).slice(5,7))===mo),M=v48cFit(tr,drops),R={ML:[],HANDICAP:[],TOTAL:[]};let team=0,total=0,diff=0,ng=0;for(const g of te){const L=v48cLam(g,M);if(!L)continue;const A=n(g.awayScore),H=n(g.homeScore);if(A===null||H===null)continue;team+=(Math.abs(L[0]-A)+Math.abs(L[1]-H))/2;total+=Math.abs(L[0]+L[1]-A-H);diff+=Math.abs((L[0]-L[1])-(A-H));ng++;const P=probs(g,L[0],L[1]);for(const k of Object.keys(R)){const q=marketRows(g,P).filter(x=>x.r.market===k);if(!q.length)continue;const x=q.reduce((a,b)=>b.p>a.p?b:a),y=wfActual(x);if(y!==null)R[k].push({p:wfCal(k,x.p),y})}}O[mo]={ng,team:team/ng,total:total/ng,diff:diff/ng,ml:wfMetric(R.ML),hc:wfMetric(R.HANDICAP),ou:wfMetric(R.TOTAL)}}return O}const V49B=v49run([]),V49C=v49run([5,6]);let wins=0,losses=0,ties=0;const cmp=(a,b)=>b<a?"개선":b>a?"악화":"동일";for(const mo of [5,6,7,8,9]){const b=V49B[mo],c=V49C[mo];console.log("\n["+mo+"월] 검증="+c.ng+"경기");console.log("팀점수 "+b.team.toFixed(3)+" -> "+c.team.toFixed(3)+" "+cmp(b.team,c.team));console.log("총점 "+b.total.toFixed(3)+" -> "+c.total.toFixed(3)+" "+cmp(b.total,c.total));console.log("점수차 "+b.diff.toFixed(3)+" -> "+c.diff.toFixed(3)+" "+cmp(b.diff,c.diff));console.log("승패 "+b.ml.b.toFixed(4)+" -> "+c.ml.b.toFixed(4)+" "+cmp(b.ml.b,c.ml.b)+" | LOGLOSS "+b.ml.l.toFixed(4)+" -> "+c.ml.l.toFixed(4));console.log("핸디 "+b.hc.b.toFixed(4)+" -> "+c.hc.b.toFixed(4)+" "+cmp(b.hc.b,c.hc.b)+" | LOGLOSS "+b.hc.l.toFixed(4)+" -> "+c.hc.l.toFixed(4));console.log("O/U "+b.ou.b.toFixed(4)+" -> "+c.ou.b.toFixed(4)+" "+cmp(b.ou.b,c.ou.b)+" | LOGLOSS "+b.ou.l.toFixed(4)+" -> "+c.ou.l.toFixed(4));for(const [x,y] of [[b.team,c.team],[b.total,c.total],[b.diff,c.diff],[b.ml.b,c.ml.b],[b.hc.b,c.hc.b],[b.ou.b,c.ou.b]]){if(y<x)wins++;else if(y>x)losses++;else ties++}}console.log("\n===== V4.9 안정성 판정 =====");console.log("월별 지표 총 30개: 개선="+wins+" 악화="+losses+" 동일="+ties);for(const key of ["team","total","diff"]){let w=0;for(const mo of [5,6,7,8,9])if(V49C[mo][key]<V49B[mo][key])w++;console.log(key.toUpperCase()+" 월별 개선="+w+"/5")}for(const [key,name] of [["ml","승패"],["hc","핸디"],["ou","O/U"]]){let w=0,lb=0,lc=0;for(const mo of [5,6,7,8,9]){if(V49C[mo][key].b<V49B[mo][key].b)w++;lb+=V49B[mo][key].l*V49B[mo][key].n;lc+=V49C[mo][key].l*V49C[mo][key].n}console.log(name+" BRIER 월별 개선="+w+"/5"+" | 누적 LOGLOSS "+(lb/[5,6,7,8,9].reduce((s,m)=>s+V49B[m][key].n,0)).toFixed(4)+" -> "+(lc/[5,6,7,8,9].reduce((s,m)=>s+V49C[m][key].n,0)).toFixed(4))}console.log("\n판정기준: 특정 월 몰빵이 아니라 여러 달에서 반복 개선되는지 확인 / 미래 데이터 학습 없음 / analyzer.ts 변경 없음")
console.log("\n===== V4.10 Champion vs 최근경기 가중 Challenger =====");const V410_DROP=[5,6],V410_HALF=[0,360,180,120,90,60];function v410days(a,b){return(Math.max(0,new Date(b+"T00:00:00Z")-new Date(a+"T00:00:00Z"))/86400000)}function v410fit(trainGames,half,testDate){const rr=trainGames.map(g=>{const f=v48cFeat(g,V410_DROP);return f?[g,f]:null}).filter(Boolean);if(rr.length<50)return null;const X=rr.map(x=>x[1]),w=rr.map(x=>half>0?Math.pow(.5,v410days(String(x[0].date).slice(0,10),testDate)/half):1),ws=w.reduce((a,b)=>a+b,0),m=X[0].map((_,j)=>j===0?0:X.reduce((s,r,i)=>s+w[i]*r[j],0)/ws),sd=X[0].map((_,j)=>{if(j===0)return 1;return Math.sqrt(X.reduce((s,r,i)=>s+w[i]*(r[j]-m[j])**2,0)/ws)||1}),Z=X.map(r=>r.map((v,j)=>j===0?1:(v-m[j])/sd[j])),sw=w.map(Math.sqrt),ZW=Z.map((r,i)=>r.map(v=>v*sw[i])),ya=rr.map((x,i)=>n(x[0].awayScore)*sw[i]),yh=rr.map((x,i)=>n(x[0].homeScore)*sw[i]),a=solve(ZW,ya,.35),h=solve(ZW,yh,.35);return{m,sd,a,h}}function v410lam(g,M){const f=v48cFeat(g,V410_DROP);if(!f||!M)return null;const z=f.map((v,j)=>j===0?1:(v-M.m[j])/M.sd[j]);return[clamp(dot(M.a,z),1.5,9),clamp(dot(M.h,z),1.5,9)]}function v410run(half){const months={};const ALL={ML:[],HANDICAP:[],TOTAL:[]};let TA=0,TT=0,TD=0,NG=0;for(const mo of [5,6,7,8,9]){const tr=games.filter(g=>Number(String(g.date).slice(5,7))<mo),te=games.filter(g=>Number(String(g.date).slice(5,7))===mo),testDate="2026-"+String(mo).padStart(2,"0")+"-01",M=v410fit(tr,half,testDate),R={ML:[],HANDICAP:[],TOTAL:[]};let ta=0,tt=0,td=0,ng=0;for(const g of te){const L=v410lam(g,M);if(!L)continue;const A=n(g.awayScore),H=n(g.homeScore);if(A===null||H===null)continue;ta+=(Math.abs(L[0]-A)+Math.abs(L[1]-H))/2;tt+=Math.abs(L[0]+L[1]-A-H);td+=Math.abs((L[0]-L[1])-(A-H));ng++;const P=probs(g,L[0],L[1]);for(const k of Object.keys(R)){const q=marketRows(g,P).filter(x=>x.r.market===k);if(!q.length)continue;const x=q.reduce((a,b)=>b.p>a.p?b:a),y=wfActual(x);if(y===null)continue;const z={p:wfCal(k,x.p),y};R[k].push(z);ALL[k].push(z)}}TA+=ta;TT+=tt;TD+=td;NG+=ng;months[mo]={ng,team:ta/ng,total:tt/ng,diff:td/ng,ml:wfMetric(R.ML),hc:wfMetric(R.HANDICAP),ou:wfMetric(R.TOTAL)}}return{half,months,team:TA/NG,total:TT/NG,diff:TD/NG,ml:wfMetric(ALL.ML),hc:wfMetric(ALL.HANDICAP),ou:wfMetric(ALL.TOTAL)}}const V410=V410_HALF.map(v410run);for(const r of V410){console.log("\n["+(r.half===0?"누적전체":"반감기 "+r.half+"일")+"]");console.log("전체 TEAM="+r.team.toFixed(3)+" TOTAL="+r.total.toFixed(3)+" DIFF="+r.diff.toFixed(3)+" | 승패="+r.ml.b.toFixed(4)+" 핸디="+r.hc.b.toFixed(4)+" O/U="+r.ou.b.toFixed(4));console.log("LOGLOSS 승패="+r.ml.l.toFixed(4)+" 핸디="+r.hc.l.toFixed(4)+" O/U="+r.ou.l.toFixed(4));for(const mo of [5,6,7,8,9]){const x=r.months[mo];console.log(mo+"월 승패="+x.ml.b.toFixed(4)+" 핸디="+x.hc.b.toFixed(4)+" O/U="+x.ou.b.toFixed(4)+" TEAM="+x.team.toFixed(3)+" TOTAL="+x.total.toFixed(3)+" DIFF="+x.diff.toFixed(3))}}const V410_CHAMP=V410[0];console.log("\n===== V4.10 Challenger 순위 =====");for(const r of V410){r.score=(r.team/V410_CHAMP.team)+(r.total/V410_CHAMP.total)+(r.diff/V410_CHAMP.diff)+(r.ml.b/V410_CHAMP.ml.b)+(r.hc.b/V410_CHAMP.hc.b)+(r.ou.b/V410_CHAMP.ou.b)}[...V410].sort((a,b)=>a.score-b.score).forEach((r,i)=>console.log((i+1)+"위 "+(r.half===0?"누적전체":"반감기 "+r.half+"일")+" 종합="+r.score.toFixed(4)+" | 승패="+r.ml.b.toFixed(4)+" 핸디="+r.hc.b.toFixed(4)+" O/U="+r.ou.b.toFixed(4)+" TEAM="+r.team.toFixed(3)+" TOTAL="+r.total.toFixed(3)+" DIFF="+r.diff.toFixed(3)));console.log("\n===== V4.10 자동승격 참고 =====");console.log("Champion=누적전체 V4.8 / Challenger=최근경기 가중 후보");console.log("이번 테스트는 후보 탐색용이며 운영 자동승격은 아직 하지 않음.");console.log("미래 경기 사용 없음 / analyzer.ts 변경 없음");
console.log("\n===== V4.11 CHAMPION / CHALLENGER 자동승격 판정 =====");function v411judge(C,R){const prob=[["승패",C.ml.b,R.ml.b],["핸디",C.hc.b,R.hc.b],["O/U",C.ou.b,R.ou.b]],score=[["TEAM",C.team,R.team],["TOTAL",C.total,R.total],["DIFF",C.diff,R.diff]],logs=[["승패 LOGLOSS",C.ml.l,R.ml.l],["핸디 LOGLOSS",C.hc.l,R.hc.l],["O/U LOGLOSS",C.ou.l,R.ou.l]];const all=[...prob,...score,...logs],improved=all.filter(x=>x[2]<x[1]).length,worse=all.filter(x=>x[2]>x[1]).length;let monthImprove=0,monthWorse=0;for(const mo of [5,6,7,8,9]){const a=C.months[mo],b=R.months[mo];for(const k of ["team","total","diff"]){if(b[k]<a[k])monthImprove++;else if(b[k]>a[k])monthWorse++}for(const k of ["ml","hc","ou"]){if(b[k].b<a[k].b)monthImprove++;else if(b[k].b>a[k].b)monthWorse++}}const coreProb=prob.filter(x=>x[2]<x[1]).length,coreScore=score.filter(x=>x[2]<x[1]).length,catastrophic=all.some(x=>x[2]>x[1]*1.02),promote=coreProb>=2&&coreScore>=2&&improved>=6&&worse<=3&&monthImprove>monthWorse&&!catastrophic;return{promote,improved,worse,coreProb,coreScore,monthImprove,monthWorse,catastrophic,all}}const V411_CHAMP=V410[0];for(const R of V410.slice(1)){const J=v411judge(V411_CHAMP,R);console.log("\n후보="+(R.half===0?"누적전체":"반감기 "+R.half+"일"));console.log("핵심 확률 개선="+J.coreProb+"/3 | 점수예측 개선="+J.coreScore+"/3 | 전체지표 개선="+J.improved+"/9 악화="+J.worse+"/9");console.log("월별 세부지표 개선="+J.monthImprove+"/30 악화="+J.monthWorse+"/30 | 2% 초과 급격악화="+(J.catastrophic?"있음":"없음"));for(const x of J.all)console.log(x[0]+" "+x[1].toFixed(4)+" -> "+x[2].toFixed(4)+" "+(x[2]<x[1]?"개선":x[2]>x[1]?"악화":"동일"));console.log("판정="+(J.promote?"PROMOTE CHALLENGER":"KEEP CHAMPION"))}console.log("\n===== V4.11 승격 규칙 =====");console.log("1. 승패/핸디/O-U 중 최소 2개 확률 정확성 개선");console.log("2. TEAM/TOTAL/DIFF 중 최소 2개 점수예측 개선");console.log("3. Brier+Score+LogLoss 총 9개 중 최소 6개 개선, 악화 최대 3개");console.log("4. 월별 30개 지표에서 개선 수가 악화 수보다 많아야 함");console.log("5. 어떤 핵심 지표도 Champion 대비 2% 초과 악화 금지");console.log("모든 조건 통과시에만 PROMOTE / 하나라도 실패하면 KEEP CHAMPION");console.log("운영 analyzer.ts 변경 없음");
console.log("\n===== V4.12 자동학습 시간순 시뮬레이션 =====");const V412_MONTHS=[6,7,8,9],V412_DROP=[5,6];function v412evalModel(M,testGames){const A={ML:[],HANDICAP:[],TOTAL:[]};let team=0,total=0,diff=0,ng=0;for(const g of testGames){const L=v48cLam(g,M,V412_DROP);if(!L)continue;const as=n(g.awayScore),hs=n(g.homeScore);if(as===null||hs===null)continue;team+=(Math.abs(L[0]-as)+Math.abs(L[1]-hs))/2;total+=Math.abs(L[0]+L[1]-as-hs);diff+=Math.abs((L[0]-L[1])-(as-hs));ng++;const P=probs(g,L[0],L[1]);for(const k of Object.keys(A)){const q=marketRows(g,P).filter(x=>x.r.market===k);if(!q.length)continue;const x=q.reduce((a,b)=>b.p>a.p?b:a),y=wfActual(x);if(y===null)continue;A[k].push({p:wfCal(k,x.p),y})}}return{ng,team:team/ng,total:total/ng,diff:diff/ng,ml:wfMetric(A.ML),hc:wfMetric(A.HANDICAP),ou:wfMetric(A.TOTAL)}}function v412simpleJudge(C,R){const a=[C.ml.b,C.hc.b,C.ou.b,C.team,C.total,C.diff,C.ml.l,C.hc.l,C.ou.l],b=[R.ml.b,R.hc.b,R.ou.b,R.team,R.total,R.diff,R.ml.l,R.hc.l,R.ou.l],prob=[0,1,2].filter(i=>b[i]<a[i]).length,score=[3,4,5].filter(i=>b[i]<a[i]).length,imp=b.filter((x,i)=>x<a[i]).length,worse=b.filter((x,i)=>x>a[i]).length,bad=b.some((x,i)=>x>a[i]*1.02);return{promote:prob>=2&&score>=2&&imp>=6&&worse<=3&&!bad,prob,score,imp,worse,bad}}let V412_CHAMP_TRAIN=games.filter(g=>Number(String(g.date).slice(5,7))<=4),V412_CHAMP=v48cFit(V412_CHAMP_TRAIN,V412_DROP),promotions=0;console.log("초기 Champion 학습경기="+V412_CHAMP_TRAIN.length);for(const mo of V412_MONTHS){const previousMonth=mo-1,available=games.filter(g=>Number(String(g.date).slice(5,7))<=previousMonth),challenge=v48cFit(available,V412_DROP),test=games.filter(g=>Number(String(g.date).slice(5,7))===mo),C=v412evalModel(V412_CHAMP,test),R=v412evalModel(challenge,test),J=v412simpleJudge(C,R);console.log("\n["+mo+"월 검증]");console.log("Champion 학습="+V412_CHAMP_TRAIN.length+" / Challenger 학습="+available.length+" / 검증="+test.length);console.log("Champion 승패="+C.ml.b.toFixed(4)+" 핸디="+C.hc.b.toFixed(4)+" O/U="+C.ou.b.toFixed(4)+" TEAM="+C.team.toFixed(3)+" TOTAL="+C.total.toFixed(3)+" DIFF="+C.diff.toFixed(3));console.log("Challenger 승패="+R.ml.b.toFixed(4)+" 핸디="+R.hc.b.toFixed(4)+" O/U="+R.ou.b.toFixed(4)+" TEAM="+R.team.toFixed(3)+" TOTAL="+R.total.toFixed(3)+" DIFF="+R.diff.toFixed(3));console.log("확률개선="+J.prob+"/3 점수개선="+J.score+"/3 전체개선="+J.imp+"/9 악화="+J.worse+"/9 급격악화="+(J.bad?"있음":"없음"));console.log("판정="+(J.promote?"PROMOTE CHALLENGER":"KEEP CHAMPION"));if(J.promote){V412_CHAMP_TRAIN=available;V412_CHAMP=challenge;promotions++;console.log("→ Champion 교체 완료: "+available.length+"경기 학습 모델")}else console.log("→ 기존 Champion 유지")}console.log("\n===== V4.12 최종 결과 =====");console.log("자동승격 횟수="+promotions);console.log("최종 Champion 학습경기="+V412_CHAMP_TRAIN.length);console.log("흐름=경기종료→데이터누적→Challenger재학습→다음기간검증→통과시에만Champion교체");console.log("주의: 과거 데이터 시간순 시뮬레이션이며 운영 자동승격은 아직 비활성");console.log("analyzer.ts 변경 없음");
console.log("\n===== V4.13 무미래정보 운영형 자동학습 =====");const V413_DROP=[5,6],V413_MONTHS=[7,8,9];function v413ym(g){return Number(String(g.date).slice(5,7))}function v413eval(M,gs){return v412evalModel(M,gs)}function v413judge(C,R){return v412simpleJudge(C,R)}let V413_CHAMP_END=4,V413_CHAMP=v48cFit(games.filter(g=>v413ym(g)<=V413_CHAMP_END),V413_DROP),V413_PROMOTE=0;console.log("초기 Champion=4월까지 학습");for(const target of V413_MONTHS){const validationMonth=target-1,trainEnd=target-2,baseTrain=games.filter(g=>v413ym(g)<=trainEnd),candidateTrain=games.filter(g=>v413ym(g)<=validationMonth),validation=games.filter(g=>v413ym(g)===validationMonth),future=games.filter(g=>v413ym(g)===target),CVAL=v413eval(V413_CHAMP,validation),challenger=v48cFit(candidateTrain,V413_DROP),RVAL=v413eval(challenger,validation),J=v413judge(CVAL,RVAL);console.log("\n["+target+"월 운영 시점]");console.log("승격판정에 사용 가능한 데이터="+validationMonth+"월까지 / 미래감사="+target+"월");console.log("Champion 학습종료="+V413_CHAMP_END+"월 / Challenger 학습="+candidateTrain.length+"경기");console.log("과거검증 Champion 승패="+CVAL.ml.b.toFixed(4)+" 핸디="+CVAL.hc.b.toFixed(4)+" O/U="+CVAL.ou.b.toFixed(4)+" TEAM="+CVAL.team.toFixed(3)+" TOTAL="+CVAL.total.toFixed(3)+" DIFF="+CVAL.diff.toFixed(3));console.log("과거검증 Challenger 승패="+RVAL.ml.b.toFixed(4)+" 핸디="+RVAL.hc.b.toFixed(4)+" O/U="+RVAL.ou.b.toFixed(4)+" TEAM="+RVAL.team.toFixed(3)+" TOTAL="+RVAL.total.toFixed(3)+" DIFF="+RVAL.diff.toFixed(3));console.log("승격심사="+(J.promote?"PROMOTE":"KEEP")+" | 확률="+J.prob+"/3 점수="+J.score+"/3 전체="+J.imp+"/9 악화="+J.worse+"/9 급격악화="+(J.bad?"있음":"없음"));const deployed=J.promote?challenger:V413_CHAMP;if(J.promote){V413_CHAMP=challenger;V413_CHAMP_END=validationMonth;V413_PROMOTE++}const F=v413eval(deployed,future);console.log("→ "+target+"월에는 "+(J.promote?"새 Challenger":"기존 Champion")+" 사용");console.log("미래감사 승패="+F.ml.b.toFixed(4)+" 핸디="+F.hc.b.toFixed(4)+" O/U="+F.ou.b.toFixed(4)+" TEAM="+F.team.toFixed(3)+" TOTAL="+F.total.toFixed(3)+" DIFF="+F.diff.toFixed(3))}console.log("\n===== V4.13 최종 =====");console.log("운영형 자동승격="+V413_PROMOTE+"회");console.log("최종 Champion 학습종료="+V413_CHAMP_END+"월");console.log("핵심: target월 결과는 승격심사에 절대 사용하지 않음");console.log("승격은 과거 데이터만으로 결정하고 target월은 미래감사 전용");console.log("analyzer.ts 변경 없음");
console.log("\n===== V4.14 안전 자동승격 =====");const V414_DROP=[5,6],V414_TARGETS=[7,8,9],V414_MIN_REL=.005,V414_MIN_GAMES=50;function v414ym(g){return Number(String(g.date).slice(5,7))}function v414good(a,b){return Number.isFinite(a)&&Number.isFinite(b)&&b<=a*(1-V414_MIN_REL)}function v414bad(a,b){return Number.isFinite(a)&&Number.isFinite(b)&&b>a*1.02}function v414compare(C,R){const cv=[C.ml.b,C.hc.b,C.ou.b,C.team,C.total,C.diff,C.ml.l,C.hc.l,C.ou.l],rv=[R.ml.b,R.hc.b,R.ou.b,R.team,R.total,R.diff,R.ml.l,R.hc.l,R.ou.l];const good=cv.map((x,i)=>v414good(x,rv[i])),prob=good.slice(0,3).filter(Boolean).length,score=good.slice(3,6).filter(Boolean).length,all=good.filter(Boolean).length,bad=cv.some((x,i)=>v414bad(x,rv[i]));return{prob,score,all,bad}}let V414_CHAMP_END=4,V414_CHAMP=v48cFit(games.filter(g=>v414ym(g)<=4),V414_DROP),V414_PROMOTIONS=0;console.log("최소 상대개선="+(V414_MIN_REL*100).toFixed(1)+"% / 검증 최소경기="+V414_MIN_GAMES);for(const target of V414_TARGETS){const availableEnd=target-1,candidateTrain=games.filter(g=>v414ym(g)<=availableEnd),challenger=v48cFit(candidateTrain,V414_DROP),valMonths=[availableEnd,availableEnd-1].filter(m=>m>=5),checks=[];console.log("\n["+target+"월 운영 시점] Champion="+V414_CHAMP_END+"월까지 / Challenger="+availableEnd+"월까지");for(const vm of valMonths){const vg=games.filter(g=>v414ym(g)===vm),C=v412evalModel(V414_CHAMP,vg),R=v412evalModel(challenger,vg),J=v414compare(C,R),pass=vg.length>=V414_MIN_GAMES&&J.prob>=2&&J.score>=2&&J.all>=6&&!J.bad;checks.push(pass);console.log(vm+"월 과거검증 N="+vg.length+" | 확률="+J.prob+"/3 점수="+J.score+"/3 전체="+J.all+"/9 급격악화="+(J.bad?"있음":"없음")+" => "+(pass?"PASS":"FAIL"));console.log("  승패 "+C.ml.b.toFixed(4)+" -> "+R.ml.b.toFixed(4)+" | 핸디 "+C.hc.b.toFixed(4)+" -> "+R.hc.b.toFixed(4)+" | O/U "+C.ou.b.toFixed(4)+" -> "+R.ou.b.toFixed(4));console.log("  TEAM "+C.team.toFixed(3)+" -> "+R.team.toFixed(3)+" | TOTAL "+C.total.toFixed(3)+" -> "+R.total.toFixed(3)+" | DIFF "+C.diff.toFixed(3)+" -> "+R.diff.toFixed(3))}const promote=checks.length>=2&&checks.every(Boolean);console.log("승격판정="+(promote?"PROMOTE":"KEEP CHAMPION")+" ("+checks.filter(Boolean).length+"/"+checks.length+" 검증구간 통과)");if(promote){V414_CHAMP=challenger;V414_CHAMP_END=availableEnd;V414_PROMOTIONS++}const future=games.filter(g=>v414ym(g)===target),F=v412evalModel(V414_CHAMP,future);console.log("미래감사 "+target+"월: 승패="+F.ml.b.toFixed(4)+" 핸디="+F.hc.b.toFixed(4)+" O/U="+F.ou.b.toFixed(4)+" TEAM="+F.team.toFixed(3)+" TOTAL="+F.total.toFixed(3)+" DIFF="+F.diff.toFixed(3))}console.log("\n===== V4.14 최종 =====");console.log("안전규칙 자동승격="+V414_PROMOTIONS+"회");console.log("최종 Champion 학습종료="+V414_CHAMP_END+"월");console.log("승격조건=최근2개 과거구간 모두 PASS + 지표별 최소0.5% 상대개선 + 각 구간50경기 이상");console.log("target월은 승격판정에 사용하지 않고 미래감사에만 사용");console.log("analyzer.ts 변경 없음");
console.log("\n===== V4.15 SHADOW TEST =====");const V415_DROP=[5,6],V415_TARGETS=[7,8,9],V415_MIN_REL=.005,V415_MIN_GAMES=50;function v415ym(g){return Number(String(g.date).slice(5,7))}function v415good(a,b){return Number.isFinite(a)&&Number.isFinite(b)&&b<=a*(1-V415_MIN_REL)}function v415bad(a,b){return Number.isFinite(a)&&Number.isFinite(b)&&b>a*1.02}function v415judge(C,R){const cv=[C.ml.b,C.hc.b,C.ou.b,C.team,C.total,C.diff,C.ml.l,C.hc.l,C.ou.l],rv=[R.ml.b,R.hc.b,R.ou.b,R.team,R.total,R.diff,R.ml.l,R.hc.l,R.ou.l],good=cv.map((x,i)=>v415good(x,rv[i]));return{prob:good.slice(0,3).filter(Boolean).length,score:good.slice(3,6).filter(Boolean).length,all:good.filter(Boolean).length,bad:cv.some((x,i)=>v415bad(x,rv[i]))}}function v415blank(){return{n:0,mlN:0,hcN:0,ouN:0,mlB:0,hcB:0,ouB:0,mlL:0,hcL:0,ouL:0,team:0,total:0,diff:0}}function v415add(A,R){A.n+=R.n||0;A.mlN+=R.ml.n||0;A.hcN+=R.hc.n||0;A.ouN+=R.ou.n||0;A.mlB+=(R.ml.b||0)*(R.ml.n||0);A.hcB+=(R.hc.b||0)*(R.hc.n||0);A.ouB+=(R.ou.b||0)*(R.ou.n||0);A.mlL+=(R.ml.l||0)*(R.ml.n||0);A.hcL+=(R.hc.l||0)*(R.hc.n||0);A.ouL+=(R.ou.l||0)*(R.ou.n||0);A.team+=(R.team||0)*(R.n||0);A.total+=(R.total||0)*(R.n||0);A.diff+=(R.diff||0)*(R.n||0)}function v415show(name,A){console.log(name+" | GAMES="+A.n+" 승패="+(A.mlB/(A.mlN||1)).toFixed(4)+" 핸디="+(A.hcB/(A.hcN||1)).toFixed(4)+" O/U="+(A.ouB/(A.ouN||1)).toFixed(4)+" TEAM="+(A.team/(A.n||1)).toFixed(3)+" TOTAL="+(A.total/(A.n||1)).toFixed(3)+" DIFF="+(A.diff/(A.n||1)).toFixed(3)+" | LL="+(A.mlL/(A.mlN||1)).toFixed(4)+"/"+(A.hcL/(A.hcN||1)).toFixed(4)+"/"+(A.ouL/(A.ouN||1)).toFixed(4))}let champEnd=4,champ=v48cFit(games.filter(g=>v415ym(g)<=4),V415_DROP),promotions=0;const SAFE=v415blank(),LATEST=v415blank();for(const target of V415_TARGETS){const availableEnd=target-1,challenger=v48cFit(games.filter(g=>v415ym(g)<=availableEnd),V415_DROP),vals=[availableEnd,availableEnd-1].filter(m=>m>=5),checks=[];for(const vm of vals){const vg=games.filter(g=>v415ym(g)===vm),C=v412evalModel(champ,vg),R=v412evalModel(challenger,vg),J=v415judge(C,R);checks.push(vg.length>=V415_MIN_GAMES&&J.prob>=2&&J.score>=2&&J.all>=6&&!J.bad)}const promote=checks.length>=2&&checks.every(Boolean);if(promote){champ=challenger;champEnd=availableEnd;promotions++}const future=games.filter(g=>v415ym(g)===target),safeR=v412evalModel(champ,future),latestR=v412evalModel(challenger,future);v415add(SAFE,safeR);v415add(LATEST,latestR);console.log("\n["+target+"월 SHADOW] 승격="+(promote?"YES":"NO")+" SAFE학습종료="+champEnd+"월 LATEST학습종료="+availableEnd+"월");console.log("SAFE   승패="+safeR.ml.b.toFixed(4)+" 핸디="+safeR.hc.b.toFixed(4)+" O/U="+safeR.ou.b.toFixed(4)+" TEAM="+safeR.team.toFixed(3)+" TOTAL="+safeR.total.toFixed(3)+" DIFF="+safeR.diff.toFixed(3));console.log("LATEST 승패="+latestR.ml.b.toFixed(4)+" 핸디="+latestR.hc.b.toFixed(4)+" O/U="+latestR.ou.b.toFixed(4)+" TEAM="+latestR.team.toFixed(3)+" TOTAL="+latestR.total.toFixed(3)+" DIFF="+latestR.diff.toFixed(3))}console.log("\n===== V4.15 SHADOW 최종 =====");v415show("SAFE CHAMPION",SAFE);v415show("ALWAYS LATEST",LATEST);const S=[SAFE.mlB/(SAFE.mlN||1),SAFE.hcB/(SAFE.hcN||1),SAFE.ouB/(SAFE.ouN||1),SAFE.team/(SAFE.n||1),SAFE.total/(SAFE.n||1),SAFE.diff/(SAFE.n||1)],L=[LATEST.mlB/(LATEST.mlN||1),LATEST.hcB/(LATEST.hcN||1),LATEST.ouB/(LATEST.ouN||1),LATEST.team/(LATEST.n||1),LATEST.total/(LATEST.n||1),LATEST.diff/(LATEST.n||1)];const wins=S.filter((x,i)=>x<L[i]-1e-12).length,ties=S.filter((x,i)=>Math.abs(x-L[i])<=1e-12).length;console.log("SAFE 우세="+wins+"/6 동률="+ties+"/6 LATEST 우세="+(6-wins-ties)+"/6");console.log("안전규칙 승격="+promotions+"회 / 미래 target 결과는 승격판정에 사용하지 않음");console.log("V4.14 규칙 변경 없음 / analyzer.ts 변경 없음");
