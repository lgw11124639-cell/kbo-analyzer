const fs=require("fs");const DATA="data/kbo-backtest-2026-all-candidates-lineup-base.json";const root=JSON.parse(fs.readFileSync(DATA,"utf8"));const rows=root.results||[];const n=v=>{const x=Number(v);return Number.isFinite(x)?x:null};const clamp=(x,a,b)=>Math.max(a,Math.min(b,x));const sigmoid=x=>1/(1+Math.exp(-x));const logit=p=>Math.log(clamp(p,.001,.999)/(1-clamp(p,.001,.999)));const games=[...new Map(rows.filter(r=>n(r.awayScore)!==null&&n(r.homeScore)!==null).map(r=>[r.gameId,r])).values()].sort((a,b)=>String(a.date).localeCompare(String(b.date)));const split=g=>{const m=Number(String(g.date).slice(5,7));return m<=4?"DISCOVERY":m<=6?"INTERNAL":"FINAL"};function mean(a){return a.length?a.reduce((s,x)=>s+x,0)/a.length:0}function sd(a){if(a.length<2)return 1;const m=mean(a);return Math.sqrt(mean(a.map(x=>(x-m)**2)))||1}function feat(g){const x=g.scoreModelInputs||{};const ar=n(x.awayAvgRuns),ara=n(x.awayAvgRunsAllowed),hr=n(x.homeAvgRuns),hra=n(x.homeAvgRunsAllowed);if([ar,ara,hr,hra].some(v=>v===null))return null;return [1,(ar+hra)/2,(hr+ara)/2,n(g.starterEdge)||0,n(g.formEdge)||0,n(g.bullpenEdge)||0,n(g.lineupEdge)||0,n(g.awayLineupOps)||0,n(g.homeLineupOps)||0]}function solve(X,y,ridge=.35){const m=X[0].length,A=Array.from({length:m},()=>Array(m).fill(0)),b=Array(m).fill(0);for(let i=0;i<X.length;i++)for(let j=0;j<m;j++){b[j]+=X[i][j]*y[i];for(let k=0;k<m;k++)A[j][k]+=X[i][j]*X[i][k]}for(let j=1;j<m;j++)A[j][j]+=ridge;for(let i=0;i<m;i++){let z=i;for(let r=i+1;r<m;r++)if(Math.abs(A[r][i])>Math.abs(A[z][i]))z=r;[A[i],A[z]]=[A[z],A[i]];[b[i],b[z]]=[b[z],b[i]];let d=A[i][i];if(Math.abs(d)<1e-10)continue;for(let k=i;k<m;k++)A[i][k]/=d;b[i]/=d;for(let r=0;r<m;r++)if(r!==i){const q=A[r][i];for(let k=i;k<m;k++)A[r][k]-=q*A[i][k];b[r]-=q*b[i]}}return b}const train=games.filter(g=>split(g)!=="FINAL").map(g=>({g,f:feat(g)})).filter(x=>x.f);const raw=train.map(x=>x.f);const mu=[],ss=[];for(let j=0;j<raw[0].length;j++){if(j===0){mu[j]=0;ss[j]=1}else{mu[j]=mean(raw.map(r=>r[j]));ss[j]=sd(raw.map(r=>r[j]))}}const Z=raw.map(r=>r.map((v,j)=>j===0?1:(v-mu[j])/ss[j]));const wa=solve(Z,train.map(x=>n(x.g.awayScore)));const wh=solve(Z,train.map(x=>n(x.g.homeScore)));function lambdas(g){const f=feat(g);if(!f)return null;const z=f.map((v,j)=>j===0?1:(v-mu[j])/ss[j]);let a=z.reduce((s,v,j)=>s+v*wa[j],0),h=z.reduce((s,v,j)=>s+v*wh[j],0);return [clamp(a,1.5,9),clamp(h,1.5,9)]}function pois(k,l){let p=Math.exp(-l);for(let i=1;i<=k;i++)p*=l/i;return p}function dist(a,h){const out=[];let mass=0;for(let x=0;x<=20;x++)for(let y=0;y<=20;y++){const p=pois(x,a)*pois(y,h);out.push([x,y,p]);mass+=p}return out.map(v=>[v[0],v[1],v[2]/mass])}function probs(g,a,h){const D=dist(a,h);let aw=0,hw=0,tie=0;for(const[x,y,p]of D){if(x>y)aw+=p;else if(y>x)hw+=p;else tie+=p}const den=aw+hw;return{awayML:den?aw/den:.5,homeML:den?hw/den:.5,D,tie}}function marketRows(g,P){const rs=rows.filter(r=>r.gameId===g.gameId);const out=[];for(const r of rs){const o=n(r.odds);if(!o||o<=1)continue;let p=null,push=0;if(r.market==="ML"){const away=String(r.label).includes(g.awayTeam);p=away?P.awayML:P.homeML}else if(r.market==="HANDICAP"){const away=String(r.label).includes(g.awayTeam);const mm=String(r.label).match(/([+-]?\d+(?:\.\d+)?)/);if(!mm)continue;const line=Number(mm[1]);let win=0;for(const[x,y,q]of P.D){const z=(away?x-y:y-x)+line;if(z>0)win+=q;else if(z===0)push+=q}p=win/(1-push||1)}else if(r.market==="TOTAL"){const line=n(r.totalLine)??Number(String(r.label).match(/(\d+(?:\.\d+)?)/)?.[1]);if(!Number.isFinite(line))continue;const over=String(r.label).includes("오버");let win=0;for(const[x,y,q]of P.D){const z=x+y-line;if(z===0)push+=q;else if((over&&z>0)||(!over&&z<0))win+=q}p=win/(1-push||1)}if(p!==null)out.push({r,p,ev:p*o-1})}return out}function score(part){const gs=games.filter(g=>split(g)===part);let teamAbs=0,totalAbs=0,diffAbs=0,nG=0,wN=0,wOK=0,viol=0;const M={ML:[],HANDICAP:[],TOTAL:[]};for(const g of gs){const L=lambdas(g);if(!L)continue;const[a,h]=L,P=probs(g,a,h),AS=n(g.awayScore),HS=n(g.homeScore);teamAbs+=(Math.abs(a-AS)+Math.abs(h-HS))/2;totalAbs+=Math.abs(a+h-AS-HS);diffAbs+=Math.abs((a-h)-(AS-HS));nG++;if(AS!==HS){wN++;if((P.awayML>.5)===(AS>HS))wOK++}const mr=marketRows(g,P);for(const x of mr)M[x.r.market]?.push(x);const hc=mr.filter(x=>x.r.market==="HANDICAP");for(const x of hc){const away=String(x.r.label).includes(g.awayTeam);const mm=String(x.r.label).match(/([+-]?\d+(?:\.\d+)?)/);if(mm&&Number(mm[1])<0){const ml=away?P.awayML:P.homeML;if(x.p>ml+1e-9)viol++}}}console.log("\n===== "+part+" =====");console.log("GAMES="+nG+" TEAM_MAE="+(teamAbs/nG).toFixed(3)+" TOTAL_MAE="+(totalAbs/nG).toFixed(3)+" DIFF_MAE="+(diffAbs/nG).toFixed(3)+" WINNER_ACC="+(100*wOK/wN).toFixed(1)+"% CONSISTENCY_VIOLATIONS="+viol);for(const k of Object.keys(M)){const a=M[k];let b=0,ll=0,hit=0,roi=0,settled=0;for(const x of a){const AS=n(x.r.awayScore),HS=n(x.r.homeScore);let win=null;if(AS===null||HS===null)continue;if(x.r.market==="ML"){const away=String(x.r.label).includes(x.r.awayTeam);if(AS!==HS)win=(away?(AS>HS):(HS>AS))?1:0}else if(x.r.market==="HANDICAP"){const away=String(x.r.label).includes(x.r.awayTeam);const mm=String(x.r.label).match(/([+-]?\\d+(?:\\.\\d+)?)/);if(!mm)continue;const z=(away?AS-HS:HS-AS)+Number(mm[1]);if(z!==0)win=z>0?1:0}else if(x.r.market==="TOTAL"){const line=n(x.r.totalLine)??Number(String(x.r.label).match(/(\\d+(?:\\.\\d+)?)/)?.[1]);if(!Number.isFinite(line))continue;const z=AS+HS-line;if(z!==0)win=String(x.r.label).includes("오버")?(z>0?1:0):(z<0?1:0)}if(win===null)continue;settled++;hit+=win;b+=(x.p-win)**2;ll+=-(win*Math.log(clamp(x.p,.001,.999))+(1-win)*Math.log(clamp(1-x.p,.001,.999)));roi+=win*(n(x.r.odds)-1)-(1-win)}console.log(k+" N="+settled+" HIT="+(100*hit/(settled||1)).toFixed(1)+"% BRIER="+(b/(settled||1)).toFixed(4)+" LOGLOSS="+(ll/(settled||1)).toFixed(4)+" ROI="+(100*roi/(settled||1)).toFixed(1)+"%")}return{nG,teamAbs,totalAbs,diffAbs,wN,wOK}}console.log("===== KBO ENGINE V4 LEARNING BACKTEST =====");console.log("ROWS="+rows.length+" GAMES="+games.length+" TRAIN_GAMES="+train.length+" FINAL_GAMES="+games.filter(g=>split(g)==="FINAL").length);console.log("MODEL=Ridge learned on Mar-Jun only; one joint score distribution for ML/HC/TOTAL");console.log("AWAY_WEIGHTS="+JSON.stringify(wa));console.log("HOME_WEIGHTS="+JSON.stringify(wh));score("DISCOVERY");score("INTERNAL");score("FINAL");console.log("\n===== V0.8 FINAL BASELINE =====");console.log("TEAM_MAE=2.855 TOTAL_MAE=4.188 DIFF_MAE=4.109 WINNER_ACC=54.0%");console.log("ML_ROI=-15.8% HANDICAP_ROI=-15.5% TOTAL_ROI=-11.2%");console.log("\nIMPORTANT: V4 is challenger only. analyzer.ts unchanged.");